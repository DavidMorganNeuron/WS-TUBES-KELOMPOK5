data:ws-125 rdf:type ws:DestinasiWisata .
data:ws-125 ws:alamat "Desa Fulolo, Kecamatan Alasa, Kabupaten Nias Utara, Sumatera Utara 22862"@id .
data:ws-125 ws:berkategori data:kategori-alam .
