data:ws-087 rdf:type ws:DestinasiWisata .
data:ws-087 ws:alamat "Jalan Trans Sumatera Bukittinggi-Padang Sidempuan, Aek Libung, Kecamatan Sayur Matinggi, Kabupaten Tapanuli Selatan, Sumatera Utara 22774"@id .
