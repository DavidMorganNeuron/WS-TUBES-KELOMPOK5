data:ws-118 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-118"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Efrata"@id ;
    ws:namaAlternatif "Sampuran Efrata"@id ;
    ws:deskripsiSingkat "Air Terjun Efrata menyuguhkan debit air setinggi 20 meter yang tersembunyi di rimbunnya lembah perbukitan dekat Menara Pandang Tele."@id ;
    ws:deskripsiLengkap "Air Terjun Efrata (dikenal warga lokal sebagai Sampuran Efrata) adalah keajaiban alam tersembunyi berjarak tidak jauh dari pusat Harian Boho. Curahan air terjun ini melebar dengan aliran deras yang menuruni bongkahan batu cadas di tebing vertikal yang diliputi vegetasi hijau subur dan anggrek hutan. Berbeda dengan air terjun lain yang mengharuskan trekking berjam-jam, lokasi Efrata dapat diakses cukup dengan berjalan kaki sekitar 100 meter dari tempat parkir, menjadikannya opsi ideal untuk rekreasi air singkat usai pengunjung puas menikmati kemegahan Menara Pandang Tele."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Efrata"@id, "Harian Boho"@id, "Samosir"@id, "Wisata Alam"@id, "Sampuran Efrata"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Sosor Dolok, Kecamatan Harian, Kabupaten Samosir, Sumatera Utara 22396"@id ;
    ws:lintang "2.53864"^^xsd:decimal ;
    ws:bujur "98.64506"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak sekitar 2 km setelah menuruni jalan dari arah Menara Pandang Tele, terdapat jalan simpang masuk."@id ;
