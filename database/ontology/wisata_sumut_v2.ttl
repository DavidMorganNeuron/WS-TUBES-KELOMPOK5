    ws:lintang "0.860397"^^xsd:decimal ;
    ws:bujur "99.575226"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di perbukitan dekat kota Panyabungan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
