data:ws-119 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-119"^^xsd:string ;
    ws:namaDestinasi "Danau Sidihoni"@id ;
    ws:namaAlternatif "Danau di Atas Danau"@id ;
    ws:deskripsiSingkat "Danau Sidihoni terkenal dengan julukan unik 'danau di atas danau' karena letaknya yang tepat berada di daratan Pulau Samosir di tengah Danau Toba."@id ;
    ws:deskripsiLengkap "Fenomena geologi Danau Sidihoni merupakan salah satu yang paling istimewa karena menjadi perairan danau alami seluas tiga hektare yang berdiam di wilayah Pulau Samosir yang juga dikelilingi oleh air (Danau Toba). Permukaan airnya sering memantulkan warna langit dan sekelilingnya yang sangat memukau, yang ironisnya dipengaruhi tingkat kedalaman air yang kerap kali berubah sesuai musim dan curah hujan. Dikelilingi padang sabana yang dihiasi pepohonan pinus yang berjejer renggang, kawasan danau kecil ini menjadi sumber air bersih warga lokal saat kemarau serta spot indah pelarian turis yang tidak suka keramain."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Sidihoni"@id, "Pangururan"@id, "Samosir"@id, "Danau di Atas Danau"@id, "Wisata Unik"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Sabungan Nihuta, Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara 22392"@id ;
    ws:lintang "2.601483"^^xsd:decimal ;
    ws:bujur "98.744764"^^xsd:decimal ;
    ws:petunjukLokasi "Masuk melalui jalur jalan Ronggur Nihuta dari arah Pangururan sejauh kurang lebih 8 km."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
