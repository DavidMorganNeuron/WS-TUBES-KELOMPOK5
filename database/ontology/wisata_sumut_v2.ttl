    ws:ratingPengunjung "4.2"^^xsd:decimal .

data:ws-269 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-269"^^xsd:string ;
    ws:namaDestinasi "Gereja Katedral Sibolga"@id ;
    ws:namaAlternatif "Gereja Katedral Santa Theresia Lisieux"@id ;
    ws:deskripsiSingkat "Gereja Katedral Sibolga, secara resmi bernama Gereja Katedral Santa Theresia Lisieux, adalah sebuah gereja katedral Katolik yang menjadi pusat dari Keuskupan Sibolga yang terletak di Kota Sibolga, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Gereja Katedral Sibolga, secara resmi bernama Gereja Katedral Santa Theresia Lisieux, adalah sebuah gereja katedral Katolik yang menjadi pusat dari Keuskupan Sibolga yang terletak di Kota Sibolga, Sumatera Utara. Sejarah Pada 12 Maret 1929, R.P. Chrysologus Timmermans, O.F.M. Cap., tiba di Sibolga dan menjadi pastor pertama yang berkarya di tanah Batak. Pada hari Raya Pentakosta, 19 Mei 1929, rumah dan kapel ini diberkati. Pada tanggal 23 Februari 1932 mulailah pembangunan rumah pastor dan Gereja. Dalam musim kemarau, tanggal 11 September 1932, gedung gereja dan pastoran diberkati oleh Prefek Apostolik Padang, Mgr. Mathias Leonardus Trudon Brans, O.F.M.Cap. Dengan demikian, diletakkanlah dasar bagi Gereja Katolik di Sibolga, yang kemudian menjadi titik pusat Prefektur Apostolik Sibolga."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Katedral Sibolga, Santa Theresia Lisieux, Keuskupan Sibolga, gereja Katolik"@id ;
    ws:beradaDi "Kota Sibolga"@id ;
    ws:alamat "-"@id ;
    ws:lintang "1.74156"^^xsd:decimal ;
