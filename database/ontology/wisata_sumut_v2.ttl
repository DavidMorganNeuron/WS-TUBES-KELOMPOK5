data:ws-121 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-121"^^xsd:string ;
    ws:namaDestinasi "Bukit Sibea-bea"@id ;
    ws:namaAlternatif "Patung Yesus Sibea-bea"@id, "Jalan Berkelok Sibea-bea"@id ;
    ws:deskripsiSingkat "Bukit Sibea-bea menghadirkan patung Yesus Kristus tertinggi di dunia (61 meter) dengan akses jalan beton aspal yang meliuk-liuk estetis menghadap kaldera."@id ;
    ws:deskripsiLengkap "Diinisiasi sejak 2018, Bukit Sibea-bea merupakan kawasan wisata religius dan mahakarya infrastruktur terpadu yang memukau perbukitan Kecamatan Harian. Monumen utama kawasan ini adalah Patung Yesus Kristus setinggi 61 meter yang menorehkan rekor dunia, berdiri agung menghadap langsung ke arah Danau Toba yang tenang seolah memberikan berkat. Namun, selain wisata ibadahnya, kawasan ini juga viral akibat tata letak jalan aspal hotmix menanjaknya yang sengaja dirancang berkelok-kelok melengkung sempurna menyerupai lintasan balap indah di Eropa, menjadikannya titik foto panorama terbaik di wilayah utara danau."@id ;
    ws:jenisDestinasi "Religi"@id, "Buatan"@id, "Alam"@id ;
    ws:kataKunci "Bukit Sibea-bea"@id, "Patung Yesus"@id, "Harian"@id, "Samosir"@id, "Wisata Religi"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Turpuk Sihotang, Kecamatan Harian, Kabupaten Samosir, Sumatera Utara 22396"@id ;
    ws:lintang "2.561681"^^xsd:decimal ;
    ws:bujur "98.659197"^^xsd:decimal ;
