data:ws-120 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-120"^^xsd:string ;
    ws:namaDestinasi "Pemandian Air Panas Aek Rangat"@id ;
    ws:namaAlternatif "Hot Spring Pangururan"@id, "Aek Rangat"@id ;
    ws:deskripsiSingkat "Pemandian Air Panas Aek Rangat bersumber langsung dari Gunung Pusuk Buhit yang menawarkan kolam belerang sehat di pinggiran Danau Toba."@id ;
    ws:deskripsiLengkap "Terletak persis di kaki Gunung Pusuk Buhit, gunung berapi aktif yang dianggap suci sebagai asal mula suku Batak, Aek Rangat merupakan mata air panas geotermal bersuhu belerang murni. Di kawasan ini, sumber mata air dialirkan langsung ke sejumlah kolam buatan berbagai tingkat kehangatan yang dikelola langsung oleh warga lokal. Berendam air belerang yang berkhasiat menyembuhkan gangguan kulit ini sembari menyaksikan bongkahan batu kapur berjejer kontras dengan birunya lanskap Danau Toba di senja hari, menjadikan pengalaman ke Aek Rangat sempurna bagi relaksasi fisik maupun jiwa."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Aek Rangat"@id, "Pangururan"@id, "Air Panas Samosir"@id, "Samosir"@id, "Pusuk Buhit"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Siogung Ogung, Kecamatan Pangururan, Kabupaten Samosir, Sumatera Utara 22392"@id ;
    ws:lintang "2.6189"^^xsd:decimal ;
    ws:bujur "98.6739"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak sekitar 3 km dari pusat kota Pangururan menuju kaki gunung."@id ;
    ws:jamOperasional "Setiap Hari 06.00-22.00"@id ;
