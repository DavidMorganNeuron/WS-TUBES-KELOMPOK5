data:ws-133 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-133"^^xsd:string ;
    ws:namaDestinasi "Pantai Monyet"@id ;
    ws:namaAlternatif "Pantai Monyet Aek Natas"@id ;
    ws:deskripsiSingkat "Pantai Monyet di Aek Natas merupakan pemandian tepi sungai dengan bebatuan lebar yang kerap disinggahi oleh kawanan kera ekor panjang liar."@id ;
    ws:deskripsiLengkap "Meskipun menyandang kata 'pantai', destinasi ini bukanlah pesisir lautan lepas, melainkan tepian sungai berbatu lebar layaknya bantaran pasir pantai di kawasan Aek Natas, Kabupaten Labuhanbatu Utara. Aliran sungainya dangkal dengan banyak ceruk kecil yang ramah untuk tempat bermain anak. Dinamakan Pantai Monyet karena kelestarian ekosistem hutannya yang terjaga membuat segerombolan kera liar jinak sering menampakkan diri menuruni dahan pepohonan ke pinggiran air, terutama saat sore hari, sehingga interaksi manusia dengan satwa ini sering menjadi hiburan tersendiri bagi pengunjung."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Pantai Monyet"@id, "Aek Natas"@id, "Labuhanbatu Utara"@id, "Pemandian Alam"@id, "Wisata Satwa"@id ;
    ws:beradaDi "Kabupaten Labuhanbatu Utara"@id ;
