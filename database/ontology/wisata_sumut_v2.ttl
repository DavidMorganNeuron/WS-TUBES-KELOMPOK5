    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-108 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-108"^^xsd:string ;
    ws:namaDestinasi "Bukit Tarabunga"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Bukit Tarabunga menyuguhkan pemandangan luas kaldera Danau Toba dari sudut perbukitan di Balige yang sejuk dan menenangkan."@id ;
    ws:deskripsiLengkap "Bukit Tarabunga merupakan destinasi alam favorit bagi para pemburu fotografi bentang alam, letaknya tidak begitu tinggi namun posisinya sangat presisi untuk melihat liukan garis Pantai Danau Toba, hamparan sawah warga yang berundak, serta latar pegunungan bukit barisan secara 360 derajat. Waktu terbaik mengunjungi tempat ini adalah menjelang senja maupun saat matahari terbit untuk mendapatkan visual warna jingga eksotis yang memantul ke perairan. Suasananya yang sepi dan jauh dari kebisingan kota sangat direkomendasikan bagi wisatawan yang mencari ketenangan."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Bukit Tarabunga"@id, "Balige"@id, "Toba"@id, "Pemandangan Danau Toba"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Desa Tarabunga, Kecamatan Tampahan, Kabupaten Toba, Sumatera Utara 22312"@id ;
    ws:lintang "2.3532"^^xsd:decimal ;
    ws:bujur "99.0273"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak 5 kilometer dari pusat Kota Balige menuju Kecamatan Tampahan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
