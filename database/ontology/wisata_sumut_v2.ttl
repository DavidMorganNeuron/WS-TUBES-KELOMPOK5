data:ws-097 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-097"^^xsd:string ;
    ws:namaDestinasi "Makam Papan Tinggi"@id ;
    ws:namaAlternatif "Makam Syekh Mahmud"@id ;
    ws:deskripsiSingkat "Makam Papan Tinggi Barus terkenal dengan situs makam Syekh Mahmud dengan ukuran nisan yang sangat panjang serta rute pendakian ribuan anak tangganya."@id ;
    ws:deskripsiLengkap "Berlokasi di ketinggian lebih dari 200 meter di atas permukaan laut, Makam Papan Tinggi menuntut peziarah untuk menaklukkan lebih dari 700 anak tangga (sering disebut 1.000 tangga oleh penduduk) yang terbentang melintasi pepohonan hutan sebelum dapat mencapai puncak bukit. Di puncaknya, terdapat makam Syekh Mahmud dari Yaman dengan panjang makam melebihi 7 meter. Selain khusyuk memanjatkan doa, peziarah yang tiba di area makam akan dimanjakan dengan pemandangan 360 derajat ke arah bentang laut Samudra Hindia dan seluruh daratan kota kuno Barus."@id ;
    ws:jenisDestinasi "Religi"@id, "Budaya"@id ;
    ws:kataKunci "Makam Papan Tinggi"@id, "Syekh Mahmud"@id, "Barus"@id, "Tapanuli Tengah"@id, "1000 Tangga"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Desa Penanggahan, Kecamatan Barus Utara, Kabupaten Tapanuli Tengah, Sumatera Utara 22564"@id ;
    ws:lintang "2.0511"^^xsd:decimal ;
    ws:bujur "98.4109"^^xsd:decimal ;
    ws:petunjukLokasi "Akses masuk melalui Desa Penanggahan Barus Utara, terdapat pintu gapura khusus Makam Papan Tinggi."@id ;
