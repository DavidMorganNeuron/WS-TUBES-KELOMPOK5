data:ws-129 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-129"^^xsd:string ;
    ws:namaDestinasi "Pulau Poncan Gadang"@id ;
    ws:namaAlternatif "Poncan Gadang"@id, "Pulau Poncan"@id ;
    ws:deskripsiSingkat "Pulau Poncan Gadang adalah pulau resor tropis menawan di lepas pantai Sibolga dengan pesona pasir putih dan jejak gua pertahanan Jepang."@id ;
    ws:deskripsiLengkap "Hanya membutuhkan waktu 15 hingga 20 menit berlayar menggunakan perahu mesin dari pelabuhan utama Sibolga, Pulau Poncan Gadang langsung menyambut wisatawan dengan air lautnya yang sangat biru dan gradasi hijau zamrud di sekitar pesisir. Pulau yang menyimpan nilai sejarah maritim masa prakemerdekaan ini memiliki sejumlah gua-gua persembunyian tentara Jepang yang menghadap laut. Saat ini, kawasan tersebut dikelola secara profesional dengan tersedianya resor mewah beralaskan panggung kayu, area snorkeling yang aman, memancing ikan laut dangkal, hingga taman yang teduh untuk bersantai."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pulau Poncan Gadang"@id, "Sibolga"@id, "Wisata Bahari"@id, "Resor Sibolga"@id, "Gua Jepang"@id ;
    ws:beradaDi "Kota Sibolga"@id ;
    ws:alamat "Kecamatan Sibolga Kota, Kota Sibolga, Sumatera Utara 22522"@id ;
    ws:lintang "1.710556"^^xsd:decimal ;
    ws:bujur "98.764442"^^xsd:decimal ;
    ws:petunjukLokasi "Menyeberang dari dermaga wisata pelabuhan Sibolga dengan speedboat."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "@disparporasibolga"^^xsd:anyURI ;
    ws:memilikiFasilitas "Penginapan"@id, "Rumah Makan"@id, "Toilet"@id, "Sewa Peralatan"@id, "Gazebo"@id ;
