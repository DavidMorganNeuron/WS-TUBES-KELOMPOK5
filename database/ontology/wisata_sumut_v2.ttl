    ws:alamat "Kecamatan Baktiraja, Kabupaten Humbang Hasundutan, Sumatera Utara 22457"@id ;
    ws:lintang "2.3094"^^xsd:decimal ;
    ws:bujur "98.8087"^^xsd:decimal ;
    ws:petunjukLokasi "Menuruni jalanan curam dan berkelok selama 30 menit dari pusat kota Dolok Sanggul."@id ;
