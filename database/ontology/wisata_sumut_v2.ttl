data:ws-136 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-136"^^xsd:string ;
    ws:namaDestinasi "Pemandian Pandayangan Indah"@id ;
    ws:namaAlternatif "Pandayangan Indah"@id, "Pantai Pandayangan"@id ;
    ws:deskripsiSingkat "Pemandian Pandayangan Indah menyajikan pesona arus sungai landai memanjang dengan struktur tepian bebatuan lebar layaknya pesisir tersembunyi."@id ;
    ws:deskripsiLengkap "Terletak di Kecamatan Silangkitang, Labuhanbatu Selatan, Pemandian Pandayangan Indah adalah kawasan sungai berbatu cadas luas yang sangat populer di kalangan warga sekitar. Debit airnya bersumber langsung dari mata air bukit, sehingga terasa sejuk sepanjang musim. Sungai ini tak begitu dalam, menjadikannya arena yang sangat aman bagi kelompok keluarga dan anak-anak yang ingin bermain air tanpa rasa cemas. Terdapat pula kawasan padang rumput yang berdampingan dengan bebatuan besar, yang kerap kali menjadi titik piknik dan acara memanggang ikan bersama rombongan kerabat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Pandayangan Indah"@id, "Silangkitang"@id, "Labuhanbatu Selatan"@id, "Pemandian Alam"@id, "Labusel"@id ;
    ws:beradaDi "Kabupaten Labuhanbatu Selatan"@id ;
    ws:alamat "Desa Ulumahuam, Kecamatan Silangkitang, Kabupaten Labuhanbatu Selatan, Sumatera Utara 21461"@id ;
    ws:lintang "1.8767"^^xsd:decimal ;
    ws:bujur "99.9531"^^xsd:decimal ;
