@prefix ws:    <http://pariwisatasumut.org/ontology/v2#> .
@prefix data:  <http://pariwisatasumut.org/resource/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Struktur Turtle destinasi wisata Sumatera Utara.
# Setiap resource destinasi menggunakan tepat 21 properti lokal ws: yang
# didefinisikan di bawah. rdf:type hanya menandai kelas resource RDF.
# Nilai yang tidak diketahui tidak perlu ditulis sebagai triple.

ws: a owl:Ontology ;
    rdfs:label "Struktur Data Destinasi Wisata Sumatera Utara"@id ;
    owl:versionInfo "2.1.0" .

ws:DestinasiWisata a owl:Class ;
    rdfs:label "Destinasi wisata"@id .

ws:idDestinasi a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ID destinasi"@id ;
    rdfs:comment "ID dibuat untuk membedakan destinasi. IRI resource juga menjadi identitas RDF-nya."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:string .

ws:namaDestinasi a owl:DatatypeProperty ;
    rdfs:label "Nama destinasi"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:namaAlternatif a owl:DatatypeProperty ;
    rdfs:label "Nama alternatif"@id ;
    rdfs:comment "Berisi lebih dari satu nama, alias, atau ejaan alternatif."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:deskripsiSingkat a owl:DatatypeProperty ;
    rdfs:label "Deskripsi singkat"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:deskripsiLengkap a owl:DatatypeProperty ;
    rdfs:label "Deskripsi lengkap"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:jenisDestinasi a owl:DatatypeProperty ;
    rdfs:label "Jenis destinasi"@id ;
    rdfs:comment "Alam, Budaya, Religi, Bahari, Kuliner, Buatan. Alam: gunung, hutan, air terjun, dan keindahan alam. Budaya: sejarah, tradisi, seni, dan kehidupan masyarakat lokal. Religi: tujuan keagamaan. Bahari: laut dan pantai. Kuliner: pengalaman makan dengan daya tarik suasana atau pemandangan. Buatan: buatan manusia seperti taman hiburan, resort, atau spot foto."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:kataKunci a owl:DatatypeProperty ;
    rdfs:label "Kata kunci"@id ;
    rdfs:comment "Berisi lebih dari satu kata atau frasa untuk pencarian."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:beradaDi a owl:DatatypeProperty ;
    rdfs:label "Berada di"@id ;
    rdfs:comment "Nama kabupaten atau kota."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:alamat a owl:DatatypeProperty ;
    rdfs:label "Alamat"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:lintang a owl:DatatypeProperty ;
    rdfs:label "Lintang"@id ;
    rdfs:comment "Koordinat lintang lokasi."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

ws:bujur a owl:DatatypeProperty ;
    rdfs:label "Bujur"@id ;
    rdfs:comment "Koordinat bujur lokasi."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

ws:petunjukLokasi a owl:DatatypeProperty ;
    rdfs:label "Petunjuk lokasi"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:jamOperasional a owl:DatatypeProperty ;
    rdfs:label "Jam operasional"@id ;
    rdfs:comment "Simpan sebagai teks, contoh Senin-Minggu 08.00-17.00 WIB."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:hargaMasuk a owl:DatatypeProperty ;
    rdfs:label "Harga masuk"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

ws:noHpResmi a owl:DatatypeProperty ;
    rdfs:label "Nomor HP resmi"@id ;
    rdfs:comment "Nomor kontak resmi yang dipublikasikan untuk umum."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:string .

ws:emailResmi a owl:DatatypeProperty ;
    rdfs:label "Email resmi"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:string .

ws:instagramResmi a owl:DatatypeProperty ;
    rdfs:label "Instagram resmi"@id ;
    rdfs:comment "URL profil Instagram resmi pengelola destinasi."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:anyURI .

ws:memilikiFasilitas a owl:DatatypeProperty ;
    rdfs:label "Memiliki fasilitas"@id ;
    rdfs:comment "Berisi lebih dari satu fasilitas, misalnya parkir, toilet, atau musala."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:dapatMelakukan a owl:DatatypeProperty ;
    rdfs:label "Dapat melakukan"@id ;
    rdfs:comment "Berisi lebih dari satu aktivitas, misalnya berenang, mendaki, atau berkemah."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:memilikiMedia a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "Memiliki media"@id ;
    rdfs:comment "Satu URL foto destinasi."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:anyURI .

ws:ratingPengunjung a owl:DatatypeProperty ;
    rdfs:label "Rating pengunjung"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

#################################################################
# DESTINASI WISATA
#################################################################

data:ws-001 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-001"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Bolon"@id ;
    ws:namaAlternatif "Turunan Bolon"@id, "Air Terjun Turbo"@id ;
    ws:deskripsiSingkat "Air Terjun Bolon atau dikenal dengan julukan Air Terjun Turbo adalah sebuah air terjun yang terletak di Desa Tomuan Holbung, Kabupaten Asahan, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Air Terjun Bolon atau dikenal dengan julukan Air Terjun Turbo adalah sebuah air terjun yang terletak di Desa Tomuan Holbung, Kabupaten Asahan, Sumatera Utara. Sumber air terjun ini berasal dari air yang keluar dari cela-cela di antara tebing yang terjepit batu dan memiliki debit air yang sangat besar dan deras. Air terjun ini memiliki ketinggian sekitar seratus meter. Air terjun ini dikelilingi oleh tebing-tebing di sekitar air terjun yang diselimuti oleh lumut dan pepohonan hijau yang subur, menambah keasrian dan kesejukan suasana. Di bawah air terjun terdapat kolam alami yang cukup dalam dengan air yang jernih. Untuk mencapai Air Terjun Turunan Bolon, pengunjung harus menempuh perjalanan trekking yang cukup menantang selama kurang lebih 2 jam dari desa terdekat. Jalur trekkingnya masih belum terlalu bagus dan cukup licin, sehingga membutuhkan kehati-hatian ekstra."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Bolon"@id, "Tomuan Holbung"@id ;
    ws:beradaDi "Kabupaten Asahan"@id ;
    ws:alamat "Tomuan Holbung, Kecamatan Bandar Pasir Mandoge, Kabupaten Asahan, Sumatera Utara 21174"@id ;
    ws:lintang "2.713679166994072"^^xsd:decimal ;
    ws:bujur "99.14826959818836"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Tomuan Holbung, Kabupaten Asahan, sekitar 200 km dari Kota Medan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Menikmati Pemandangan"@id,
        "Berenang"@id,
        "Trekking"@id ;
    ws:memilikiMedia "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhw7qynzepsGcPeFgHbWOHYRiJugMap1wZndvehKDIrSZL_NBM3cJkgcg6R0nntmKwEI9hokenJ56QRyRh1DIJcGaUTqCn4GSEICmD5EENTOu_y_hM01WzK6EJ8iiqUVfMqmXamxdQBZErL/s1600/air-terjun-turunan-bolon.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.4" .

data:ws-002 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-002"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Lae Mbilulu"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Lae Mbilulu (dikenal juga sebagai Si Mbilulu) adalah sebuah air terjun kembar di Prongil, Tinada, Kabupaten Pakpak Bharat, Provinsi Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Dikenal juga dengan nama Air Terjun Si Mbilulu, objek wisata andalan di Kabupaten Pakpak Bharat ini menyuguhkan keunikan dua aliran air terjun berdampingan yang bersumber dari satu aliran sungai yang sama. Air terjun setinggi kurang lebih 40 meter ini dikelilingi oleh lanskap hutan tropis yang masih asri serta formasi bebatuan alami. Di bagian bawahnya, terdapat kolam alami yang luas dengan air yang segar, di mana pengunjung kerap menikmati pemandangan atau berswafoto di berbagai sudut yang telah disediakan pengelola."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Sembilulu"@id, "Air Terjun Kembar"@id, "Prongil"@id, "Tinada"@id ;
    ws:beradaDi "Kabupaten Pakpak Bharat"@id ;
    ws:alamat "Buluh Tellang, Kec. Tinada, Kabupaten Pakpak Bharat, Sumatera Utara 22271"@id ;
    ws:lintang "2.6119486688740423"^^xsd:decimal ;
    ws:bujur "98.34891832517512"^^xsd:decimal ;
    ws:petunjukLokasi "Ditempuh melalui jalur darat ke arah Berastagi, Kabanjahe, Sidikalang (Dairi), lalu lanjut menuju kawasan Desa Prongil."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Toko Oleh-Oleh"@id, "Gazebo"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Menikmati Pemandangan"@id, "Berenang"@id ;
    ws:memilikiMedia "https://i.pinimg.com/1200x/6a/7c/f7/6a7cf77bd4e5a5b426a261c5bebed355.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-003 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-003"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Ponot"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air Terjun Ponot adalah sebuah air terjun yang terletak di antara Kabupaten Toba."@id ;
    ws:deskripsiLengkap "Air Terjun Ponot adalah sebuah air terjun yang terletak di antara Kabupaten Toba. Air Terjun Ponot memiliki tiga tingkatan dengan ketinggian ±250 meter. Air Terjun Ponot berada di aliran Sungai Ponot yang merupakan anak Sungai Asahan di ketinggian sekitar 500 meter di atas permukaan air laut. Keindahan Air terjun Ponot terletak pada debit airnya yang sangat deras. Di bawah curahan air terjun banyak terdapat batu-batuan alam yang berukuran sangat besar sehingga menjadi daya tarik tersendiri sebagai pelengkap keindahan Air terjun Ponot ."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Ponot, Sungai Ponot, Air Terjun Tiga Tingkat"@id ;
    ws:beradaDi "Kabupaten Asahan"@id ;
    ws:alamat "Jl. Sigura - Gura, Halado, Kecamatan Pintu Pohan Merant, Kabupaten Toba, Sumatera Utara 21274"@id ;
    ws:lintang "2.5552073244776548"^^xsd:decimal ;
    ws:bujur "99.3061324423661"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di aliran Sungai Ponot (anak Sungai Asahan), di perbatasan Kabupaten Asahan dan Kabupaten Toba, pada ketinggian sekitar 500 mdpl."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "20000" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Rumah Makan"@id, "Toilet"@id, "Musala"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Menikmati Pemandangan"@id, "Berenang"@id ;
    ws:memilikiMedia "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQE7wOvcID9TwfKkPbBKcm7aZX-82KpsdExisn2A3NJ8pgb_3zNS6EpyhE&s=10"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-004 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-004"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sampurharima"@id ;
    ws:namaAlternatif "Harimo"@id ;
    ws:deskripsiSingkat "Air Terjun Sampuran Harimau adalah air terjun setinggi sekitar 28 meter di aliran Sungai Asahan yang namanya diambil dari fenomena masa lalu ketika gemuruh debit airnya yang dahsyat terdengar menyerupai auman harimau."@id ;
    ws:deskripsiLengkap "Tersembunyi di tengah rimbunnya hutan tebing batu Desa Meranti Utara, destinasi ini menyimpan lanskap alam yang eksotis sekaligus saksi sejarah perubahan ekosistem lingkungan. Faktanya, debit air raksasa yang dahulu memicu suara auman bergemuruh kini telah menyusut drastis setelah hulu Sungai Asahan dibendung pada era 1980-an untuk dialirkan menuju turbin Pembangkit Listrik Tenaga Air (PLTA) Asahan. Meski volume airnya saat ini jauh lebih kecil dan jalurnya kerap tertutup semak belukar, sisa riam air yang jatuh di palung curahan yang luas ini tetap memancarkan pesona sunyi yang memikat bagi para pencinta petualangan sejarah alam liar Sumatera Utara."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Sampurharima"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Halado, Kecamatan Pintu Pohan Merant, Kabupaten Toba, Sumatera Utara 21274"@id ;
    ws:lintang "2.5508494433668725"^^xsd:decimal ;
    ws:bujur "99.30639646674273"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak di Desa Halado, Kecamatan Pintu Pohan Meranti, Kabupaten Toba, yang dapat ditempuh dari Kota Medan melalui jalur lintas menuju Pematang Siantar dan Porsea."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Menikmati Pemandangan"@id ;
    ws:memilikiMedia "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSE12qMoDoDqBknnfKaHFevvqxNXPQv2XSrFvXLVy2EKZMBi3JHXRB70AuF&s=10"^^xsd:anyURI ;
    ws:ratingPengunjung "-" .

data:ws-005 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-005"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Efrata"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air terjun Efrata adalah sebuah air terjun yang terletak di Kecamatan Harian, provinsi Sumatera Utara, di bagian barat negara Indonesia (186 km dari pusat Kota Medan)."@id ;
    ws:deskripsiLengkap "Dikenal juga dengan nama Sampuran Efrata, air terjun yang tidak bertingkat ini mengalirkan debit air yang deras menuruni tebing batu di antara dua perbukitan hijau yang asri. Berlokasi di Desa Sosor Dolok, Kecamatan Harian, Kabupaten Samosir, objek wisata ini berada tidak jauh dari jalur utama Danau Toba serta Menara Pandang Tele. Nama Efrata sendiri memiliki makna taman suci dan indah, mencerminkan pesona alam sekitarnya yang memadukan gemericik air jernih, udara pegunungan yang sejuk, dan akses yang relatif mudah bagi para pelancong."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Efrata"@id, "Harian"@id, "Samosir"@id, "Bukit Sibea-Bea"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Sosor Dolok, Kecamatan Harian, Kabupaten Samosir, Sumatera Utara 22396"@id ;
    ws:lintang "2.53883204525327"^^xsd:decimal ;
    ws:bujur "98.64517769818872"^^xsd:decimal ;
    ws:petunjukLokasi "Jarak tempuh dari Kota Medan sekitar 186 kilometer melalui jalur Berastagi, Kabanjahe, dan Merek."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "10000" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Rumah Makan"@id, "Gazebo"@id, "Toko Oleh-Oleh"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Menikmati Pemandangan"@id, "Berenang"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Air_Terjun_Efrata_tampak_dari_bawah_hingga_atas_06.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-006 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-006"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sampuren Putih"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air Terjun Sampuren Putih adalah sebuah air terjun yang terletak di Desa Cinta Rakyat, Kecamatan Percut Sei Tuan, Kabupaten Deli Serdang, Provinsi Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Air Terjun Sampuren Putih adalah sebuah air terjun yang terletak di Desa Cinta Rakyat, Kecamatan Percut Sei Tuan, Kabupaten Deli Serdang, Provinsi Sumatera Utara, Indonesia. Lokasinya berjarak sejauh 51,7 km dari Kota Medan. Ketinggian air terjun ini sekitar 3 meter. Rata-rata wisatawan yang berkunjung ke sini melakukan aktivitas trekking dan berkemah, selain mandi di air terjun. Suhu rata-rata disana adalah 23Â°C dan beriklim tropis. Bulan terpanas adalah pada Februari (24Â°C) serta bulan terdingin pada September (22Â°C). Curah hujan rata-rata di sana sekitar 3.483 milimeter per tahun. Bulan terbasah adalah Oktober dengan curah hujan 465 milimeter, sedangkan yang terkering adalah Juli dengan curah hujan 181 milimeter."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Sampuren Putih"@id, "Cinta Rakyat"@id, "Percut Sei Tuan"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Negri Gugung, Kecamatan Sibolangit, Kabupaten Deli Serdang, Sumatera Utara 20357"@id ;
    ws:lintang "3.267492579036195"^^xsd:decimal ;
    ws:bujur "98.60079685955638"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Cinta Rakyat, Kecamatan Percut Sei Tuan, Kabupaten Deli Serdang, sekitar 51,7 km dari Kota Medan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "5000" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Rumah Makan"@id ;
    ws:dapatMelakukan "Berkemah"@id,
        "Berenang"@id,
        "Trekking"@id, "Menikmati Pemandangan"@id ;
    ws:memilikiMedia "https://www.tempatwisata.pro/users_media/3131/42999c298d9ccd7c61830f2e8f818d86.png"^^xsd:anyURI ;
    ws:ratingPengunjung "4.3"^^xsd:decimal .

data:ws-007 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-007"^^xsd:string ;
    ws:namaDestinasi "Candi Bahal"@id ;
    ws:namaAlternatif "Biaro Bahal"@id,
        "Candi Portibi"@id ;
    ws:deskripsiSingkat "Kompleks candi Buddha Vajrayana peninggalan Kerajaan Pannai dari sekitar abad ke-11."@id ;
    ws:deskripsiLengkap "Berdiri megah sekitar 200 meter di barat daya Sungai Batang Pane, Candi Bahal atau sering disebut Biaro Portibi memikat mata dengan struktur bata merahnya yang kontras dengan lanskap alam sekitarnya. Candi utama ini memiliki keunikan arsitektur yang sangat langka pada bagian atapnya, yaitu berbentuk silinder bulat menyerupai kue di atas tatakan persegi setinggi 2,5 meter, lengkap dengan ukiran untaian bunga lambang kediaman tertinggi para dewa. Keaslian struktur kuno abad ke-11 ini dijaga ketat lewat aturan cagar budaya nasional, di mana para pengunjung diwajibkan melepas alas kaki saat menaiki tangga untuk melindungi bata-bata eksotisnya yang mulai menua dari pengikisan."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Bahal, Biaro Bahal"@id, "Biaro Bahal"@id, "Candi Portibi"@id, "Padang Lawas Utara"@id, "Kerajaan Pannai"@id ;
    ws:beradaDi "Kabupaten Padang Lawas Utara"@id ;
    ws:alamat "Bahal, Kecamatan Portibi, Kabupaten Padang Lawas Utara, Sumatera Utara 22741"@id ;
    ws:lintang "1.409416714071288"^^xsd:decimal ;
    ws:bujur "99.72662665570365"^^xsd:decimal ;
    ws:petunjukLokasi "Sekitar 3 jam perjalanan dari Kota Padang Sidempuan atau sekitar 400 km dari Kota Medan."@id ;
    ws:jamOperasional "Setiap Hari 08.00 - 03.00"@id ;
    ws:hargaMasuk "10000" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/candi_bahal"^^xsd:anyURI ;
