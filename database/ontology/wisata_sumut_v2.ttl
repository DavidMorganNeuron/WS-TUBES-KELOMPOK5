data:ws-089 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-089"^^xsd:string ;
    ws:namaDestinasi "Danau Tao"@id ;
    ws:namaAlternatif "Danau Tao Batang Onang"@id ;
    ws:deskripsiSingkat "Danau Tao di Batang Onang adalah padang sabana dan telaga luas nan eksotis yang sering dijuluki sebagai Ranu Kumbolo-nya Sumatera Utara."@id ;
    ws:deskripsiLengkap "Terletak di kawasan perbukitan Kecamatan Batang Onang, Danau Tao menawarkan pemandangan alam yang memesona berupa hamparan rumput hijau yang luas melingkari perairan danau yang tenang. Keistimewaan danau ini terletak pada ekosistemnya yang mirip sabana tropis, di mana kawanan sapi atau kerbau liar milik warga sering terlihat merumput bebas di sekitarnya. Tempat ini merupakan surga tersembunyi bagi para pencinta aktivitas berkemah, karena suasananya yang sangat tenang, udara yang bersih, serta minimnya polusi cahaya untuk menyaksikan langit malam bertabur bintang."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Tao"@id, "Batang Onang"@id, "Padang Lawas Utara"@id, "Sabana"@id, "Wisata Alam"@id ;
    ws:beradaDi "Kabupaten Padang Lawas Utara"@id ;
    ws:alamat "Desa Batang Onang Baru, Kecamatan Batang Onang, Kabupaten Padang Lawas Utara, Sumatera Utara 22762"@id ;
    ws:lintang "1.5209"^^xsd:decimal ;
    ws:bujur "99.5701"^^xsd:decimal ;
    ws:petunjukLokasi "Rute masuk terbaik adalah lewat Pasar Matanggor ke arah Batang Onang."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/_danautao?mdxt=amt4cDZ0NGMyMjkx"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Rumah Makan"@id ;
    ws:dapatMelakukan "Berkemah"@id, "Menikmati Pemandangan"@id, "Berfoto"@id, "Bersantai"@id ;
