data:ws-063 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-063"^^xsd:string ;
    ws:namaDestinasi "Situs Megalith Tetegewo Hilisao'ötö"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Situs Megalith Tetegewo Hilisaoʻötö adalah peninggalan purbakala di Nias Selatan berupa hamparan batu-batu megalitik kuno di atas bukit yang menjadi saksi bisu peradaban leluhur masyarakat Nias."@id ;
    ws:deskripsiLengkap "Terletak di Desa Hilisaoʻötö, Kecamatan Siduaʻori, Kabupaten Nias Selatan, Situs Megalit Tetegewo merupakan salah satu situs purbakala penting di Kepulauan Nias yang menyimpan ratusan artefak batu bernilai sejarah tinggi dengan perkiraan usia mencapai ratusan hingga ribuan tahun. Di puncak bukit ini, pengunjung dapat menemukan berbagai struktur batu khas tradisi megalitik, seperti menhir (behu) yang didirikan setiap kali selesai menggelar pesta adat (owasa), serta dolmen dan batu berbentuk meja bundar (gowe nilare) yang dahulu digunakan sebagai tempat menari para putri bangsawan. Berdasarkan catatan sejarah lokal dan penelitian, kawasan ini dulunya merupakan sebuah permukiman dan pusat aktivitas raja yang difungsikan sebagai tempat bermusyawarah, mengadili perkara, hingga menggelar ritual adat sebelum akhirnya ditinggalkan sekitar seabad lalu karena kesulitan air."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Megalit Nias"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Hilisao'oto, Kecamatan Sidua'ori, Kabupaten Nias Selatan, Sumatera Utara 22874"@id ;
    ws:lintang "0.8326973147123636"^^xsd:decimal ;
    ws:bujur "97.82880049819256"^^xsd:decimal ;
    ws:petunjukLokasi "Melalui Sibolga menuju wilayah Sidua'or"@id ;
    ws:jamOperasional "Setiap Hari 07.00 - 17.00"@id ;
    ws:hargaMasuk "0" ;
    ws:noHpResmi "082161887703" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas ""@id ;
    ws:dapatMelakukan "Berfoto"@id, "Belajar"@id,
        "Menelusuri"@id, "Menikmati Pemandangan"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Situs_Megalith_Tetegewo.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.6"^^xsd:decimal .

data:ws-064 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-064"^^xsd:string ;
    ws:namaDestinasi "Taman Nasional Batang Gadis"@id ;
    ws:namaAlternatif ""@id ;
    ws:deskripsiSingkat "Taman Nasional Batang Gadis (disingkat TNBG) adalah sebuah taman nasional yang terletak di Kabupaten Mandailing Natal, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Taman Nasional Batang Gadis memiliki luas sekitar 72.803,75 hektare dengan bentang alam bergunung-gunung yang mencapai puncaknya di Gunung Sorik Marapi (2.145 meter di atas permukaan laut). Kawasan ini merupakan surga biodiversitas yang menyimpan puluhan jenis mamalia—termasuk satwa langka dan dilindungi seperti Harimau Sumatra, Tapir Sumatra, dan Beruang Madu—serta ratusan spesies burung dan flora unik seperti Rafflesia. Selain nilai ekologisnya yang tinggi, taman nasional ini memiliki keunikan historis karena diinisiasi langsung dari usulan masyarakat dan pemerintah daerah setempat untuk melindungi fungsi hidrologi wilayah Mandailing Natal."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Konservasi"@id, "Bukit Barisan"@id ;
    ws:beradaDi "Kabupaten Mandailing Natal"@id ;
    ws:alamat "Jl. Willem Iskandar No.Kel, Pidoli Dolok, Kecamatan Panyabungan, Kabupaten Mandailing Natal, Sumatera Utara 22915"@id ;
    ws:lintang "0.716667"^^xsd:decimal ;
    ws:bujur "99.5"^^xsd:decimal ;
    ws:petunjukLokasi "Terbentang di Kabupaten Mandailing Natal, Sumatera Utara."@id ;
    ws:jamOperasional "Senin - Jumat 08.00 - 16.30"@id ;
    ws:hargaMasuk "0" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/dwp_btnbg"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Berkemah"@id,
        "Menikmati Pemandangan"@id,
        "Trekking"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Aliran_Sungai_Batang_Gadis_di_atara_bukit.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.3" .

data:ws-065 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-065"^^xsd:string ;
    ws:namaDestinasi "Vihara Gunung Timur"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Vihara Gunung Timur yang terletak di Jalan Hang Tuah, Medan Polonia, adalah salah satu kuil Taoisme dan Buddha terbesar serta tertua di Kota Medan yang beridiri megah sejak awal 1960-an"@id ;
    ws:deskripsiLengkap "Berdiri di atas lahan seluas kurang lebih 5.000 meter persegi di tepi Sungai Babura, Vihara Gunung Timur dikenal sebagai ikon arsitektur Tionghoa tradisional yang kaya akan warna merah dan emas, lengkap dengan ornamen naga, lentera gantung, serta altar pemujaan bagi berbagai dewa seperti Kwan Im dan Toa Pek Kong. Tempat ibadah Tri Dharma (Buddha, Tao, dan Konghucu) ini dibangun secara gotong royong oleh komunitas Tionghoa—khususnya dari kelompok Henghwa yang membawa akar tradisi dari Tiongkok—dan kini tidak hanya berfungsi sebagai pusat kegiatan ritual, tetapi juga menjadi magnet wisata religi yang sangat ramai dikunjungi saat perayaan besar seperti Tahun Baru Imlek, Cap Go Meh, hingga Hungry Ghost Festival (Chit Gwee Pua)."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Kelenteng"@id, "Taoisme"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Hang Tuah No.16, Madras Hulu, Kecamatan Medan Polonia, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.578273854821178"^^xsd:decimal ;
    ws:bujur "98.66896060983248"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. Hang Tuah No. 16, Madras Hulu, Kecamatan Medan Polonia, di sisi Sungai Deli."@id ;
    ws:jamOperasional "Setiap Hari 08.00 - 16.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/viharagunungtimurmedan/"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id ;
    ws:dapatMelakukan "Beribadah"@id,
        "Belajar"@id, "Menelusuri"@id, "Bersantai"@id ;
    ws:memilikiMedia "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRdZ_tvXjnFQ-1IMlksH_0a3SjEf2Ya3rYi6JRhn3guUQ&s=10"^^xsd:anyURI ;
    ws:ratingPengunjung "4.7"^^xsd:decimal .

data:ws-066 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-066"^^xsd:string ;
    ws:namaDestinasi "Museum Juang 45 Kisaran"@id ;
    ws:namaAlternatif "Gedung Juang 45 Kisaran"@id ;
    ws:deskripsiSingkat "Museum Juang 45 Kisaran adalah bangunan bersejarah di Kabupaten Asahan yang menyimpan koleksi persenjataan dan peralatan dari masa perjuangan kemerdekaan."@id ;
    ws:deskripsiLengkap "Diresmikan oleh Gubernur Sumatera Utara Edy Rahmayadi pada 18 Agustus 2023, Museum Juang 45 Kisaran menjadi pusat edukasi sejarah satu-satunya di wilayah Asahan dan Tanjungbalai. Museum yang berlokasi di Jalan Cokro Aminoto ini memamerkan berbagai peninggalan dari masa kesultanan, era kolonial Belanda, hingga masa kejayaan perkebunan karet Asahan. Beberapa koleksi menarik yang dapat disaksikan antara lain senjata tradisional peninggalan pejuang seperti pisau tumbuk lada dan keris, mangkuk getah karet keramik dari era PT HAPM (1888), hingga tiang tempat tidur peninggalan Tuan Syekh Silau Laut."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Juang 45"@id, "Gedung Juang 45"@id, "Sejarah Kemerdekaan"@id, "Kisaran"@id ;
    ws:beradaDi "Kabupaten Asahan"@id ;
    ws:alamat "Jalan Cokro Aminoto, Kisaran Kota, Kecamatan Kota Kisaran Barat, Kabupaten Asahan, Sumatera Utara 21211"@id ;
    ws:lintang "2.985153"^^xsd:decimal ;
    ws:bujur "99.627879"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di pusat Kota Kisaran, Kabupaten Asahan, Sumatera Utara."@id ;
    ws:jamOperasional "Senin-Jumat 08.00-16.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Area Istirahat"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Mengapresiasi"@id, "Berfoto"@id ;
    ws:memilikiMedia "https://awsimages.detik.net.id/community/media/visual/2023/02/13/museum-gedung-juang-45-asahan_169.jpeg?w=1200"^^xsd:anyURI ;
    ws:ratingPengunjung "4.2"^^xsd:decimal .

data:ws-067 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-067"^^xsd:string ;
    ws:namaDestinasi "Museum Niat Lima Laras"@id ;
    ws:namaAlternatif "Istana Niat Lima Laras"@id ;
    ws:deskripsiSingkat "Museum Niat Lima Laras adalah bangunan istana bersejarah peninggalan kebudayaan Melayu pesisir di Kabupaten Batu Bara yang usianya telah mencapai lebih dari satu abad."@id ;
    ws:deskripsiLengkap "Terletak di Desa Lima Laras, Kecamatan Nibung Hangus, istana megah berarsitektur perpaduan Melayu, Eropa, dan Tiongkok ini didirikan pada tahun 1907 oleh Datuk Muhammad Yuda (Raja Kerajaan Lima Laras XII) dan rampung pada tahun 1912. Pembangunan istana ini menghabiskan dana 150.000 gulden sebagai pemenuhan niat (nazar) sang datuk apabila kapalnya selamat berlabuh di pelabuhan Tanjung Tiram setelah kerap berhadapan dengan larangan dagang kolonial Belanda. Saat ini, museum tersebut menyimpan berbagai barang pusaka seperti tempayan berukir naga, pedang, dan peninggalan bersejarah lainnya yang dirawat oleh keturunan kerajaan."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Niat Lima Laras"@id, "Istana Niat Lima Laras"@id, "Melayu Pesisir"@id, "Batu Bara"@id ;
    ws:beradaDi "Kabupaten Batu Bara"@id ;
    ws:alamat "Jl. Istana, Desa Lima Laras, Kecamatan Nibung Hangus, Kabupaten Batu Bara, Sumatera Utara 21253"@id ;
    ws:lintang "3.20405"^^xsd:decimal ;
    ws:bujur "99.601275"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Dusun 1, Desa Lima Laras, Kecamatan Nibung Hangus, sekitar 136 km dari Kota Medan."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Mengapresiasi"@id, "Menelusuri"@id, "Berfoto"@id ;
    ws:memilikiMedia "https://upload.wikimedia.org/wikipedia/commons/3/36/Istana_Niat_Lima_Laras.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.3"^^xsd:decimal .

data:ws-068 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-068"^^xsd:string ;
    ws:namaDestinasi "Gereja HKBP I Sidikalang"@id ;
    ws:namaAlternatif "Gereja Huria Kristen Batak Protestan I Sidikalang"@id ;
    ws:deskripsiSingkat "Gereja HKBP I Sidikalang adalah rumah ibadah berdenah megah di pusat Kabupaten Dairi yang menjadi pusat kegiatan spiritual masyarakat penganut Kristen Protestan."@id ;
    ws:deskripsiLengkap "Sebagai salah satu gereja terbesar dan tertua di Sidikalang, bangunan Gereja HKBP (Huria Kristen Batak Protestan) I Sidikalang ini memiliki nilai historis dan arsitektur yang sangat khas. Berada tepat di persimpangan jalan utama kota, gereja ini tidak hanya berfungsi sebagai pusat peribadatan mingguan bagi ribuan jemaat, tetapi juga sebagai saksi perkembangan penyebaran agama Kristen di dataran tinggi Kabupaten Dairi. Dengan halamannya yang luas dan struktur bangunan yang kokoh, gereja ini memberikan ketenangan bagi siapa saja yang datang untuk beribadah maupun berdoa."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "HKBP I Sidikalang"@id, "Gereja HKBP"@id, "Lutheran"@id, "Sidikalang"@id, "Dairi"@id ;
    ws:beradaDi "Kabupaten Dairi"@id ;
    ws:alamat "Jl. Gereja No.1, Sidikalang, Kabupaten Dairi, Sumatera Utara 22218"@id ;
