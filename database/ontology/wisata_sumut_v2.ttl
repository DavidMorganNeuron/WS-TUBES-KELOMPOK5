data:ws-243 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-243"^^xsd:string ;
    ws:namaDestinasi "Merdeka Walk"@id ;
    ws:namaAlternatif "Merdeka Walk Medan"@id ;
    ws:deskripsiSingkat "Kawasan kuliner terbuka di depan Balai Kota Medan, Lapangan Merdeka, yang ramai pada sore hingga malam hari."@id ;
    ws:deskripsiLengkap "Merdeka Walk berada di Jalan Balai Kota, Kecamatan Medan Barat, Kota Medan, menempati sisi Lapangan Merdeka di depan balai kota. Kawasan ini berupa deretan kios dan restoran terbuka yang menyajikan pilihan makanan Indonesia, Tionghoa, dan Barat. Tidak ada tiket masuk; pengunjung hanya membayar makanan dan minuman yang dipesan. Pada sore hingga malam hari kawasan ini ramai karena berdekatan dengan bangunan bersejarah seperti Kantor Pos dan Tjong A Fie Mansion. Fasilitasnya mencakup area parkir, toilet, musala, dan panggung hiburan."@id ;
    ws:jenisDestinasi "Kuliner"@id ;
    ws:kataKunci "Merdeka Walk"@id, "Lapangan Merdeka"@id, "Medan Barat"@id, "Kuliner Malam"@id, "Food Court"@id ;
