data:ws-186 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-186"^^xsd:string ;
    ws:namaDestinasi "Hillpark Sibolangit"@id ;
    ws:namaAlternatif "Green Hill City"@id,
        "Hillpark Medan"@id ;
    ws:deskripsiSingkat "Hillpark Sibolangit adalah taman bermain di Sikeben, Kecamatan Sibolangit, Kabupaten Deli Serdang, yang terdiri atas tiga tema kawasan."@id ;
    ws:deskripsiLengkap "Hillpark Sibolangit adalah taman bermain di Jalan Letjen Jamin Ginting, Desa Sikeben, Kecamatan Sibolangit, Kabupaten Deli Serdang, di kawasan Green Hill City pada ketinggian sekitar 500 meter di atas permukaan laut. Taman ini dibagi menjadi tiga tema, yaitu The Lost City, Toon Town, dan The Heritage, dengan wahana seperti bianglala, komedi putar, bumper boat, boom-boom car, teater 4D, kora-kora, hingga flume ride. Udara pegunungan Sibolangit membuat taman permainan ini nyaman dikunjungi pada siang hari."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "Hillpark Sibolangit, Green Hill City, Deli Serdang, taman bermain, wahana"@id ;
