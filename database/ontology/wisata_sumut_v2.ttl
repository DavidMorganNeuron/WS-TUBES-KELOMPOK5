data:ws-088 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-088"^^xsd:string ;
    ws:namaDestinasi "Candi Bahal III"@id ;
    ws:namaAlternatif "Biaro Bahal III"@id ;
    ws:deskripsiSingkat "Candi Bahal III merupakan candi ketiga dari kompleks percandian Portibi yang menyimpan misteri susunan fondasi bata berukiran bunga teratai."@id ;
    ws:deskripsiLengkap "Candi Bahal III adalah candi dengan ukuran paling kecil di antara ketiga candi dalam gugusan Biaro Bahal, serta memiliki kondisi bangunan yang tidak seutuh dua candi lainnya. Meskipun demikian, sisa reruntuhan pada struktur kakinya menampilkan ukiran daun-daunan dan bunga teratai (padma) yang sangat mendetail, menandakan keahlian seni rupa yang tinggi dari masyarakat Kerajaan Pannai. Berada di lingkungan pelataran yang lapang dan ditumbuhi pepohonan, situs ini sering dimanfaatkan oleh pengunjung sebagai tempat bersantai sekaligus ruang studi observasi arkeologi."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Bahal III"@id, "Candi Bata Merah"@id, "Padang Lawas Utara"@id ;
    ws:beradaDi "Kabupaten Padang Lawas Utara"@id ;
    ws:alamat "Desa Bahal, Kecamatan Portibi, Kabupaten Padang Lawas Utara, Sumatera Utara 22751"@id ;
    ws:lintang "1.4132"^^xsd:decimal ;
    ws:bujur "99.7335"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak di sebelah timur dari Candi Bahal II."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
