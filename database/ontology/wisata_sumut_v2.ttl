    ws:lintang "3.591380"^^xsd:decimal ;
    ws:bujur "98.679130"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di sisi timur Lapangan Merdeka, tepat di seberang Balai Kota Medan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
