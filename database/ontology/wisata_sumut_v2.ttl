data:ws-234 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-234"^^xsd:string ;
    ws:namaDestinasi "Jungle River Sibolangit"@id ;
    ws:namaAlternatif "Jungle River Camp Sibolangit"@id ;
    ws:deskripsiSingkat "Jungle River Sibolangit adalah area kemah tepi sungai di Desa Bandar Baru, Kecamatan Sibolangit, Kabupaten Deli Serdang."@id ;
    ws:deskripsiLengkap "Jungle River Sibolangit berada di Dusun 5, Desa Bandar Baru, Kecamatan Sibolangit, Kabupaten Deli Serdang, dan dikelola sebagai lokasi berkemah di tepi sungai berair jernih. Pengunjung dapat mendirikan tenda sendiri, menyewa tenda, atau menginap di glamping, dengan kamar mandi yang cukup banyak serta pasokan air yang melimpah. Tiket masuk dikenakan per orang dengan tarif berbeda untuk dewasa dan anak-anak, sedangkan lapak di tepi sungai, listrik tambahan, dan parkir dikenakan biaya tersendiri. Pada akhir pekan lokasi sering penuh sehingga pemesanan lebih dulu disarankan, dan pengelola menyediakan makanan ringan serta mi instan di tempat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Jungle River"@id, "Sibolangit"@id, "Bandar Baru"@id, "Deli Serdang"@id, "Camping"@id, "Glamping"@id, "Sungai"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Dusun 5, Bandar Baru, Kec. Sibolangit, Kab. Deli Serdang, Sumatera Utara 20357"@id ;
    ws:lintang "3.273581"^^xsd:decimal ;
    ws:bujur "98.536098"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Dusun 5, Desa Bandar Baru, Kecamatan Sibolangit, Kabupaten Deli Serdang."@id ;
    ws:jamOperasional "Senin-Jumat 08.00-23.00, Sabtu-Minggu 00.00-23.00"@id ;
    ws:hargaMasuk "15000"^^xsd:decimal ;
    ws:noHpResmi "083876278555"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/jungleriver_sibolangit"^^xsd:anyURI ;
