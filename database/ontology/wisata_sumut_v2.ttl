data:ws-128 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-128"^^xsd:string ;
    ws:namaDestinasi "Tangga Seratus Sibolga"@id ;
    ws:namaAlternatif "Tangga 100 Sibolga"@id, "Bukit Tangga Seratus"@id ;
    ws:deskripsiSingkat "Tangga Seratus Sibolga merupakan anak tangga peninggalan kolonial yang mengarah ke puncak bukit untuk melihat pesona keindahan lanskap Kota Sibolga."@id ;
    ws:deskripsiLengkap "Menyandang nama Tangga Seratus, jumlah anak tangga untuk menuju puncaknya sebenarnya lebih dari 200 buah anak tangga bata tua yang merayapi tebing perbukitan kota. Jejak infrastruktur peninggalan masa penjajahan Belanda ini berfungsi sebagai akses observasi pantai barat di masa lampau. Setelah bersusah payah mendaki tangga yang cukup menguras tenaga di bawah teduhnya pepohonan besar, pengunjung akan tiba di kawasan puncak (Gua Jepang) dengan hadiah visual tak terlupakan berupa pemandangan utuh Kota Sibolga, gugusan pulau-pulau kecil, serta laut lepas Teluk Tapian Nauli."@id ;
    ws:jenisDestinasi "Alam"@id, "Budaya"@id ;
    ws:kataKunci "Tangga Seratus"@id, "Sibolga"@id, "Gua Jepang"@id, "Wisata Sejarah"@id, "Titik Pandang"@id ;
    ws:beradaDi "Kota Sibolga"@id ;
    ws:alamat "Pasar Baru, Kecamatan Sibolga Kota, Kota Sibolga, Sumatera Utara 22522"@id ;
    ws:lintang "1.740241"^^xsd:decimal ;
    ws:bujur "98.779990"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak persis di pusat kota Sibolga, dekat pelabuhan lama."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "@disparporasibolga"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Rumah Makan"@id ;
