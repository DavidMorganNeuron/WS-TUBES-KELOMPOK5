    ws:ratingPengunjung "4.2"^^xsd:decimal .

data:ws-080 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-080"^^xsd:string ;
    ws:namaDestinasi "Museum Pusaka Karo"@id ;
    ws:namaAlternatif "Museum Pusaka Batak Karo"@id ;
    ws:deskripsiSingkat "Museum Pusaka Karo di Berastagi adalah pusat pelestarian sejarah yang mengoleksi lebih dari ribuan benda antik budaya Karo, termasuk Pustaha Laklak kuno."@id ;
    ws:deskripsiLengkap "Dibangun di bekas gedung Gereja Katolik Santa Maria, museum ini digagas oleh Pastor Leonardus Egidius Joosten dan dikelola oleh Yayasan Pusaka Karo semenjak diresmikan pada 2013. Koleksinya yang berjumlah lebih dari 1.500 artefak, yang sebagian besar disumbangkan atau dititipkan langsung oleh masyarakat Karo, menceritakan kepingan sejarah peradaban sejak abad ke-18. Benda andalan museum ini adalah buku naskah kuno berbahan kulit kayu (Pustaha Laklak) yang bertuliskan mantra dengan tinta getah kayu, serta topeng ukiran tradisional yang eksotis."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Pusaka Karo"@id, "Berastagi"@id, "Benda Pusaka Karo"@id, "Museum"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jl. Perwira No.1, Gundaling I, Kecamatan Berastagi, Kabupaten Karo, Sumatera Utara 22152"@id ;
    ws:lintang "3.19492"^^xsd:decimal ;
    ws:bujur "98.50822"^^xsd:decimal ;
    ws:petunjukLokasi "Berlokasi tepat di kawasan strategis Gundaling I, pusat rekreasi Berastagi."@id ;
    ws:jamOperasional "Selasa-Jumat 10.00-17.00, Minggu 14.30-17.30"@id ;
    ws:hargaMasuk "8000"^^xsd:decimal ;
    ws:noHpResmi "0628-922-18"^^xsd:string ;
    ws:emailResmi "leo_joosten@yahoo.co.id"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/museumpusaka_karo?cplk=YXp5cTAyMmwwbmox"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Pemandu Wisata"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Mengapresiasi"@id, "Berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Museum_Pusaka_Karo_%28Berastagi%29.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-081 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-081"^^xsd:string ;
    ws:namaDestinasi "Masjid Azizi"@id ;
    ws:namaAlternatif "Masjid Kesultanan Langkat"@id, "Masjid Sultan Abdul Aziz"@id ;
    ws:deskripsiSingkat "Masjid Azizi peninggalan Kesultanan Langkat adalah bangunan peribadatan megah di Tanjung Pura yang arsitekturnya menginspirasi pembangunan Masjid Zahir di Malaysia."@id ;
    ws:deskripsiLengkap "Berdiri di atas tanah kebanggaan Kesultanan Langkat sejak dibangun pertama kali pada tahun 1889 oleh Sultan Abdul Aziz, masjid ini memancarkan kemewahan seni bangunan yang didominasi paduan budaya Melayu, India, dan Timur Tengah. Fasad masjid dihiasi oleh menara yang indah serta kubah bergaya klasik berwarna kontras yang menjadi landmark kebanggaan kota Tanjung Pura. Di kawasan halaman masjid ini juga terdapat makam-makam raja Kesultanan Langkat beserta pahlawan nasional Tengku Amir Hamzah, menjadikannya tujuan ziarah sekaligus ruang rekreasi spiritual."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Masjid Azizi"@id, "Kesultanan Langkat"@id, "Tanjung Pura"@id, "Masjid Bersejarah"@id, "Masjid Melayu"@id ;
    ws:beradaDi "Kabupaten Langkat"@id ;
    ws:alamat "Jl. Masjid, Kelurahan Tanjung Pura, Kecamatan Tanjung Pura, Kabupaten Langkat, Sumatera Utara 20853"@id ;
    ws:lintang "3.89145"^^xsd:decimal ;
    ws:bujur "98.42392"^^xsd:decimal ;
    ws:petunjukLokasi "Tepat di jantung kota Tanjung Pura, sekitar 60 km di arah barat laut dari Kota Medan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
