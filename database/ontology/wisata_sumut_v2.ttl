data:ws-074 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-074"^^xsd:string ;
    ws:namaDestinasi "Museum Deli Serdang"@id ;
    ws:namaAlternatif "Museum Kabupaten Deli Serdang"@id ;
    ws:deskripsiSingkat "Museum Deli Serdang adalah museum sejarah yang berdesain arsitektur 'Itik Pulang Petang' di pusat perkantoran Lubuk Pakam."@id ;
    ws:deskripsiLengkap "Diresmikan pada 8 September 2018, Museum Deli Serdang yang berlokasi di kompleks pemerintahan ini dirancang dengan bentuk atap 'Itik Pulang Petang' yang melambangkan keharmonisan budaya Melayu. Bangunan tiga lantai ini menyimpan perjalanan panjang Kabupaten Deli Serdang, mulai dari benda peninggalan prasejarah, diorama perang masa revolusi, hingga peninggalan kebesaran Kesultanan Deli dan Kesultanan Serdang. Pada lantai dua dan tiga, pengunjung dapat melihat berbagai artefak bersejarah seperti pakaian adat, alat musik tradisional, prasasti kuno, serta memorabilia era pascakemerdekaan."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Deli Serdang"@id, "Museum Daerah"@id, "Lubuk Pakam"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Kawasan Perkantoran Pemkab Deli Serdang, Petapahan, Lubuk Pakam, Deli Serdang, Sumatera Utara 20511"@id ;
    ws:lintang "3.55184"^^xsd:decimal ;
    ws:bujur "98.866539"^^xsd:decimal ;
    ws:petunjukLokasi "Berada persis di depan kantor Bupati Deli Serdang di Tanjung Garbus I."@id ;
    ws:jamOperasional "Senin-Jumat 09.00-15.00"@id ;
