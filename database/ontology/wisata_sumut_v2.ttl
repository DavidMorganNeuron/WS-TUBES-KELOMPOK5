    ws:alamat "Kec. Sibolangit, Kab. Deli Serdang, Sumatera Utara"@id ;
    ws:lintang "3.259400"^^xsd:decimal ;
    ws:bujur "98.536200"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, ikuti Jalan Letjen Jamin Ginting ke arah Berastagi; goa berada di sisi jalan sebelum pusat Sibolangit."@id ;
