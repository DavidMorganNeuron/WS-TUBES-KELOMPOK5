    ws:idDestinasi "ws-224"^^xsd:string ;
    ws:namaDestinasi "Bukit Kubu Berastagi"@id ;
    ws:namaAlternatif "Bukit Kubu"@id ;
    ws:deskripsiSingkat "Kawasan perbukitan di Berastagi, Kabupaten Karo, yang menawarkan panorama Kota Berastagi dan Gunung Sinabung."@id ;
    ws:deskripsiLengkap "Bukit Kubu berada di Kecamatan Berastagi, Kabupaten Karo, pada lereng yang menghadap ke arah kota dan Gunung Sinabung. Kawasan ini memiliki taman, gazebo, area api unggun, dan penginapan bergaya kabin, sehingga sering dipakai untuk camping maupun acara keluarga. Tiket masuk dua puluh ribu rupiah per orang, sedangkan sewa gazebo dan penginapan dihitung terpisah. Bukit Kubu buka setiap hari dari pagi hingga sore. Udara di sini sejuk dan pada malam hari suhu turun cukup tajam sehingga pengunjung perlu membawa jaket."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Bukit Kubu Berastagi"@id, "Berastagi"@id, "Karo"@id, "Perbukitan"@id, "Camping"@id, "Gunung Sinabung"@id ;
