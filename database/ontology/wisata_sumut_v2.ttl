    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-014 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-014"^^xsd:string ;
    ws:namaDestinasi "Danau Lautdendang"@id ;
    ws:namaAlternatif "Laut Dandang"@id ;
    ws:deskripsiSingkat "Danau Laut Dendang merupakan sebuah kawasan rawa alami berbentuk danau seluas kurang lebih 5 hektar di Serdang Bedagai yang memiliki bentuk menyerupai perkakas dandang serta diselimuti cerita rakyat tentang penunggu buaya putih."@id ;
    ws:deskripsiLengkap "Danau Laut Dendang (atau yang sering disebut Lauttendang) adalah genangan air rawa alami dengan luas sekitar 5 hektar yang terletak di wilayah Kabupaten Serdang Bedagai. Dinamakan Laut Dendang oleh warga lokal karena bentuk genangan airnya yang menyerupai sebuah dandang (periuk besar dari tembaga atau aluminium). Kawasan ini dikenal asri dengan ditumbuhi pepohonan seperti kayu pule serta bunga teratai yang subur, menjadikannya tempat favorit warga untuk bersantai maupun memancing. Di balik keindahan alamnya yang tenang, danau ini sarat akan cerita legenda dan mitos lokal mengenai sosok buaya putih yang diyakini bersembunyi di bawah pepohonan sekitar, sehingga sempat direncanakan oleh pemerintah setempat untuk dikembangkan kembali menjadi destinasi wisata alam bernuansa unik."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Lautdendang"@id, "Laut Dandang"@id ;
    ws:beradaDi "Kabupaten Serdang Bedagai"@id ;
    ws:alamat "Cempedak Lobang, Kecamatan Sei Rampah, Kabupaten Serdang Bedagai, Sumatera Utara"@id ;
    ws:lintang "3.481710650045117"^^xsd:decimal ;
    ws:bujur "99.07290878839687"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak sekitar 64,7 kilometer melalui rute Jl. Tol Medan - Kuala Namu - Tebing Tinggi dan Jalan Lintas Sumatera."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Menikmati Pemandangan"@id ;
    ws:memilikiMedia "https://www.jabarnews.com/wp-content/uploads/2022/08/danau-di-sergai.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "3.3"^^xsd:decimal .

