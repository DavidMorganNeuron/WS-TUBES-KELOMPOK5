data:ws-244 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-244"^^xsd:string ;
    ws:namaDestinasi "Paropo Silalahi Bang Gogo"@id ;
    ws:namaAlternatif "Camping Basecamp Gogo"@id, "Basecamp Gogo"@id ;
    ws:deskripsiSingkat "Paropo Silalahi Bang Gogo adalah area kemah tepi Danau Toba di Desa Silalahi III, Kecamatan Silahisabungan, Kabupaten Dairi."@id ;
    ws:deskripsiLengkap "Paropo Silalahi Bang Gogo, yang juga dikenal sebagai Camping Basecamp Gogo, berada di Jalan Tugu Silahisabungan, Desa Silalahi III, Kecamatan Silahisabungan, Kabupaten Dairi, di kawasan perbukitan yang menghadap Danau Toba. Tempat ini dikelola sebagai lokasi berkemah dengan layanan sewa tenda, kursi, dan peralatan memasak, sehingga pengunjung dapat menginap tanpa membawa perlengkapan sendiri. Dari area kemah, pengunjung dapat menikmati pemandangan danau, berenang di tepi danau, dan berfoto, termasuk menggunakan jasa fotografer di lokasi. Area parkir berada di bagian atas sehingga pengunjung perlu menuruni anak tangga menuju area kemah, sedangkan udara pada malam hari cukup dingin."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Paropo"@id, "Silalahi"@id, "Bang Gogo"@id, "Basecamp Gogo"@id, "Camping"@id, "Silahisabungan"@id, "Dairi"@id, "Danau Toba"@id ;
    ws:beradaDi "Kabupaten Dairi"@id ;
    ws:alamat "Camping Basecamp Gogo, Jl. Tugu Silahisabungan, Pulo, Silalahi III, Kec. Silahisabungan, Kab. Dairi, Sumatera Utara 22281"@id ;
    ws:lintang "2.833082"^^xsd:decimal ;
    ws:bujur "98.525635"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan menuju Berastagi, Kabanjahe, Merek, dan Tongging, lalu lanjut ke Desa Silalahi III melalui Jalan Tugu Silahisabungan; perjalanan sekitar 4 jam."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "20000" ;
    ws:noHpResmi "083121217130"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
