    ws:namaAlternatif ""@id ;
    ws:deskripsiSingkat "Danau Linting adalah danau vulkanik yang terletak di Sinembah Tanjung Muda Hulu, Deli Serdang, Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Terletak di Kecamatan Sinembah Tanjung Muda (STM) Hulu, Danau Linting merupakan danau hidrotermal seluas kurang lebih 1 hektar yang memiliki suhu air hangat (sekitar 30°C) akibat aktivitas vulkanik di bawahnya. Salah satu daya tarik utamanya adalah warna airnya yang dapat berubah-ubah secara alami dalam gradasi biru, hijau toska, hingga hijau kebiruan akibat kandungan mineral dan sulfur. Meskipun menyimpan pesona yang sangat indah dan dikelilingi pepohonan tropis yang rindang, danau ini juga diselimuti fakta misterius karena kedalamannya hingga kini belum pernah berhasil diukur secara pasti oleh para ahli maupun pemerintah setempat. Oleh karena itu, wisatawan hanya diizinkan bermain air atau bersantai di tepiannya demi keamanan."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Linting"@id, "Danau Vulkanik"@id, "Sinembah Tanjung Muda Hulu"@id, "Danau Belerang"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Jl. Simpang Gn. Manumpak A, Sibunga Bunga Hilir, Kecamatan Sinembah Tj. Muda Hulu, Kabupaten Deli Serdang, Sumatera Utara 20582"@id ;
    ws:lintang "3.2298447298332538"^^xsd:decimal ;
    ws:bujur "98.72567924449064"^^xsd:decimal ;
    ws:petunjukLokasi "Perjalanan dari Kota Medan menuju Danau Linting menempuh jarak sekitar 50 kilometer ke arah selatan melewati rute Jalan Sisingamangaraja, Jalan Pertahanan, dan Jalan Talun Kenas - Patumbak."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "10000" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi ""^^xsd:anyURI ;
