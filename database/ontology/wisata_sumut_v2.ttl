    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-206 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-206"^^xsd:string ;
    ws:namaDestinasi "Pulau Sibandang"@id ;
    ws:namaAlternatif "Kawasan Pulo Sibandang"@id ;
    ws:deskripsiSingkat "Pulau di Danau Toba yang menjadi bagian Geopark Kaldera Toba, terletak di Kecamatan Muara, Kabupaten Tapanuli Utara."@id ;
    ws:deskripsiLengkap "Pulau Sibandang terletak di Kecamatan Muara, Kabupaten Tapanuli Utara, dan termasuk salah satu geosite Geopark Kaldera Toba yang diakui UNESCO. Pulau ini terbentuk dari endapan letusan supervulkan Toba dan dihuni masyarakat yang mengelola kebun jeruk serta sawah. Pengunjung datang untuk trekking ringan ke titik pandang, menyusuri desa, membeli jeruk dan hasil bumi, atau menonton matahari terbenam di tepi danau. Kawasan ini memiliki area parkir, kios suvenir, dan spot foto; tiket masuk kawasan berkisar sepuluh ribu hingga seratus dua puluh ribu rupiah tergantung layanan yang diambil."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Pulau Sibandang"@id, "Pulo Sibandang"@id, "Muara"@id, "Tapanuli Utara"@id, "Geopark Kaldera Toba"@id, "Kebun Jeruk"@id ;
    ws:beradaDi "Kabupaten Tapanuli Utara"@id ;
    ws:alamat "Jl. Lingkar Pulo Sibandang, Desa Sibandang Dusun I, Kec. Muara, Kab. Tapanuli Utara, Sumatera Utara"@id ;
    ws:lintang "2.3624000"^^xsd:decimal ;
    ws:bujur "98.8967000"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Muara, menyeberang dengan kapal feri atau perahu sekitar 15 menit menuju Pulau Sibandang."@id ;
    ws:jamOperasional "Setiap hari 07.00-21.00"@id ;
    ws:hargaMasuk "20000"^^xsd:decimal ;
    ws:noHpResmi "+62 813-7682-1631"^^xsd:string ;
    ws:emailResmi "pokdarwismapulosibandang@gmail.com"^^xsd:string ;
