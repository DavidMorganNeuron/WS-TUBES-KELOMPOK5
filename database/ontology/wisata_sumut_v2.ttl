data:ws-111 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-111"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Situmurun"@id ;
    ws:namaAlternatif "Air Terjun Binangalom"@id, "Situmurun Waterfall"@id ;
    ws:deskripsiSingkat "Air Terjun Situmurun adalah air terjun spektakuler bersusun tujuh tingkat yang mengalirkan air tawarnya langsung jatuh ke perairan Danau Toba."@id ;
    ws:deskripsiLengkap "Berada tersembunyi di wilayah administratif Kecamatan Lumban Julu, Air Terjun Situmurun (atau Binangalom) menawarkan fenomena alam unik yang sangat memanjakan mata, yaitu jeram setinggi puluhan meter yang langsung memuntahkan air ke kaldera raksasa Toba. Tidak ada akses jalan darat untuk mencapai ke bawah jatuhnya air terjun ini, sehingga wisatawan harus menyewa kapal motor kayu atau speedboat dari pelabuhan Balige maupun Parapat. Pengunjung kapal sering melompat ke tepian danau di bawah air terjun untuk berenang di airnya yang sangat sejuk, sembari memancing atau memanggang ikan dari atas kapal."@id ;
    ws:jenisDestinasi "Alam"@id, "Bahari"@id ;
    ws:kataKunci "Air Terjun Situmurun"@id, "Binangalom"@id, "Lumban Julu"@id, "Toba"@id, "Air Terjun Danau Toba"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Desa Situmurun, Kecamatan Lumban Julu, Kabupaten Toba, Sumatera Utara 22386"@id ;
    ws:lintang "2.5357"^^xsd:decimal ;
    ws:bujur "99.0091"^^xsd:decimal ;
    ws:petunjukLokasi "Hanya dapat diakses melalui jalur air (perahu/speedboat) dari Pelabuhan Ajibata atau Balige."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
