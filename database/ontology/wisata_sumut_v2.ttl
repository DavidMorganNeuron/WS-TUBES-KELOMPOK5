data:ws-126 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-126"^^xsd:string ;
    ws:namaDestinasi "Istana Raja Sisingamangaraja"@id ;
    ws:namaAlternatif "Situs Istana Raja Bakkara"@id, "Istana Sisingamangaraja XII"@id ;
    ws:deskripsiSingkat "Istana Raja Sisingamangaraja adalah situs kompleks peninggalan pusat pemerintahan pahlawan nasional dari tanah Batak di Lembah Bakkara."@id ;
    ws:deskripsiLengkap "Terletak di Desa Simamora, kompleks bersejarah seluas satu hektare ini merupakan rumah sekaligus pusat administrasi pahlawan nasional Raja Sisingamangaraja ke-I hingga ke-XII sebelum dihancurkan oleh pasukan kolonial Belanda. Walaupun bangunan yang berdiri saat ini adalah hasil pemugaran (replika) dari rumah Ruma Bolon aslinya, situs ini tetap memancarkan keagungan sejarah. Di dalamnya tersimpan sisa-sisa peninggalan dan makam dari Raja Sisingamangaraja XI, dikelilingi pagar batu kokoh dengan pepohonan besar yang memberikan suasana sakral nan tenang bagi setiap peziarah."@id ;
    ws:jenisDestinasi "Budaya"@id, "Religi"@id ;
    ws:kataKunci "Istana Raja Sisingamangaraja"@id, "Bakkara"@id, "Humbang Hasundutan"@id, "Pahlawan Nasional"@id, "Sejarah Batak"@id ;
    ws:beradaDi "Kabupaten Humbang Hasundutan"@id ;
    ws:alamat "Desa Simamora, Kecamatan Baktiraja, Kabupaten Humbang Hasundutan, Sumatera Utara 22457"@id ;
    ws:lintang "2.305839"^^xsd:decimal ;
    ws:bujur "98.812620"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di dataran rendah Lembah Bakkara, tidak jauh dari tepi Sungai Aek Silang."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
