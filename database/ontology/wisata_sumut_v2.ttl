    ws:lintang "3.243950"^^xsd:decimal ;
    ws:bujur "98.535790"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Berastagi, berkendara sekitar 15 menit ke arah Sibolangit lalu ikuti plang Air Terjun Sikulikap."@id ;
