data:ws-079 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-079"^^xsd:string ;
    ws:namaDestinasi "Museum Karo Lingga"@id ;
    ws:namaAlternatif "Museum Adat Lingga"@id ;
    ws:deskripsiSingkat "Museum Karo Lingga adalah balai penyimpanan benda-benda pusaka dan kebudayaan etnis Karo yang berbentuk menyerupai rumah adat (Tersek) di Desa Budaya Lingga."@id ;
    ws:deskripsiLengkap "Diinisiasi pada tahun 1977 oleh Pangkowilham Kodam II Bukit Barisan, G.H. Mantik, museum ini secara resmi dibuka pada tahun 1989 atas dorongan tetua adat setempat. Menempati replika rumah adat tradisional Karo berbahan modern, museum ini berupaya menyelamatkan artefak budaya yang hampir punah dari rumah-rumah warga. Koleksi museum meliputi berbagai benda seni kerajinan tangan, alat pertanian kuno, perhiasan, serta perabotan khas masyarakat Karo masa lampau yang menjadi pusat edukasi kearifan lokal."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Karo Lingga"@id, "Desa Lingga"@id, "Karo"@id, "Museum Budaya"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jl. Kotacane No.180, Kabanjahe, Kecamatan Simpang Empat, Kabupaten Karo, Sumatera Utara"@id ;
    ws:lintang "3.118111"^^xsd:decimal ;
    ws:bujur "98.475278"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak sekitar 5 km arah barat dari pusat Kabanjahe."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "062-821-848"^^xsd:string ;
    ws:emailResmi "karolingga@yahoo.co.id"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Mengapresiasi"@id, "Berfoto"@id ;
