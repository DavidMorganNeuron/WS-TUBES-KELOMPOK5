data:ws-076 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-076"^^xsd:string ;
    ws:namaDestinasi "Vihara Sakyamuni Buddha ITBC"@id ;
    ws:namaAlternatif "Indonesia Theravada Buddhist Centre"@id ;
    ws:deskripsiSingkat "Vihara Sakyamuni Buddha ITBC merupakan candi dan vihara megah berarsitektur khas Thailand di kawasan Medan Estate."@id ;
    ws:deskripsiLengkap "Dikenal juga sebagai kompleks Indonesia Theravada Buddhist Centre (ITBC), vihara ini menghadirkan replika candi bergaya Chedi yang identik dengan arsitektur klasik di Thailand. Tempat ini difungsikan sebagai pusat meditasi, pendalaman kitab suci Tipitaka, dan pengembangan spiritual umat Buddha aliran Theravada. Suasananya yang hening, asri, dan tertata dengan sangat rapi menjadikannya lokasi favorit untuk mencari ketenangan batin, sementara struktur bangunannya yang unik sering kali menjadi objek fotografi yang estetis."@id ;
