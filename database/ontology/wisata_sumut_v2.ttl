data:ws-197 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-197"^^xsd:string ;
    ws:namaDestinasi "Pantai Pandan"@id ;
    ws:namaAlternatif "PIP"@id,
        "Pantai Bosur"@id,
        "Pantai Indah Pandan"@id ;
    ws:deskripsiSingkat "Pantai berpasir putih di pesisir barat Sumatera, Kecamatan Pandan, Kabupaten Tapanuli Tengah, yang ramai dikunjungi warga Sibolga dan sekitarnya."@id ;
    ws:deskripsiLengkap "Pantai Pandan membentang di sepanjang Jalan Sibolga-Padang Sidempuan, Kecamatan Pandan, Kabupaten Tapanuli Tengah. Sebelumnya kawasan ini dikenal sebagai Pantai Bosur dan sejak 2019 dikelola sebagai Pantai Indah Pandan. Pasirnya putih dengan ombak yang relatif bersahabat, dilengkapi gazebo, warung kuliner laut, toilet, dan lahan parkir. Pengunjung dapat berenang di area yang dijaga, menyewa ban, atau menikmati ikan bakar di warung tepi pantai. Pada akhir pekan dan hari libur, kawasan ini menjadi salah satu tujuan utama warga Tapanuli Tengah."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Pandan, Pantai Indah Pandan, Pantai Bosur, Pandan, Tapanuli Tengah, pantai barat"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Jl. Sibolga-Padang Sidempuan, Kec. Pandan, Kab. Tapanuli Tengah, Sumatera Utara 22615"@id ;
    ws:lintang "1.668300"^^xsd:decimal ;
    ws:bujur "98.806100"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di jalan lintas Sibolga-Padang Sidempuan; dari pusat Kota Sibolga sekitar 6 km ke arah selatan."@id ;
