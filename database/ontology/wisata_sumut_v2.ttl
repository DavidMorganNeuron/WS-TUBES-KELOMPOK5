    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-087 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-087"^^xsd:string ;
    ws:namaDestinasi "Candi Bahal II"@id ;
    ws:namaAlternatif "Biaro Bahal II"@id ;
    ws:deskripsiSingkat "Candi Bahal II adalah struktur candi bata kuno di kompleks Biaro Bahal yang memiliki bentuk atap tumpul yang lebih rendah dari Bahal I."@id ;
    ws:deskripsiLengkap "Hanya berjarak beberapa ratus meter dari Bahal I, Candi Bahal II menyajikan arsitektur yang sedikit berbeda, khususnya pada bentuk kemuncak atau atap stupanya yang lebih membulat (tumpul). Sama halnya dengan Candi Bahal I, bangunan ini dikelilingi pagar langkan bata merah yang tebal serta menyimpan corak kebudayaan Buddha aliran Tantrayana (Vajrayana). Lokasinya yang dikelilingi oleh padang rumput ilalang memberikan nuansa kedamaian dan sangat cocok bagi wisatawan yang ingin menelusuri keheningan sisa-sisa peradaban masa lalu."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Bahal II"@id, "Biaro Bahal"@id, "Sejarah Buddha"@id, "Padang Lawas Utara"@id ;
    ws:beradaDi "Kabupaten Padang Lawas Utara"@id ;
    ws:alamat "Desa Bahal, Kecamatan Portibi, Kabupaten Padang Lawas Utara, Sumatera Utara 22751"@id ;
