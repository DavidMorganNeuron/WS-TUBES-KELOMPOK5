data:ws-181 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-181"^^xsd:string ;
    ws:namaDestinasi "Pantai Perupuk"@id ;
    ws:namaAlternatif "Pantai Sejarah Perupuk"@id ;
    ws:deskripsiSingkat "Pantai Perupuk adalah pantai di Desa Perupuk, Kecamatan Lima Puluh Pesisir, Kabupaten Batu Bara, yang dikenal sebagai lokasi pendaratan tentara Jepang pada 1942."@id ;
    ws:deskripsiLengkap "Pantai Perupuk berada di Desa Perupuk, Kecamatan Lima Puluh Pesisir, Kabupaten Batu Bara, menghadap Selat Malaka. Pantai ini disebut juga Pantai Sejarah karena menjadi salah satu lokasi pendaratan pertama tentara Jepang di Sumatera Utara pada 1942. Selain nilai sejarahnya, kawasan pantai memiliki hutan mangrove, hamparan pasir, dan deretan warung ikan bakar yang ramai pada akhir pekan."@id ;
