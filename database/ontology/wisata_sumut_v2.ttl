data:ws-160 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-160"^^xsd:string ;
    ws:namaDestinasi "Masjid Lama Gang Bengkok"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Masjid Lama Gang Bengkok Medan merupakan sebuah masjid yang terletak di Kota Medan, Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Masjid Lama Gang Bengkok Medan merupakan sebuah masjid yang terletak di Kota Medan, Sumatera Utara, Indonesia. Masjid Lama Gang Bengkok ini tepatnya berada di Jalan Mesjid No. 62, Kelurahan Kesawan, Kecamatan Medan Barat, Kota Medan. Masjid Lama Gang Bengkok dibangun oleh saudagar asal Tiongkok, Tjong A Fie. Masjid ini pertama kali dibangun antara tahun 1874 hingga 1885 Masehi, tetapi renovasi pembangunannya selesai pada tahun 1889 M. Masjid ini kemudian diserahkan Tjong A Fie kepada Kesultanan Deli, yakni pada masa pemerintahan Sultan Deli Ma'moen Al Rasyid. Bangunan masjid tersebut berdiri diatas tanah wakaf dari Haji Muhammad Ali, atau lebih dikenal dengan nama Datuk Kesawan. Tjong A Fie sendiri menanggung seluruh pembangunan masjid tersebut. Sebelumnya masjid Al Osmani merupakan masjid tertua yang berada di Kota Medan didirikan pada tahun 1854. Kemudian 20 tahun setelahnya, dibangunlah masjid Gang Bengkok yang juga memiliki sebuah sejarah antara orang Melayu dengan orang Tionghoa. Di belakang masjid, berdiri gedung Maktab Islamiyah Tapanuli (MIT) yang merupakan tempat kelahiran Al Washliyah, organisasi Islam yang berdiri pada 1930. Gedung tersebut kini menjadi Museum Al Washliyah."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Masjid Lama Gang Bengkok, Tjong A Fie, Kesawan, masjid bersejarah, Medan"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Mesjid No.62, Kesawan, Kec. Medan Barat, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.586647"^^xsd:decimal ;
    ws:bujur "98.677992"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Mesjid No. 62, Kelurahan Kesawan, Kecamatan Medan Barat, Kota Medan."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "Gratis" ;
