data:ws-107 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-107"^^xsd:string ;
    ws:namaDestinasi "Museum Fansuri"@id ;
    ws:namaAlternatif "Museum Fansuri Situs Bongal"@id ;
    ws:deskripsiSingkat "Museum yang menyajikan koleksi dari situs arkeologi Bongal."@id ;
    ws:deskripsiLengkap "Museum Fansuri Situs Bongal merupakan museum yang terletak di desa Jago-Jago, Kecamatan Badiri, Kabupaten Tapanuli Tengah, Provinsi Sumatera Utara. Koleksi museum ini berasal dari situs Bongal. Sejarah Museum ini didirikan dan diresmikan pada tanggal 13 Mei 2023 oleh lembaga penelitian swasta Sultanate Institute yang diperuntukkan sebagai bagian dari upaya konservasi dan penelitian terhadap Situs Bongal, sebuah kawasan bernilai sejarah Islam, Kristen dan arkeologi di pantai barat Provinsi Sumatera Utara. Peresmian museum dihadiri oleh berbagai pihak, termasuk pejabat pemerintahan, akademisi, serta peneliti dari BRIN dan Kementerian Kebudayaan. Pendirian museum ini bertujuan untuk mengarsipkan dan menampilkan temuan arkeologi dari Situs Bongal serta menjadi pusat edukasi bagi masyarakat luas. Penelitian arkeologis tahun 2021 di Situs Bongal, Sumatera Utara, mengungkap bukti aktivitas perdagangan antara abad ke-7 hingga ke-10 Masehi. Situs yang terletak di Desa Jago-jago, Kabupaten Tapanuli Tengah, ini menunjukkan adanya interaksi penduduk Nusantara dengan pedagang dari Timur Tengah, India, dan Tiongkok. Fasilitas Di dalam Museum Fansuri menyajikan beberapa fasilitas antara lain seperti ruang pameran, galeri artefak dan fasilitas edukasi berupa media interaktif dan ruang riset. Terdapat toilet dan ruang tamu yang tersedia di sebelah ruang galeri museum. Pengunjung dapat memperoleh pemahaman yang lebih mendalam melalui tur yang dipandu oleh tenaga ahli (penjaga museum). Selain itu, museum ini berfungsi sebagai tempat bagi peneliti dan akademisi untuk melakukan kajian terhadap temuan-temuan terbaru dari Situs Bongal."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Fansuri, Situs Bongal, arkeologi, Jago-Jago, Tapanuli Tengah"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Desa Jago Jago, Kec. Badiri, Kabupaten Tapanuli Tengah, Sumatera Utara"@id ;
    ws:lintang "1.605163"^^xsd:decimal ;
    ws:bujur "98.823496"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Jago-Jago, Kecamatan Badiri, Kabupaten Tapanuli Tengah."@id ;
    ws:jamOperasional ""@id ;
    ws:hargaMasuk "" ;
    ws:noHpResmi "081396282222"^^xsd:string ;
