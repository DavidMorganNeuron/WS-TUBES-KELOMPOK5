data:ws-110 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-110"^^xsd:string ;
    ws:namaDestinasi "Taman Eden 100"@id ;
    ws:namaAlternatif "Agrowisata Taman Eden 100"@id, "Taman Eden"@id ;
    ws:deskripsiSingkat "Taman Eden 100 merupakan agrowisata pelestarian alam seluas 40 hektare di Lumban Julu yang dihiasi ratusan spesies tanaman langka dan aliran air terjun."@id ;
    ws:deskripsiLengkap "Diprakarsai secara swadaya oleh tokoh lingkungan hidup Marandus Sirait, Taman Eden 100 dinamakan demikian karena awalnya berhasil menanam 100 jenis spesies pohon berbuah di kawasan ini. Hutan lindung konservasi ini kini menjadi kawasan wisata alam edukatif yang menawarkan berbagai aktivitas outdoor yang luar biasa, mulai dari jungle tracking ringan menuju air terjun dua tingkat, camping ground yang luas, pembibitan anggrek hutan, budidaya andaliman, hingga rumah peribadatan berbentuk gua. Pengunjung diperkenankan menanam pohon dengan mencantumkan nama mereka sebagai simbol partisipasi kelestarian bumi."@id ;
    ws:jenisDestinasi "Alam"@id, "Buatan"@id ;
    ws:kataKunci "Taman Eden 100"@id, "Agrowisata"@id, "Lumban Julu"@id, "Toba"@id, "Wisata Konservasi"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Desa Sionggang Utara, Kecamatan Lumban Julu, Kabupaten Toba, Sumatera Utara 22386"@id ;
    ws:lintang "2.591098"^^xsd:decimal ;
    ws:bujur "99.038888"^^xsd:decimal ;
    ws:petunjukLokasi "Sekitar 20 km dari Parapat menuju arah Balige, memiliki gapura pintu masuk jelas di pinggir jalan raya."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "15000"^^xsd:decimal ;
    ws:noHpResmi "0813-7097-3088"^^xsd:string ;
    ws:emailResmi "tobacalunescoggp@gmail.com"^^xsd:string ;
