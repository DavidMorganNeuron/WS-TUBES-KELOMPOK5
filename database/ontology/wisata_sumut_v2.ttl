    ws:kataKunci "Bukit Kubu Berastagi, Berastagi, Karo, perbukitan, camping, Gunung Sinabung"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Kec. Berastagi, Kab. Karo, Sumatera Utara"@id ;
    ws:lintang "3.197810"^^xsd:decimal ;
    ws:bujur "98.511710"^^xsd:decimal ;
    ws:petunjukLokasi "Dari pusat Berastagi, berkendara sekitar 10 menit ke arah Bukit Kubu; jalan menanjak dengan plang di sisi kanan."@id ;
