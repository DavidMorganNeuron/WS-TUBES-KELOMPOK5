data:ws-216 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-216"^^xsd:string ;
    ws:namaDestinasi "Jona Garden Binjai"@id ;
    ws:namaAlternatif "Jona Garden"@id ;
    ws:deskripsiSingkat "Taman rekreasi keluarga dengan wahana anak dan kolam ombak di Emplasmen Kwala Mencirim, Kecamatan Sei Bingai, Kabupaten Langkat."@id ;
    ws:deskripsiLengkap "Jona Garden Binjai berlokasi di Jalan Sungai Musi Nomor 103, Emplasmen Kwala Mencirim, Kecamatan Sei Bingai, Kabupaten Langkat, di perbatasan dengan Kota Binjai. Kawasan ini menawarkan wahana permainan anak dan keluarga seperti ATV, flying fox, bom-bom car, odong-odong, serta kolam ombak. Tersedia area parkir luas, toilet, musala, warung makanan, dan gazebo untuk bersantai. Tiket masuk mulai lima ribu rupiah dan naik sesuai wahana yang dipilih. Pada akhir pekan pengunjung disarankan datang lebih pagi karena antrean wahana cukup panjang."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "Jona Garden Binjai"@id, "Kwala Mencirim"@id, "Sei Bingai"@id, "Langkat"@id, "Taman Rekreasi"@id, "Kolam Ombak"@id ;
    ws:beradaDi "Kabupaten Langkat"@id ;
    ws:alamat "Jl. Sungai Musi No. 103, Emplasmen Kwala Mencirim, Kec. Sei Bingai, Kab. Langkat, Sumatera Utara"@id ;
    ws:lintang "3.524990"^^xsd:decimal ;
    ws:bujur "98.476850"^^xsd:decimal ;
    ws:petunjukLokasi "Dari pusat Kota Binjai, berkendara sekitar 15 menit ke arah Kwala Mencirim; gerbang berada di sisi kiri jalan."@id ;
    ws:jamOperasional "Senin-Jumat 09.00-22.00, Sabtu-Minggu 08.00-22.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "081279762760"^^xsd:string ;
