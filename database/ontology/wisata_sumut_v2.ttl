    ws:memilikiMedia "-"^^xsd:anyURI ;
    ws:ratingPengunjung "5.0"^^xsd:decimal .

data:ws-164 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-164"^^xsd:string ;
    ws:namaDestinasi "Museum Perkebunan Indonesia"@id ;
    ws:namaAlternatif "Musperin"@id ;
    ws:deskripsiSingkat "Museum Perkebunan Indonesia adalah sebuah museum yang didirikan sebagai pusat informasi dan pendidikan tentang perkebunan yang ada di Indonesia."@id ;
    ws:deskripsiLengkap "Museum Perkebunan Indonesia adalah sebuah museum yang didirikan sebagai pusat informasi dan pendidikan tentang perkebunan yang ada di Indonesia. Museum ini berlokasi di Jalan Brigjen Katamso No. 53 Kota Medan, Sumatera Utara. Museum ini berada di bangunan yang menjadi bagian dari APA (Algemeene Proefstation der AVROS) atau Perhimpunan Pengusaha Perkebunan Karet di Pantai Timur Sumatra. Bangunan museum menyatu dengan tempat hunian, kafe serta rumah cokelat milik Pusat Penelitian Kelapa Sawit (PPKS). Penggagas sekaligus pendiri Museum Perkebunan Indonesia bernama Soedjai Kartasasmita. Peresmian Museum Perkebunan Indonesia dilakukan pada tanggal 10 Desember 2016 oleh Gubernur Sumatera Utara Tengku Erry Nuradi. Gedung museum memiliki dua lantai yang menyimpan banyak penjelasan seputar perkebunan pada masa lampau dan memamerkan koleksi hasil kebun serta sejarahnya. Lantai pertama didesain dengan grafis dan konteks kekinian perkebunan. Lantai dua menyajikan koleksi artefak perkebunan dari masa lampau hingga kini. Terdapat beberapa ruangan di Museum di antaranya yaitu ruang Sultan Ma'mun Al Rasyid, ruang Said Abdullah, dan ruang Jacobus Nienhuys."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Perkebunan Indonesia, Musperin, kelapa sawit, PPKS, Medan"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jalan Brigjen Katamso No.53, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.556111"^^xsd:decimal ;
    ws:bujur "98.688861"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Brigjen Katamso No. 53, Kota Medan, menyatu dengan kawasan Pusat Penelitian Kelapa Sawit."@id ;
    ws:jamOperasional "Senin-Jumat 09.00-16.00 WIB, Sabtu 08.30-15.30 WIB"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "085361968255"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "belajar sejarah perkebunan"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Museum_Perkebunan_Indonesia.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.6"^^xsd:decimal .

data:ws-165 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-165"^^xsd:string ;
    ws:namaDestinasi "Museum Situs Kotta Cinna"@id ;
    ws:namaAlternatif "Museum Situs Kota China"@id ;
    ws:deskripsiSingkat "Museum Situs Kota China (ditulis juga sebagai Museum Situs Kotta Cinna) adalah sebuah situs arkeologi yang terletak di tepi danau Siombak, Kelurahan Paya Pasir, Kecamatan Medan Marelan, Kota Medan."@id ;
    ws:deskripsiLengkap "Museum Situs Kota China (ditulis juga sebagai Museum Situs Kotta Cinna) adalah sebuah situs arkeologi yang terletak di tepi danau Siombak, Kelurahan Paya Pasir, Kecamatan Medan Marelan, Kota Medan. Museum ini dibangun pada tahun 2008 oleh seorang sejarawan bernama Ichwan Azhari dan diresmikan oleh pemerintah pada tahun 2009. Dari abad ke-11 sampai 14 Masehi, Kota China adalah pelabuhan dagang internasional. Kapal-kapal yang berlabuh berasal dari Persia, Hindia dan Tiongkok. Di Kota China ditemukan keramik dari Persia dan Tiongkok, uang koin dari Sri Lanka dan Tiongkok, dan patung Buddha dari Hindia. Situs Kota China di Medan Marelan telah diketahui sejak tahun 1970-an, namun jejak sejarahnya mulai terkuak sejak ditemukannya sebuah arca kuno pada saat penggalian tanah menggunakan alat berat untuk penimbunan pembangunan jalan Tol Belmera pada tahun 1986."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Situs Kota China, Kota Cina, arkeologi, Medan Marelan"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Kota Cina, Paya Pasir, Kec. Medan Marelan, Kota Medan, Sumatera Utara 20254"@id ;
    ws:lintang "3.723243"^^xsd:decimal ;
    ws:bujur "98.656755"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. Kota Cina, Kelurahan Paya Pasir, Kecamatan Medan Marelan, Kota Medan, di tepi Danau Siombak."@id ;
