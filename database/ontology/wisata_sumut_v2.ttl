data:ws-095 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-095"^^xsd:string ;
    ws:namaDestinasi "Bukit Sibea-bea"@id ;
    ws:namaAlternatif ""@id ;
    ws:deskripsiSingkat "Bukit Sibea-bea adalah destinasi religi yang terletak di Harian Boho, Kabupaten Samosir, Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Bukit Sibea-bea adalah destinasi religi yang terletak di Harian Boho, Kabupaten Samosir, Sumatera Utara, Indonesia. Daya tarik utama objek wisata ini adalah hadirnya sebuah patung Yesus di puncak bukit Sibea-bea. Selain itu, bukit ini juga dikenal karena indahnya panorama alam Toba di ketinggian 1.021 meter di atas permukaan laut. Bukit Sibea-bea sejatinya adalah sebuah objek wisata religi bagi umat Kristiani, karena fokus utamanya adalah menghadirkan sebuah patung Yesus. Patung Yesus Bukit Sibea-bea direncanakan akan memiliki tinggi sekitar 61 meter. Dengan tinggi tersebut menjadikannya patung Yesus tertinggi, yang ada di dunia. Patung ini diharapkan akan menjadi sebuah ikon Samosir dan akan mengalahkan tinggi dari patung Yesus populer Christ the Redeemer, di Rio de Janeiro, Brasil yang mempunyai tinggi sekitar 30 meter saja. Bukit Sibea-bea menjadi terkenal bahkan sebelum resmi dibuka. Sebab, masyarakat terkesima dengan keelokan dan keindahan alam Danau Toba melalui foto-foto yang telah beredar di media sosial. Foto-foto tersebut memperlihatkan sebuah jalan berlatarkan alam yang merupakan sebuah jalan aspal berkelok dan mendaki. Jalur ini nantinya akan menjadi jalur utama bagi para pengunjung untuk menuju ke objek wisata religi Patung Yesus Kristus yang ada di puncak bukit. Melalui jalur tersebut, pengunjung bisa menyusuri birunya Danau Toba dan hijaunya pemandangan perbukitan yang asri."@id ;
    ws:jenisDestinasi "Alam"@id,
        "Religi"@id ;
    ws:kataKunci "Bukit Sibea-bea, patung Yesus, wisata rohani, Harian Boho, Samosir"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat ""@id ;
    ws:lintang "2.548"^^xsd:decimal ;
    ws:bujur "98.672"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Harian Boho, Kabupaten Samosir, pada ketinggian sekitar 1.021 mdpl dengan panorama Danau Toba."@id ;
    ws:jamOperasional ""@id ;
    ws:hargaMasuk "" ;
    ws:noHpResmi "" ;
    ws:emailResmi "" ;
    ws:instagramResmi ""^^xsd:anyURI ;
    ws:memilikiFasilitas ""@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Melihat patung Yesus"@id,
        "Menikmati panorama"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Bukit-Sibea-bea-_Wisata-Rohani.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.7"^^xsd:decimal .

data:ws-096 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-096"^^xsd:string ;
    ws:namaDestinasi "Danau Aek Natonang"@id ;
    ws:namaAlternatif "danau di atas danau"@id ;
    ws:deskripsiSingkat "Danau Aek Natonang terletak di Desa Tanjungan, Kecamatan Simanindo, Pulau Samosir, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Danau Aek Natonang terletak di Desa Tanjungan, Kecamatan Simanindo, Pulau Samosir, Sumatera Utara. Kalau Pulau Samosir dikatakan sebagai \"pulau di atas pulau\", Danau Aek Natonang yang berada di Pulau Samosir ini bisa dikatakan sebagai \"danau di atas danau\" (di atas Danau Toba). Aksesibilitas ke danau seluas 105 hektare ini sudah diperbaharui, jalanan beraspal bagus, hanya saja minimnya sarana prasarana pendukung, membuat Danau Aek Natonang tidak mendapat kunjungan wisatawan dan direncanakan sebagai areal Hutan Wisata. Danau Aek Natonang bukan satu-satunya danau di Pulau Samosir, ada sebuah danau lagi yang lebih besar dari Danau Aek Natonang di pulau ini yang bernama Danau Sidihoni."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Aek Natonang, Pea Aek Natonang, Tanjungan, Simanindo, Samosir"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat ""@id ;
    ws:lintang "2.564722"^^xsd:decimal ;
    ws:bujur "98.883889"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Tanjungan, Kecamatan Simanindo, Pulau Samosir."@id ;
