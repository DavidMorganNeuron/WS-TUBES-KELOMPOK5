data:ws-205 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-205"^^xsd:string ;
    ws:namaDestinasi "Taman Ya'ahowu"@id ;
    ws:namaAlternatif "Taman Yaahowu Gunungsitoli"@id ;
    ws:deskripsiSingkat "Ruang terbuka hijau di pusat Kota Gunungsitoli yang dibangun di atas lahan bekas puing gempa 2005 dan kini menjadi taman rekreasi warga."@id ;
    ws:deskripsiLengkap "Taman Ya'ahowu berada di pusat Kota Gunungsitoli, Kecamatan Gunungsitoli, dan menempati lahan bekas timbunan puing setelah gempa Nias 2005. Namanya diambil dari sapaan khas Nias. Taman ini dilengkapi jalur pejalan kaki, gazebo, bangku, area bermain anak, dan patung ikonik yang sering menjadi latar foto. Pada pagi hari taman dipakai untuk olahraga, sedangkan sore hingga malam menjadi tempat berkumpul keluarga dan pedagang kaki lima. Tidak ada tiket masuk, sehingga taman ini menjadi alternatif rekreasi murah di Gunungsitoli."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "Taman Ya'ahowu"@id, "Gunungsitoli"@id, "Taman Kota"@id, "Ruang Terbuka Hijau"@id, "Nias"@id ;
    ws:beradaDi "Kota Gunungsitoli"@id ;
    ws:alamat "Kec. Gunungsitoli, Kota Gunungsitoli, Sumatera Utara"@id ;
    ws:lintang "1.2903125"^^xsd:decimal ;
    ws:bujur "97.6186875"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak di pusat Kota Gunungsitoli, berjarak beberapa menit jalan kaki dari kantor wali kota."@id ;
    ws:jamOperasional "Setiap hari 09.00-17.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Gazebo"@id, "Toilet"@id, "Wahana"@id ;
