data:ws-098 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-098"^^xsd:string ;
    ws:namaDestinasi "Pemandian Air Panas Sipoholon"@id ;
    ws:namaAlternatif "Kawah Putih Sipoholon"@id, "Pemandian Sipoholon"@id ;
    ws:deskripsiSingkat "Pemandian Air Panas Sipoholon di Tarutung menawarkan relaksasi kolam air belerang yang dikelilingi oleh perbukitan batu kapur putih yang eksotis."@id ;
    ws:deskripsiLengkap "Terbentuk dari aktivitas panas bumi (geotermal), mata air panas di Sipoholon menghasilkan air yang kaya akan kandungan belerang, yang dipercaya sangat berkhasiat menyembuhkan berbagai penyakit kulit dan melancarkan sirkulasi darah. Daya tarik visual utamanya terletak pada deposit kapur berwarna putih gading dan semburat kuning sulfur yang mengkristal membentuk terasering secara alami menyerupai pamukkale di Turki. Pengunjung dapat memilih untuk mandi di kolam-kolam umum yang ditawarkan warga maupun di kamar mandi tertutup, sembari berswafoto dengan latar tebing kapur berselimut uap panas."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Sipoholon"@id, "Air Panas"@id, "Tarutung"@id, "Tapanuli Utara"@id, "Kawah Putih"@id ;
    ws:beradaDi "Kabupaten Tapanuli Utara"@id ;
    ws:alamat "Situmeang Hasundutan, Kecamatan Sipoholon, Kabupaten Tapanuli Utara, Sumatera Utara 22452"@id ;
    ws:lintang "2.0526"^^xsd:decimal ;
    ws:bujur "98.9669"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak persis di tepian Jalan Raya Lintas Sumatera arah Tarutung - Siborong-borong."@id ;
