data:ws-220 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-220"^^xsd:string ;
    ws:namaDestinasi "Pemandian Bah Damanik"@id ;
    ws:namaAlternatif "Aek Manik"@id, "Pemandian Alam Aek Manik"@id ;
    ws:deskripsiSingkat "Pemandian mata air di tengah perkebunan teh Ambarisan, Kecamatan Sidamanik, Kabupaten Simalungun."@id ;
    ws:deskripsiLengkap "Pemandian Bah Damanik atau Aek Manik berada di Desa Ambarisan, Kecamatan Sidamanik, Kabupaten Simalungun, dikelilingi hamparan kebun teh. Sumber airnya berupa mata air pegunungan yang ditampung dalam kolam berbatu, dengan legenda yang dikaitkan dengan keluarga Raja Damanik. Pengunjung dapat berenang dan bermain rakit, lalu bersantai di gazebo atau warung di sekitar kolam. Fasilitasnya mencakup area parkir, toilet, kamar bilas, dan penyewaan ban pelampung. Tiket masuk lima ribu rupiah per orang, sementara parkir dan sewa tikar dihitung terpisah."@id ;
