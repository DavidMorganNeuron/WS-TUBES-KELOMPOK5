data:ws-144 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-144"^^xsd:string ;
    ws:namaDestinasi "Graha Maria Annai Velangkanni"@id ;
    ws:namaAlternatif "Graha Maria Annai Velangkanni Medan"@id ;
    ws:deskripsiSingkat "Graha Maria Annai Velangkanni adalah gereja Katolik bergaya India-Mughal yang dibuka pada tahun 2005 di Kota Medan, Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Graha Maria Annai Velangkanni adalah gereja Katolik bergaya India-Mughal yang dibuka pada tahun 2005 di Kota Medan, Sumatera Utara, Indonesia. Peresmian bangunan dilakukan oleh Gubernur Sumatera Utara Rudolf Pardede. Konsekrasi bangunan dan altar dilakukan oleh Uskup Agung Medan Mgr. Alfred Gonti Pius Datubara, OFM.Cap. Gereja ini dipersembahkan untuk Bunda Velangkanni atau Santa Maria Bunda Penyembuh yang Baik (bahasa Tamil: ஆரோக்கிய மாதா Ārōkkiya mātā). Gereja Velangkanni terletak di sebuah jalan kecil yang bernama Jl. Sakura III, dan masuk ke dalam wilayah Paroki Santa Maria, Medan. Pada bagian gerbang bangunan ini, terdapat miniatur rumah tradisional Batak Karo dan Batak Toba. Konon Bunda Maria pernah muncul pada abad ke-17 di Kota Velankanni, Tamil Nadu, India, sehingga muncullah gelar Bunda Velangkanni Bunda Penyembuh. Gereja ini merupakan bangunan dua tingkat yang terdiri dari tempat pertemuan di lantai dasar dan tempat ibadah di lantai pertama, sementara menara di atasnya terdiri dari tujuh lantai sebagai lambang bahwa di surga terdapat tempat untuk semua orang. Menara ini sendiri merupakan perwakilan Raja Gopuram (kubah raja) dalam arsitektur Hindu. Di atas bangunan gereja ini juga terdapat tiga kubah yang dibangun dengan gaya arsitektur Mughal dan merupakan lambang Tritunggal."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Graha Maria Annai Velangkanni, Bunda Velangkanni, gereja Katolik, arsitektur India-Mughal, Medan"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Sakura III No. 7-10, Tanjung Selamat, Kec. Medan Tuntungan, Kota Medan, Sumatera Utara 20135"@id ;
    ws:lintang "3.548065"^^xsd:decimal ;
    ws:bujur "98.608646"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. Sakura III, Kecamatan Medan Tuntungan, Kota Medan, dalam wilayah Paroki Santa Maria."@id ;
    ws:jamOperasional "Setiap hari 07.00-20.00 WIB"@id ;
    ws:hargaMasuk "Gratis" ;
    ws:noHpResmi "(061) 8201943"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "area parkir, toilet, toko suvenir, kantin"@id ;
    ws:dapatMelakukan "berdoa"@id ;
    ws:dapatMelakukan "menikmati arsitektur"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Graha_Maria_Annai_Velangkanni_Medan.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.8"^^xsd:decimal .

