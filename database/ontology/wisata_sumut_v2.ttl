data:ws-078 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-078"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sipisopiso"@id ;
    ws:namaAlternatif "Piso dari Tanah Karo"@id ;
    ws:deskripsiSingkat "Air Terjun Sipisopiso merupakan air terjun tipe plunge setinggi 120 meter yang jatuh secara vertikal dari bibir kaldera Danau Toba di Desa Tongging."@id ;
    ws:deskripsiLengkap "Berada di ketinggian sekitar 1.300 meter di atas permukaan laut, Air Terjun Sipisopiso menyuguhkan pemandangan spektakuler aliran air Sungai Pajanabolon yang membelah tebing raksasa kaldera Toba. Nama 'Sipisopiso' merujuk pada bentuk curahan airnya yang lurus dan tajam menyerupai sebilah pisau. Pengunjung tidak hanya bisa menikmati kemegahannya dari gardu pandang di atas bukit sembari melihat Danau Toba yang terbentang luas, tetapi juga bisa menuruni ratusan anak tangga untuk merasakan embun sejuk tepat di dasar air terjun."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Sipisopiso"@id, "Sipiso-piso"@id, "Tongging"@id, "Merek"@id, "Danau Toba"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Desa Tongging, Kecamatan Merek, Kabupaten Karo, Sumatera Utara 22173"@id ;
    ws:lintang "2.9162"^^xsd:decimal ;
    ws:bujur "98.5196"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak sekitar 24 km dari Kabanjahe, berada dekat perbatasan dengan Kabupaten Simalungun."@id ;
