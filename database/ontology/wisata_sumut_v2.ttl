data:ws-138 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-138"^^xsd:string ;
    ws:namaDestinasi "Desa Wisata Bawomataluo"@id ;
    ws:namaAlternatif "Kampung Bawomataluo"@id, "Desa Bawomataluo"@id ;
    ws:deskripsiSingkat "Desa Wisata Bawomataluo adalah kampung adat purba Nias Selatan berskala dunia yang melestarikan arsitektur rumah tinggi dan tradisi lompat batu (Fahombo)."@id ;
    ws:deskripsiLengkap "Terdaftar dalam warisan dunia tentatif UNESCO, Desa Bawomataluo (berarti 'Bukit Matahari') menyajikan rupa asli kehebatan suku Nias. Memasuki kampung ini, wisatawan ditantang mendaki ratusan anak tangga batu massif (Batu Puncak) hingga tiba di pelataran luas beralaskan lempengan batu megalitik kuno. Desa ini dipagari puluhan Omo Hada (rumah panggung kayu tanpa paku) yang mengelilingi Omo Sebua, yakni istana sang raja kepala suku. Atraksi lompat batu (Fahombo) dan tarian perang (Fataele) rutin diperagakan oleh para pemuda desa berotot tangguh yang memanjakan mata para pelancong kultural mancanegara."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Bawomataluo"@id, "Nias Selatan"@id, "Fahombo"@id, "Lompat Batu"@id, "Omo Sebua"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Desa Bawomataluo, Kecamatan Fanayama, Kabupaten Nias Selatan, Sumatera Utara 22865"@id ;
    ws:lintang "0.6125"^^xsd:decimal ;
    ws:bujur "97.7713"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak 15 km utara dari pusat kota Teluk Dalam, jalan aspal dapat dilalui mobil hingga tangga masuk kampung."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "20000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toko Suvenir"@id, "Pemandu Wisata"@id, "Toilet"@id, "Rumah Makan"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Mengapresiasi"@id, "Menelusuri"@id, "Berfoto"@id, "Menonton"@id ;
    ws:memilikiMedia "https://upload.wikimedia.org/wikipedia/commons/e/ea/Bawomataluo_Village.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.9"^^xsd:decimal .

data:ws-139 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-139"^^xsd:string ;
    ws:namaDestinasi "Situs Megalitikum Tetegewe"@id ;
    ws:namaAlternatif "Situs Tetegewe"@id, "Batu Megalit Tetegewe"@id ;
    ws:deskripsiSingkat "Situs Megalitikum Tetegewe merupakan hamparan peninggalan formasi bongkahan batu peradaban masa megalitikum (zaman batu besar) di Kepulauan Nias."@id ;
    ws:deskripsiLengkap "Nias Selatan bukan hanya rumah bagi desa adat budaya, melainkan juga situs sejarah geologi kebudayaan purba, yaitu Situs Tetegewe. Di situs terbuka yang telah diteliti oleh para arkeolog internasional ini, terdapat lebih dari ratusan lempengan dan pilar batu menhir dengan pahatan ornamen kuno berwujud dewa kesuburan dan satwa mitologi. Benda-benda megalitikum ini merepresentasikan stratifikasi sosial serta tingginya kecerdasan masyarakat kuno Nias di masa 1.000 tahun sebelum Masehi, ketika mereka mampu memahat, memindahkan, dan menancapkan batuan cadas berton-ton ke perbukitan yang terjal."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Situs Tetegewe"@id, "Megalitikum Nias"@id, "Nias Selatan"@id, "Zaman Batu"@id, "Wisata Sejarah"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Desa Tetegewe, Kecamatan Susua, Kabupaten Nias Selatan, Sumatera Utara 22865"@id ;
    ws:lintang "0.6833"^^xsd:decimal ;
    ws:bujur "97.7121"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di perbukitan pedalaman Susua, membutuhkan perjalanan dengan rute jalan desa mendaki."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
