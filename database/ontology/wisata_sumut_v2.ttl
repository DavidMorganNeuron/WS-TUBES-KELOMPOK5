data:ws-152 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-152"^^xsd:string ;
    ws:namaDestinasi "Tangkahan"@id ;
    ws:namaAlternatif "Ekowisata Tangkahan"@id, "Elephant Village Tangkahan"@id ;
    ws:deskripsiSingkat "Tangkahan adalah kawasan ekowisata di Namu Sialang, Kecamatan Batang Serangan, Kabupaten Langkat, yang dikenal dengan aktivitas memandikan gajah dan penyusuran hutan Taman Nasional Gunung Leuser."@id ;
    ws:deskripsiLengkap "Tangkahan adalah kawasan ekowisata di Namu Sialang, Kecamatan Batang Serangan, Kabupaten Langkat, yang dikenal dengan aktivitas memandikan gajah dan penyusuran hutan Taman Nasional Gunung Leuser. Kawasan ini dikelola bersama oleh Conservation Response Unit (CRU) Tangkahan dan masyarakat setempat, dan menjadi salah satu ekowisata unggulan Sumatera Utara. Selain memandikan gajah, pengunjung dapat trekking, tubing di Sungai Batang Serangan, dan menjelajahi hulu sungai dengan perahu."@id ;
    ws:jenisDestinasi "Alam"@id ;
