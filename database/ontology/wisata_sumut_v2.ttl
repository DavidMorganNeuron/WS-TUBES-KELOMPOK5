data:ws-053 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-053"^^xsd:string ;
    ws:namaDestinasi "Huta Siallagan"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Huta Siallagan adalah kompleks perkampungan adat Batak Toba berusia ratusan tahun di Kabupaten Samosir yang terkenal dengan peninggalan Batu Persidangan dan deretan Rumah Bolon tradisional."@id ;
    ws:deskripsiLengkap "Dibangun pada masa pemerintahan Raja Laga Siallagan pada abad ke-13, Huta Siallagan merupakan cagar budaya tertutup yang dikelilingi benteng berupa tembok batu setinggi 1,5 hingga 2 meter untuk melindungi warga dari gangguan luar. Di dalam kawasan ini, pengunjung dapat melihat ikon sejarah berupa Batu Parsidangan (Batu Persidangan) berusia lebih dari 200 tahun yang dulunya digunakan oleh raja untuk menggelar musyawarah adat hingga mengadili dan mengeksekusi pelanggar hukum berat. Selain nilai historis yang kental, kompleks yang telah direvitalisasi dan diresmikan ulang oleh Presiden Joko Widodo pada Februari 2022 ini juga menampilkan Rumah Bolon khas Batak Toba tanpa paku serta pertunjukan budaya lokal yang hidup."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Batu Kursi Raja"@id, "Ambarita"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Jl. Lkr. Tuktuk, Desa Siallagan, Pindaraya, Kecamatan Simanindo, Kabupaten Samosir, Sumatera Utara 22395"@id ;
    ws:lintang "2.6792344052646087"^^xsd:decimal ;
    ws:bujur "98.83623310983303"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. Lkr. Tuktuk, Desa Siallagan, Pindaraya, Kabupaten Samosir, Sumatera Utara 22395."@id ;
    ws:jamOperasional "Setiap hari 08.00 - 18.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "082161824800" ;
    ws:emailResmi "batuparsidangansiallagan@gmail.com" ;
    ws:instagramResmi "https://www.instagram.com/hutasiallagan"^^xsd:anyURI ;
    ws:memilikiFasilitas "Toilet"@id, "Tempat Parkir"@id, "Toko Oleh-Oleh"@id, "Pemandu Wisata"@id ;
    ws:dapatMelakukan "Belajar"@id,
        "Berfoto"@id,
        "Menulusuri"@id, "Mengapresiasi"@id, "Bersantai"@id ;
