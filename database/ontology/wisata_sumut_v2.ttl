data:ws-092 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-092"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Silima-lima"@id ;
    ws:namaAlternatif "Air Terjun Silimalima"@id ;
    ws:deskripsiSingkat "Air Terjun Silima-lima merupakan wisata alam ekstrem di Marancar dengan ketinggian mencapai 80 meter yang diapit dua tebing curam."@id ;
    ws:deskripsiLengkap "Disebut 'Silima-lima' (berarti lima) karena air terjun ini terletak di pegunungan yang berada pada lima pilar desa di Kecamatan Marancar, Kabupaten Tapanuli Selatan. Aliran airnya sangat deras, jatuh langsung dari tebing dengan ketinggian lebih dari 80 meter, menciptakan kabut air (embun) abadi di dasar lembahnya. Untuk tiba di lokasi jatuhnya air terjun ini, para wisatawan ditantang melewati ribuan anak tangga menurun yang cukup curam namun telah disemen dengan baik, ditemani pemandangan perkebunan karet dan lanskap hutan tropis perawan di sepanjang rute perjalanan."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Silima-lima"@id, "Marancar"@id, "Tapanuli Selatan"@id, "Wisata Alam"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "Desa Maju, Kecamatan Marancar, Kabupaten Tapanuli Selatan, Sumatera Utara 22761"@id ;
    ws:lintang "1.5238"^^xsd:decimal ;
    ws:bujur "99.1171"^^xsd:decimal ;
    ws:petunjukLokasi "Masuk melalui jalan utama Kecamatan Marancar, terdapat gerbang khusus menuju area parkir."@id ;
    ws:jamOperasional "Setiap Hari 07.00-17.30"@id ;
