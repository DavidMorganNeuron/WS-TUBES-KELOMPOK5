data:ws-189 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-189"^^xsd:string ;
    ws:namaDestinasi "Central Park Zoo & Resort"@id ;
    ws:namaAlternatif "Central Park Zoo"@id, "Central Park Zoo Medan"@id ;
    ws:deskripsiSingkat "Central Park Zoo & Resort adalah kawasan rekreasi terpadu di Kecamatan Pancur Batu, Kabupaten Deli Serdang, yang memadukan kebun binatang, taman air, akuarium, dan penginapan."@id ;
    ws:deskripsiLengkap "Central Park Zoo & Resort berada di Jalan Jamin Ginting Km 20, Desa Sugau, Kecamatan Pancur Batu, Kabupaten Deli Serdang, di lahan seluas sekitar 15 hektare. Dalam satu kawasan terdapat kebun binatang dengan satwa seperti singa dan harimau, taman air, akuarium, aviary, museum, restoran, serta penginapan. Pengunjung dapat mengelilingi kandang satwa, bermain air, dan belajar tentang fauna dalam satu kunjungan."@id ;
    ws:jenisDestinasi "Buatan"@id ;
