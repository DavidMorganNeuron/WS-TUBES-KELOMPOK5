data:ws-104 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-104"^^xsd:string ;
    ws:namaDestinasi "Rumah Bolon Pematang Purba"@id ;
    ws:namaAlternatif "Istana Raja Purba"@id, "Rumah Bolon Simalungun"@id ;
    ws:deskripsiSingkat "Rumah Bolon Pematang Purba merupakan kompleks istana peninggalan Kerajaan Simalungun abad ke-16 yang seluruhnya dibangun menggunakan material kayu tanpa paku besi."@id ;
    ws:deskripsiLengkap "Istana adat yang sangat megah ini didirikan oleh Pangultop-ultop, Raja Purba pertama pada tahun 1515, dengan mengedepankan gaya arsitektur khas ornamen geometris (Pinar) suku Simalungun. Struktur utama bangunan ini ditopang ratusan tiang kayu bulat padat di mana bagian atap sirap ijuknya diukir dengan detail patung kepala kerbau yang melambangkan perlindungan dan kesejahteraan. Kompleks seluas 2 hektare ini merangkum sistem tata negara dan kehidupan sosial masa lalu, menampilkan ruangan Balai Bolon, Jambur, hingga ruang peradilan raja yang hingga kini terawat dengan amat rapi sebagai pusat wisata pelestarian adat."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Rumah Bolon"@id, "Pematang Purba"@id, "Simalungun"@id, "Istana Raja"@id, "Budaya Simalungun"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Desa Pematang Purba, Kecamatan Purba, Kabupaten Simalungun, Sumatera Utara 21165"@id ;
    ws:lintang "2.9110"^^xsd:decimal ;
    ws:bujur "98.6808"^^xsd:decimal ;
    ws:petunjukLokasi "Dari arah Kabanjahe menuju Seribu Dolok, lokasi berada di tepi jalan utama Pematang Purba."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
