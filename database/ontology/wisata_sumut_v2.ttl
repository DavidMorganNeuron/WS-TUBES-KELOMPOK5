data:ws-093 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-093"^^xsd:string ;
    ws:namaDestinasi "Pantai Pandan"@id ;
    ws:namaAlternatif "Pantai Bosur"@id ;
    ws:deskripsiSingkat "Pantai Pandan adalah pantai primadona berpasir putih halus di pesisir barat Sumatera dengan ombak tenang yang berada di Tapanuli Tengah."@id ;
    ws:deskripsiLengkap "Menghadap langsung ke perairan Teluk Tapian Nauli, Pantai Pandan menawarkan lanskap pesisir yang landai dengan ombak yang sangat ramah untuk tempat bermain keluarga. Hamparan pasir putihnya yang bersih dihiasi jejeran pepohonan cemara laut dan ketapang, membuat suasana bersantai di siang hari tetap teduh. Pengunjung dapat menikmati aneka hidangan laut bakar yang dijual di sepanjang garis pantai sembari menunggu momen matahari terbenam (sunset) yang sangat terkenal keindahannya karena gradasi warna jingga yang memantul sempurna di laut lepas."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Pandan"@id, "Sibolga"@id, "Tapanuli Tengah"@id, "Wisata Pantai"@id, "Pasir Putih"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Jl. Padang Sidempuan, Kecamatan Pandan, Kabupaten Tapanuli Tengah, Sumatera Utara 22611"@id ;
    ws:lintang "1.7061"^^xsd:decimal ;
    ws:bujur "98.8142"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak dekat dari pusat kota Sibolga, dapat diakses langsung dari jalan utama Trans Sumatera barat."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
