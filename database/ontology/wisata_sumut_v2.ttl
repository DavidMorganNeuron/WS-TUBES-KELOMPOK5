data:ws-003 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-003"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Ponot"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air Terjun Ponot adalah sebuah air terjun yang terletak di antara Kabupaten Toba."@id ;
    ws:deskripsiLengkap "Air Terjun Ponot adalah sebuah air terjun yang terletak di antara Kabupaten Toba. Air Terjun Ponot memiliki tiga tingkatan dengan ketinggian ±250 meter. Air Terjun Ponot berada di aliran Sungai Ponot yang merupakan anak Sungai Asahan di ketinggian sekitar 500 meter di atas permukaan air laut. Keindahan Air terjun Ponot terletak pada debit airnya yang sangat deras. Di bawah curahan air terjun banyak terdapat batu-batuan alam yang berukuran sangat besar sehingga menjadi daya tarik tersendiri sebagai pelengkap keindahan Air terjun Ponot ."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "air terjun Ponot, Sungai Ponot, air terjun tiga tingkat"@id ;
    ws:beradaDi "Kabupaten Asahan"@id ;
    ws:alamat "-"@id ;
    ws:lintang "2.5547"^^xsd:decimal ;
    ws:bujur "99.303976"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di aliran Sungai Ponot (anak Sungai Asahan), di perbatasan Kabupaten Asahan dan Kabupaten Toba, pada ketinggian sekitar 500 mdpl."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "menikmati pemandangan air terjun"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:memilikiMedia "-"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

