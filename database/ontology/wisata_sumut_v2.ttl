data:ws-217 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-217"^^xsd:string ;
    ws:namaDestinasi "Siantar Waterpark"@id ;
    ws:namaAlternatif "Waterpark Pematang Siantar"@id ;
    ws:deskripsiSingkat "Waterpark di Jalan Rakutta Sembiring, Kelurahan Naga Pita, Kecamatan Siantar Martoba, Kota Pematangsiantar."@id ;
    ws:deskripsiLengkap "Siantar Waterpark berada di Jalan Rakutta Sembiring Nomor 1, Kelurahan Naga Pita, Kecamatan Siantar Martoba, Kota Pematangsiantar. Wahana yang tersedia antara lain body slide, kid water slide, flow pool, kolam renang dewasa, super fun bowl, dan waterfall, ditambah baby kids play set untuk anak kecil. Fasilitasnya meliputi stan makanan, pondok, loker, spot foto, area parkir, dan kamar mandi. Tiket masuk tiga puluh lima ribu rupiah pada hari biasa, dengan jadwal lebih panjang pada akhir pekan. Tempat ini menjadi alternatif rekreasi air di kawasan Siantar dan sering dipenuhi rombongan keluarga."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "Siantar Waterpark"@id, "Naga Pita"@id, "Siantar Martoba"@id, "Pematangsiantar"@id, "Waterpark"@id, "Seluncuran"@id ;
    ws:beradaDi "Kota Pematangsiantar"@id ;
    ws:alamat "Jl. Rakutta Sembiring No. 1, Kel. Naga Pita, Kec. Siantar Martoba, Kota Pematangsiantar, Sumatera Utara"@id ;
    ws:lintang "2.983480"^^xsd:decimal ;
    ws:bujur "99.068180"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di sisi utara Kota Pematangsiantar; dari pusat kota berkendara sekitar 10 menit ke Jalan Rakutta Sembiring."@id ;
    ws:jamOperasional "Senin-Jumat 09.00-18.00, Sabtu-Minggu 08.00-21.00"@id ;
