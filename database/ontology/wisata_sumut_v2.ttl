    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-114 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-114"^^xsd:string ;
    ws:namaDestinasi "Makam Raja Sidabutar"@id ;
    ws:namaAlternatif "Situs Makam Raja Sidabutar"@id ;
    ws:deskripsiSingkat "Makam Raja Sidabutar di Desa Tomok adalah kompleks pusara megalitik yang dipahat utuh dari sebongkah batu raksasa peninggalan penguasa Samosir masa lampau."@id ;
    ws:deskripsiLengkap "Tanpa perlu mendaki bukit atau masuk ke hutan, pengunjung Desa Tomok dapat langsung melihat jejak kejayaan Raja Ompu Soributu Sidabutar, raja pertama yang mendiami Tomok dengan kesaktian magis yang melegenda. Kompleks kuburan batu ini unik karena petinya (sarkofagus) tidak ditanam di dalam tanah, melainkan diletakkan utuh di atas permukaan dan dipahat langsung menyerupai wajah sang raja beserta penasihatnya. Sebelum masuk ke dalam situs keramat yang dihiasi cat tiga warna khas Batak (merah, hitam, putih) ini, peziarah dan wisatawan diwajibkan mengenakan selendang ulos sebagai tanda penghormatan."@id ;
    ws:jenisDestinasi "Budaya"@id, "Religi"@id ;
    ws:kataKunci "Makam Raja Sidabutar"@id, "Tomok"@id, "Samosir"@id, "Megalitikum"@id, "Situs Sejarah"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Tomok Parsaoran, Kecamatan Simanindo, Kabupaten Samosir, Sumatera Utara 22395"@id ;
