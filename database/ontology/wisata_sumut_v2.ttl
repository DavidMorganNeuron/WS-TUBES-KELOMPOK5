data:ws-212 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-212"^^xsd:string ;
    ws:namaDestinasi "Tor Simagomago"@id ;
    ws:namaAlternatif "Puncak Tor Simago-mago"@id ;
    ws:deskripsiSingkat "Puncak perbukitan di Huta Raja, Kecamatan Sipirok, Kabupaten Tapanuli Selatan, yang populer untuk berkemah dan menikmati matahari terbit."@id ;
    ws:deskripsiLengkap "Tor Simagomago berada di Huta Raja, Kecamatan Sipirok, Kabupaten Tapanuli Selatan, pada ketinggian yang menghadap lembah dan perbukitan hijau. Pengelola membuka area ini 24 jam dengan tiket lima ribu rupiah untuk dewasa dan tiga ribu rupiah untuk anak-anak, ditambah biaya parkir. Di puncak tersedia area camping, gazebo, dan warung sederhana. Pengunjung biasanya datang pagi untuk mengejar kabut dan matahari terbit, atau sore untuk menikmati matahari terbenam. Karena berada di jalur pegunungan, suhu di malam hari cukup dingin sehingga pengunjung disarankan membawa jaket."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Tor Simagomago"@id, "Tor Simago-mago"@id, "Sipirok"@id, "Tapanuli Selatan"@id, "Camping"@id, "Puncak"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "Huta Raja, Kec. Sipirok, Kab. Tapanuli Selatan, Sumatera Utara 22742"@id ;
    ws:lintang "1.5614375"^^xsd:decimal ;
    ws:bujur "99.2891875"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Sipirok, berkendara sekitar 20 menit ke arah Huta Raja; gerbang retribusi berada di jalan menuju puncak."@id ;
    ws:jamOperasional "Setiap hari 24 jam"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "+62-821-6419-7950"^^xsd:string ;
