data:ws-031 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-031"^^xsd:string ;
    ws:namaDestinasi "Funworld Deli Park Podomoro City Medan"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Funworld Delipark Podomoro City Medan adalah pusat hiburan keluarga modern yang menghadirkan beragam pilihan permainan arkade, wahana seru, hingga teknologi virtual reality (VR) di tengah Kota Medan."@id ;
    ws:deskripsiLengkap "Funworld (termasuk konsep modern seperti Funworld Frenzy dan Funworld Adventure) menawarkan pengalaman rekreasi indoor yang luas dan lengkap untuk semua kalangan, mulai dari anak-anak hingga orang dewasa. Di sini, pengunjung dapat menikmati berbagai mesin permainan arkade kekinian, wahana keluarga seperti kereta mini dan komedi putar, hingga area softplay yang aman bagi anak-anak. Daya tarik utamanya meliputi teknologi virtual reality (VR) seperti VR Paraglider yang memicu adrenalin, serta berbagai zona modern berteknologi tinggi."@id ;
    ws:jenisDestinasi "Buatan"@id ;
