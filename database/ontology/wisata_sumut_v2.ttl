data:ws-133 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-133"^^xsd:string ;
    ws:namaDestinasi "Gunung Lubuk Raya"@id ;
    ws:namaAlternatif "Dolok Lubuk Raya"@id ;
    ws:namaAlternatif "Mount Lubukraya"@en ;
    ws:deskripsiSingkat "Gunung Lubuk Raya (Surat Batak: ᯑᯬᯞᯬᯄ᯦᯲ ᯞᯮᯅᯮᯄ᯦᯲ ᯒᯛ, translit. Dolok Lubuk Raya) adalah gunung berapi kerucut andesit di Pulau Sumatra, Indonesia."@id ;
    ws:deskripsiLengkap "Gunung Lubuk Raya (Surat Batak: ᯑᯬᯞᯬᯄ᯦᯲ ᯞᯮᯅᯮᯄ᯦᯲ ᯒᯛ, translit. Dolok Lubuk Raya) adalah gunung berapi kerucut andesit di Pulau Sumatra, Indonesia. Gunung ini secara administratif terletak di Kabupaten Tapanuli Selatan, Sumatera Utara. Gunung Lubuk Raya merupakan gunung api yang sudah tidak aktif yang tidak diketahui waktu letusan terakhirnya. Tidak ada aktivitas vulkanik di permukaan gunung ini tetapi jejak letusannya tampak berupa bekas dinding kawah yang sobek memanjang ke arah barat daya. Pendakian Gunung Lubuk Raya umumnya dimulai dari Desa Lembah Lubuk Raya, Kecamatan Angkola Barat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Gunung Lubuk Raya, Dolok Lubuk Raya, gunung api, Angkola Barat"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "-"@id ;
    ws:lintang "1.478"^^xsd:decimal ;
