data:ws-144 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-144"^^xsd:string ;
    ws:namaDestinasi "Museum Simalungun"@id ;
    ws:namaAlternatif "Rumah Pusaka Simalungun"@id ;
    ws:deskripsiSingkat "Museum daerah yang menyimpan koleksi budaya Simalungun."@id ;
    ws:deskripsiLengkap "Museum Simalungun adalah sebuah museum daerah yang berada di Jalan Sudirman Nomor 20, Kelurahan Proklamasi, Kecamatan Siantar Barat, Kota Pematangsiantar, Provinsi Sumatera Utara. Museum ini mulai dibangun pada bulan April tahun 1939 dan selesai dibangun pada bulan Desember pada tahun yang sama. Pembangunan museum bertujuan untuk melestarikan budaya Batak Simalungun seperti benda-benda cagar budaya yang bernilai sejarah. Museum Simalungun dikelola oleh Yayasan Museum Simalungun yang didirikan pada tanggal 27 September 1954 sesuai dengan akta notaris nomor 13 tahun 1954. Awalnya, museum Simalungun disebut sebagai Rumah Pusaka Simalungun. Museum ini merupakan hasil dari rapat Harungguan yang dihadiri oleh tokoh-tokoh penting di Kabupaten Simalungun pada tanggal 14 Januari 1937. Museum Simalungun menyimpan koleksi benda-benda etnografi dan arkeologi yang sangat erat kaitannya dengan kehidupan sehari-hari masyarakat Simalungun sebanyak 866 buah, antara lain patung batu Silapalapa dari zaman megalitik, Pustaha Laklak, peralatan rumah tangga, perhiasan emas dan perak, serta koin dan uang."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Simalungun, rumah pusaka Simalungun, Pematangsiantar, museum"@id ;
    ws:beradaDi "Kota Pematangsiantar"@id ;
    ws:alamat "Jalan Sudirman No.20, Kelurahan Proklamasi, Kecamatan Siantar Barat, Kota Pematangsiantar, Sumatera Utara"@id ;
    ws:lintang "2.954288"^^xsd:decimal ;
    ws:bujur "99.061083"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Sudirman Nomor 20, Kelurahan Proklamasi, Kecamatan Siantar Barat, Kota Pematangsiantar."@id ;
    ws:jamOperasional "Senin-Sabtu 08.00-17.00 WIB"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "(0622) 21954"^^xsd:string ;
    ws:emailResmi "" ;
    ws:instagramResmi ""^^xsd:anyURI ;
    ws:memilikiFasilitas ""@id ;
    ws:dapatMelakukan "Melihat koleksi budaya Simalungun"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Pasung_di_Museum_Simalungun.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.2"^^xsd:decimal .

data:ws-145 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-145"^^xsd:string ;
    ws:namaDestinasi "Museum Zoologi"@id ;
    ws:namaAlternatif "Museum Zoologi THPS"@id,
        "Zoological Museum Siantar"@id ;
    ws:deskripsiSingkat "Museum zoologi di kawasan Taman Hewan Pematangsiantar."@id ;
    ws:deskripsiLengkap "Museum Zoologi (dikenal juga sebagai Taman Hewan Pematang Siantar/THPS) adalah sebuah museum yang bertujuan untuk memajukan pengetahuan tentang keanekaragaman hayati, khususnya fauna, kepada masyarakat. Museum ini bertempat di Jl. Kapten Sitorus No. 10, Pematang Siantar, sebuah kota di Provinsi Sumatera Utara, Indonesia. Dr. Coonrad merupakan tokoh yang memprakarsai pendirian taman zoologi pertama di Kota Pematangsiantar. Pada bulan Juni 1956, di situs Taman Zoologi dan Botani yang didirikan oleh Dr. Coonrad, didirikan juga sebuah Museum Zoological oleh Prof. Dr. F. J. Nainggolan. Museum ini diresmikan oleh Rahmi Hatta, istri dari Wakil Presiden RI saat itu, Mohammad Hatta. Kebun Binatang Pematangsiantar merupakan kebun binatang keempat tertua di Indonesia yang masih bertahan, setelah Kebun Binatang Surabaya, Taman Margasatwa Budaya Kinantan di Bukittinggi, dan Kebun Binatang Bandung. Mulai tanggal 1 September 1996, pengelolaan Taman Hewan ini dialihkan kepada Bapak Rahmat Shah, dan namanya berubah menjadi Taman Hewan Pematang Siantar."@id ;
    ws:jenisDestinasi "Buatan"@id,
        "Budaya"@id ;
    ws:kataKunci "Museum Zoologi, Taman Hewan Pematangsiantar, fauna, museum"@id ;
    ws:beradaDi "Kota Pematangsiantar"@id ;
    ws:alamat "Jl. Kapten Sitorus No. 10, Kota Pematangsiantar, Sumatera Utara"@id ;
    ws:lintang "2.952577"^^xsd:decimal ;
    ws:bujur "99.059379"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di dalam kawasan Taman Hewan Pematangsiantar (THPS), Jl. Kapten Sitorus No. 10, Kota Pematangsiantar."@id ;
    ws:jamOperasional "Setiap hari 09.00-17.00 WIB"@id ;
    ws:hargaMasuk "35000"^^xsd:decimal ;
    ws:noHpResmi "" ;
