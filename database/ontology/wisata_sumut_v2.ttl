data:ws-240 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-240"^^xsd:string ;
    ws:namaDestinasi "Gunung Sibuatan"@id ;
    ws:namaAlternatif "Sibuatan"@id ;
    ws:deskripsiSingkat "Gunung setinggi 2.457 meter di Kabupaten Dairi yang menjadi salah satu puncak tertinggi di Sumatera Utara dan jalur pendakian populer."@id ;
    ws:deskripsiLengkap "Gunung Sibuatan berada di perbatasan Kecamatan Merek dan Kecamatan Sidikalang, Kabupaten Dairi, dengan ketinggian sekitar 2.457 meter di atas permukaan laut. Jalur pendakiannya melewati hutan tropis, kebun warga, dan area edelweis di bagian atas. Pendakian umumnya memakan waktu enam sampai delapan jam menuju puncak, yang menawarkan panorama perbukitan dan Danau Toba di kejauhan. Pengelolaan dilakukan bersama warga desa dengan biaya registrasi sekitar sepuluh ribu rupiah. Pendaki disarankan mendaftar di pos desa dan membawa logistik memadai."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Gunung Sibuatan, Dairi, Sidikalang, pendakian, puncak tertinggi Sumatera Utara"@id ;
