    ws:bujur "98.7735625"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di dalam Kota Sibolga; dari pusat kota ikuti Jalan Sisingamangaraja lalu masuk ke kawasan Simare-mare sekitar 2 km."@id ;
    ws:jamOperasional "Setiap hari 08.00-24.00"@id ;
