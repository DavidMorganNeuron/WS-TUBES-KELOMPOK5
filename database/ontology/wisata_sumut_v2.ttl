    ws:lintang "3.398720"^^xsd:decimal ;
    ws:bujur "98.688830"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, berkendara sekitar 45 menit ke arah Sibiru-biru melalui Jalan Jamin Ginting lalu masuk ke Desa Namo Suro Baru."@id ;
