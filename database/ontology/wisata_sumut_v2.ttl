    ws:idDestinasi "ws-132"^^xsd:string ;
    ws:namaDestinasi "Pemandian Alam Aek Buru"@id ;
    ws:namaAlternatif "Aek Buru"@id, "Pemandian Aek Buru"@id ;
    ws:deskripsiSingkat "Pemandian Alam Aek Buru di Labuhanbatu Utara adalah sungai beraliran jernih yang membelah struktur bebatuan tebing alam berukuran raksasa."@id ;
    ws:deskripsiLengkap "Tersembunyi di balik kawasan hutan Rantau Utara menuju Kabupaten Labuhanbatu Utara, Pemandian Alam Aek Buru menyuguhkan sensasi berenang di sungai yang terapit oleh dinding tebing batu cadas purba yang tinggi. Aliran air sungainya relatif tenang dan berwarna kehijauan layaknya cermin raksasa yang memantulkan kelebatan rimbunnya pepohonan di sekeliling. Daya tarik utama tempat ini tidak hanya kejernihan air sungainya yang segar, melainkan juga wahana pelompatan alami (cliff jumping) dari dinding tebing bagi pengunjung yang memiliki nyali besar dan gemar tantangan ekstrem."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Aek Buru"@id, "Labuhanbatu Utara"@id, "Wisata Sungai"@id, "Pemandian Alam"@id, "Labura"@id ;
    ws:beradaDi "Kabupaten Labuhanbatu Utara"@id ;
    ws:alamat "Desa Batu Tunggal, Kecamatan Na IX-X, Kabupaten Labuhanbatu Utara, Sumatera Utara 21454"@id ;
    ws:lintang "2.1411"^^xsd:decimal ;
    ws:bujur "99.7739"^^xsd:decimal ;
