data:ws-194 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-194"^^xsd:string ;
    ws:namaDestinasi "Pantai Batu Hoda"@id ;
    ws:namaAlternatif "Batu Hoda Beach"@id, "Pantai Batu Kuda"@id ;
    ws:deskripsiSingkat "Pantai di tepi Danau Toba dengan patung batu berbentuk kuda, terletak di Dusun Malau, Desa Cinta Dame, Kecamatan Simanindo, Kabupaten Samosir."@id ;
    ws:deskripsiLengkap "Pantai Batu Hoda terletak di Dusun Malau, Desa Cinta Dame, Kecamatan Simanindo, Kabupaten Samosir, sekitar 30 menit berkendara dari Pelabuhan Tomok. Nama Batu Hoda merujuk pada batu yang bentuknya menyerupai kuda dan dikaitkan dengan legenda kesetiaan seekor kuda milik warga setempat. Pantai berpasir putih ini menghadap perairan Danau Toba yang tenang, dilengkapi taman bermain anak, gazebo, toilet, dan area berkemah. Pengunjung bisa berenang di tepi danau, menyewa perahu, berfoto di antara ornamen batu, atau menginap di tenda dengan biaya tambahan."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Batu Hoda"@id, "Batu Hoda Beach"@id, "Cinta Dame"@id, "Simanindo"@id, "Samosir"@id, "Patung Batu Kuda"@id ;
