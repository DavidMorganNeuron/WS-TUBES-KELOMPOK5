        "Menikmati Pemandangan"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Sinabung.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-036 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-036"^^xsd:string ;
    ws:namaDestinasi "Gunung Sorik Marapi"@id ;
    ws:namaAlternatif "Sorik Marapi"@id ;
    ws:deskripsiSingkat "Gunung Sorik Marapi adalah gunung berapi aktif tipe strato setinggi 2.145 meter di atas permukaan laut yang terletak di Kabupaten Mandailing Natal, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Terletak di dalam kawasan Taman Nasional Batang Gadis, Gunung Sorik Marapi merupakan puncak tertinggi di wilayah Mandailing Natal yang menyimpan pesona vulkanik sekaligus cadangan energi panas bumi (geothermal) yang besar. Di bagian puncaknya yang indah, terdapat kawah aktif berdampingan dengan danau vulkanik unik bernama Danau Aek Cunik yang memiliki air tawar dan memantulkan tiga warna berbeda (kuning, hijau, dan kebiruan). Meski memiliki panorama alam yang memikat dan menjadi destinasi pendakian, gunung aktif normal ini juga memiliki sejarah aktivitas vulkanik serta fenomena gas beracun di sekitar kaki gunung seperti di Desa Sibanggor Julu."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Taman Nasional Batang Gadis"@id ;
    ws:beradaDi "Kabupaten Mandailing Natal"@id ;
    ws:alamat "Sibanggor Julu, Kecamatan Puncak Sorik Marapi, Kabupaten Mandailing Natal, Sumatera Utara"@id ;
    ws:lintang "0.6868582343067829"^^xsd:decimal ;
    ws:bujur "99.53908577369494"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Sibanggor Julu, Kecamatan Puncak Sorik Marapi, Kabupaten Mandailing Natal, dalam kawasan Taman Nasional Batang Gadis."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
