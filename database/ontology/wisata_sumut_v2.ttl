data:ws-124 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-124"^^xsd:string ;
    ws:namaDestinasi "Lembah Bakkara"@id ;
    ws:namaAlternatif "Bakkara"@id ;
    ws:deskripsiSingkat "Lembah Bakkara di pesisir barat daya Danau Toba merupakan wilayah epik nan subur yang dahulu menjadi pusat dinasti Raja Sisingamangaraja."@id ;
    ws:deskripsiLengkap "Dikelilingi tebing-tebing kaldera yang menjulang tinggi memagari dataran rendahnya, Lembah Bakkara (Bakti Raja) adalah kawasan strategis dan sakral yang memadukan keindahan agraris dengan kekuatan historis. Kawasan ini dihiasi hamparan sawah dan dilintasi oleh aliran deras Sungai Aek Silang dan Aek Simangira yang bermuara langsung ke perairan Toba. Sebagai pusat pemerintahan masa lalu Kerajaan Dinasti Sisingamangaraja, lembah ini menjadi rumah bagi Makam Raja Sisingamangaraja ke-I hingga ke-XI, serta sisa peninggalan Istana Tombak Sulu-sulu yang konon menjadi tempat bertapanya pahlawan nasional dari tanah Batak tersebut."@id ;
    ws:jenisDestinasi "Alam"@id, "Budaya"@id ;
    ws:kataKunci "Lembah Bakkara"@id, "Raja Sisingamangaraja"@id, "Bakti Raja"@id, "Humbang Hasundutan"@id, "Sejarah Batak"@id ;
