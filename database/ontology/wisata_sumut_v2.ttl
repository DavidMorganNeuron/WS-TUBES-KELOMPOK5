    ws:alamat "Komplek Cemara Asri, Jl. Cemara Boulevard Utara No.8, Medan Estate, Percut Sei Tuan, Deli Serdang, Sumatera Utara 20371"@id ;
    ws:lintang "3.637917"^^xsd:decimal ;
    ws:bujur "98.701306"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di dalam kawasan perumahan elit Cemara Asri."@id ;
    ws:jamOperasional "Setiap Hari 06.00-20.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "061-6633300"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/maha_vihara_maitreya?dlrf=NHJtb3JydzM3c3Vx"^^xsd:anyURI ;
