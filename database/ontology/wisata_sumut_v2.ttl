data:ws-242 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-242"^^xsd:string ;
    ws:namaDestinasi "Pos Bloc Medan"@id ;
    ws:namaAlternatif "Pos Blok Medan"@id ;
    ws:deskripsiSingkat "Ruang kreatif publik di gedung bekas kantor pos Jalan Kesawan, Kota Medan, yang memadukan kafe, galeri, dan acara seni."@id ;
    ws:deskripsiLengkap "Pos Bloc Medan menempati gedung bekas kantor pos di Jalan Kesawan, Kecamatan Medan Barat, Kota Medan. Bangunan peninggalan kolonial ini direvitalisasi menjadi ruang kreatif yang berisi kafe, toko produk lokal, ruang pameran, dan panggung acara. Arsitektur lengkung bangunan dipertahankan, sehingga menjadi latar foto yang populer. Kawasan ini tidak memungut tiket masuk; pengunjung hanya membayar konsumsi di tenant. Jam operasionalnya berbeda pada hari kerja dan akhir pekan, dan acara komunitas seperti pasar produk lokal biasanya digelar pada Sabtu dan Minggu."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "Pos Bloc Medan"@id, "Kesawan"@id, "Medan Barat"@id, "Ruang Kreatif"@id, "Gedung Pos"@id, "Kafe"@id ;
