data:ws-244 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-244"^^xsd:string ;
    ws:namaDestinasi "Pasar Ikan Lama"@id ;
    ws:namaAlternatif "Pajak Ikan Lama"@id ;
    ws:deskripsiSingkat "Pusat perdagangan kain dan pakaian legendaris di Jalan Perniagaan, Kelurahan Kesawan, Kota Medan."@id ;
    ws:deskripsiLengkap "Pasar Ikan Lama berada di Jalan Perniagaan, Kelurahan Kesawan, Kecamatan Medan Barat, Kota Medan, tidak jauh dari Tjong A Fie Mansion dan Lapangan Merdeka. Meski namanya merujuk pada pasar ikan, sejak puluhan tahun lalu kawasan ini beralih menjadi pusat penjualan kain, pakaian, dan oleh-oleh, dengan bangunan berderet di sepanjang gang beratap. Pengunjung dapat membeli kain Batak, bahan seragam, serta jajanan khas. Tidak ada tiket masuk; jam operasional umumnya sembilan pagi hingga enam sore, dan waktu terbaik berbelanja adalah pagi hingga siang."@id ;
    ws:jenisDestinasi "Kuliner"@id ;
    ws:kataKunci "Pasar Ikan Lama, Pajak Ikan Lama, Kesawan, Medan, wisata belanja, kain"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Perniagaan, Kel. Kesawan, Kec. Medan Barat, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.586800"^^xsd:decimal ;
    ws:bujur "98.680520"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di kawasan Kesawan; dari Lapangan Merdeka dapat ditempuh dengan berjalan kaki sekitar 10 menit."@id ;
    ws:jamOperasional "Setiap hari 09.00-18.00 WIB"@id ;
