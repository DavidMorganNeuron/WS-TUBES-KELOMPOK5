data:ws-222 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-222"^^xsd:string ;
    ws:namaDestinasi "Sipinsur"@id ;
    ws:namaAlternatif "Geosite Sipinsur"@id,
        "Wisata Sipinsur"@id ;
    ws:deskripsiSingkat "Geosite di Desa Pearung, Kecamatan Paranginan, Kabupaten Humbang Hasundutan, yang menawarkan panorama Danau Toba dari ketinggian 1.213 meter."@id ;
    ws:deskripsiLengkap "Sipinsur berada di Desa Pearung, Kecamatan Paranginan, Kabupaten Humbang Hasundutan, salah satu geosite Geopark Kaldera Toba. Dari ketinggian sekitar 1.213 meter di atas permukaan laut, pengunjung dapat melihat Danau Toba dan Pulau Samosir dengan latar hutan pinus. Kawasan ini dilengkapi jalur pejalan kaki, gazebo, spot foto, toilet, dan area parkir. Tiket masuk seribu rupiah per orang, sehingga menjadi salah satu destinasi termurah di kawasan Toba. Pagi hari memberi peluang terbaik untuk melihat danau tanpa kabut."@id ;
