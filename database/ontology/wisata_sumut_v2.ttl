data:ws-091 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-091"^^xsd:string ;
    ws:namaDestinasi "Danau Siais"@id ;
    ws:namaAlternatif "Danau Eksotis"@id ;
    ws:deskripsiSingkat "Danau Siais adalah danau terbesar kedua di Sumatera Utara yang kaya akan ikan purba misterius (ikan jurung) dan keindahan alam pegunungan di Tapanuli Selatan."@id ;
    ws:deskripsiLengkap "Berlokasi di Kecamatan Angkola Sangkunur, Danau Siais membentang seluas kurang lebih 4.500 hektare, menjadikannya danau terluas setelah Danau Toba di wilayah Sumatera Utara. Di danau ini hidup sekumpulan ikan jurung (ikan mera) yang dianggap keramat oleh penduduk setempat dan konon dilarang untuk ditangkap atau dimakan agar tidak mendatangkan kesialan. Selain wisata memandangi air danau yang membiru dan perbukitan hijau, pengunjung biasanya menyempatkan diri memberi makan ikan-ikan purba jinak tersebut dari tepian sungai Batang Toru yang bermuara di danau ini."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Siais"@id, "Ikan Jurung"@id, "Angkola Sangkunur"@id, "Tapanuli Selatan"@id, "Wisata Danau"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "Desa Rianiate, Kecamatan Angkola Sangkunur, Kabupaten Tapanuli Selatan, Sumatera Utara 22765"@id ;
    ws:lintang "1.2587"^^xsd:decimal ;
    ws:bujur "98.9839"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak sekitar 40 km dari pusat Kota Padang Sidempuan melintasi jalur Batang Toru."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Rumah Makan"@id, "Area Istirahat"@id ;
