data:ws-105 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-105"^^xsd:string ;
    ws:namaDestinasi "Danau Toba Parapat"@id ;
    ws:namaAlternatif "Pantai Bebas Parapat"@id, "Parapat"@id ;
    ws:deskripsiSingkat "Danau Toba Parapat di Simalungun adalah gerbang pariwisata utama, tersibuk, dan paling ikonik untuk mengakses keindahan danau vulkanik terbesar di dunia."@id ;
    ws:deskripsiLengkap "Sebagai kawasan sentral wisata berkelas internasional sejak dekade 1980-an, kota Parapat menyajikan paket lengkap pengalaman menikmati kemegahan Danau Toba dari daratan timur kaldera. Sepanjang tepian perairannya, seperti di Pantai Bebas dan Pesanggrahan Bung Karno, wisatawan tidak hanya bisa menyewa speedboat untuk mengelilingi tepian perairan atau berenang, melainkan juga menyeberang menuju Pulau Samosir melalui Pelabuhan Ajibata dan Tiga Raja. Deretan hotel mewah, pasar kerajinan tangan lokal yang semarak, hingga atraksi permainan air menjadikan Parapat surga peristirahatan liburan segala usia."@id ;
    ws:jenisDestinasi "Alam"@id, "Bahari"@id ;
    ws:kataKunci "Danau Toba"@id, "Parapat"@id, "Simalungun"@id, "Wisata Danau"@id, "Pelabuhan Ajibata"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Kecamatan Girsang Sipangan Bolon, Kabupaten Simalungun, Sumatera Utara 21174"@id ;
    ws:lintang "2.6547"^^xsd:decimal ;
    ws:bujur "98.9368"^^xsd:decimal ;
    ws:petunjukLokasi "Gerbang utama pariwisata Danau Toba dari Jalan Lintas Sumatera rute Pematangsiantar - Balige."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
