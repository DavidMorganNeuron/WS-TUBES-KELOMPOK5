data:ws-041 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-041"^^xsd:string ;
    ws:namaDestinasi "Kuil Shri Mariamman"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Kuil Shri Mariamman adalah kuil Hindu tertua di Petisah Tengah, Medan Petisah, Medan."@id ;
    ws:deskripsiLengkap "Berlokasi di kawasan Kampung Madras (Little India), Kuil Shri Mariamman merupakan kuil Hindu tertua di Sumatera Utara yang berdiri sejak tahun 1884 oleh komunitas awal etnis Tamil. Bangunan ini didedikasikan untuk memuja Dewi Mariamman, dewi yang diyakini masyarakat memiliki kekuatan menyembuhkan penyakit dan mendatangkan hujan. Dari segi arsitektur, kuil ini mengusung gaya Dravidia khas India Selatan yang ditandai dengan menara gopuram bertingkat di bagian pintu masuknya serta dihiasi patung-patung dewa-dewi beraneka warna. Selain berfungsi sebagai pusat kegiatan keagamaan umat Hindu—terutama saat perayaan besar seperti Deepavali dan Thaipusam—kuil ini juga menjadi simbol sejarah masuknya masyarakat keturunan India di Tanah Deli serta ikon kerukunan antarumat beragama di Kota Medan."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Kampung Madras"@id, "Kuil Hindu"@id, "Gopuram"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Teuku Umar No.18, Petisah Tengah, Kecamatan Medan Petisah, Kota Medan, Sumatera Utara 20151"@id ;
    ws:lintang "3.584105445597152"^^xsd:decimal ;
    ws:bujur "98.67116626750342"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Petisah Tengah, Kecamatan Medan Petisah, Kota Medan, di kawasan Kampung Madras."@id ;
    ws:jamOperasional "Setiap Hari 06.00-12.00 dan 16.00-20.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "081360311617" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/shriparameshwariammankuil"^^xsd:anyURI ;
