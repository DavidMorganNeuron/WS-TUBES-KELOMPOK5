data:ws-071 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-071"^^xsd:string ;
    ws:namaDestinasi "Maha Vihara Chong De"@id ;
    ws:namaAlternatif "Chong De Fo Yuan"@id ;
    ws:deskripsiSingkat "Maha Vihara Chong De adalah tempat ibadah umat Buddha yang megah di kawasan Medan Estate, Kabupaten Deli Serdang."@id ;
    ws:deskripsiLengkap "Maha Vihara Chong De (Chong De Fo Yuan) yang berdiri kokoh di Jalan Selamat Ketaren menawarkan arsitektur modern berpadu sentuhan tradisional Buddha yang memukau. Dengan pelataran yang bersih dan aula utama yang sangat luas, vihara ini tidak hanya berfungsi sebagai pusat kegiatan keagamaan dan meditasi, melainkan juga menyelenggarakan berbagai pelatihan pengembangan diri serta kelas-kelas dharma bagi generasi muda. Suasananya yang damai menjadikan vihara ini tempat yang sempurna untuk menenangkan pikiran dari hiruk pikuk perkotaan."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Maha Vihara Chong De"@id, "Chong De Fo Yuan"@id, "Medan Estate"@id ;
