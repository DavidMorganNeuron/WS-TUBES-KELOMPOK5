data:ws-250 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-250"^^xsd:string ;
    ws:namaDestinasi "Pantai Bulbul"@id ;
    ws:namaAlternatif "Pantai Lumban Bulbul"@id ;
    ws:deskripsiSingkat "Pantai pasir putih di tepi Danau Toba, Desa Lumban Bulbul, Kecamatan Balige, Kabupaten Toba, sekitar 3,7 kilometer dari pusat Balige."@id ;
    ws:deskripsiLengkap "Pantai Bulbul berada di Desa Lumban Bulbul, Kecamatan Balige, Kabupaten Toba, sekitar 3,7 kilometer dari pusat Kota Balige. Pantai di tepi Danau Toba ini berpasir putih dengan ornamen batak di sepanjang area, kolam dangkal yang aman untuk anak, serta penyewaan speed boat, banana boat, dan jet ski. Tersedia gazebo, warung makan, restoran, dan homestay di sekitarnya. Tiket masuk lima ribu rupiah per orang, dan kawasan ini terbuka sepanjang hari. Pengunjung biasanya datang sore hari untuk menikmati matahari terbenam di balik perbukitan."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Bulbul, Lumban Bulbul, Balige, Toba, pantai danau, pasir putih"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
