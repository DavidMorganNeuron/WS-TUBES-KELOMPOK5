data:ws-051 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-051"^^xsd:string ;
    ws:namaDestinasi "Museum Gereja Batak Karo Protestan"@id ;
    ws:namaAlternatif "Museum GBKP"@id ;
    ws:deskripsiSingkat "Museum Gereja Batak Karo Protestan (GBKP) adalah museum khusus di Kabupaten Deli Serdang yang menyimpan dan melestarikan dokumen sejarah penginjilan serta warisan budaya masyarakat Karo."@id ;
    ws:deskripsiLengkap "Terletak di kawasan Taman Jubileum 100 Tahun GBKP, Desa Sukamakmur, Kecamatan Sibolangit, Kabupaten Deli Serdang, museum ini berdiri sebagai wujud penghormatan atas sejarah panjang masuk dan berkembangnya agama Kristen di Tanah Karo sejak akhir abad ke-19. Peletakan batu pertama pembangunan museum ini dilakukan pada 30 Juli 1990, bertepatan dengan perayaan seabad masuknya Injil ke wilayah Karo (1890–1990) dan diresmikan secara resmi pada 11 Agustus 2007. Di dalam bangunannya, museum menyimpan ratusan koleksi bernilai tinggi yang mencakup bidang etnografi, arkeologi, sejarah, filologi, hingga keramik, termasuk replika rumah adat tradisional Karo yaitu Rumah Lesung."@id ;
    ws:jenisDestinasi "Budaya"@id, "Religi"@id ;
    ws:kataKunci "Gereja Batak Karo Protestan"@id, "Sejarah Gereja"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Jl. Jamin Ginting, Suka Makmur, Kecamatan Sibolangit, Kabupaten Deli Serdang, Sumatera Utara 20357"@id ;
    ws:lintang "3.283407066105397"^^xsd:decimal ;
    ws:bujur "98.54942008284543"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di kompleks Taman Jubelium 100 Tahun GBKP, Bandar Baru, Sibolangit, Kabupaten Deli Serdang."@id ;
    ws:jamOperasional "Rabu - Senin 09.00 - 17.00"@id ;
    ws:hargaMasuk "5000" ;
    ws:noHpResmi "081362637727"^^xsd:string ;
    ws:emailResmi "museum_gbkp@yahoo.co.id"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/museumgbkp"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Kolam Renang"@id, "Taman Bermain"@id ;
    ws:dapatMelakukan "Beribadah"@id, "Belajar"@id, "Berfoto"@id, "Menelusuri"@id, "Mengapresiasi"@id ;
