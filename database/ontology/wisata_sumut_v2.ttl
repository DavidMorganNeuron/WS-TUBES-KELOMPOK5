data:ws-029 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-029"^^xsd:string ;
    ws:namaDestinasi "Danau Toba"@id ;
    ws:namaAlternatif "Tao Toba"@id ;
    ws:deskripsiSingkat "Danau vulkanik terbesar di dunia, kaldera supervulkan Toba."@id ;
    ws:deskripsiLengkap "Danau Toba (Indonesia: Danau Toba, Batak Toba: ᯖᯀᯬ ᯖᯬᯅ; romanisasi: Tao Toba) adalah sebuah danau alami berukuran besar di Sumatera Utara dan Indonesia. Danau ini merupakan kaldera raksasa dari gunung berapi super Toba. Danau ini terletak di tengah bagian utara pulau Sumatra, dengan ketinggian permukaan sekitar 900 meter (2.953 ft), danau ini membentang dari 2.88°N 98.52°E﻿ / 2.88; 98.52 hingga 2.35°N 99.1°E﻿ / 2.35; 99.1. Danau ini memiliki panjang sekitar 100 kilometer (62 mil), lebar 30 kilometer (19 mi), dan kedalaman hingga 505 meter (1.657 ft). Danau Toba adalah danau terbesar di Indonesia dan danau vulkanik terbesar di dunia. Kaldera Toba adalah satu dari dua puluh geopark di Indonesia, dan diakui pada Juli 2020 sebagai salah satu UNESCO Global Geoparks. Danau Toba adalah lokasi letusan supervulkanik dengan perkiraan skala 8 pada VEI yang terjadi 69.000 hingga 77.000 tahun yang lalu, yang mengubah iklim bumi untuk sementara waktu. Kemajuan terbaru dalam metode penanggalan menunjukkan tanggal letusan yang lebih presisi, yaitu 74.000 tahun yang lalu. Letusan ini merupakan letusan eksplosif terbesar yang diketahui di Bumi dalam 25 juta tahun terakhir. Sebuah teori yang dikenal sebagai teori bencana Toba mendalilkan bahwa peristiwa ini membawa konsekuensi global bagi populasi manusia di Bumi. Karena letusan tersebut kemungkinan besar telah membunuh sebagian besar manusia beserta banyak makhluk lain yang hidup pada saat itu, teori ini menyarankan bahwa letusan itu bisa menjelaskan leher botol populasi yang terlihat di Afrika Timur bagian tengah dan India pada sekitar waktu tersebut. Kehilangan keragaman genetik yang dahsyat akan memengaruhi susunan genetik manusia di seluruh dunia, sehingga berdampak pada evolusi manusia hingga saat ini. Penelitian yang lebih baru meragukan teori ini, karena tidak ada bukti yang muncul tentang pengurangan populasi manusia dan fauna lainnya secara berkelanjutan pada waktu itu. Terdapat kemungkinan lain, termasuk pola migrasi, yang dapat menjelaskan penurunan yang tampak pada keragaman genetik manusia."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Toba"@id, "Tao Toba"@id, "Kaldera Toba"@id, "UNESCO Global Geopark"@id, "Vulkanik"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Jl. Siborongborong - Parapat, Sibaganding, Kecamatan Girsang Sipangan Bolon, Kabupaten Simalungun, Sumatera Utara 21174"@id ;
    ws:lintang "2.6967648484483937"^^xsd:decimal ;
    ws:bujur "98.92416232152277"^^xsd:decimal ;
    ws:petunjukLokasi "Terbentang di tengah bagian utara Pulau Sumatra pada ketinggian sekitar 900 mdpl; dapat dicapai melalui Kota Medan (sekitar 4-5 jam) menuju Parapat, Balige, atau Pangururan. Kawasan danau ini melintasi beberapa kabupaten; nilai beradaDi merujuk pada Kabupaten Toba sebagai wilayah inti dan gerbang wisata utama."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/danau_tobasamosir"^^xsd:anyURI ;
    ws:memilikiFasilitas "Rumah Makan"@id, "Penginapan"@id, "Tempat Wisata"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Berperahu"@id,
        "Menikmati panorama danau"@id,
        "Menjelajah desa wisata"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Danau_Toba_-_Sumut.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.6" .

data:ws-030 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-030"^^xsd:string ;
    ws:namaDestinasi "Fun & Fit Centre Point"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Fun & Fit Centre Point Medan adalah adventure park dalam ruangan pertama di Sumatra yang dirancang sebagai wahana bermain interaktif untuk segala usia, mulai dari balita hingga orang dewasa."@id ;
    ws:deskripsiLengkap "Destinasi rekreasi keluarga di bawah naungan Funworld ini menghadirkan lebih dari 11 spot wahana interaktif bertema dinamis dan futuristik. Pengunjung dapat menguji ketangkasan dan memacu adrenalin melalui fasilitas populer seperti Ninja Warrior Course, arena trampolin, panjat tebing (Wall Climbing), banteng kayuh (Rodeo Bull), hingga kolam bola raksasa dengan perosotan menantang. Dengan konsep inklusif yang ramah untuk anak-anak maupun orang dewasa, taman bermain dalam ruangan ini menjadi pilihan populer warga kota Medan untuk rekreasi aktif yang menyehatkan sekaligus tempat berburu foto yang estetik."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "-"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Timor No.8, Gg. Buntu, Kecamatan Medan Timur, Kota Medan, Sumatera Utara 20232"@id ;
    ws:lintang "3.5923586282373114"^^xsd:decimal ;
    ws:bujur "98.68077335400976"^^xsd:decimal ;
    ws:petunjukLokasi ""@id ;
    ws:jamOperasional ""@id ;
    ws:hargaMasuk "" ;
    ws:noHpResmi "" ;
    ws:emailResmi "" ;
    ws:instagramResmi ""^^xsd:anyURI ;
    ws:memilikiFasilitas ""@id ;
    ws:dapatMelakukan "Beribadah"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/HKBP_Aek_Dakka%2C_Tapanuli_Tengah_2.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "5.0"^^xsd:decimal .

data:ws-031 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-031"^^xsd:string ;
    ws:namaDestinasi "Funworld Deli Park Podomoro City Medan"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Funworld Delipark Podomoro City Medan adalah pusat hiburan keluarga modern yang menghadirkan beragam pilihan permainan arkade, wahana seru, hingga teknologi virtual reality (VR) di tengah Kota Medan."@id ;
    ws:deskripsiLengkap "Funworld (termasuk konsep modern seperti Funworld Frenzy dan Funworld Adventure) menawarkan pengalaman rekreasi indoor yang luas dan lengkap untuk semua kalangan, mulai dari anak-anak hingga orang dewasa. Di sini, pengunjung dapat menikmati berbagai mesin permainan arkade kekinian, wahana keluarga seperti kereta mini dan komedi putar, hingga area softplay yang aman bagi anak-anak. Daya tarik utamanya meliputi teknologi virtual reality (VR) seperti VR Paraglider yang memicu adrenalin, serta berbagai zona modern berteknologi tinggi."@id ;
    ws:jenisDestinasi "Buatan"@id ;
