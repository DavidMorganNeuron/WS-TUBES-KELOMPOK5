data:ws-139 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-139"^^xsd:string ;
    ws:namaDestinasi "Gua Togi Ndrawa"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Tögi Ndrawa adalah sebuah gua yang terletak di Nias."@id ;
    ws:deskripsiLengkap "Tögi Ndrawa adalah sebuah gua yang terletak di Nias. Gua ini memiliki jejak peninggalan orang Nias sejak 12.000 tahun lalu. Letaknya berada di Desa Lolowonu Niko'otano, Gunungsitoli. Sejarah Mitos Menurut masyarakat sekitar, gua ini disebut Tögi Ndrawa karena gua ini sebelumnya merupakan tempat persembunyian pendatang atau orang asing, ada juga diartikan yang beragama Islam, Hindu, Budha, dan lain-lain (oleh orang Nias disebut Ndrawa) pada masa pendudukan Jepang di Nias. Ada juga versi lain yang menyatakan bahwa gua ini merupakan tempat persembunyian orang Nias pada masa datangnya Niha Dawa (orang asing) ke daerah tersebut."@id ;
    ws:jenisDestinasi "Alam"@id ;
