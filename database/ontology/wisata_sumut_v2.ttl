data:ws-129 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-129"^^xsd:string ;
    ws:namaDestinasi "Museum Uang Sumatra"@id ;
    ws:namaAlternatif ""@id ;
    ws:deskripsiSingkat "Museum Uang Sumatera adalah museum uang pertama yang ada di Sumatra yang diresmikan pada tanggal 2 Mei 2017 oleh Gubernur Sumatera Utara."@id ;
    ws:deskripsiLengkap "Museum Uang Sumatera adalah museum uang pertama yang ada di Sumatra yang diresmikan pada tanggal 2 Mei 2017 oleh Gubernur Sumatera Utara. Museum ini awalnya terletak di lantai 2 Gedung Juang 45 Sumatera Utara. Kini museum ini beralih lokasi di Kantor Bupati Aceh Jaya, Aceh. Museum ini didirikan oleh Saparudin Barus yang merupakan kolektor uang yang peduli dengan sejarah uang Indonesia dan memberikan edukasi pada masyarakat. Koleksi Beberapa koleksi koin kesultanan diantaranya adalah koin Kesultanan Aceh, koin Kesultanan Deli, koin Kerajaan Batubara, koin Kesultanan Siak Sri Indrapura, koin Kerajaan Samudera Pasai, koin Kesultanan Palembang, koin Kesultanan Banten, koin Kesultanan Demak, koin Majapahit, koin Kesultanan Gowa, serta koleksi token perkebunan Sumatra dan uang ORIDA dari berbagai daerah."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Uang Sumatera, numismatik, sejarah uang, Gedung Juang 45, Medan"@id ;
    ws:beradaDi "Kota Medan"@id ;
