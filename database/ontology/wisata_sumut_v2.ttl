@prefix ws:    <http://pariwisatasumut.org/ontology/v2#> .
@prefix data:  <http://pariwisatasumut.org/resource/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ws: a owl:Ontology ;
    rdfs:label "Struktur Data Destinasi Wisata Sumatera Utara"@id ;
    owl:versionInfo "2.1.0" .

ws:DestinasiWisata a owl:Class ;
    rdfs:label "Destinasi wisata"@id .

ws:idDestinasi a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ID destinasi"@id ;
    rdfs:comment "ID stabil yang dibuat untuk membedakan destinasi. IRI resource juga menjadi identitas RDF-nya."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:string .

ws:namaDestinasi a owl:DatatypeProperty ;
    rdfs:label "Nama destinasi"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:namaAlternatif a owl:DatatypeProperty ;
    rdfs:label "Nama alternatif"@id ;
    rdfs:comment "Boleh berisi lebih dari satu nama, alias, atau ejaan alternatif."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:deskripsiSingkat a owl:DatatypeProperty ;
    rdfs:label "Deskripsi singkat"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:deskripsiLengkap a owl:DatatypeProperty ;
    rdfs:label "Deskripsi lengkap"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:jenisDestinasi a owl:DatatypeProperty ;
    rdfs:label "Jenis destinasi"@id ;
    rdfs:comment "Gunakan satu atau lebih nilai berikut: Alam, Budaya, Religi, Bahari, Kuliner, Buatan. Alam: gunung, hutan, air terjun, dan keindahan alam. Budaya: sejarah, tradisi, seni, dan kehidupan masyarakat lokal. Religi: tujuan keagamaan. Bahari: laut dan pantai. Kuliner: pengalaman makan dengan daya tarik suasana atau pemandangan. Buatan: atraksi ciptaan manusia seperti taman hiburan, resort, atau spot foto."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:kataKunci a owl:DatatypeProperty ;
    rdfs:label "Kata kunci"@id ;
    rdfs:comment "Boleh berisi lebih dari satu kata atau frasa untuk pencarian."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:beradaDi a owl:DatatypeProperty ;
    rdfs:label "Berada di"@id ;
    rdfs:comment "Wilayah administratif destinasi, minimal nama kabupaten atau kota."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:alamat a owl:DatatypeProperty ;
    rdfs:label "Alamat"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:lintang a owl:DatatypeProperty ;
    rdfs:label "Lintang"@id ;
    rdfs:comment "Koordinat lintang WGS 84 dalam derajat desimal, rentang -90 sampai 90."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

ws:bujur a owl:DatatypeProperty ;
    rdfs:label "Bujur"@id ;
    rdfs:comment "Koordinat bujur WGS 84 dalam derajat desimal, rentang -180 sampai 180."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

ws:petunjukLokasi a owl:DatatypeProperty ;
    rdfs:label "Petunjuk lokasi"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:jamOperasional a owl:DatatypeProperty ;
    rdfs:label "Jam operasional"@id ;
    rdfs:comment "Simpan sebagai teks, misalnya Senin-Minggu 08.00-17.00 WIB. Jangan mengisi jam yang tidak diketahui."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:hargaMasuk a owl:DatatypeProperty ;
    rdfs:label "Harga masuk"@id ;
    rdfs:comment "Nilai angka dalam Rupiah. Jika harga berbeda menurut jenis tiket, tuliskan rinciannya dalam nilai properti ini."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

ws:noHpResmi a owl:DatatypeProperty ;
    rdfs:label "Nomor HP resmi"@id ;
    rdfs:comment "Nomor kontak resmi yang dipublikasikan untuk umum."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:string .

ws:emailResmi a owl:DatatypeProperty ;
    rdfs:label "Email resmi"@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:string .

ws:instagramResmi a owl:DatatypeProperty ;
    rdfs:label "Instagram resmi"@id ;
    rdfs:comment "URL profil Instagram resmi destinasi atau pengelolanya."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:anyURI .

ws:memilikiFasilitas a owl:DatatypeProperty ;
    rdfs:label "Memiliki fasilitas"@id ;
    rdfs:comment "Boleh berisi lebih dari satu fasilitas, misalnya parkir, toilet, atau musala."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:dapatMelakukan a owl:DatatypeProperty ;
    rdfs:label "Dapat melakukan"@id ;
    rdfs:comment "Boleh berisi lebih dari satu aktivitas, misalnya berenang, mendaki, atau berkemah."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range rdf:langString .

ws:memilikiMedia a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "Memiliki media"@id ;
    rdfs:comment "Satu URL foto destinasi."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:anyURI .

ws:ratingPengunjung a owl:DatatypeProperty ;
    rdfs:label "Rating pengunjung"@id ;
    rdfs:comment "Nilai rating sesuai skala pada sumber data. Jangan mengarang rating jika tidak tersedia."@id ;
    rdfs:domain ws:DestinasiWisata ;
    rdfs:range xsd:decimal .

data:ws-001 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-001"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Bolon"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air Terjun Bolon atau dikenal dengan julukan Air Terjun Turbo adalah sebuah air terjun yang terletak di Desa Tomuan Holbung, Kabupaten Asahan, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Air Terjun Bolon atau dikenal dengan julukan Air Terjun Turbo adalah sebuah air terjun yang terletak di Desa Tomuan Holbung, Kabupaten Asahan, Sumatera Utara. Sumber air terjun ini berasal dari air yang keluar dari cela-cela di antara tebing yang tercepit batu dan memiliki debit air yang sangat besar dan deras. Air terjun ini memiliki ketinggian sekitar seratus meter. Air terjun ini dikelilingi oleh tebing-tebing di sekitar air terjun yang diselimuti oleh lumut dan pepohonan hijau yang subur, menambah keasrian dan kesejukan suasana. Di bawah air terjun terdapat kolam alami yang cukup dalam dengan air yang jernih. Untuk mencapai Air Terjun Turunan Bolon, pengunjung harus menempuh perjalanan trekking yang cukup menantang selama kurang lebih 2 jam dari desa terdekat. Jalur trekkingnya masih belum terlalu bagus dan cukup licin, sehingga membutuhkan kehati-hatian ekstra."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "air terjun Bolon, Air Terjun Turbo, Tomuan Holbung"@id ;
    ws:beradaDi "Kabupaten Asahan"@id ;
    ws:alamat "-"@id ;
    ws:lintang "2.713693"^^xsd:decimal ;
    ws:bujur "99.148157"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Tomuan Holbung, Kabupaten Asahan, sekitar 200 km dari Kota Medan."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "menikmati pemandangan air terjun"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:memilikiMedia "-"^^xsd:anyURI ;
    ws:ratingPengunjung "-" .

