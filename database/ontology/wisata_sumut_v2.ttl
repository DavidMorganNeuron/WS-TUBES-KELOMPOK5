data:ws-070 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-070"^^xsd:string ;
    ws:namaDestinasi "Klenteng Kera Sakti"@id ;
    ws:namaAlternatif "Kera Sakti Vihara"@id ;
    ws:deskripsiSingkat "Klenteng Kera Sakti di Deli Tua merupakan rumah ibadah umat Tridharma yang memiliki arsitektur khas bergaya oriental dengan ornamen patung pahlawan mitologi Sun Wukong."@id ;
    ws:deskripsiLengkap "Terletak di wilayah Deli Tua Barat, Kabupaten Deli Serdang, Klenteng Kera Sakti memancarkan nuansa spiritualitas sekaligus keindahan seni bangunan khas Tiongkok. Tempat ibadah ini dipersembahkan untuk menghormati Dewa Kera (Sun Wukong) yang melambangkan kecerdikan dan kekuatan dalam mitologi klasik. Dikelilingi oleh lingkungan yang tenang, klenteng ini menjadi pusat kegiatan ritual rutin serta festival-festival perayaan umat Buddha dan Konghucu, sekaligus menarik perhatian wisatawan yang ingin menyaksikan langsung detail ukiran dan warna merah-emas yang mendominasi bangunannya."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Klenteng Kera Sakti"@id, "Tridharma"@id, "Deli Tua"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Deli Tua Barat, Kecamatan Deli Tua, Kabupaten Deli Serdang, Sumatera Utara 20355"@id ;
    ws:lintang "3.475926"^^xsd:decimal ;
    ws:bujur "98.698125"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di jalan utama Deli Tua Barat, mudah diakses dari pusat Kota Medan ke arah selatan."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
