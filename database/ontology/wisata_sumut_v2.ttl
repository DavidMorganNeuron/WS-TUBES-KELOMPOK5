data:ws-094 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-094"^^xsd:string ;
    ws:namaDestinasi "Pulau Mursala"@id ;
    ws:namaAlternatif "Air Terjun Pulau Mursala"@id ;
    ws:deskripsiSingkat "Pulau Mursala adalah pulau eksotis yang terkenal berkat keunikan air terjun air tawar yang jatuh langsung ke perairan laut dangkal."@id ;
    ws:deskripsiLengkap "Terletak di Samudra Hindia sebelah barat pesisir Tapanuli Tengah, Pulau Mursala menyimpan fenomena geologis yang sangat langka di dunia, yaitu air terjun yang alirannya tumpah tepat di atas permukaan laut asin. Air terjun ini bersumber dari sungai bawah tanah di perbukitan granit pulau dan mengalir deras pada tebing setinggi lebih dari 30 meter. Tempat ini mulai mendunia sejak dijadikan salah satu lokasi syuting film Hollywood 'King Kong' (2005) arahan Peter Jackson, menjadikannya surga bagi wisata jelajah pulau, fotografi, dan snorkeling melingkari tebing-tebing raksasanya."@id ;
    ws:jenisDestinasi "Alam"@id, "Bahari"@id ;
    ws:kataKunci "Pulau Mursala"@id, "Air Terjun Laut"@id, "King Kong"@id, "Tapanuli Tengah"@id, "Wisata Pulau"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Kecamatan Tapian Nauli, Kabupaten Tapanuli Tengah, Sumatera Utara"@id ;
    ws:lintang "1.6366"^^xsd:decimal ;
    ws:bujur "98.5303"^^xsd:decimal ;
    ws:petunjukLokasi "Dapat dijangkau menggunakan perahu atau speedboat sewaan dari Pantai Pandan atau Sibolga (sekitar 1-2 jam laut)."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
