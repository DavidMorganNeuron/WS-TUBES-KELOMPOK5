data:ws-096 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-096"^^xsd:string ;
    ws:namaDestinasi "Makam Mahligai"@id ;
    ws:namaAlternatif "Kompleks Makam Mahligai"@id ;
    ws:deskripsiSingkat "Makam Mahligai adalah situs makam kuno ulama penyebar Islam abad ke-7 asal Timur Tengah yang berada di perbukitan Barus."@id ;
    ws:deskripsiLengkap "Kompleks pemakaman Mahligai seluas 3 hektare ini didirikan di atas perbukitan Desa Aek Dakka sejak abad ke-7 Masehi, tepatnya di masa kekhalifahan sahabat Nabi. Makam-makam di kawasan ini ditandai dengan nisan-nisan batu andesit bertuliskan kaligrafi Arab kuno maupun aksara Parsi yang mulai memudar termakan zaman. Tokoh paling terkenal yang disemayamkan di sini adalah Syekh Rukunuddin yang wafat pada tahun 672 M, menjadikan lokasi ini tujuan ziarah tingkat nasional maupun internasional yang rutin dipadati ribuan umat Islam pada bulan-bulan tertentu."@id ;
    ws:jenisDestinasi "Religi"@id, "Budaya"@id ;
    ws:kataKunci "Makam Mahligai"@id, "Barus"@id, "Wisata Religi Islam"@id, "Tapanuli Tengah"@id, "Syekh Rukunuddin"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
