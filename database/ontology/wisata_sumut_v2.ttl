data:ws-130 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-130"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Lae Une"@id ;
    ws:namaAlternatif "Sampuran Lae Une"@id, "Air Terjun Laeune"@id ;
    ws:deskripsiSingkat "Air Terjun Lae Une merupakan ikon pesona alam perawan Kabupaten Pakpak Bharat yang airnya mengalir deras melintasi struktur tebing berundak."@id ;
    ws:deskripsiLengkap "Air Terjun Lae Une menyajikan deburan air pegunungan yang sangat dingin dengan ketinggian jatuhan kurang lebih 10 meter. Meski tidak terlampau tinggi, kekuatan arusnya cukup besar karena debit air bertumpu pada kolam alami bundar dan membelah undakan batuan andesit kehitaman yang kokoh. Terletak cukup dekat dari pusat pemerintahan daerah, air terjun ini dikelilingi hutan hujan sekunder yang masih banyak dihuni oleh kera liar. Keasrian dan udaranya yang kaya oksigen menjadikan tempat ini ideal untuk sekadar piknik keluarga melepas penat di akhir minggu."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Lae Une"@id, "Pakpak Bharat"@id, "Wisata Alam"@id, "Salak"@id ;
    ws:beradaDi "Kabupaten Pakpak Bharat"@id ;
    ws:alamat "Desa Kecupak I, Kecamatan Pergetteng-Getteng Sengkut, Kabupaten Pakpak Bharat, Sumatera Utara 22272"@id ;
    ws:lintang "2.5521037"^^xsd:decimal ;
    ws:bujur "96.4409698"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak hanya beberapa kilometer dari pusat kota Salak, ibu kota Pakpak Bharat."@id ;
