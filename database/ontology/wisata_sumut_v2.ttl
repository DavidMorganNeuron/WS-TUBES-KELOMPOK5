data:ws-135 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-135"^^xsd:string ;
    ws:namaDestinasi "Tugu Juang 45 Rantauprapat"@id ;
    ws:namaAlternatif "Tugu Juang 45"@id, "Tugu Juang Labuhanbatu"@id ;
    ws:deskripsiSingkat "Tugu Juang 45 Rantauprapat merupakan monumen sejarah revolusi kemerdekaan berskala besar yang menjadi ruang publik (alun-alun) kebanggaan warga Labuhanbatu."@id ;
    ws:deskripsiLengkap "Monumen ikonis berbentuk pilar tinggi dengan patung sekelompok prajurit yang mengangkat senjata dan bambu runcing ini didirikan untuk menghormati perlawanan sengit pahlawan lokal terhadap agresi militer Belanda di tanah Labuhanbatu. Berada di pusat persimpangan jalur utama Rantauprapat, kawasan Tugu Juang 45 ini dilengkapi dengan plaza luas, area rerumputan hijau, bangku taman, dan air mancur yang dihidupkan pada malam hari. Lokasi ini senantiasa ramai dikunjungi keluarga pada sore dan malam hari untuk bersantai, berolahraga, maupun menikmati beragam jajanan pedagang kaki lima."@id ;
    ws:jenisDestinasi "Budaya"@id, "Buatan"@id ;
    ws:kataKunci "Tugu Juang 45"@id, "Rantauprapat"@id, "Labuhanbatu"@id, "Monumen Sejarah"@id, "Ruang Publik"@id ;
    ws:beradaDi "Kabupaten Labuhanbatu"@id ;
    ws:alamat "Jalan H.M. Thamrin, Rantauprapat, Kecamatan Rantau Utara, Kabupaten Labuhanbatu, Sumatera Utara 21411"@id ;
    ws:lintang "3.6007267"^^xsd:decimal ;
    ws:bujur "98.6768193"^^xsd:decimal ;
    ws:petunjukLokasi "Berada persis di tengah-tengah persimpangan segitiga utama Rantauprapat."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
