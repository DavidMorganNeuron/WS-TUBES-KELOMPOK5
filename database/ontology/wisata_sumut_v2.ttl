data:ws-214 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-214"^^xsd:string ;
    ws:namaDestinasi "Pantai Garoga Tigaras"@id ;
    ws:namaAlternatif "Garoga Beach"@id, "Permandian Pantai Garoga"@id ;
    ws:deskripsiSingkat "Pantai di tepi Danau Toba kawasan Tigaras, Kecamatan Dolok Pardamean, Kabupaten Simalungun, yang juga berfungsi sebagai pemandian."@id ;
    ws:deskripsiLengkap "Pantai Garoga berada di Jalan Besar Tigaras, Kecamatan Dolok Pardamean, Kabupaten Simalungun, di tepi Danau Toba dekat pelabuhan penyeberangan menuju Samosir. Kawasan ini dikelola desa dan mulai beroperasi sekitar 2010 sebagai permandian pantai. Pengunjung dikenakan tiket masuk sepuluh ribu rupiah; sewa pondok dan parkir dihitung terpisah. Fasilitasnya mencakup gazebo, pondok lesehan, toilet, dan area parkir. Air danau di bagian ini landai sehingga ramah anak, dan pengunjung dapat menyewa perahu atau menikmati ikan bakar di warung sekitar."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Garoga"@id, "Tigaras"@id, "Dolok Pardamean"@id, "Simalungun"@id, "Danau Toba"@id, "Permandian"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Jl. Besar Tigaras, Garoga, Kec. Dolok Pardamean, Kab. Simalungun, Sumatera Utara"@id ;
    ws:lintang "2.798590"^^xsd:decimal ;
    ws:bujur "98.787740"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di tepi Jalan Besar Tigaras, sekitar 1 km dari Pelabuhan Tigaras yang menyeberang ke Samosir."@id ;
    ws:jamOperasional "Senin-Jumat 09.00-17.00, Sabtu-Minggu 08.00-17.00"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "081264628988"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/pantai_garoga_tigaras"^^xsd:anyURI ;
