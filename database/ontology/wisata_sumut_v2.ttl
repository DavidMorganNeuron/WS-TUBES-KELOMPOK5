data:ws-033 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-033"^^xsd:string ;
    ws:namaDestinasi "Gunung Sibayak"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Gunung Sibayak adalah gunung berapi stratovolcano aktif setinggi 2.212 mdpl di Kabupaten Karo, Sumatera Utara, yang dijuluki sebagai Gunung Raja oleh masyarakat setempat."@id ;
    ws:deskripsiLengkap "Terletak sekitar 50 kilometer barat daya Kota Medan, Gunung Sibayak merupakan destinasi vulkanik ikonik yang terakhir kali mengalami letusan pada tahun 1881. Dalam bahasa Karo, kata Sibayak memiliki arti raja, sehingga gunung ini kerap disebut sebagai Gunung Raja. Dikenal sangat ramah bagi pendaki pemula, jalur menuju puncaknya dapat ditempuh dalam waktu sekitar 1 hingga 2 jam saja dari titik awal seperti Desa Jaranguda atau Desa Semangat Gunung. Di area puncaknya yang menyerupai kepala kuda—disebut Takal Kuda—pengunjung disuguhkan kawah aktif yang mengeluarkan uap solfatara dan aroma belerang khas, serta pemandangan megah ke arah Gunung Sinabung di kejauhan. Selain pendakian, kawasan kaki gunung ini terkenal dengan pemandian air panas alami belerang seperti di Lau Sidebuk-Debuk.:"@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Gunung Sibayak"@id, "Gunung Raja"@id, "Gunung Berapi"@id, "Karo"@id, "Berastagi"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jaranguda, Kecamatan Merdeka, Kabupaten Karo, Sumatera Utara"@id ;
    ws:lintang "3.2392185529768365"^^xsd:decimal ;
    ws:bujur "98.50490200429391"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di perbatasan Kabupaten Karo dan Kabupaten Deli Serdang, sekitar 65 km di barat daya Kota Medan (dekat Berastagi)."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "081275496779" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/gunungsibayakofficial"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Rumah Makan"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Mendaki"@id,
        "Berkemah"@id,
