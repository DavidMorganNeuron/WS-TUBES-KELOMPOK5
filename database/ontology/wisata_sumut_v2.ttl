data:ws-107 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-107"^^xsd:string ;
    ws:namaDestinasi "Pantai Lumban Bulbul"@id ;
    ws:namaAlternatif "Pantai Bulbul Balige"@id, "Pantai Bulbul"@id ;
    ws:deskripsiSingkat "Pantai Lumban Bulbul merupakan objek wisata tepi Danau Toba berpasir putih yang dangkal dengan ombak tenang di pinggiran kota Balige."@id ;
    ws:deskripsiLengkap "Berbeda dengan pesisir Danau Toba di Parapat yang cenderung berbatu, Pantai Lumban Bulbul menawarkan hamparan pasir putih bersih layaknya pesisir lautan sungguhan. Kontur air danaunya yang sangat landai menjadikannya destinasi wisata keluarga yang sangat aman bagi anak-anak untuk berenang. Di sepanjang kawasan pantai ini telah disediakan berbagai arena permainan air, penyewaan ban, banana boat, serta pondok-pondok kuliner terapung dan fasilitas spot berfoto kekinian dengan latar belakang perbukitan hijau Pulau Samosir dari kejauhan."@id ;
    ws:jenisDestinasi "Alam"@id, "Bahari"@id ;
    ws:kataKunci "Pantai Lumban Bulbul"@id, "Pantai Bulbul"@id, "Balige"@id, "Toba"@id, "Pasir Putih"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Desa Lumban Bulbul, Kecamatan Balige, Kabupaten Toba, Sumatera Utara 22312"@id ;
    ws:lintang "2.343889"^^xsd:decimal ;
    ws:bujur "99.071944"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak sekitar 2 kilometer saja dari pusat keramaian kota Balige."@id ;
    ws:jamOperasional "Setiap Hari 07.00-18.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "pokdarwislumbanbulbul@gmail.com"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
