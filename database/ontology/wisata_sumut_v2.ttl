data:ws-073 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-073"^^xsd:string ;
    ws:namaDestinasi "Masjid Agung Deli Serdang"@id ;
    ws:namaAlternatif "Masjid Agung Sultan Thaf Sinar Basarsyah"@id ;
    ws:deskripsiSingkat "Masjid Agung Deli Serdang adalah ikon kebanggaan religius dan arsitektural yang berlokasi di kompleks pusat pemerintahan Kabupaten Deli Serdang, Lubuk Pakam."@id ;
    ws:deskripsiLengkap "Diresmikan sebagai rumah ibadah utama di Kabupaten Deli Serdang, masjid ini menampilkan kemegahan arsitektur modern berpadu dengan ciri khas ornamen Melayu yang sangat kental. Bangunan ini memiliki menara yang menjulang tinggi, hamparan ruang salat yang luas dengan kaligrafi indah, serta pelataran yang sangat lapang. Selain menjadi pusat aktivitas keagamaan, masjid ini sering dimanfaatkan warga sebagai ruang publik untuk bersantai pada sore hari berkat area halamannya yang tertata bersih dan asri."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Masjid Agung Deli Serdang"@id, "Lubuk Pakam"@id, "Deli Serdang"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Jl. Lintas Sumatera, Petapahan, Kecamatan Lubuk Pakam, Kabupaten Deli Serdang, Sumatera Utara 20518"@id ;
    ws:lintang "3.551445"^^xsd:decimal ;
    ws:bujur "98.869484"^^xsd:decimal ;
    ws:petunjukLokasi "Berada tepat di pinggir Jalan Lintas Sumatera di kawasan pusat perkantoran Pemkab Deli Serdang."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
