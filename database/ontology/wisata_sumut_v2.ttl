data:ws-099 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-099"^^xsd:string ;
    ws:namaDestinasi "Salib Kasih Tarutung"@id ;
    ws:namaAlternatif "Salib Kasih Siatas Barita"@id, "Monumen Salib Kasih"@id ;
    ws:deskripsiSingkat "Salib Kasih Tarutung adalah monumen religi berbentuk salib raksasa di puncak bukit Siatas Barita untuk mengenang perjalanan penyebaran agama Kristen di Tanah Batak."@id ;
    ws:deskripsiLengkap "Monumen Salib Kasih menjulang setinggi 30 meter di atas Bukit Dolok Siatas Barita, dibangun pada 1993 untuk mengenang jasa penginjil asal Jerman, Dr. I.L. Nommensen, yang pertama kali memandang ke arah Lembah Silindung dari titik ini pada tahun 1863. Kawasan wisata rohani yang sangat sejuk ini dilengkapi dengan trek pendakian jalan setapak yang ditumbuhi pohon pinus, tempat duduk berbentuk amfiteater untuk ibadah luar ruang (kebaktian), dan pilar-pilar tempat berdoa. Pengunjung sering menggantungkan tulisan doa pada pohon-pohon di sekitar lokasi sebagai simbol harapan spiritual."@id ;
    ws:jenisDestinasi "Religi"@id, "Budaya"@id ;
    ws:kataKunci "Salib Kasih"@id, "Tarutung"@id, "Tapanuli Utara"@id, "Wisata Rohani"@id, "Nommensen"@id ;
    ws:beradaDi "Kabupaten Tapanuli Utara"@id ;
    ws:alamat "Simorangkir Julu, Kecamatan Siatas Barita, Kabupaten Tapanuli Utara, Sumatera Utara 22417"@id ;
    ws:lintang "1.9961"^^xsd:decimal ;
    ws:bujur "98.9772"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak sekitar 2 kilometer di selatan pusat kota Tarutung."@id ;
    ws:jamOperasional "Setiap Hari 07.00-18.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "087749263369"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
