data:ws-140 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-140"^^xsd:string ;
    ws:namaDestinasi "Pantai Lagundri"@id ;
    ws:namaAlternatif "Lagundri Beach"@id, "Pantai Lagundri Nias"@id ;
    ws:deskripsiSingkat "Pantai Lagundri adalah teluk pantai pasir putih primadona di Samudra Hindia yang merupakan saudara kembar Pantai Sorake di ujung Nias Selatan."@id ;
    ws:deskripsiLengkap "Berbeda dengan Pantai Sorake yang letaknya saling berdampingan dan ombaknya ganas khusus bagi peselancar profesional, Pantai Lagundri di sisi teluk menawarkan perairan yang relatif lebih tenang di garis tepiannya karena terlindung formasi daratan teluk kecil. Hal ini menjadikannya lokasi liburan sempurna bagi peselancar tingkat pemula maupun keluarga yang ingin berjemur. Garis pantainya dihiasi ratusan pohon kelapa khas pesisir khatulistiwa dan terumbu karang yang melandai, disemarakkan oleh banyaknya kedai makanan dan bar lokal yang melayani turis kulit putih di sore hari."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Lagundri"@id, "Nias Selatan"@id, "Surfing Nias"@id, "Wisata Bahari"@id, "Lagundri Beach"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Desa Lagundri, Kecamatan Luahagundre Maniamolo, Kabupaten Nias Selatan, Sumatera Utara 22865"@id ;
    ws:lintang "0.5755"^^xsd:decimal ;
    ws:bujur "97.7411"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak bersebelahan dengan Pantai Sorake, kurang lebih 12 km dari Kota Teluk Dalam."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Penginapan"@id, "Rumah Makan"@id, "Sewa Peralatan"@id ;
    ws:dapatMelakukan "Berselancar"@id, "Berenang"@id, "Bersantai"@id, "Berfoto"@id, "Menikmati Makanan"@id ;
