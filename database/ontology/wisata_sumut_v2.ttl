data:ws-111 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-111"^^xsd:string ;
    ws:namaDestinasi "Museum Pusaka Nias"@id ;
    ws:namaAlternatif "Museum Swasta Pusaka Nias"@id ;
    ws:deskripsiSingkat "Museum Pusaka Nias adalah sebuah museum di Jl. Yos Sudarso No. 134-A, SaombÃ¶, Gunungsitoli, Sumatera Utara yang didirikan untuk melestarikan budaya Nias."@id ;
    ws:deskripsiLengkap "Museum Pusaka Nias adalah sebuah museum di Jl. Yos Sudarso No. 134-A. SaombÃ¶, Gunungsitoli, Sumatera Utara yang didirikan untuk melestarikan budaya Nias. Museum ini dikelola oleh Persaudaraan Kapusin Sibolga. Sejarah Sejak tahun 1972, seorang misionaris Gereja Katolik bernama Johannes Maria HÃ¤mmerle sudah memulai mengoleksi benda-benda budaya, seni dan sejarah masyarakat Nias. Lama-kelamaan jumlah koleksinya makin banyak, dan dia mulai mencatat nama dan kegunaannya masing-masing. Pastor Johannes mengusulkan kepada Dewan Ordo Kapusin Provinsi Sibolga untuk mendirikan sebuah museum dan disetujui pada tahun 1990. Pada tanggal 19 April 1991, Pastor Johannes bertindak atas nama Dewan Ordo Kapusin Provinsi Sibolga menghadap Notaris untuk mendirikan Yayasan Pusaka Nias sebagai Badan Hukum Museum Pusaka Nias. Museum Pusaka Nias terdiri dari 4 paviliun dan 1 paviliun khusus tempat koleksi batu-batu megalit. Pada 16 September 1993, Kakanwil Depdikbud Prop. Sumatera Utara mengeluarkan Izin Pendirian Museum Pusaka Nias."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Pusaka Nias, budaya Nias, Gunungsitoli, museum"@id ;
    ws:beradaDi "Kota Gunungsitoli"@id ;
    ws:alamat "Jalan Yos Sudarso No.134-A, SaombÃ¶, Kota Gunungsitoli, Sumatera Utara 22812"@id ;
    ws:lintang "1.298416"^^xsd:decimal ;
    ws:bujur "97.608737"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Yos Sudarso No. 134-A, SaombÃ¶, Kota Gunungsitoli, Pulau Nias."@id ;
    ws:jamOperasional "Senin-Sabtu 08.00-18.00 WIB, Minggu 12.30-18.00 WIB"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "" ;
    ws:emailResmi "info@museum-nias.org"^^xsd:string ;
    ws:instagramResmi ""^^xsd:anyURI ;
