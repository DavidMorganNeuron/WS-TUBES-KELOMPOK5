data:ws-166 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-166"^^xsd:string ;
    ws:namaDestinasi "Kebun Teh Bah Butong Sidamanik"@id ;
    ws:namaAlternatif "Agrowisata Bah Butong"@id, "Kebun Teh Sidamanik"@id ;
    ws:deskripsiSingkat "Kebun Teh Bah Butong Sidamanik adalah agrowisata kebun teh di Kecamatan Sidamanik, Kabupaten Simalungun, yang memungkinkan pengunjung memetik daun teh sendiri."@id ;
    ws:deskripsiLengkap "Kebun Teh Bah Butong Sidamanik adalah agrowisata kebun teh di Kecamatan Sidamanik, Kabupaten Simalungun, yang dikelola PT Perkebunan Nusantara IV. Hamparan kebunnya seluas sekitar 6.373 hektare pada ketinggian 800-1.100 meter di atas permukaan laut dan merupakan salah satu kebun teh terluas di Indonesia. Pengunjung dapat memetik daun teh bersama petani, mengikuti tur pabrik untuk melihat proses pengolahan dari pucuk hingga menjadi teh siap seduh, mencicipi teh khas Juma Superpeko, dan membeli produk teh sebagai oleh-oleh."@id ;
    ws:jenisDestinasi "Kuliner"@id ;
    ws:kataKunci "Kebun Teh Bah Butong"@id, "Sidamanik"@id, "Simalungun"@id, "Agrowisata"@id, "Petik Teh"@id, "Juma Superpeko"@id ;
