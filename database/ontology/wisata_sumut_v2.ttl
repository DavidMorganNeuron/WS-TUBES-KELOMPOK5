data:ws-145 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-145"^^xsd:string ;
    ws:namaDestinasi "Museum Pusaka Nias"@id ;
    ws:namaAlternatif "Nias Heritage Museum"@id, "Museum Nias"@id ;
    ws:deskripsiSingkat "Museum Pusaka Nias adalah museum terlengkap dan bertaraf internasional di Gunungsitoli yang menyelamatkan harta peradaban, bahasa, dan ekologi masyarakat Ono Niha."@id ;
    ws:deskripsiLengkap "Diprakarsai secara gemilang oleh Pastor Johannes M. Hämmerle pada dekade 90-an, Museum Pusaka Nias menjadi satu-satunya rumah kebudayaan utuh terlengkap di Pulau Nias (Ono Niha). Berlokasi di kawasan tepi laut yang hijau nan asri, museum ini memamerkan lebih dari 6.000 artefak termasuk aneka persenjataan kuno, perhiasan porselen berusia ratusan tahun, serta replika rumah adat Omo Hada dengan pilar-pilar kayunya yang unik. Museum ini juga tak hanya melulu tentang benda mati; di bagian sayap luar, terdapat taman kebun binatang mini (minizoo) yang melindungi ragam koleksi flora maupun burung liar khas Nias untuk keperluan penelitian edukatif."@id ;
    ws:jenisDestinasi "Budaya"@id, "Alam"@id ;
    ws:kataKunci "Museum Pusaka Nias"@id, "Gunungsitoli"@id, "Ono Niha"@id, "Nias Heritage"@id, "Sejarah Nias"@id ;
    ws:beradaDi "Kota Gunungsitoli"@id ;
    ws:alamat "Jl. Yos Sudarso No.134-A, Iraonogeba, Kecamatan Gunungsitoli, Kota Gunungsitoli, Sumatera Utara 22811"@id ;
    ws:lintang "1.3056"^^xsd:decimal ;
    ws:bujur "97.6083"^^xsd:decimal ;
    ws:petunjukLokasi "Berada dekat dengan bibir pantai arah menuju pusat kota Gunungsitoli dari bandara Binaka."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "0639-22286"^^xsd:string ;
    ws:emailResmi "museum.nias@gmail.com"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Pemandu Wisata"@id, "Toko Suvenir"@id, "Rumah Makan"@id, "Area Istirahat"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Mengapresiasi"@id, "Menelusuri"@id, "Berfoto"@id, "Berinteraksi"@id ;
    ws:memilikiMedia "https://upload.wikimedia.org/wikipedia/commons/e/ea/Museum_Pusaka_Nias.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.6"^^xsd:decimal .

data:ws-146 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-146"^^xsd:string ;
    ws:namaDestinasi "Gereja Katedral Sibolga"@id ;
    ws:namaAlternatif "Gereja Katedral Santa Theresia Lisieux"@id ;
    ws:deskripsiSingkat "Gereja Katedral Sibolga, secara resmi bernama Gereja Katedral Santa Theresia Lisieux, adalah sebuah gereja katedral Katolik yang menjadi pusat dari Keuskupan Sibolga yang terletak di Kota Sibolga, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Gereja Katedral Sibolga, secara resmi bernama Gereja Katedral Santa Theresia Lisieux, adalah sebuah gereja katedral Katolik yang menjadi pusat dari Keuskupan Sibolga yang terletak di Kota Sibolga, Sumatera Utara. Sejarah Pada 12 Maret 1929, R.P. Chrysologus Timmermans, O.F.M. Cap., tiba di Sibolga dan menjadi pastor pertama yang berkarya di tanah Batak. Pada hari Raya Pentakosta, 19 Mei 1929, rumah dan kapel ini diberkati. Pada tanggal 23 Februari 1932 mulailah pembangunan rumah pastor dan Gereja. Dalam musim kemarau, tanggal 11 September 1932, gedung gereja dan pastoran diberkati oleh Prefek Apostolik Padang, Mgr. Mathias Leonardus Trudon Brans, O.F.M.Cap. Dengan demikian, diletakkanlah dasar bagi Gereja Katolik di Sibolga, yang kemudian menjadi titik pusat Prefektur Apostolik Sibolga."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Katedral Sibolga"@id, "Santa Theresia Lisieux"@id, "Keuskupan Sibolga"@id, "Gereja Katolik"@id ;
    ws:beradaDi "Kota Sibolga"@id ;
    ws:alamat "Jl. Brigjen Katamso No.21, Pasar Baru, Sibolga Kota, Kota Sibolga, Sumatera Utara 22513"@id ;
    ws:lintang "1.74156"^^xsd:decimal ;
    ws:bujur "98.77856"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kota Sibolga, Sumatera Utara."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "063122428"^^xsd:string ;
