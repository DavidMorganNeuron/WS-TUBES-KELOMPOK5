data:ws-109 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-109"^^xsd:string ;
    ws:namaDestinasi "Desa Wisata Jangga Dolok"@id ;
    ws:namaAlternatif "Desa Jangga Dolok"@id ;
    ws:deskripsiSingkat "Desa Wisata Jangga Dolok adalah kampung tradisional tertua di Toba yang melestarikan arsitektur rumah adat Batak Toba (Ruma Bolon) secara komunal."@id ;
    ws:deskripsiLengkap "Terletak di kawasan perbukitan yang dingin, Desa Wisata Jangga Dolok adalah kampung kuno berusia ratusan tahun yang masih setia melestarikan jejeran Ruma Bolon (rumah adat Batak Toba beratap ijuk) asli tanpa mengubah susunan struktur utamanya. Di desa ini, masyarakatnya menjaga tradisi menenun ulos (kain tradisional Batak) dengan alat tenun bukan mesin yang bisa disaksikan langsung oleh pengunjung di teras-teras rumah mereka. Pengunjung dapat belajar mengenai sejarah marga-marga, makna filosofis pada setiap ornamen gorga, serta kehidupan sosial masyarakat agraris Batak Toba yang sangat memegang teguh asas kekerabatan Dalihan Na Tolu."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Jangga Dolok"@id, "Desa Wisata"@id, "Lumban Julu"@id, "Toba"@id, "Rumah Adat Batak"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Desa Jangga Dolok, Kecamatan Lumban Julu, Kabupaten Toba, Sumatera Utara 22386"@id ;
    ws:lintang "2.5761"^^xsd:decimal ;
    ws:bujur "99.0681"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak persis di tepi jalan Lintas Tengah Sumatera, rute Parapat menuju Balige."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
