data:ws-100 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-100"^^xsd:string ;
    ws:namaDestinasi "Kawah Putih Tinggi Raja"@id ;
    ws:namaAlternatif "Bukit Kapur Tinggi Raja"@id, "Cagar Alam Tinggi Raja"@id ;
    ws:deskripsiSingkat "Kawah Putih Tinggi Raja adalah danau air panas belerang berwarna toska memukau yang berada di dalam cagar alam lindung Simalungun."@id ;
    ws:deskripsiLengkap "Sebagai kawasan cagar alam seluas 167 hektare, Kawah Putih Tinggi Raja ibarat kepingan salju di tengah hutan tropis lebat berkat bukit endapan kapur yang mengeras selama ratusan tahun. Aliran air panas yang mendidih langsung dari perut bumi bersuhu mencapai 90 derajat Celcius tertampung dalam kolam-kolam bertingkat memancarkan gradasi warna biru toska yang indah menawan. Walaupun membutuhkan perjuangan melintasi jalanan berbatu (off-road) untuk mencapai lokasinya, panorama langka bukit salju kapur panas ini sangat sepadan bagi para petualang sejati."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Kawah Putih"@id, "Tinggi Raja"@id, "Simalungun"@id, "Air Panas"@id, "Cagar Alam"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Desa Dolok Marawa, Kecamatan Silau Kahean, Kabupaten Simalungun, Sumatera Utara 21157"@id ;
    ws:lintang "3.1235"^^xsd:decimal ;
    ws:bujur "98.7884"^^xsd:decimal ;
    ws:petunjukLokasi "Bisa diakses dari kota Tebing Tinggi atau Galang, masuk melewati jalur perkebunan karet dan sawit menuju Silau Kahean."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
