data:ws-123 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-123"^^xsd:string ;
    ws:namaDestinasi "Masjid Raya Al-Ma'shun"@id ;
    ws:namaAlternatif "Masjid Raya Al-Mashun"@id,
        "Masjid Raya Al-Maâ€™shun"@id,
        "Mesjid Raya Medan"@id ;
    ws:deskripsiSingkat "Masjid Raya Al-Ma'shun adalah masjid di Jalan Sisingamangaraja, Kelurahan Mesjid, Kecamatan Medan Kota, Kota Medan, dekat Istana Maimun."@id ;
    ws:deskripsiLengkap "Masjid Raya Al-Mashun (bahasa Arab: Ù…Ø³Ø¬Ø¯ Ø¬Ø§Ù…Ø¹ Ø§Ù„Ù…Ø´ÙˆÙ†) atau yang lebih dikenal Masjid Raya Medan adalah sebuah masjid yang berada di Kota Medan, Provinsi Sumatera Utara, Indonesia. Masjid ini dibangun pada tahun 1906 dan selesai pada tahun 1909. Pada awal pendiriannya, masjid ini merupakan bagian dari kompleks Istana Maimun. Gaya arsitekturnya memadukan unsur Timur Tengah, India, dan Spanyol. Masjid ini berbentuk segi delapan dan memiliki sayap di bagian selatan, timur, utara, dan barat. Sejarah Sultan Ma'mun Ar-Rasyid sebagai pemimpin Kesultanan Deli memulai pembangunan masjid ini pada tanggal 21 Agustus 1906 atau yang bertepatan pada 1 Rajab 1324 Hijriah. Seluruh pembangunan selesai pada tanggal 10 September 1909 dan ditandai dengan pelaksanaan salat Jumat pertama di masjid tersebut. Anggaran pembangunan keseluruhan adalah satu juta gulden. Pembangunan masjid ini dibiayai oleh Kesultanan Deli, Deli Maatschappij, dan Tjong A Fie, pengusaha terkaya di Medan saat itu."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Masjid Raya Al-Ma'shun, Masjid Raya Medan"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jalan Sisingamangaraja, Kelurahan Mesjid, Kecamatan Medan Kota, Kota Medan"@id ;
    ws:lintang "3.57517"^^xsd:decimal ;
    ws:bujur "98.68728"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Sisingamangaraja, Kelurahan Mesjid, Kecamatan Medan Kota, Kota Medan, dekat Istana Maimun."@id ;
    ws:jamOperasional "Buka 24 jam, kecuali saat waktu ibadah"@id ;
