data:ws-052 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-052"^^xsd:string ;
    ws:namaDestinasi "Museum Huta Bolon Simanindo"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Museum Batak Toba di Samosir."@id ;
    ws:deskripsiLengkap "Terletak di Desa Simanindo, Kabupaten Samosir, Sumatera Utara, Museum Huta Bolon Simanindo bermula dari kompleks istana dan rumah adat warisan Raja Sidauruk yang kemudian dikembangkan menjadi museum terbuka pada tahun 1969 dan diresmikan pada 1971. Di dalam kawasan ini, pengunjung dapat melihat deretan rumah adat Bolon yang saling berhadapan lengkap dengan lumbung padi (sopo), serta berbagai koleksi artefak leluhur seperti pustaha laklak (naskah kuno kulit kayu), parhalaan (kalender tradisional), tunggal panaluan, hingga perahu lesung tradisional solu bolon. Selain itu, museum ini menjadi pusat pelestarian hidup budaya Batak Toba di mana wisatawan sering kali disuguhkan pertunjukan seni tradisional seperti tari Tortor dan boneka Sigale-gale."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Rumah Adat Batak"@id, "Raja Sidauruk"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
