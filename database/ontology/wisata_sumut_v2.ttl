data:ws-072 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-072"^^xsd:string ;
    ws:namaDestinasi "Maha Vihara Maitreya"@id ;
    ws:namaAlternatif "Vihara Cemara Asri"@id ;
    ws:deskripsiSingkat "Maha Vihara Maitreya adalah salah satu vihara Buddha terbesar di Asia Tenggara yang terletak di dalam Kompleks Perumahan Cemara Asri, Deli Serdang."@id ;
    ws:deskripsiLengkap "Maha Vihara Maitreya dibangun di atas lahan seluas 4,5 hektare dan diresmikan pada tahun 2008, didedikasikan untuk memuja Buddha Maitreya (Buddha Tertawa) yang melambangkan kebahagiaan dan welas asih universal. Tempat ibadah raksasa ini tidak hanya terkenal dengan arsitekturnya yang sangat megah dan patung naga di depannya, tetapi juga fasilitas pendukung yang luar biasa seperti kantin vegetarian besar, kolam ikan koi, dan taman burung bangau yang asri. Vihara ini selalu ramai dikunjungi pada akhir pekan dan hari raya sebagai pusat rekreasi keluarga yang damai."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Maha Vihara Maitreya"@id, "Vihara"@id, "Medan"@id, "Cemara Asri"@id ;
