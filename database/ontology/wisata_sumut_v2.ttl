data:ws-078 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-078"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sipisopiso"@id ;
    ws:namaAlternatif ""@id ;
    ws:deskripsiSingkat "Air Terjun Sipisopiso atau Sipiso-piso adalah sebuah air terjun yang berada di Desa Tongging, Kecamatan Merek, Kabupaten Karo, Provinsi Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Air Terjun Sipisopiso atau Sipiso-piso adalah sebuah air terjun yang berada di Desa Tongging, Kecamatan Merek, Kabupaten Karo, Provinsi Sumatera Utara, Indonesia. Air Terjun Sipisopiso memiliki ketinggian hingga 120 meter dan mengucur deras membentuk garis vertikal sempurna. Sehingga Air Terjun Sipisopiso masuk dalam air terjun tipe Plunge. Air Terjun Sipisopiso berada di bibir kaldera raksasa Danau Toba serta terbentuk pada aliran Sungai Pajanabolon yang merupakan salah satu sungai menyuplai air ke Danau Toba. Air Terjun Sipisopiso berada di ketinggian sekitar 1.300 meter di atas permukaan air laut. Nama Sipisopiso diambil dari nama sebuah Gunung yang berada tepat di timur laut Air Terjun Sipisopiso. Gunung yang juga disebut Gunung Sipisopiso ini memiliki ketinggian sekitar 1.860 meter di atas permukaan air laut."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "air terjun Sipisopiso, Sipiso-piso, Tongging, Merek, Danau Toba"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat ""@id ;
    ws:lintang "2.9162"^^xsd:decimal ;
    ws:bujur "98.5196"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Tongging, Kecamatan Merek, Kabupaten Karo, di bibir kaldera Danau Toba pada ketinggian sekitar 1.300 mdpl; dapat ditempuh sekitar 2,5 jam dari Kota Medan."@id ;
    ws:jamOperasional "Setiap hari 08.00-17.00 WIB"@id ;
    ws:hargaMasuk "7500"^^xsd:decimal ;
