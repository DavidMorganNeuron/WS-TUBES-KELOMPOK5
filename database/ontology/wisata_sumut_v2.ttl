data:ws-011 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-011"^^xsd:string ;
    ws:namaDestinasi "Danau Baua"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Danau Baua adalah sebuah danau air tawar unik yang terletak tersembunyi tepat di bagian tengah Pulau Bawa, wilayah administrasi Kecamatan Sirombu, Kabupaten Nias Barat, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Berbeda dengan mayoritas destinasi di Kepulauan Hinako yang didominasi oleh pesisir laut terjal dan pantai berpasir yang menghadap langsung ke Samudera Hindia, Danau Baua menyajikan fenomena alam yang memikat berupa hamparan air tawar yang tenang di tengah-tengah pulau kecil. Kehadiran danau tersembunyi ini menjadi daya tarik ekologis yang kontras sekaligus menyegarkan bagi para petualang yang mengunjungi Pulau Bawa. Dikelilingi oleh vegetasi hijau dan suasana pedesaan yang dihuni masyarakat lokal yang ramah, Danau Baua menawarkan lanskap alami yang masih asri, menjadikannya sebuah permata tersembunyi yang menyimpan potensi wisata geografi luar biasa di Nias Barat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Baua"@id ;
    ws:beradaDi "Kabupaten Nias Barat"@id ;
    ws:alamat "Tuwa Tuwa, Kecamatan Sirombu, Kabupaten Nias Barat, Sumatera Utara"@id ;
    ws:lintang "0.827222"^^xsd:decimal ;
    ws:bujur "97.340278"^^xsd:decimal ;
    ws:petunjukLokasi "Rute darat dari Kota Medan menuju Danau Toba membentang sejauh kurang lebih 176 kilometer ke arah selatan melalui jalur Tebing Tinggi, Pematangsiantar, hingga tiba di Parapat."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Menikmati Pemandangan"@id, "Berenang"@id ;
