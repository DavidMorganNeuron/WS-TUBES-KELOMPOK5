data:ws-090 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-090"^^xsd:string ;
    ws:namaDestinasi "Aek Sijorni"@id ;
    ws:namaAlternatif "Pemandian Alam Aek Sijorni"@id, "Air Terjun Aek Sijorni"@id ;
    ws:deskripsiSingkat "Aek Sijorni merupakan wisata pemandian alam bertingkat dengan aliran air terjun jernih yang melewati kontur batuan cadas di Tapanuli Selatan."@id ;
    ws:deskripsiLengkap "Dalam bahasa Batak Angkola, 'Aek Sijorni' bermakna air yang sangat jernih. Destinasi yang berlokasi di Kecamatan Sayur Matinggi ini memiliki lanskap unik di mana air mengalir turun melalui bebatuan cadas kapur berundak-undak yang tidak licin, sehingga sangat aman untuk dipijak saat berenang. Kawasan wisata ini dikelilingi oleh rindangnya pohon kelapa, memberikan nuansa layaknya oase tropis di tengah pegunungan, dan difasilitasi dengan beberapa kolam pemandian buatan, perosotan air, hingga gubuk-gubuk peristirahatan untuk keluarga."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Aek Sijorni"@id, "Pemandian Alam"@id, "Sayur Matinggi"@id, "Tapanuli Selatan"@id, "Air Terjun"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "Jalan Trans Sumatera Bukittinggi-Padang Sidempuan, Aek Libung, Kecamatan Sayur Matinggi, Kabupaten Tapanuli Selatan, Sumatera Utara 22774"@id ;
    ws:lintang "1.2333"^^xsd:decimal ;
    ws:bujur "99.3082"^^xsd:decimal ;
    ws:petunjukLokasi "Berada persis di pinggir jalan raya lintas Padang Sidempuan - Mandailing Natal, pengunjung harus menyeberangi jembatan gantung untuk masuk."@id ;
    ws:jamOperasional "Setiap Hari 07.00-18.00"@id ;
    ws:hargaMasuk "20000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/sijorni_official?rpxt=MTQyYjB2cnFzeHZ2MA=="^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Musala"@id, "Rumah Makan"@id, "Taman Bermain"@id, "Gazebo"@id ;
