    ws:lintang "2.752420060582756"^^xsd:decimal ;
    ws:bujur "98.74414551168162"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Simanindo, Kecamatan Simanindo, Kabupaten Samosir, di tepi Danau Toba."@id ;
