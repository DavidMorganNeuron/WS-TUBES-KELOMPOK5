data:ws-103 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-103"^^xsd:string ;
    ws:namaDestinasi "Bukit Indah Simarjarunjung"@id ;
    ws:namaAlternatif "BIS"@id, "Bukit Simarjarunjung"@id, "Dolog Simarjarunjung@id", "Dolok Simarjarunjung@id", "Puncak Simarjarunjung@id" ;
    ws:deskripsiSingkat "Bukit Indah Simarjarunjung adalah titik pandang spektakuler di punggung bukit Kabupaten Simalungun untuk menikmati lanskap kaldera Danau Toba dari ketinggian."@id ;
    ws:deskripsiLengkap "Menjadi destinasi wisata kekinian (Instagramable) yang diidamkan kaum muda, Bukit Indah Simarjarunjung (BIS) menawarkan puluhan spot foto buatan kreatif yang dirancang melayang dengan latar belakang biru magisnya air Danau Toba. Pengelola kawasan menyediakan berbagai anjungan menarik seperti ayunan langit, replika balon udara, hingga rumah pohon, yang semuanya menghadap langsung ke arah perairan luas Pulau Samosir. Tempat ini sangat direkomendasikan dikunjungi pada sore hari karena letaknya yang menyajikan visibilitas sempurna untuk menikmati cahaya keemasan saat matahari terbenam."@id ;
    ws:jenisDestinasi "Alam"@id, "Buatan"@id ;
    ws:kataKunci "Bukit Indah Simarjarunjung"@id, "BIS"@id, "Simalungun"@id, "Danau Toba"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Jl. Simarjarunjung, Butu Raya, Kecamatan Pematang Sidamanik, Kabupaten Simalungun, Sumatera Utara 21162"@id ;
    ws:lintang "2.8133"^^xsd:decimal ;
    ws:bujur "98.7813"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di jalur atas penghubung Sidamanik dan Parapat (rute alternatif ke Parapat)."@id ;
    ws:jamOperasional "Setiap Hari 07.00-19.00"@id ;
    ws:hargaMasuk "15000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "bukitindahsimarjarunjung@gmail.com"^^xsd:string ;
