data:ws-043 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-043"^^xsd:string ;
    ws:namaDestinasi "Masjid Raya Al Osmani"@id ;
    ws:namaAlternatif "Masjid Labuhan"@id ;
    ws:deskripsiSingkat "Masjid Al Osmani Medan Labuhan adalah masjid di Jalan K.L. Yos Sudarso, Kelurahan Pekan Labuhan, sekitar 20 km di utara Kota Medan."@id ;
    ws:deskripsiLengkap "Terletak di kawasan Pekan Labuhan, Masjid Raya Al-Osmani merupakan ikon sejarah Islam tertua di Kota Medan yang didirikan pada tahun 1854 oleh Raja Deli ketujuh, Sultan Osman Perkasa Alam. Awalnya dibangun menggunakan bahan kayu pilihan berukuran 16x16 meter, masjid ini kemudian dipugar menjadi bangunan permanen bergaya megah antara tahun 1870–1872 oleh anaknya, Sultan Mahmud Perkasa Alam, di bawah rancangan arsitek asal Jerman G.D. Langereis. Keunikan bangunan ini terletak pada perpaduan arsitektur yang memadukan unsur Tiongkok, India, Eropa, Timur Tengah, dan Melayu, dengan dominasi warna kuning khas kedaulatan Melayu serta kubah tembaga seberat 2,5 ton. Selain menjadi pusat ibadah, kompleks masjid yang telah ditetapkan sebagai cagar budaya ini juga menyimpan makam dari lima raja Kesultanan Deli."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "-"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jalan K.L. Yos Sudarso, Pekan Labuhan, Kecamatan Medan Labuhan, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.732376496437109"^^xsd:decimal ;
    ws:bujur "98.67627567125885"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan K.L. Yos Sudarso, Kelurahan Pekan Labuhan, sekitar 20 km di utara Kota Medan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "http://www.medanwisata.com/2014/03/masjid-raya-al-osmani-medan-sumatera.html" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Toilet"@id, "Tempat Parkir"@id ;
    ws:dapatMelakukan "Beribadah"@id, "Berdoa"@id, "Berziarah"@id, "Berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Al-Osmani_Mosque%2C_Medan%2C_Indonesia.jpg"^^xsd:anyURI ;
