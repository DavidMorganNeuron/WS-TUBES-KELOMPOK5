    ws:bujur "98.901570"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Pematangsiantar, berkendara sekitar 45 menit ke arah Sidamanik; pemandian berada sebelum kawasan Kebun Teh Sidamanik."@id ;
    ws:jamOperasional "Setiap hari 08.00-19.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
