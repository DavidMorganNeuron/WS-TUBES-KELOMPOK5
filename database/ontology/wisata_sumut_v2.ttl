data:ws-227 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-227"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sikulikap"@id ;
    ws:namaAlternatif "Sikulikap Waterfall"@id ;
    ws:deskripsiSingkat "Air terjun di Kabupaten Karo, Sumatera Utara, yang berada di bawah kawasan Berastagi dan dikelilingi hutan pinus."@id ;
    ws:deskripsiLengkap "Air Terjun Sikulikap berada di Kecamatan Berastagi, Kabupaten Karo, di bawah lereng menuju kawasan Sibolangit. Airnya jatuh dari dinding batu setinggi belasan meter ke kolam berbatu yang bisa dipakai berendam. Kawasan ini dilengkapi jalur tangga, gazebo, toilet, dan warung sederhana, serta sering digabung dengan kunjungan ke Kebun Kopi maupun Pasar Buah Berastagi. Tiket masuk lima ribu rupiah per orang. Pada musim hujan debit air meningkat sehingga pengunjung perlu berhati-hati di area bebatuan."@id ;
