data:ws-143 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-143"^^xsd:string ;
    ws:namaDestinasi "Pulau Asu"@id ;
    ws:namaAlternatif "Asu Island"@id, "Pulau Asu Hinako"@id ;
    ws:deskripsiSingkat "Pulau Asu merupakan atol tropis kecil di Kepulauan Hinako, Nias Barat, yang memancarkan pesona laut bergradasi biru jernih tanpa batas."@id ;
    ws:deskripsiLengkap "Dijuluki sebagai 'The Paradise on Earth', Pulau Asu adalah satu dari delapan gugusan pulau terluar Kepulauan Hinako. Pulau Asu yang damai memanjakan mata siapa saja berkat pasir pantai yang berwarna putih bersih serta lautnya yang membiaskan pantulan kebiruan super bening hingga jarak puluhan meter ke lepas pantai. Pulau ini minim perumahan penduduk permanen, mempertahankan kesunyian liburan bagi peselancar profesional mancanegara maupun penyelam alam karang koral yang ingin lari sejenak dari peradaban kota bising, ditemani hamparan pohon nyiur yang menjuntai rendah."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pulau Asu"@id, "Hinako"@id, "Nias Barat"@id, "Pulau Tropis"@id, "Surfing Nias Barat"@id ;
    ws:beradaDi "Kabupaten Nias Barat"@id ;
    ws:alamat "Desa Hanofa, Kecamatan Sirombu, Kabupaten Nias Barat, Sumatera Utara 22867"@id ;
    ws:lintang "0.9161"^^xsd:decimal ;
    ws:bujur "97.3512"^^xsd:decimal ;
    ws:petunjukLokasi "Menyeberang selama kurang lebih 1,5 hingga 2 jam dengan perahu mesin dari dermaga Pantai Sirombu."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
