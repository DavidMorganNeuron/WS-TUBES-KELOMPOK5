    ws:petunjukLokasi "Berada di Desa Bukit Lawang, Kecamatan Bahorok, Kabupaten Langkat, sekitar 3 jam perjalanan dari Kota Medan."@id ;
    ws:jamOperasional "Setiap hari 07.00-16.00"@id ;
