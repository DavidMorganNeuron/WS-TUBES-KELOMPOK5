data:ws-025 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-025"^^xsd:string ;
    ws:namaDestinasi "Danau Silosung"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Danau Silosung (Tao Silosung) adalah danau air tawar alami seluas kurang lebih 10 hektare di Desa Siponjot, Kecamatan Lintong Nihuta, yang memiliki bentuk unik menyerupai lesung dengan kedalaman sekitar 3 meter."@id ;
    ws:deskripsiLengkap "Terletak di Desa Siponjot, Kecamatan Lintong Nihuta, Kabupaten Humbang Hasundutan, Danau Silosung atau yang kerap disebut Tao Silaban ini terkenal dengan kejernihan airnya yang kerap dimanfaatkan warga sekitar untuk kebutuhan harian. Secara geografis, danau alami ini dikelilingi oleh pemukiman penduduk di sebelah timur, akses jalan di sisi barat dan selatan, serta area perkebunan warga di bagian utara. Selain keelokan panorama alam dataran tingginya yang asri, danau ini sangat erat kaitannya dengan legenda lokal pertikaian dua bersaudara (Datu Dalu dan Sangmaima) yang melempar lesung hingga membentuk cekungan perairan unik ini, serta menjadi destinasi rekreasi tenang yang sering dimanfaatkan untuk kegiatan seperti lomba memancing oleh pemerintah dan masyarakat setempat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Silosung"@id, "Siponjot"@id, "Lintongnihuta"@id, "Doloksanggul"@id;
    ws:beradaDi "Kabupaten Humbang Hasundutan"@id ;
    ws:alamat "Siponjot, Kec. Lintong Nihuta, Kabupaten Humbang Hasundutan, Sumatera Utara 22457"@id ;
    ws:lintang "2.289785867668039"^^xsd:decimal ;
    ws:bujur "98.8084344803379"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Siponjot, Kecamatan Lintongnihuta, Kabupaten Humbang Hasundutan, sekitar 10 km dari Doloksanggul."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
