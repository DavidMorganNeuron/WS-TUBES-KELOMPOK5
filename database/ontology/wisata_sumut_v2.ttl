    ws:lintang "2.529170"^^xsd:decimal ;
    ws:bujur "98.634940"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Pangururan, berkendara sekitar 25 km ke arah Harian; jalan menanjak dan menikung menuju Bukit Tele."@id ;
