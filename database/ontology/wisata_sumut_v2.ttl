data:ws-069 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-069"^^xsd:string ;
    ws:namaDestinasi "Taman Wisata Iman Sitinjo, Dairi"@id ;
    ws:namaAlternatif "TWI"@id, "Taman Wisata Iman"@id ;
    ws:deskripsiSingkat "Taman Wisata Iman Sitinjo merupakan kawasan wisata rohani terpadu di Kabupaten Dairi yang menghadirkan miniatur berbagai rumah ibadah dari agama-agama di Indonesia."@id ;
    ws:deskripsiLengkap "Diinisiasi pada tahun 2001 oleh Bupati Dairi Dr. Master Parulian Tumanggor, Taman Wisata Iman (TWI) menempati lahan perbukitan seluas 130.000 meter persegi yang dikelilingi hutan pinus nan asri di Desa Sitinjo. Kawasan ini merupakan simbol toleransi beragama yang sangat kuat, memamerkan miniatur bangunan bersejarah seperti Ka'bah, Gereja, Vihara, Kuil Hindu, serta rute Jalan Salib. Dengan udara yang sejuk dan panorama alam perbukitan, taman ini menyuguhkan wisata religius sekaligus arena rekreasi alam yang edukatif bagi para pengunjung dari berbagai latar belakang keyakinan."@id ;
    ws:jenisDestinasi "Budaya"@id, "Religi"@id ;
    ws:kataKunci "Taman Wisata Iman"@id, "TWI"@id, "Sitinjo"@id, "Wisata Rohani"@id, "Dairi"@id ;
    ws:beradaDi "Kabupaten Dairi"@id ;
    ws:alamat "Sitinjo I, Kecamatan Sitinjo, Kabupaten Dairi, Sumatera Utara 22281"@id ;
    ws:lintang "2.72888"^^xsd:decimal ;
    ws:bujur "98.38309"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak di Kecamatan Sitinjo, sekitar 10 km dari Sidikalang atau 154 km dari Kota Medan."@id ;
    ws:jamOperasional "Setiap Hari 06.00-18.30"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
