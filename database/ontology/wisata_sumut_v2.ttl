    ws:alamat "Jl. Pendidikan, Kel. Deli Tua Barat, Kec. Deli Tua, Kab. Deli Serdang, Sumatera Utara"@id ;
    ws:lintang "3.4803073141775758"^^xsd:decimal ;
    ws:bujur "98.69466813358663"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, ambil Jalan Letjen Jamin Ginting lalu belok ke Jalan Pendidikan, Deli Tua; gerbang terlihat dari jalan."@id ;
