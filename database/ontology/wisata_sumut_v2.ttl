    ws:lintang "3.420510"^^xsd:decimal ;
    ws:bujur "99.757560"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Pelabuhan Tanjung Tiram, naik kapal feri sekitar satu jam menuju Pulau Pandang."@id ;
    ws:jamOperasional "Setiap hari 24 jam"@id ;
