data:ws-131 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-131"^^xsd:string ;
    ws:namaDestinasi "Panorama Delleng Simpon"@id ;
    ws:namaAlternatif "Gunung Simpon"@id, "Puncak Delleng Simpon"@id ;
    ws:deskripsiSingkat "Panorama Delleng Simpon adalah kawasan dataran tinggi perbatasan Humbahas dan Pakpak Bharat yang menawarkan lanskap awan serta lautan belantara Sumatera."@id ;
    ws:deskripsiLengkap "Delleng Simpon dalam bahasa Pakpak berarti Gunung Simpon. Destinasi alam liar ini merupakan puncak tertinggi di Pakpak Bharat dengan ketinggian lebih dari 1.300 meter di atas permukaan laut. Di sepanjang jalur pendakian menuju puncaknya, pengunjung disuguhkan keanekaragaman flora langka seperti kantong semar hingga anggrek hutan eksotis. Pada pagi hari, kawasan puncaknya yang sering disebut 'negeri di atas awan' menyajikan sensasi magis melihat gumpalan kabut tebal menyelimuti dataran rendah, sebuah panorama yang sangat dicari oleh para pencinta alam dan fotografer profesional."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Delleng Simpon"@id, "Pakpak Bharat"@id, "Pendakian"@id, "Gunung Simpon"@id, "Wisata Alam"@id ;
    ws:beradaDi "Kabupaten Pakpak Bharat"@id ;
    ws:alamat "Kecamatan Salak, Kabupaten Pakpak Bharat, Sumatera Utara 22272"@id ;
    ws:lintang "2.462037"^^xsd:decimal ;
    ws:bujur "98.387891"^^xsd:decimal ;
    ws:petunjukLokasi "Masuk melalui Kecamatan Salak, melintasi rute perbukitan menuju kawasan hutan lindung."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "jasaberutu35@gmail.com"^^xsd:string ;
    ws:instagramResmi "@mt.simpon"^^xsd:anyURI ;
