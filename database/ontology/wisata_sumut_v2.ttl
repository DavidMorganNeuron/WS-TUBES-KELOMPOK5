data:ws-199 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-199"^^xsd:string ;
    ws:namaDestinasi "Pantai Ujung Sibolga"@id ;
    ws:namaAlternatif "PAJUS"@id, "Pantai Ujung"@id ;
    ws:deskripsiSingkat "Pantai berpasir hitam di jantung Kota Sibolga, Kecamatan Sibolga Utara, yang sudah direnovasi dan kembali beroperasi sebagai ruang rekreasi warga."@id ;
    ws:deskripsiLengkap "Pantai Ujung Sibolga, atau PAJUS, berada di Kelurahan Simare-mare, Kecamatan Sibolga Utara, Kota Sibolga. Setelah direnovasi, kawasan ini kembali dibuka dengan fasilitas yang lebih memadai: jalur pejalan kaki, gazebo, warung kuliner, toilet, dan wahana permainan anak. Pantainya berpasir hitam dengan perairan jernih dan menghadap langsung ke Teluk Tapian Nauli, sehingga menjadi lokasi favorit untuk menikmati matahari terbenam. Pengunjung dikenakan tiket masuk sepuluh ribu rupiah per orang, dan biasanya ramai pada sore hingga malam hari."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Ujung Sibolga"@id, "PAJUS"@id, "Simare-mare"@id, "Sibolga Utara"@id, "Teluk Tapian Nauli"@id ;
