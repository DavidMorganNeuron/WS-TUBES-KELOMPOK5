data:ws-183 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-183"^^xsd:string ;
    ws:namaDestinasi "Pulau Mursala"@id ;
    ws:namaAlternatif "Mursala Island"@id, "Pulau Musala"@id ;
    ws:deskripsiSingkat "Pulau Mursala adalah pulau di Kecamatan Tapian Nauli, Kabupaten Tapanuli Tengah, yang memiliki air terjun setinggi sekitar 35 meter yang jatuh langsung ke laut."@id ;
    ws:deskripsiLengkap "Pulau Mursala adalah pulau seluas sekitar 8.000 hektare di Kecamatan Tapian Nauli, Kabupaten Tapanuli Tengah, yang terletak di Samudra Hindia antara Sumatra dan Nias. Ikonnya adalah air terjun setinggi sekitar 35 meter yang berasal dari sungai pendek di atas tebing granit dan tumpah langsung ke laut, salah satu dari sedikit fenomena sejenis di dunia. Perairan sekitarnya memiliki puluhan titik selam dan snorkeling dengan terumbu karang yang masih terjaga, serta laguna berpasir putih di antara pulau-pulau kecil. Pulau ini hanya dapat dicapai dengan perahu sewaan dari Pantai Pandan atau Pantai Bosur, sekitar 2 jam pelayaran dari Sibolga."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pulau Mursala"@id, "Tapian Nauli"@id, "Tapanuli Tengah"@id, "Air Terjun ke Laut"@id, "Snorkeling"@id, "Diving"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Desa Tapian Nauli I, Kec. Tapian Nauli, Kabupaten Tapanuli Tengah, Sumatera Utara"@id ;
    ws:lintang "1.6375000"^^xsd:decimal ;
    ws:bujur "98.5258333"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Samudra Hindia, sekitar 2 jam pelayaran dengan perahu sewaan dari Pantai Pandan atau Pelabuhan Sibolga."@id ;
    ws:jamOperasional "24 jam"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "+62 852-7084-0356"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "@pulaumursala "^^xsd:anyURI ;
    ws:memilikiFasilitas "Pemandu Wisata"@id, "Rumah Makan"@id ;
    ws:dapatMelakukan "Berenang"@id, "Berfoto"@id, "Berkemah"@id, "Menikmati Pemandangan"@id, "Memancing"@id, "Menyelam"@id ;
    ws:memilikiMedia "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQcDAGCiJEi0z0Gt6vemJlGCmXc9Y7vb-d6T-PjvGILIWqcI0dR0F4b78k&s=10"^^xsd:anyURI ;
