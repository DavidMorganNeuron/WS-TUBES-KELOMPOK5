data:ws-164 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-164"^^xsd:string ;
    ws:namaDestinasi "Bukit Indah Simarjarunjung"@id ;
    ws:namaAlternatif "Bukit Indah Simarjarunjung"@id, "Simarjarunjung"@id ;
    ws:deskripsiSingkat "Bukit Indah Simarjarunjung adalah kawasan perbukitan di Kecamatan Dolok Pardamean, Kabupaten Simalungun, dengan panorama Danau Toba dan hutan pinus."@id ;
    ws:deskripsiLengkap "Bukit Indah Simarjarunjung adalah kawasan perbukitan di Kecamatan Dolok Pardamean, Kabupaten Simalungun, dengan panorama Danau Toba dan hutan pinus. Berada di gugusan Pegunungan Bukit Barisan pada ketinggian sekitar 1.200 mdpl, kawasan ini dipenuhi warung, kafe, dan spot foto yang menghadap ke danau, sehingga kerap dijuluki \"Bali Baru\". Suhu di sini sejuk dan paling ramai dikunjungi pada pagi hingga sore hari."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Bukit Indah Simarjarunjung"@id, "Danau Toba"@id, "Simalungun"@id, "Hutan Pinus"@id, "Panorama"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
