data:ws-273 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-273"^^xsd:string ;
    ws:namaDestinasi "Istana Maimun"@id ;
    ws:namaAlternatif "Istana Sultan Deli"@id ;
    ws:namaAlternatif "Maimun Palace"@id ;
    ws:deskripsiSingkat "Istana Maimun adalah istana Kesultanan Deli yang dibangun pada 1888-1891 dan menjadi ikon wisata sejarah Kota Medan."@id ;
    ws:deskripsiLengkap "Istana Maimun adalah istana Kesultanan Deli yang dibangun pada 1888-1891 dan menjadi ikon wisata sejarah Kota Medan. Bangunan rancangan arsitek Belanda Capt. Theodoor van Erp ini memadukan gaya Melayu, Mughal, dan Eropa, dengan 30 ruangan dan balairung utama yang masih menyimpan singgasana, foto keluarga kesultanan, serta koleksi senjata. Istana berlokasi di Jl. Brigjen Katamso, berdekatan dengan Masjid Raya Al-Ma'shun, sehingga kedua destinasi ini biasa dikunjungi dalam satu perjalanan."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Istana Maimun, Kesultanan Deli, istana, Medan Maimun, wisata sejarah"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Brigjen Katamso No. 1, Aur, Kec. Medan Maimun, Kota Medan, Sumatera Utara 20151"@id ;
    ws:lintang "3.575232"^^xsd:decimal ;
    ws:bujur "98.683817"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. Brigjen Katamso No. 1, Kelurahan Aur, Kecamatan Medan Maimun, bersebelahan dengan Masjid Raya Al-Ma'shun."@id ;
    ws:jamOperasional "Senin-Minggu 08.00-17.00 WIB (Jumat 08.00-12.00 dan 14.00-17.00 WIB)"@id ;
