    ws:lintang "0.952000"^^xsd:decimal ;
    ws:bujur "97.416700"^^xsd:decimal ;
    ws:petunjukLokasi "Dari pusat Kabupaten Nias Barat di Lahomi, berkendara sekitar 20 menit ke arah utara menuju Sirombu."@id ;
