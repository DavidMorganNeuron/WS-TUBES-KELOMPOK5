    ws:idDestinasi "ws-141"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Luaha Ndroi"@id ;
    ws:namaAlternatif "Luaha Ndroi"@id ;
    ws:deskripsiSingkat "Air Terjun Luaha Ndroi adalah keajaiban wisata tebing curam di Nias Utara yang airnya mengalir memancar melewati lempengan batu karang terasering."@id ;
    ws:deskripsiLengkap "Air Terjun Luaha Ndroi atau Simalombu adalah surga tersembunyi berjarak belasan kilometer ke dalam belantara Nias Utara. Air terjun ini memiliki keunikan morfologi karena tak hanya jatuh pada satu tebing vertikal, melainkan merayap deras menyebar melintasi susunan terasering tebing batu yang melingkar luas dan beralaskan lumut kehijauan. Kesan magis dan perawan langsung terasa saat pengunjung membenamkan tubuh ke dalam air kolam di dasar jeram yang memantulkan rona bening kebiruan, ditemani orkestra cuitan burung liar hutan endemik pulau tersebut."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Luaha Ndroi"@id, "Nias Utara"@id, "Air Terjun Nias"@id, "Wisata Alam"@id, "Terasering Batu"@id ;
    ws:beradaDi "Kabupaten Nias Utara"@id ;
    ws:alamat "Desa Fulolo, Kecamatan Alasa, Kabupaten Nias Utara, Sumatera Utara 22862"@id ;
    ws:lintang "1.2333"^^xsd:decimal ;
    ws:bujur "97.4589"^^xsd:decimal ;
    ws:petunjukLokasi "Memerlukan trekking berjalan kaki singkat menuruni hutan dari lokasi perhentian terakhir di Alasa."@id ;
    ws:jamOperasional "Setiap Hari 07.00-17.00"@id ;
