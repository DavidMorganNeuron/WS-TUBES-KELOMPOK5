    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Rumah Makan"@id, "Toko Oleh-Oleh"@id, "Sewa Peralatan"@id ;
