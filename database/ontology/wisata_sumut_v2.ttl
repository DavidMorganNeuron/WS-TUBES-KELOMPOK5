data:ws-171 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-171"^^xsd:string ;
    ws:namaDestinasi "Rahmat International Wildlife Museum & Gallery"@id ;
    ws:namaAlternatif "Rahmat International Wildlife Museum dan Gallery"@id ;
    ws:deskripsiSingkat "Rahmat International Wildlife Museum and Gallery adalah museum yang diilhami oleh Dr. H Rahmatsyah yang memiliki kecintaan pada alam dan niatnya mencegah kepunahan hewan langka."@id ;
    ws:deskripsiLengkap "Rahmat International Wildlife Museum and Gallery adalah museum yang diilhami oleh Dr. H Rahmatsyah yang memiliki kecintaan pada alam dan niatnya mencegah kepunahan hewan langka. Museum ini terletak di Kelurahan Petisah Hulu, Medan Baru, Kota Medan. Konsep pendiriannya sama dengan Safari Club International yaitu konservasi dengan pemanfaatan. Museum ini diresmikan pada tanggal 14 Mei 1999 oleh Menteri Pendidikan dan Kebudayaan, Juwono Sudarsono. Museum ini menampilkan koleksi yang menakjubkan dari berbagai binatang liar yang dilestarikan, yang berasal dari berbagai tempat di seluruh dunia. Museum ini terkenal sebagai galeri satwa liar pertama di Asia Tenggara. Di dalamnya, pengunjung dapat menemukan lebih dari 2000 hewan, baik besar maupun kecil, yang diatur sesuai dengan habitat asli mereka. Salah satu koleksi yang menonjol di museum ini adalah The African Big Five, yang terdiri dari Bull, Elephant, Cheetah, White Rhino, dan Lion. Selain itu, museum ini juga memiliki koleksi Cats of the World yang menampilkan berbagai jenis kucing dari seluruh dunia."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Rahmat International Wildlife Museum, taxidermi, museum satwa, Medan"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. S. Parman No.309, Petisah Hulu, Kec. Medan Baru, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.579258"^^xsd:decimal ;
    ws:bujur "98.667732"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. S. Parman No. 309, Kelurahan Petisah Hulu, Kecamatan Medan Baru, Kota Medan."@id ;
    ws:jamOperasional "Setiap hari 09.00-17.00 WIB"@id ;
    ws:hargaMasuk "75000"^^xsd:decimal ;
    ws:noHpResmi "+628-11-6126-129"^^xsd:string ;
    ws:emailResmi "rahmatgallery@gmail.com"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/rahmatgallery_id/"^^xsd:anyURI ;
    ws:memilikiFasilitas "perpustakaan"@id ;
    ws:dapatMelakukan "melihat koleksi satwa"@id ;
    ws:dapatMelakukan "edukasi konservasi"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Rahmat_Gallery_-_panoramio.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.6"^^xsd:decimal .

