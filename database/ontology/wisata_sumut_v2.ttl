data:ws-029 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-029"^^xsd:string ;
    ws:namaDestinasi "Danau Toba"@id ;
    ws:namaAlternatif "Tao Toba"@id ;
    ws:deskripsiSingkat "Danau vulkanik terbesar di dunia, kaldera supervulkan Toba."@id ;
    ws:deskripsiLengkap "Danau Toba merupakan danau kawah raksasa di Provinsi Sumatera Utara yang membentang sepanjang 100 kilometer dan lebar 30 kilometer dengan kedalaman hingga 505 meter. Terletak di ketinggian sekitar 900 meter di atas permukaan laut, danau ini lahir dari letusan Gunung Toba Purba—salah satu letusan vulkanik paling kolosal dalam sejarah bumi. Di tengah danau ini terdapat Pulau Samosir, sebuah pulau luas yang menjadi pusat kebudayaan dan tradisi masyarakat Batak Toba. Berkat keunikan geologi dan kekayaan ekosistemnya, kawasan ini resmi diakui sebagai UNESCO Global Geopark sejak Juli 2020."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Toba"@id, "Tao Toba"@id, "Kaldera Toba"@id, "UNESCO Global Geopark"@id, "Vulkanik"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Jl. Siborongborong - Parapat, Sibaganding, Kecamatan Girsang Sipangan Bolon, Kabupaten Simalungun, Sumatera Utara 21174"@id ;
    ws:lintang "2.6967648484483937"^^xsd:decimal ;
    ws:bujur "98.92416232152277"^^xsd:decimal ;
