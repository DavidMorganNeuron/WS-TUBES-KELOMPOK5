data:ws-082 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-082"^^xsd:string ;
    ws:namaDestinasi "Museum Daerah Kabupaten Langkat"@id ;
    ws:namaAlternatif "Gedung Kerapatan Sultan Langkat"@id ;
    ws:deskripsiSingkat "Museum Daerah Kabupaten Langkat menempati Gedung Kerapatan peninggalan Kesultanan Langkat dan menjadi pusat pelestarian sejarah multietnis masyarakat Langkat."@id ;
    ws:deskripsiLengkap "Bangunan yang didirikan pada tahun 1905 ini awalnya berfungsi sebagai balai persidangan serta pusat permusyawaratan elit Kesultanan Langkat. Sempat terbengkalai pasca pengeboman tentara Jepang, bangunan ini direnovasi dan beralih fungsi menjadi museum pada tahun 2003. Museum ini memamerkan berbagai peninggalan kebudayaan suku Melayu, Jawa, dan Karo, serta diorama miniatur sejarah lokal seperti rumah Tengku Amir Hamzah dan singgasana raja. Melalui koleksinya, museum ini menyampaikan potret panjang perjalanan sosial, budaya, dan politik yang pernah membentuk wilayah pesisir Sumatera Utara."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Daerah Langkat"@id, "Kesultanan Langkat"@id, "Tanjung Pura"@id, "Sejarah Melayu"@id ;
    ws:beradaDi "Kabupaten Langkat"@id ;
    ws:alamat "Jl. Amir Hamzah No.1, Kecamatan Tanjung Pura, Kabupaten Langkat, Sumatera Utara 20853"@id ;
    ws:lintang "3.892806"^^xsd:decimal ;
    ws:bujur "98.425556"^^xsd:decimal ;
    ws:petunjukLokasi "Lokasi berdekatan dengan kompleks Masjid Azizi di kota Tanjung Pura."@id ;
    ws:jamOperasional "Senin-Jumat 08.30-16.00"@id ;
