data:ws-056 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-056"^^xsd:string ;
    ws:namaDestinasi "Museum Perjuangan TNI"@id ;
    ws:namaAlternatif "Museum Perjuangan Bukit Barisan"@id,
        "Museum Perjuangan TNI Kodam I"@id ;
    ws:deskripsiSingkat "Museum Perjuangan TNI Kodam I/Bukit Barisan di Medan Petisah merupakan gedung cagar budaya peninggalan kolonial yang menyimpan ratusan koleksi bersejarah serta persenjataan dari masa perjuangan kemerdekaan Indonesia di Sumatera Utara."@id ;
    ws:deskripsiLengkap "Terletak di Jalan KH. Zainul Arifin No. 8, Kecamatan Medan Petisah, bangunan bergaya arsitektur kolonial ini pertama kali didirikan pada tahun 1928 sebagai kantor asuransi sebelum sempat berganti fungsi menjadi markas tentara Jepang, sekutu Inggris, hingga Markas Komando Teritorium I/Kodam I/BB, sebelum akhirnya diresmikan sebagai museum pada 5 Oktober 1996. Di dalam gedung yang telah ditetapkan sebagai bangunan cagar budaya ini, pengunjung dapat menyaksikan sekitar 555 koleksi autentik, mulai dari duplikat bendera Merah Putih pertama yang dikibarkan di Medan, senjata rampasan perang, meriam, hingga perlengkapan medis dan arsip revolusi 1945–1948 yang merekam heroisme para pejuang melawan penjajah."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Kodam I Bukit Barisan"@id, "Museum Militer"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. KH. Zainul Arifin No.8, Petisah Tengah, Kecamatan Medan Petisah, Kota Medan, Sumatera Utara 20151"@id ;
    ws:lintang "3.583930929924635"^^xsd:decimal ;
