data:ws-287 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-287"^^xsd:string ;
    ws:namaDestinasi "Desa Adat Bawomataluo"@id ;
    ws:namaAlternatif "Bawomataluo"@id ;
    ws:namaAlternatif "Bawömataluo"@id ;
    ws:deskripsiSingkat "Bawomataluo adalah desa adat di Kecamatan Fanayama, Kabupaten Nias Selatan, yang dikenal karena rumah adat Nias dan atraksi lompat batu (fahombo)."@id ;
    ws:deskripsiLengkap "Bawomataluo adalah desa adat di Kecamatan Fanayama, Kabupaten Nias Selatan, yang dikenal karena rumah adat Nias dan atraksi lompat batu (fahombo). Desa ini berada di atas bukit sekitar 400 mdpl dan memiliki deretan omo hada (rumah adat) yang berhadapan sepanjang jalan batu, dengan batu megalitik di halaman masing-masing. Atas keaslian dan kelengkapan budayanya, Bawomataluo ditetapkan sebagai cagar budaya peringkat nasional pada 2017."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Bawomataluo, desa adat Nias, lompat batu, fahombo, omo hada"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Desa Bawomataluo, Kec. Fanayama, Kabupaten Nias Selatan, Sumatera Utara"@id ;
    ws:lintang "0.614335"^^xsd:decimal ;
    ws:bujur "97.770376"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Fanayama, Kabupaten Nias Selatan, sekitar 2-3 jam perjalanan darat dari Gunungsitoli."@id ;
    ws:jamOperasional "Setiap hari 08.00-18.00 WIB"@id ;
    ws:hargaMasuk "20000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "area parkir, pemandu lokal, toko suvenir, toilet"@id ;
    ws:dapatMelakukan "menyaksikan lompat batu"@id ;
    ws:dapatMelakukan "menjelajah desa adat"@id ;
    ws:dapatMelakukan "melihat rumah adat"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/COLLECTIE_TROPENMUSEUM_Een_adathuis_in_Bawomataloewo_met_megalieten_en_een_zinken_dak_TMnr_60038140.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "-" .

data:ws-288 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-288"^^xsd:string ;
    ws:namaDestinasi "Bukit Indah Simarjarunjung"@id ;
    ws:namaAlternatif "Simarjarunjung"@id ;
    ws:namaAlternatif "Bukit Indah Simarjarunjung"@id ;
    ws:deskripsiSingkat "Bukit Indah Simarjarunjung adalah kawasan perbukitan di Kecamatan Dolok Pardamean, Kabupaten Simalungun, dengan panorama Danau Toba dan hutan pinus."@id ;
    ws:deskripsiLengkap "Bukit Indah Simarjarunjung adalah kawasan perbukitan di Kecamatan Dolok Pardamean, Kabupaten Simalungun, dengan panorama Danau Toba dan hutan pinus. Berada di gugusan Pegunungan Bukit Barisan pada ketinggian sekitar 1.200 mdpl, kawasan ini dipenuhi warung, kafe, dan spot foto yang menghadap ke danau, sehingga kerap dijuluki \"Bali Baru\". Suhu di sini sejuk dan paling ramai dikunjungi pada pagi hingga sore hari."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Bukit Indah Simarjarunjung, Danau Toba, Simalungun, hutan pinus, panorama"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Jl. Simarjarunjung, Butu Bayu Pane Raja, Kec. Dolok Pardamean, Kabupaten Simalungun, Sumatera Utara 21163"@id ;
    ws:lintang "2.824301"^^xsd:decimal ;
    ws:bujur "98.799627"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Simarjarunjung, Desa Butu Bayu Pane Raja, Kecamatan Dolok Pardamean, Kabupaten Simalungun."@id ;
    ws:jamOperasional "Setiap hari 07.00-18.00 WIB"@id ;
    ws:hargaMasuk "15000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
