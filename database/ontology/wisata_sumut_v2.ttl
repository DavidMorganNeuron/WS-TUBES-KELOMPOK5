data:ws-163 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-163"^^xsd:string ;
    ws:namaDestinasi "Museum Koleksi dan Galeri Raz"@id ;
    ws:namaAlternatif "Raz Collection Museum & Gallery"@id ;
    ws:namaAlternatif "Raz Museum & Gallery"@id ;
    ws:deskripsiSingkat "Museum Koleksi dan Galeri Raz (nama resmi: Raz Collection Museum and Gallery, dikenal juga sebagai Raz Museum and Gallery) adalah museum khusus yang didirikan oleh Rahmawaty Sofyan Raz."@id ;
    ws:deskripsiLengkap "Museum Koleksi dan Galeri Raz (nama resmi: Raz Collection Museum and Gallery, dikenal juga sebagai Raz Museum and Gallery) adalah museum khusus yang didirikan oleh Rahmawaty Sofyan Raz. Museum ini berisi koleksi benda kenang-kenangan dari keluarga Raz. Museum ini diresmikan oleh Menteri Pendidikan periode 2005–2009, Bambang Sudibyo. Raz Museum & Gallery berlokasi di Jl. DR. Mansyur No.162, Kota Medan, Provinsi Sumatera Utara. Raz Museum and Gallery telah diakui oleh Museum Rekor Dunia Indonesia melalui pemberian sejumlah piagam penghargaan yang bergengsi, termasuk \"Sekolah yang memiliki galeri dengan koleksi barang-barang keluarga variasi terbanyak\" dan \"Pemrakarsa berdirinya galeri dengan koleksi barang-barang variasi terbanyak\". Museum ini dikenal karena menampilkan berbagai koleksi unik yang mengundang minat pengunjung. Dengan bangunan galeri tiga lantai, museum ini dirancang dengan penataan yang rapi untuk memberikan pengalaman visual yang memuaskan. Koleksi yang dipamerkan meliputi berbagai barang perabotan, pakaian, perlengkapan pengantin, serta perlengkapan anak-anak dari keluarga Sofyan Raz. Selain itu, museum juga menampilkan berbagai pernak-pernik koleksi dari berbagai negara yang dikunjungi."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Raz Collection Museum, museum keluarga, Medan Sunggal, galeri"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Dr. Mansyur No.162, Tanjung Rejo, Kec. Medan Sunggal, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.56811"^^xsd:decimal ;
    ws:bujur "98.64381"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. Dr. Mansyur No. 162, Tanjung Rejo, Kecamatan Medan Sunggal, Kota Medan."@id ;
    ws:jamOperasional "Senin-Sabtu 08.10-15.30 WIB"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "061-8213-207"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
