data:ws-008 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-008"^^xsd:string ;
    ws:namaDestinasi "Candi Sangkilon"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Candi Sangkilon adalah candi di Kabupaten Padang Lawas, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Terletak di Desa Sangkilon, Kecamatan Lubuk Barumun, Kabupaten Padang Lawas, situs arkeologi yang juga dikenal dengan sebutan Biaro Si Sangkilon ini merupakan bagian dari kompleks percandian kuno di Sumatera Utara yang pernah diteliti oleh arkeolog Belanda Frederic Martin Schnitger pada tahun 1935. Bangunan utamanya memiliki denah dasar berukuran 11 x 11 meter dengan tinggi sisa kaki mencapai sekitar 3,1 meter, dikelilingi oleh tembok pagar serta tiga gundukan kecil yang diyakini sebagai struktur candi perwara. Berdasarkan catatan sejarah dan temuan prasasti lempengan emas beraksara Nagari berbahasa Sanskerta, kompleks ini menjadi bukti penting adanya jalur perdagangan dan penyebaran peradaban Hindu-Buddha di pedalaman Sumatera yang terhubung dengan rute pesisir. Meski telah ditetapkan sebagai cagar budaya, kondisi bangunan saat ini cukup memprihatinkan karena belum sepenuhnya dipugar dan sempat mengalami kerusakan akibat aktivitas pencarian harta karun."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Sangkilon"@id, "Padang Lawas"@id ;
    ws:beradaDi "Kabupaten Padang Lawas"@id ;
    ws:alamat "Sangkilon, Kecamatan Lubuk Barumun, Kabupaten Padang Lawas, Sumatera Utara 22763"@id ;
    ws:lintang "1.1306765535681835"^^xsd:decimal ;
    ws:bujur "99.75461584052053"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak sekitar 400 kilometer ke arah selatan dari Kota Medan."@id ;
