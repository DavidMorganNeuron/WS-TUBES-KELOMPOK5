data:ws-252 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-252"^^xsd:string ;
    ws:namaDestinasi "Rumah Makan Batak Hipas"@id ;
    ws:namaAlternatif "RM Batak Hipas"@id, "Hipas Rumah Makan"@id ;
    ws:deskripsiSingkat "Rumah Makan Batak Hipas adalah tempat makan hidangan tradisional khas Batak yang berlokasi di kawasan Setia Budi, Medan Selayang, Kota Medan, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Rumah Makan Batak Hipas merupakan salah satu destinasi kuliner khas Batak di kawasan Setia Budi, Kota Medan. Tempat ini menyajikan berbagai masakan tradisional Batak yang autentik dengan cita rasa bumbu rempah dan andaliman yang kuat, seperti saksang margota. Untuk melengkapi hidangan, pengunjung juga dapat menikmati minuman khas Sumatera Utara seperti limun Badak dalam suasana bersantap yang nyaman."@id ;
    ws:jenisDestinasi "Kuliner"@id ;
    ws:kataKunci "Rumah Makan Batak Hipas"@id, "Kuliner Batak Medan"@id, "Setia Budi"@id ;
