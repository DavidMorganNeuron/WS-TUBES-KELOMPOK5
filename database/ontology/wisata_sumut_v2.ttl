data:ws-112 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-112"^^xsd:string ;
    ws:namaDestinasi "Museum Huta Bolon Simanindo"@id ;
    ws:namaAlternatif "Museum Huta Bolon"@id, "Huta Bolon Simanindo"@id ;
    ws:deskripsiSingkat "Museum Huta Bolon Simanindo merupakan bekas rumah raja Sidauruk di Pulau Samosir yang dialihfungsikan sebagai pusat pelestarian dan pertunjukan tari tradisional Batak."@id ;
    ws:deskripsiLengkap "Diwariskan dari Kerajaan Sidauruk, Museum Huta Bolon resmi berdiri pada 1969 untuk mengabadikan peradaban kampung (huta) Batak kuno yang dikelilingi benteng pertahanan dari tanaman bambu. Museum ini menampilkan belasan rumah adat Ruma Bolon berjejer rapi menghadap sopo (lumbung padi) yang menyimpan benda-benda pusaka magis peninggalan masa lalu, alat tenun, koleksi tembikar, hingga senjata sisa peperangan antar suku. Daya tarik terbesar di museum ini adalah pementasan budaya tari Tor-tor dan atraksi magis Sigale-gale yang diadakan setiap hari di lapangan utama untuk menghibur wisatawan mancanegara."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Huta Bolon"@id, "Simanindo"@id, "Samosir"@id, "Tari Tor-tor"@id, "Raja Sidauruk"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Simanindo, Kecamatan Simanindo, Kabupaten Samosir, Sumatera Utara 22395"@id ;
    ws:lintang "2.7525"^^xsd:decimal ;
    ws:bujur "98.7445"^^xsd:decimal ;
    ws:petunjukLokasi "Berada persis di tepi jalan lingkar utama Pulau Samosir ujung utara."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "50000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "info@kemenpar.go.id"^^xsd:string ;
    ws:instagramResmi "@samosir_indah"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Toko Suvenir"@id, "Pemandu Wisata"@id, "Area Istirahat"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Mengapresiasi"@id, "Berfoto"@id, "Menonton"@id ;
    ws:memilikiMedia "https://www.tobawisata.com/wp-content/uploads/2025/12/museum-huta-bolon-simanindo.jpeg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.6"^^xsd:decimal .

data:ws-113 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-113"^^xsd:string ;
    ws:namaDestinasi "Desa Wisata Tomok"@id ;
    ws:namaAlternatif "Kampung Tomok"@id, "Tomok"@id ;
    ws:deskripsiSingkat "Desa Wisata Tomok merupakan sentra ekonomi, pintu gerbang budaya, dan surga belanja suvenir di pesisir timur Pulau Samosir."@id ;
    ws:deskripsiLengkap "Melalui pelabuhan feri yang menghubungkannya langsung dengan kota Parapat, Tomok adalah gerbang masuk pertama yang menyambut kedatangan turis ke Pulau Samosir. Sepanjang lorong-lorong desa ini, pengunjung disajikan pasar tumpah tradisional yang menjual ribuan kerajinan tangan lokal, ulos tenun asli, ukiran kayu bernuansa etnik, hingga kaus suvenir khas Danau Toba. Tidak sekadar untuk berbelanja, desa yang padat penduduk ini juga menyimpan nilai sejarah penting seperti makam raja-raja Sidabutar berusia ratusan tahun dan pertunjukan boneka kayu Sigale-gale."@id ;
    ws:jenisDestinasi "Budaya"@id, "Buatan"@id ;
    ws:kataKunci "Desa Tomok"@id, "Samosir"@id, "Danau Toba"@id, "Wisata Belanja"@id, "Pelabuhan Tomok"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Tomok, Kecamatan Simanindo, Kabupaten Samosir, Sumatera Utara 22395"@id ;
    ws:lintang "2.6518011"^^xsd:decimal ;
    ws:bujur "98.8597318"^^xsd:decimal ;
    ws:petunjukLokasi "Dapat diakses langsung via pelayaran feri/kapal wisata dari Pelabuhan Ajibata Parapat menuju Pelabuhan Tomok."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "@tomok.tourism"^^xsd:anyURI ;
