data:ws-150 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-150"^^xsd:string ;
    ws:namaDestinasi "Tjong A Fie Mansion"@id ;
    ws:namaAlternatif "Museum Tjong A Fie"@id,
