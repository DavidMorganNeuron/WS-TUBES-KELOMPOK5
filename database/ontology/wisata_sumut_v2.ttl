    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Beribadah"@id, "Mengapresiasi"@id ;
    ws:memilikiMedia "-"^^xsd:anyURI ;
    ws:ratingPengunjung "4.6"^^xsd:decimal .

data:ws-147 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-147"^^xsd:string ;
    ws:namaDestinasi "Pantai Pelabuhan Lama Sibolga"@id ;
    ws:namaAlternatif "Pelabuhan Lama Sibolga"@id, "Pantai Anggar"@id, "Pelabuhan Anggar"@id ;
    ws:deskripsiSingkat "Pantai Pelabuhan Lama Sibolga, juga dikenal sebagai Pantai Anggar, adalah kawasan pantai di bekas pelabuhan lama Kota Sibolga yang populer untuk menikmati matahari terbenam."@id ;
    ws:deskripsiLengkap "Pantai Pelabuhan Lama Sibolga, atau Pantai Anggar, berada di Jalan Com. Yos Sudarso, Kelurahan Kota Beringin, Kota Sibolga. Kawasan ini semula merupakan Pelabuhan Sibolga yang kemudian beralih fungsi menjadi area pergudangan, hingga Pemerintah Kota Sibolga mulai menatanya sebagai tempat wisata pada tahun 2019. Hamparan pantai yang luas dengan latar laut dan langit sore menjadikannya tempat warga bersantai, berswafoto, menikmati matahari terbenam, dan berenang, bahkan sering dipilih sebagai lokasi pembuatan video klip. Pemerintah kota merencanakan sejumlah fasilitas pendukung di kawasan ini, antara lain panggung hiburan, pusat jajanan kuliner, taman bermain, pusat suvenir, jogging track, fasilitas bilas, dan musala. Lokasinya terbuka sepanjang hari dan paling ramai pada sore hari."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Pelabuhan Lama"@id, "Pelabuhan Lama Sibolga"@id, "Pantai Anggar"@id, "Sibolga"@id, "Matahari Terbenam"@id ;
    ws:beradaDi "Kota Sibolga"@id ;
    ws:alamat "Jl. Com. Yos Sudarso, Kota Beringin, Sibolga Kota, Kota Sibolga, Sumatera Utara 22513"@id ;
    ws:lintang "1.740919"^^xsd:decimal ;
    ws:bujur "98.774155"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di kawasan pelabuhan lama Kota Sibolga."@id ;
    ws:jamOperasional "Setiap hari 24 jam"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
