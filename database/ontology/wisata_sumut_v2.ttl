data:ws-154 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-154"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Dua Warna"@id ;
    ws:namaAlternatif "Air Terjun Dua Warna Sibolangit"@id, "Dua Warna"@id ;
    ws:deskripsiSingkat "Air Terjun Dua Warna adalah air terjun di Desa Durin Sirugun, Kecamatan Sibolangit, Kabupaten Deli Serdang, dengan aliran air dua warna kebiruan yang khas."@id ;
    ws:deskripsiLengkap "Air Terjun Dua Warna adalah air terjun di Desa Durin Sirugun, Kecamatan Sibolangit, Kabupaten Deli Serdang, dengan aliran air dua warna kebiruan yang khas. Kawasan ini berada di kaki Gunung Sibayak dan masih berupa hutan tropis, sehingga pengunjung harus trekking sekitar 2 jam menyusuri jalur yang menantang dan menyeberangi beberapa sungai kecil. Pemandu lokal disarankan untuk keamanan, dengan tarif sekitar Rp100.000-Rp300.000."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Dua Warna"@id, "Sibolangit"@id, "Deli Serdang"@id, "Trekking"@id, "Air Terjun"@id ;
