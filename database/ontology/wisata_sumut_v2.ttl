data:ws-166 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-166"^^xsd:string ;
    ws:namaDestinasi "Museum Sumatera Utara"@id ;
    ws:namaAlternatif "Museum Negeri Sumatera Utara"@id ;
    ws:namaAlternatif "Museum Negeri Provinsi Sumatera Utara"@id ;
    ws:namaAlternatif "Museum Gedung Arca"@id ;
    ws:namaAlternatif "Gedung Arca"@id ;
    ws:namaAlternatif "North Sumatra State Museum"@en ;
    ws:deskripsiSingkat "Museum Sumatera Utara atau yang lebih dikenal warga Sumut Museum Negeri Provinsi Sumatera Utara (disingkat Museum Negeri Provsu) ini terletak di Jln. H.M. Jhoni No. 51, Pasar Merah, Medan."@id ;
    ws:deskripsiLengkap "Museum Sumatera Utara atau yang lebih dikenal warga Sumut Museum Negeri Provinsi Sumatera Utara (disingkat Museum Negeri Provsu) ini terletak di Jln. H.M. Jhoni No. 51, Pasar Merah, Medan. Merupakan Museum terbesar di Sumatera Utara yang menyimpan berbagai peninggalan sejarah budaya bangsa, hasil seni dan kerajinan dari berbagai suku di Sumatera Utara. Museum ini dibangun pada tahun 1954, peletakan batu pertama berupa sepasang makara dilakukan oleh Presiden Soekarno pada tahun 1954, dan diresmikan pada tanggal 19 April 1982 oleh Menteri Pendidikan dan Kebudayaan Daoed Joesoef. Bangunan museum berdiri di atas lahan seluas 10.468 m2, terdiri atas bangunan induk dua lantai yang difungsikan untuk ruang pameran tetap, ruang pameran temporer, ruang audio visual/ceramah, perpustakaan, ruang mikro film, serta gudang. Sampai tahun 2005, Museum Sumatera Utara memiliki 6799 koleksi, terdiri atas replika hewan khas Sumatra, replika fosil manusia purba, diorama kehidupan prasejarah, arca-arca peninggalan zaman Hindu-Budha, peninggalan batu nisan, Al-Qur'an, replika Masjid Azizi, dan perkakas zaman Kolonial Belanda."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Sumatera Utara, Museum Negeri, Gedung Arca, museum terbesar Sumut, Medan"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. HM. Joni No.51, Teladan Barat, Kec. Medan Kota, Kota Medan, Sumatera Utara 20217"@id ;
    ws:lintang "3.568139"^^xsd:decimal ;
    ws:bujur "98.696306"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan H.M. Jhonny No. 51, Pasar Merah, Kecamatan Medan Kota, Kota Medan."@id ;
    ws:jamOperasional "Selasa-Minggu 09.00-16.00 WIB"@id ;
    ws:hargaMasuk "3000"^^xsd:decimal ;
    ws:noHpResmi "061-7366-792"^^xsd:string ;
    ws:emailResmi "museum.sumut@gmail.com"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/museumsumut.official/"^^xsd:anyURI ;
    ws:memilikiFasilitas "area parkir, toilet, food court"@id ;
