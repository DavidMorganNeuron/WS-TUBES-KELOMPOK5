data:ws-196 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-196"^^xsd:string ;
    ws:namaDestinasi "Pantai Cemara Kembar"@id ;
    ws:namaAlternatif "Cemara Kembar Beach"@id ;
    ws:deskripsiSingkat "Pantai di pesisir Selat Malaka dengan deretan cemara laut dan dermaga kayu, terletak di Desa Sei Nagalawan, Kecamatan Perbaungan, Kabupaten Serdang Bedagai."@id ;
    ws:deskripsiLengkap "Pantai Cemara Kembar berada di Jalan Pantai ATP, Desa Sei Nagalawan, Kecamatan Perbaungan, Kabupaten Serdang Bedagai, sekitar satu jam perjalanan dari Medan melalui jalan tol. Pantai ini dikelola swasta bersama pemerintah daerah dengan konsep paket: tiket masuk sudah mencakup parkir, pondok, tikar, dan satu minuman. Deretan pohon cemara laut memberi keteduhan, sementara dermaga kayu dan ornamen perahu menjadi latar foto favorit. Tersedia kantin seafood, wahana flying fox berbayar, dan area bermain anak; pengunjung datang pagi untuk berenang ringan atau sore untuk menikmati senja."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Cemara Kembar, Sei Nagalawan, Perbaungan, Serdang Bedagai, pantai Selat Malaka"@id ;
    ws:beradaDi "Kabupaten Serdang Bedagai"@id ;
    ws:alamat "Jl. Pantai ATP No. 15, Desa Sei Nagalawan, Kec. Perbaungan, Kab. Serdang Bedagai, Sumatera Utara 20987"@id ;
    ws:lintang "3.618720"^^xsd:decimal ;
    ws:bujur "99.004200"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, ambil Tol Medan-Tebing Tinggi lalu keluar di Perbaungan; lanjutkan ke arah pantai melalui Jalan Pantai ATP sekitar 12 km."@id ;
    ws:jamOperasional "Setiap hari 08.00-19.00 WIB"@id ;
    ws:hargaMasuk "40000"^^xsd:decimal ;
