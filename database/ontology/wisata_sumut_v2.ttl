data:ws-037 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-037"^^xsd:string ;
    ws:namaDestinasi "Gunung Toba"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Gunung Toba adalah gunung berapi supervulkan purba yang terletak di Provinsi Sumatera Utara."@id ;
    ws:deskripsiLengkap "Gunung Toba adalah gunung berapi supervulkan purba yang terletak di Provinsi Sumatera Utara. Sebagai salah satu supervolcano paling aktif dalam sejarah bumi, Gunung Toba tercatat pernah mengalami tiga letusan besar, dengan letusan terakhir sekitar 74.000 tahun lalu sebagai yang paling mematikan karena memuntahkan lebih dari 2.800 kilometer kubik material vulkanik ke atmosfer. Ledakan dahsyat berkategori skala 8 VEI (Volcanic Explosivity Index) ini memicu musim dingin vulkanik global yang menurunkan suhu bumi secara drastis serta menyebarkan abu sulfur hingga ke wilayah India dan Afrika. Pasca-letusan hebat tersebut, dinding gunung yang runtuh membentuk kaldera masif sepanjang 100 kilometer dan lebar 30 kilometer, yang seiring berjalannya waktu terisi air hingga menjadi Danau Toba yang megah, dengan Pulau Samosir di tengahnya yang terbentuk akibat desakan magma dari bawah danau."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Supervulkan"@id, "Toba"@id, "Kaldera"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Ronggur Nihuta, Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara"@id ;
    ws:lintang "2.617567190109934"^^xsd:decimal ;
    ws:bujur "98.81670985827797"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Provinsi Sumatera Utara dan melintasi beberapa kabupaten; kalderanya kini terisi air dan dikenal sebagai Danau Toba. Nilai beradaDi merujuk pada Kabupaten Toba sebagai wilayah inti kaldera."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Toko Oleh-Oleh"@id ;
    ws:dapatMelakukan "Mendaki"@id, "Berfoto"@id,
        "Menikmati Pemandangan"@id, "Berkemah"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Kaldera_Danau_Toba.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.4"^^xsd:decimal .

