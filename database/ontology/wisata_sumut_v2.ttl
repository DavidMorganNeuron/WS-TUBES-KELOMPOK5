data:ws-190 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-190"^^xsd:string ;
    ws:namaDestinasi "Mora Waterpark"@id ;
    ws:namaAlternatif "Mora Indah"@id ;
    ws:deskripsiSingkat "Mora Waterpark adalah taman bermain air di Kecamatan Tanjung Morawa, Kabupaten Deli Serdang, yang dibuka kembali pada 2025 setelah lama tidak beroperasi."@id ;
    ws:deskripsiLengkap "Mora Waterpark berada di Desa Bangun Mulia, Kecamatan Tanjung Morawa, Kabupaten Deli Serdang, dan merupakan kebangkitan taman air legenda Mora Indah yang kembali dibuka pada awal 2025 dengan wajah baru. Kawasan ini mengusung suasana pantai buatan dengan kolam berombak, perosotan, kolam anak, dan area bersantai di gazebo. Fasilitas pendukung seperti loker gratis, kamar bilas, restoran, dan penjualan oleh-oleh tersedia di dalam kawasan."@id ;
