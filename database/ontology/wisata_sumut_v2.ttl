    ws:bujur "98.907161"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Bah Butong I, Kecamatan Sidamanik, Kabupaten Simalungun, sekitar 30 km dari Kota Pematang Siantar."@id ;
