data:ws-230 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-230"^^xsd:string ;
    ws:namaDestinasi "Goa Ergendang"@id ;
    ws:namaAlternatif "Gua Ergendang"@id ;
    ws:deskripsiSingkat "Goa alam di Kecamatan Sibolangit, Kabupaten Deli Serdang, yang terbentuk dari batuan kapur dan berada di tepi jalan menuju Berastagi."@id ;
    ws:deskripsiLengkap "Goa Ergendang terletak di Kecamatan Sibolangit, Kabupaten Deli Serdang, di lereng bukit kapur yang menghadap jalan utama Medan-Berastagi. Goa ini memiliki lorong dan ruang yang cukup luas dengan stalaktit serta dinding berlumut, dan sebagian lantainya dialiri air. Pengunjung masuk dengan pemandu lokal menggunakan lampu. Fasilitas di luar goa mencakup area parkir, toilet, warung makan, dan gazebo. Tiket masuk tiga belas ribu rupiah per orang. Karena lantai licin, pengunjung disarankan memakai alas kaki bersol kuat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Goa Ergendang, Sibolangit, Deli Serdang, goa kapur, stalaktit"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Kec. Sibolangit, Kab. Deli Serdang, Sumatera Utara"@id ;
    ws:lintang "3.259400"^^xsd:decimal ;
    ws:bujur "98.536200"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, ikuti Jalan Letjen Jamin Ginting ke arah Berastagi; goa berada di sisi jalan sebelum pusat Sibolangit."@id ;
    ws:jamOperasional "Setiap hari 08.00-20.00 WIB"@id ;
    ws:hargaMasuk "13000"^^xsd:decimal ;
    ws:noHpResmi "" ;
