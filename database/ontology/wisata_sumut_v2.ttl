data:ws-032 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-032"^^xsd:string ;
    ws:namaDestinasi "Milky Verse Tebing Tinggi"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Milky Verse Tebing Tinggi merupakan wahana permainan indoor bertema luar angkasa yang terletak di lantai 3 Ramayana Tebing Tinggi dengan menyediakan lebih dari 20 jenis wahana interaktif untuk anak-anak hingga orang dewasa."@id ;
    ws:deskripsiLengkap "Milky Verse Tebing Tinggi menghadirkan konsep wisata rekreasi keluarga berbasis petualangan antarbintang yang bisa dinikmati oleh pengunjung dari usia 1 tahun hingga dewasa. Tempat bermain ini dilengkapi dengan berbagai fasilitas seru seperti kolam bola, trampolin, seluncuran (spiral slide), dinding panjat bertema planet (planet wall climbing), hingga party room untuk acara spesial. Dibuka secara resmi pada 22 Desember 2024, destinasi ini dirancang tidak hanya sebagai sarana hiburan (healing), tetapi juga tempat bermain sambil belajar yang memberikan sensasi imajinatif ala astronot bagi masyarakat Kota Tebing Tinggi dan sekitarnya."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "-"@id ;
