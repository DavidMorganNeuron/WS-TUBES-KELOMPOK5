    ws:alamat "Desa Tongging, Kec. Merek, Kab. Karo, Sumatera Utara 22173"@id ;
    ws:lintang "2.910110"^^xsd:decimal ;
    ws:bujur "98.519520"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Berastagi, berkendara sekitar 30 menit ke arah Merek lalu turun ke Desa Tongging; lokasi berada di dekat Sipiso-piso."@id ;
    ws:jamOperasional "Senin-Minggu 08.00-18.00"@id ;
