    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-086 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-086"^^xsd:string ;
    ws:namaDestinasi "Candi Bahal I"@id ;
    ws:namaAlternatif "Biaro Bahal I"@id, "Candi Portibi"@id ;
    ws:deskripsiSingkat "Candi Bahal I adalah peninggalan purbakala Buddha beraliran Vajrayana abad ke-11 dari Kerajaan Pannai yang berlokasi di Padang Lawas Utara."@id ;
    ws:deskripsiLengkap "Terletak di Desa Bahal, Candi Bahal I merupakan bangunan candi bata merah terbesar dalam kompleks percandian Bahal (Biaro Bahal). Dibangun pada masa kejayaan Kerajaan Pannai, candi ini memiliki struktur yang sangat identik dengan candi-candi di Muara Takus maupun peradaban Chola di India, dengan atap berbentuk stupa silindris. Pada dinding luar candi, pengunjung dapat melihat sisa-sisa relief unik berbentuk singa dan sosok raksasa (yaksa) yang berfungsi sebagai penjaga arah mata angin, yang menjadi daya tarik utama bagi para arkeolog maupun wisatawan sejarah."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Bahal I"@id, "Biaro Bahal"@id, "Candi Portibi"@id, "Kerajaan Pannai"@id, "Padang Lawas Utara"@id ;
    ws:beradaDi "Kabupaten Padang Lawas Utara"@id ;
    ws:alamat "Desa Bahal, Kecamatan Portibi, Kabupaten Padang Lawas Utara, Sumatera Utara 22751"@id ;
    ws:lintang "1.40879"^^xsd:decimal ;
    ws:bujur "99.7288"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak sekitar 3 jam dari Kota Padang Sidempuan melintasi Jalan Raya Portibi."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
