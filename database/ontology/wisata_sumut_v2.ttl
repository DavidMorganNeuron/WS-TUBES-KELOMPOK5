data:ws-210 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-210"^^xsd:string ;
    ws:namaDestinasi "Istana Sisingamangaraja"@id ;
    ws:namaAlternatif "Istana Raja Sisingamangaraja"@id,
        "Kompleks Bakkara"@id ;
    ws:deskripsiSingkat "Kompleks rumah adat dan makam dinasti Sisingamangaraja di Desa Simamora, Kecamatan Baktiraja, Kabupaten Humbang Hasundutan."@id ;
    ws:deskripsiLengkap "Istana Sisingamangaraja berada di Desa Simamora, Kecamatan Baktiraja, Kabupaten Humbang Hasundutan, di lembah Bakkara yang menjadi pusat pemerintahan dinasti Sisingamangaraja sejak abad ke-16. Kompleks ini terdiri atas tiga bangunan utama, yaitu Sopo Parsaktian, Ruma Bolon, dan Sopo Bolon, serta makam Sisingamangaraja X dan XI. Dinding bangunan dihiasi ukiran gorga berwarna merah, putih, dan hitam. Pengunjung dapat mengelilingi kompleks, melihat koleksi pusaka, dan mendengar penjelasan juru kunci. Tiket masuk lima ribu rupiah per orang; pada hari tertentu biaya masuk bersifat sukarela."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Istana Sisingamangaraja, Bakkara, Baktiraja, Humbang Hasundutan, rumah adat Batak, gorga"@id ;
