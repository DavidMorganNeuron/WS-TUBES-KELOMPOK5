data:ws-035 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-035"^^xsd:string ;
    ws:namaDestinasi "Gunung Sinabung"@id ;
    ws:namaAlternatif "Sinabung"@id ;
    ws:deskripsiSingkat "Gunung Sinabung (bahasa Batak Karo: Deleng Sinabung) adalah gunung api di Dataran Tinggi Karo, Kabupaten Karo, Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Gunung Sinabung (bahasa Batak Karo: Deleng Sinabung) adalah gunung api di Dataran Tinggi Karo, Kabupaten Karo, Sumatera Utara, Indonesia. Sinabung, bersama Gunung Sibayak di dekatnya, adalah dua gunung berapi aktif di Sumatera Utara dan menjadi puncak tertinggi ke 2 (2.460 mdpl) di provinsi Sumatera Utara setelah Gunung Sibuatan. Dulu dikategorikan sebagai gunung api tipe B karena tidak memiliki catatan sejarah letusan sejak tahun 1600-an, gunung ini secara mengejutkan kembali aktif dan mengalami erupsi freatik pada Agustus 2010. Sejak saat itu, Sinabung mencatat sejarah panjang aktivitas vulkanik eksplosif, pembentukan kubah lava, serta luncuran awan panas yang mengubah lanskap dan memaksa relokasi beberapa desa di sekitarnya. Saat ini, aktivitas vulkaniknya terus dipantau secara ketat oleh PVMBG dengan status siaga dan zona larangan demi keselamatan warga."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Gunung Berapi"@id, "Dataran Tinggi Karo"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Kuta Gugung, Kecamatan Naman Teran, Kabupaten Karo, Sumatera Utara"@id ;
    ws:lintang "3.170255913704568"^^xsd:decimal ;
    ws:bujur "98.39316298221439"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Dataran Tinggi Karo, Kabupaten Karo, sekitar 2,5 jam dari Kota Medan."@id ;
    ws:jamOperasional "Ditutup Sementara"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
