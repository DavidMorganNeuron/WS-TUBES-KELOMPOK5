    ws:lintang "3.689796"^^xsd:decimal ;
    ws:bujur "98.073212"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Namu Sialang, Kecamatan Batang Serangan, Kabupaten Langkat, sekitar 3 jam perjalanan dari Kota Medan."@id ;
