data:ws-010 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-010"^^xsd:string ;
    ws:namaDestinasi "Timezone Medan Fair"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Timezone Plaza Medan Fair di Lantai 4, Kecamatan Medan Petisah, adalah pusat hiburan keluarga ikonik yang hadir dengan wajah baru dan luas sejak pembukaan kembali pada 9 Juli 2025."@id ;
    ws:deskripsiLengkap "Berlokasi strategis di Lantai 4 Plaza Medan Fair, Kecamatan Medan Petisah, Timezone ini menempati area seluas 1.635,42 meter persegi dengan penambahan area permainan lebih dari 1.000 meter persegi yang telah diperbarui secara besar-besaran. Tempat bermain keluarga legendaris yang sudah ada sejak Plaza Medan Fair dibuka pada September 2004 ini kini menghadirkan wahana-wahana eksklusif pertama di Medan dan Sumatera seperti Colour Grid dan VR Space Ride 4P, serta fasilitas pendukung berupa Party Room berkapasitas hingga 24 orang untuk berbagai acara spesial."@id ;
