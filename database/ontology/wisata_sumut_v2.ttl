data:ws-134 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-134"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Linggahara"@id ;
    ws:namaAlternatif "Linggahara"@id, "Air Terjun Kembar Linggahara"@id ;
    ws:deskripsiSingkat "Air Terjun Linggahara adalah destinasi alam andalan Rantauprapat yang menampilkan debit air kembar mengalir membelah rimbunnya hutan Labuhanbatu."@id ;
    ws:deskripsiLengkap "Air Terjun Linggahara, yang berada di kaki perbukitan Bukit Barisan, menawarkan surga tersembunyi berupa dua aliran air terjun berdampingan (kembar) yang tidak terlalu tinggi (sekitar 15 meter) namun sangat jernih dan tak pernah surut di musim kemarau. Keunikan dari air terjun ini adalah adanya formasi bebatuan raksasa yang bisa dijadikan pijakan tepat di bawah jatuhnya air. Pihak pengelola swadaya masyarakat secara aktif merawat kelestarian area ini dengan menambahkan gazebo panggung di antara pepohonan serta jalur pejalan kaki yang aman tanpa merusak ekosistem hutan sekitarnya."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Linggahara"@id, "Linggahara"@id, "Rantauprapat"@id, "Labuhanbatu"@id, "Wisata Alam"@id ;
    ws:beradaDi "Kabupaten Labuhanbatu"@id ;
    ws:alamat "Desa Lobusona, Kecamatan Rantau Selatan, Kabupaten Labuhanbatu, Sumatera Utara 21421"@id ;
    ws:lintang "2.0477"^^xsd:decimal ;
    ws:bujur "99.8147"^^xsd:decimal ;
    ws:petunjukLokasi "Masuk melalui jalur Aek Paing Rantauprapat dengan waktu tempuh sekitar 30 menit dari pusat kota."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
