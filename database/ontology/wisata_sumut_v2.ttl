    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-045 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-045"^^xsd:string ;
    ws:namaDestinasi "Timezone Brastagi Cemara Medan"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Timezone Brastagi Supermarket Cemara Medan adalah destinasi hiburan keluarga modern yang berlokasi di dalam kompleks Brastagi Supermarket Cemara Medan, menghadirkan beragam pilihan permainan arcade seru untuk anak-anak hingga dewasa."@id ;
    ws:deskripsiLengkap "Arena bermain ini menjadi bagian dari konsep baru cabang ke-6 Brastagi Supermarket yang diresmikan pada akhir Oktober 2024. Di tempat ini, pengunjung dapat menikmati berbagai wahana permainan interaktif—mulai dari mesin capit boneka, permainan basket, hingga deretan game arcade modern yang tiketnya dapat dikumpulkan untuk ditukar dengan berbagai hadiah menarik. Kehadirannya melengkapi pengalaman belanja harian keluarga di supermarket tersebut sehingga pengunjung bisa berbelanja kebutuhan pokok sekaligus berekreasi dalam satu lokasi yang nyaman dan mudah dijangkau."@id ;
