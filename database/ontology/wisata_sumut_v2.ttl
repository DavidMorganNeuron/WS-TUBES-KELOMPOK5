data:ws-115 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-115"^^xsd:string ;
    ws:namaDestinasi "Huta Siallagan"@id ;
    ws:namaAlternatif "Batu Persidangan Siallagan"@id, "Desa Siallagan"@id ;
    ws:deskripsiSingkat "Huta Siallagan adalah perkampungan kuno marga Siallagan yang masyhur akan situs purbakala Batu Persidangan dan riwayat hukum pancungnya yang tegas."@id ;
    ws:deskripsiLengkap "Dibangun pada masa pemerintahan Raja Laga Siallagan, kampung yang dikelilingi tembok batu dan rumpun bambu pelindung ini menjadi salah satu peninggalan terpenting di Ambarita, Pulau Samosir. Di tengah pelataran huta yang dipercantik oleh deretan rumah panggung Bolon berusia 200 tahun, tersusun kursi dan meja melingkar dari batuan andesit (Batu Persidangan) tempat para raja zaman dahulu mengadili pelanggar hukum berat. Konon, pelaku kejahatan magis maupun pembunuh akan dijatuhi hukuman penggal di tempat eksekusi yang terletak tak jauh dari meja batu tersebut, yang prosesinya selalu diceritakan dengan sangat teatrikal oleh pemandu lokal."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Huta Siallagan"@id, "Ambarita"@id, "Batu Persidangan"@id, "Samosir"@id, "Sejarah Batak"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Ambarita, Kecamatan Simanindo, Kabupaten Samosir, Sumatera Utara 22395"@id ;
    ws:lintang "2.6790415"^^xsd:decimal ;
    ws:bujur "98.8362653"^^xsd:decimal ;
