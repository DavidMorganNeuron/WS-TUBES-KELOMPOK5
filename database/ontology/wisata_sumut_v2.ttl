data:ws-022 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-022"^^xsd:string ;
    ws:namaDestinasi "Danau Siais"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Danau Siais di Desa Rianiate, Kecamatan Angkola Sangkunur, merupakan danau alami terbesar kedua di Provinsi Sumatera Utara setelah Danau Toba dengan luas sekitar 4.500 hektare."@id ;
    ws:deskripsiLengkap "Terletak di Desa Rianiate dan Desa Malombu, Danau Siais menyuguhkan pesona perairan jernih bernuansa kebiruan yang dikelilingi oleh bentang alam perbukitan hijau serta hutan tropis yang masih alami. Dengan luas mencapai kurang lebih 4.500 hektare, danau ini tidak hanya menjadi habitat bagi berbagai jenis ikan air tawar seperti ikan mas, nila, dan mujair yang dikelola warga melalui keramba jaring apung, tetapi juga menyimpan kearifan lokal serta potensi ekowisata yang mulai dikembangkan oleh pemerintah daerah. Para pengunjung yang menempuh perjalanan darat sekitar dua jam dari Kota Padang Sidempuan dapat menikmati ketenangan alam, memancing, berkemah, hingga menyaksikan ekosistem pulau-pulau kecil dari tumpukan tumbuhan air yang mengapung di tengah danau."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Siais"@id, "Angkola Sangkunur"@id, "Tapanuli Selatan"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "Rianiate, Kecamatan Angkola Sangkunur, Kabupaten Tapanuli Selatan, Sumatera Utara"@id ;
    ws:lintang "1.3247673330181091"^^xsd:decimal ;
    ws:bujur "98.99848229695259"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Kota Medan, berkendaralah ke arah selatan melalui Jalan Lintas Sumatera menuju Padangsidimpuan, lalu lanjutkan perjalanan via Batang Toru menuju Kelurahan Rianiate di Kecamatan Angkola Sangkunur, Tapanuli Selatan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Gazebo"@id, "Rumah Makan"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Memancing"@id,
        "Menikmati Pemandangan"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Danau_Siais_kabupaten_Tapanuli_Selatan.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-023 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-023"^^xsd:string ;
    ws:namaDestinasi "Danau Sidihoni"@id ;
    ws:namaAlternatif "Tao Sidihoni"@id ;
    ws:deskripsiSingkat "Danau di atas Pulau Samosir, dikenal sebagai \"danau di atas danau\"."@id ;
    ws:deskripsiLengkap "Danau Sidihoni (bahasa Batak Toba: Tao Sidihoni) adalah sebuah danau yang terletak di Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara. Oleh karena berada di atas Pulau Samosir, Danau Sidihoni disebut sebagai \"danau di atas danau\" (di atas Danau Toba). Danau Sidihoni berjarak 8 kilometer dari Pangururan. Pemandangan di sekitar danau bisa dipantulkan oleh air danau. Danau ini dikelilingi oleh bukit landai berwarna hijau muda dan deretan pohon pinus.Danau Sidinohi merupakan danau yang berada di atas danau. Danau Sidihoni dikenal memiliki pemandangan alam yang memukau dan suasana yang sejuk, dan menawarkan daya tarik tersendiri yang jarang ada di tempat lain. Warna air di danau ini dapat berubah sesuai dengan keadaan lingkungan sekitarnya. Dalam kondisi di mana terjadi proses sedimentasi tertentu, air di danau ini akan memiliki warna cenderung kecoklatan. Terdapat juga faktor lainnya yang dapat menyebabkan perubahan warna air danau, seperti angin yang dapat memberi guncangan pada air hingga dasar. Wisata Untuk dapat mencapai danau ini, wisatawan dapat melalui rute Pangururan menggunakan kendaraan roda dua maupun roda empat. Pertama, kunjungi Pelabuhan Parapet dan menaiki kapal menuju Pelabuhan Tomok di Pulau Samosir. Lanjutkan perjalanan selanjutnya menuju ke Pangururan lalu ikuti petunjuk arah menuju Danau Sidihoni. Markah tanah yang paling terkenal di sekitar danau ini adalah bangunan gereja HKBP Sidihoni."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Sidihoni"@id, "Tao Sidihoni"@id, "Danau di Atas Danau"@id, "Ronggur Nihuta"@id, "Samosir"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Salaon Toba, Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara"@id ;
    ws:lintang "2.602254587969435"^^xsd:decimal ;
    ws:bujur "98.74467811225207"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Ronggur Nihuta, Kabupaten Samosir, sekitar 8 km dari Pangururan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
