data:ws-193 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-193"^^xsd:string ;
    ws:namaDestinasi "Pantai Parbaba"@id ;
    ws:namaAlternatif "Pantai Parbaba Dolok"@id,
        "Pantai Pasir Putih Parbaba"@id ;
    ws:deskripsiSingkat "Pantai berpasir putih di tepi Danau Toba, Desa Parbaba Dolok, Kecamatan Pangururan, Kabupaten Samosir, yang populer untuk bermain perahu dan menikmati matahari terbenam."@id ;
    ws:deskripsiLengkap "Pantai Parbaba berada di Desa Parbaba Dolok, Kecamatan Pangururan, Kabupaten Samosir, di tepi Danau Toba. Hamparan pasir putihnya landai dan air danau tergolong tenang sehingga sering dipakai keluarga untuk bermain di tepi air, berperahu, atau mencoba wahana air seperti banana boat dan speed boat yang dikelola warga. Kawasan ini juga punya deretan pondok, warung makan, dan spot foto menghadap perbukitan di seberang danau. Pengunjung umumnya datang pagi untuk udara sejuk atau sore untuk mengejar matahari terbenam; akhir pekan dan musim liburan membuat area parkir cepat penuh."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Parbaba, Pasir Putih Parbaba, Pangururan, Samosir, Danau Toba, pantai danau"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Parbaba Dolok, Kec. Pangururan, Kab. Samosir, Sumatera Utara"@id ;
    ws:lintang "2.695565"^^xsd:decimal ;
    ws:bujur "98.689837"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Pangururan, ikuti jalan lingkar Samosir ke arah utara sekitar 8 km hingga plang Pantai Parbaba di sisi kanan jalan."@id ;
