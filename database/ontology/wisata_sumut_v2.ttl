data:ws-084 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-084"^^xsd:string ;
    ws:namaDestinasi "Sorake"@id ;
    ws:namaAlternatif "Pantai Sorake"@id ;
    ws:deskripsiSingkat "Pantai Sorake merupakan destinasi bahari unggulan berskala internasional di Nias Selatan yang tersohor akan gulungan ombak raksasanya yang ideal bagi peselancar."@id ;
    ws:deskripsiLengkap "Menghadap langsung ke perairan terbuka Samudra Hindia, Pantai Sorake di Kecamatan Luahagundre Maniamolo menyajikan ombak spektakuler yang konon bisa menggulung hingga 15 meter pada musim puncak (April hingga September). Karakter ombak di pantai ini memiliki 11 kali gelombang sebelum pecah dengan lima tingkatan yang sangat menantang adrenalin surfer kelas dunia. Selain menjadi tuan rumah kejuaraan selancar Nias Open setiap tahunnya, tepi pantainya yang dihiasi formasi terumbu karang unik juga dikelilingi oleh banyak homestay bernuansa tropis yang nyaman bagi pelancong mancanegara."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Sorake"@id, "Surfing"@id, "Ombak"@id, "Nias Selatan"@id, "Lagundri"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Desa Botohilitano, Kecamatan Luahagundre Maniamolo, Kabupaten Nias Selatan, Sumatera Utara 22865"@id ;
    ws:lintang "0.573202"^^xsd:decimal ;
    ws:bujur "97.732281"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak bersebelahan dengan Pantai Lagundri, dapat dicapai lewat jalur darat dari Teluk Dalam."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Penginapan"@id, "Rumah Makan"@id, "Toilet"@id, "Sewa Peralatan"@id ;
    ws:dapatMelakukan "Berselancar"@id, "Berenang"@id, "Bersantai"@id, "Berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Pantai_Sorake.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.7"^^xsd:decimal .

data:ws-085 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-085"^^xsd:string ;
    ws:namaDestinasi "Candi Sipamutung"@id ;
    ws:namaAlternatif "Biaro Sipamutung"@id ;
    ws:deskripsiSingkat "Candi Sipamutung merupakan candi Hindu-Buddha terbesar di Kompleks Percandian Padang Lawas, peninggalan kejayaan Kerajaan Pannai pada abad ke-11."@id ;
    ws:deskripsiLengkap "Berdiam dalam keheningan dataran rendah di tepi Sungai Barumun, Candi Sipamutung (Biaro Sipamutung) mendominasi lahan seluas 6.000 meter persegi dengan material susunan bata merah tebal. Kompleks megah ini terdiri atas sebuah bangunan induk setinggi 13 meter yang dikelilingi oleh 6 candi perwara serta sisa dari 16 stupa. Candi yang diproyeksikan sebagai pusat ritual keagamaan masa lampau ini tidak hanya merepresentasikan kemajuan teknik arsitektur pada eranya, tetapi juga memperlihatkan kuatnya interaksi budaya spiritual Nusantara dengan pengaruh peradaban dari tanah seberang di abad pertengahan."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Sipamutung"@id, "Kerajaan Pannai"@id, "Sungai Barumun"@id, "Siparau"@id, "Barumun Tengah"@id ;
    ws:beradaDi "Kabupaten Padang Lawas"@id ;
    ws:alamat "Desa Siparau, Kecamatan Barumun Tengah, Kabupaten Padang Lawas, Sumatera Utara 22775"@id ;
    ws:lintang "1.39273"^^xsd:decimal ;
    ws:bujur "99.75465"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di dekat tepian aliran Sungai Barumun, berjarak sekitar 40 km dari Sibuhuan."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/candisipamutung?obrf=M3phYWd0b3gybzBk"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id ;
    ws:dapatMelakukan "Menelusuri"@id, "Mengapresiasi"@id, "Berfoto"@id ;
