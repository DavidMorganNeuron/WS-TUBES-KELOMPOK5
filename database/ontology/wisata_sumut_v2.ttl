data:ws-036 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-036"^^xsd:string ;
    ws:namaDestinasi "Gunung Sorik Marapi"@id ;
    ws:namaAlternatif "Sorik Marapi"@id ;
    ws:deskripsiSingkat "Sorik Marapi (Surat Batak: ᯑᯬᯞᯬᯄ᯦᯲ ᯚᯬᯒᯪᯄ᯦᯲ ᯔᯒᯇᯪ, translit."@id ;
    ws:deskripsiLengkap "Sorik Marapi (Surat Batak: ᯑᯬᯞᯬᯄ᯦᯲ ᯚᯬᯒᯪᯄ᯦᯲ ᯔᯒᯇᯪ, translit. Dolok Sorik Marapi) adalah sebuah gunung yang masuk dalam kawasan Taman Nasional Batang Gadis, secara administratif berada di Desa Sibanggor Julu, Kecamatan Puncak Sorik Marapi, Kabupaten Mandailing Natal, Sumatera Utara. Sorik Marapi merupakan gunung berapi aktif yang berketinggian 2.145 meter. Koordinat puncak gunung adalah 0°41' 11\" LS and 99° 32' 13\" BT. Di puncaknya terdapat sebuah danau vulkanik. Gunung ini tercatat pernah meletus sebanyak tujuh kali. Masing-masing pada tahun 1830, 1879, 1892, 1893, 1917, 1970, 1986 dan terakhir pada tahun 1987. Pada letusan terakhir, Sorik Marapi memuntahkan debu dan lahar panas yang mengalir sampai ke Kabupaten Pasaman di Sumatera Barat. Gunung Sorik Marapi adalah salah satu gunung yang masuk dalam kategori aktif normal, oleh karena itu gunung ini terus diamati aktivitasnya. Pos Pengamatan Gunung Api Gunung Sorik Marapi terletak di Desa Sibanggor Tonga Kecamatan Puncak Sorik Marapi. Dari Tahun 2013 di sekitaran gunung Sorik Marapi sedang dilakukan proyek Raksasa oleh PT SMGP/OTP Sorik Marapi yaitu proyek pemanfaatan energi panas bumi."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Gunung Sorik Marapi, Sorik Marapi, Taman Nasional Batang Gadis, Mandailing Natal"@id ;
    ws:beradaDi "Kabupaten Mandailing Natal"@id ;
    ws:alamat "-"@id ;
    ws:lintang "0.686"^^xsd:decimal ;
    ws:bujur "99.539"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Sibanggor Julu, Kecamatan Puncak Sorik Marapi, Kabupaten Mandailing Natal, dalam kawasan Taman Nasional Batang Gadis."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
