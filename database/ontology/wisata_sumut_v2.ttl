data:ws-122 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-122"^^xsd:string ;
    ws:namaDestinasi "Pantai Pasir Putih Parbaba"@id ;
    ws:namaAlternatif "Pantai Parbaba"@id ;
    ws:deskripsiSingkat "Pantai Pasir Putih Parbaba adalah primadona rekreasi keluarga di Pangururan dengan pasir halus, air dangkal, serta atraksi olahraga air lengkap."@id ;
    ws:deskripsiLengkap "Menyajikan atmosfer layaknya pesisir lautan Bali, Pantai Parbaba menjadi tempat liburan wajib wisatawan karena dikelola dengan amat sangat terorganisir. Garis pantainya didominasi endapan pasir kuarsa berwarna keputihan dan deretan pohon pinus rindang yang menjanjikan kesejukan meskipun di bawah terik matahari. Kawasan ini merupakan sentra water sport terbesar di sekitaran Samosir, memberikan fasilitas seru mulai dari banana boat, jet ski, kano, hingga voli pantai, serta barisan panjang pondok penjual makanan khas batak maupun penganan instan."@id ;
    ws:jenisDestinasi "Bahari"@id, "Buatan"@id ;
    ws:kataKunci "Pantai Parbaba"@id, "Pasir Putih"@id, "Pangururan"@id, "Samosir"@id, "Wisata Air"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Huta Bolon, Desa Siopat Sosor, Kecamatan Pangururan, Kabupaten Samosir, Sumatera Utara 22392"@id ;
    ws:lintang "2.658"^^xsd:decimal ;
    ws:bujur "98.705"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak sekitar 15 km utara dari pusat kota Pangururan melewati jalan lingkar Danau Toba."@id ;
