data:ws-168 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-168"^^xsd:string ;
    ws:namaDestinasi "Pasar Buah Berastagi"@id ;
    ws:namaAlternatif "Pasar Buah Brastagi"@id ;
    ws:deskripsiSingkat "Pasar Buah Berastagi adalah pasar buah dan sayur di Kecamatan Berastagi, Kabupaten Karo, yang menjual hasil panen segar dataran tinggi Karo."@id ;
    ws:deskripsiLengkap "Pasar Buah Berastagi adalah pasar yang berada di Jalan Gundaling, Kecamatan Berastagi, Kabupaten Karo, dan menjadi pusat penjualan buah serta sayur hasil pertanian dataran tinggi Karo. Lapak pedagang menawarkan jeruk, markisa, dan stroberi segar, jambu biji, alpukat, sayuran, bumbu, serta aneka camilan dan oleh-oleh. Suasananya menjadi langkah pertama wisatawan untuk mengenal hasil bumi Tanah Karo, sekaligus tempat mencicipi stroberi celup cokelat yang dijual di sepanjang lorong pasar."@id ;
    ws:jenisDestinasi "Kuliner"@id ;
    ws:kataKunci "Pasar Buah Berastagi"@id, "Gundaling"@id, "Karo"@id, "Buah Segar"@id, "Stroberi"@id, "Markisa"@id, "Oleh-oleh"@id ;
