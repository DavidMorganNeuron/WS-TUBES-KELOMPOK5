data:ws-142 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-142"^^xsd:string ;
    ws:namaDestinasi "Pantai Turedawola"@id ;
    ws:namaAlternatif "Turedawola Beach"@id ;
    ws:deskripsiSingkat "Pantai Turedawola di pesisir Nias Utara sangat tenar bagi para pecinta olahraga memancing dan perairan dangkal yang sangat eksotis berpasir putih pudar."@id ;
    ws:deskripsiLengkap "Menghadap langsung hembusan lepas Samudra Hindia di sebelah barat Pulau Nias, Pantai Turedawola memiliki gulungan ombak yang cukup bersahabat dengan kontur bibir pantai landai yang sangat bersih dari koral tajam. Selain ombaknya yang terkadang dimanfaatkan bagi surfer amatir, kawasan ini terkenal dengan gugusan palung laut kecil tidak jauh dari pantainya yang menjadi sumber limpahan spesies ikan segar, mengundang banyak wisatawan mancanegara dan lokal untuk datang khusus melakukan hobi wisata memancing pancing lepas (cast fishing) hingga menikmati sore yang cerah."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Turedawola"@id, "Nias Utara"@id, "Afulu"@id, "Wisata Bahari"@id, "Surfing"@id ;
    ws:beradaDi "Kabupaten Nias Utara"@id ;
    ws:alamat "Desa Afulu, Kecamatan Afulu, Kabupaten Nias Utara, Sumatera Utara 22862"@id ;
    ws:lintang "1.3415"^^xsd:decimal ;
    ws:bujur "97.2341"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak di sebelah pesisir barat daya utara, berjarak sekitar 40 km dari Lotu."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
