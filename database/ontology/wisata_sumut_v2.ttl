    ws:deskripsiSingkat "Lau Sidebuk-debuk adalah pemandian air panas belerang di Desa Semangat Gunung, Kabupaten Karo, dengan latar Gunung Sibayak."@id ;
    ws:deskripsiLengkap "Lau Sidebuk-debuk adalah pemandian air panas belerang di Desa Semangat Gunung, Kabupaten Karo, dengan latar Gunung Sibayak. Sumber air panasnya berasal dari aktivitas vulkanik Gunung Sibayak dengan suhu sekitar 40-50 derajat Celsius, dan terbagi dalam beberapa kolam dengan tingkat suhu serta warna air yang berbeda. Pemandian ini juga menjadi titik awal jalur pendakian Gunung Sibayak dan buka selama 24 jam."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Lau Sidebuk-debuk, pemandian air panas, belerang, Berastagi, Gunung Sibayak"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jl. Jamin Ginting, Desa Semangat Gunung, Kabupaten Karo, Sumatera Utara"@id ;
    ws:lintang "3.227262"^^xsd:decimal ;
    ws:bujur "98.538480"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Semangat Gunung, di kaki Gunung Sibayak, sekitar 15 menit dari pusat Kota Berastagi."@id ;
    ws:jamOperasional "24 jam"@id ;
