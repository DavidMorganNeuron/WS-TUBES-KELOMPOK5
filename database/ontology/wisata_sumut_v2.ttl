data:ws-219 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-219"^^xsd:string ;
    ws:namaDestinasi "Pemandian Alam Sembahe"@id ;
    ws:namaAlternatif "Pemandian Sembahe"@id ;
    ws:deskripsiSingkat "Pemandian sungai di Kampung Mbelin, Kecamatan Sibolangit, Kabupaten Deli Serdang, yang memanfaatkan aliran Sungai Betimus."@id ;
    ws:deskripsiLengkap "Pemandian Alam Sembahe berada di Kampung Mbelin, Kecamatan Sibolangit, Kabupaten Deli Serdang, pada ketinggian sekitar 800 meter di atas permukaan laut. Aliran Sungai Betimus yang berhulu di Gunung Sibayak ditata menjadi beberapa kolam alami berbatu, dikelilingi pepohonan hutan. Kawasan ini mulai dikembangkan sejak 1970-an dan menjadi tujuan favorit warga Medan untuk berenang dan piknik. Fasilitasnya mencakup area parkir, toilet, kamar bilas, warung makan, gazebo, dan penyewaan ban pelampung. Tiket masuk sepuluh ribu rupiah untuk dewasa dan lima ribu rupiah untuk anak."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Pemandian Alam Sembahe"@id, "Sembahe"@id, "Sibolangit"@id, "Deli Serdang"@id, "Sungai Betimus"@id, "Pemandian Alam"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Kampung Mbelin, Kec. Sibolangit, Kab. Deli Serdang, Sumatera Utara"@id ;
    ws:lintang "3.341040"^^xsd:decimal ;
    ws:bujur "98.583970"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, ikuti Jalan Letjen Jamin Ginting ke arah Berastagi sekitar 35 km; pemandian berada di sisi kiri jalan sebelum Sibolangit."@id ;
    ws:jamOperasional "Senin-Jumat 09.00-17.00, Sabtu-Minggu 08.00-18.00"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "081918888438"^^xsd:string ;
