data:ws-231 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-231"^^xsd:string ;
    ws:namaDestinasi "Pantai Biru Langkat"@id ;
    ws:namaAlternatif "Pantai Biru"@id ;
    ws:deskripsiSingkat "Pantai di pesisir Kabupaten Langkat yang dikenal dengan aliran sungai berbatu dan muara yang berhadapan langsung dengan Selat Malaka."@id ;
    ws:deskripsiLengkap "Pantai Biru berada di Kecamatan Secanggang, Kabupaten Langkat, sekitar dua jam berkendara dari Medan. Kawasan ini memiliki garis pantai berpasir kecokelatan serta aliran sungai berbatu yang bermuara ke laut, dikelilingi hutan bakau dan pohon kelapa. Pengunjung biasanya berenang ringan di bagian muara, bermain pasir, atau menikmati hasil laut di warung sekitar. Fasilitas yang tersedia meliputi area parkir, toilet, kamar bilas, warung makan, dan gazebo. Tiket masuk lima ribu rupiah per orang dengan jam operasional pagi hingga sore."@id ;
