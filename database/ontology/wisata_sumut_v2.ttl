data:ws-016 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-016"^^xsd:string ;
    ws:namaDestinasi "Danau Laut Tador"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Danau Laut Tador adalah sebuah telaga alami seluas sekitar 14,5 hektar di Kabupaten Batu Bara yang dijuluki sebagai miniatur Danau Toba karena keasrian ekosistemnya serta kemiripan nama-nama desa di sekelilingnya."@id ;
    ws:deskripsiLengkap "Tersembunyi di balik rimbunnya hutan alami dan bentangan perkebunan kelapa sawit di Desa Laut Tador, destinasi ekowisata ini menawarkan panorama air yang tenang lengkap dengan sebuah pulau kecil eksotis di bagian tengahnya. Terbentuk secara alami dan diselimuti legenda rakyat yang emosional tentang kesedihan seorang anak bernama Tador, kawasan ini menjadi rumah bagi berbagai flora langka serta kawanan monyet liar yang masih hidup bebas. Selain menyuguhkan kesejukan udara untuk melepas penat, situs yang menjadi salah satu ikon wisata andalan Kabupaten Batu Bara ini juga kerap dimanfaatkan sebagai bumi perkemahan pramuka dan terus didorong pengembangannya agar menjadi pusat pariwisata yang representatif di Sumatera Utara."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Lauttodor"@id ;
    ws:beradaDi "Kabupaten Batu Bara"@id ;
    ws:alamat "Laut Tador, Kecamatan Sei Suka, Kabupaten Batu Bara, Sumatera Utara 20998"@id ;
    ws:lintang "3.2678855075496047"^^xsd:decimal ;
    ws:bujur "99.24196465087259"^^xsd:decimal ;
    ws:petunjukLokasi "Berjarak sekitar 103 kilometer melalui Jalan Tol Medan–Tebing Tinggi, dilanjutkan menyusuri Jalan Lintas Sumatera hingga ke Jalan Arjo Utomo di Laut Tador, Kecamatan Sei Suka"@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
