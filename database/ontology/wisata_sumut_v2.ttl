data:ws-075 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-075"^^xsd:string ;
    ws:namaDestinasi "Museum Sejarah Al-Qur'an Sumatra Utara"@id ;
    ws:namaAlternatif "Museum Al-Qur'an Sumatra Utara"@id ;
    ws:deskripsiSingkat "Museum Sejarah Al-Qur'an Sumatra Utara adalah pusat konservasi dan pameran mushaf Al-Qur'an kuno yang terletak di wilayah Percut Sei Tuan."@id ;
    ws:deskripsiLengkap "Berdiri berkat dedikasi Dr. Phil Ichwan Azhari, museum yang diresmikan pada 22 September 2019 ini berfungsi sebagai wadah pelestarian naskah-naskah kuno terkait peradaban Islam di Sumatera Utara. Di dalamnya tersimpan sekitar 50 manuskrip mushaf kuno, di mana manuskrip tertuanya berusia lebih dari 370 tahun yang merekam berbagai motif corak hiasan khas lokal seperti motif Jawa, Melayu-Aceh, hingga Simalungun. Selain menikmati ruang pamer yang sunyi, pengunjung juga dapat mengikuti berbagai kegiatan edukatif seperti kelas kaligrafi, seminar ulama, dan praktik pembuatan tembikar tradisional yang diselenggarakan secara berkala."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Sejarah Al-Qur'an"@id, "Manuskrip Al-Qur'an"@id, "Percut Sei Tuan"@id, "Deli Serdang"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Jl. William Iskandar Pasar V, Kenangan Baru, Kecamatan Percut Sei Tuan, Kabupaten Deli Serdang, Sumatera Utara"@id ;
    ws:lintang "3.606389"^^xsd:decimal ;
    ws:bujur "98.708611"^^xsd:decimal ;
    ws:petunjukLokasi "Berada dekat kawasan Universitas Negeri Medan di jalan Pasar V, Kenangan Baru."@id ;
    ws:jamOperasional "Senin-Jumat 09.00-16.00"@id ;
