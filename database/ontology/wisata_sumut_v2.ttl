data:ws-240 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-240"^^xsd:string ;
    ws:namaDestinasi "Gunung Sibuatan"@id ;
    ws:namaAlternatif "Sibuatan"@id ;
    ws:deskripsiSingkat "Gunung setinggi 2.457 meter di Kabupaten Dairi yang menjadi salah satu puncak tertinggi di Sumatera Utara dan jalur pendakian populer."@id ;
    ws:deskripsiLengkap "Gunung Sibuatan berada di perbatasan Kecamatan Merek dan Kecamatan Sidikalang, Kabupaten Dairi, dengan ketinggian sekitar 2.457 meter di atas permukaan laut. Jalur pendakiannya melewati hutan tropis, kebun warga, dan area edelweis di bagian atas. Pendakian umumnya memakan waktu enam sampai delapan jam menuju puncak, yang menawarkan panorama perbukitan dan Danau Toba di kejauhan. Pengelolaan dilakukan bersama warga desa dengan biaya registrasi sekitar sepuluh ribu rupiah. Pendaki disarankan mendaftar di pos desa dan membawa logistik memadai."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Gunung Sibuatan"@id, "Dairi"@id, "Sidikalang"@id, "Pendakian"@id, "Puncak Tertinggi Sumatera Utara"@id ;
    ws:beradaDi "Kabupaten Dairi"@id ;
    ws:alamat "Kec. Sidikalang, Kab. Dairi, Sumatera Utara"@id ;
    ws:lintang "2.917720"^^xsd:decimal ;
    ws:bujur "98.429640"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Sidikalang, berkendara sekitar 40 menit ke desa terakhir di kaki gunung, lalu mendaki 6-8 jam menuju puncak."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/sibuatanmountain"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Pemandu Wisata"@id, "Toilet"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Berkemah"@id, "Mendaki"@id, "Menikmati Pemandangan"@id ;
    ws:memilikiMedia "https://www.eigeradventure.com/blog/wp-content/uploads/2021/10/gunung-sibuatan-sumut-kilas-balik-ekspedisi-28-gunung-eiger-adventure-puncak.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-241 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-241"^^xsd:string ;
    ws:namaDestinasi "Taman Ahmad Yani"@id ;
    ws:namaAlternatif "Tugu Ahmad Yani"@id ;
    ws:deskripsiSingkat "Taman kota di Medan dengan monumen Jenderal Ahmad Yani sebagai ikon, terbuka untuk umum sepanjang waktu."@id ;
    ws:deskripsiLengkap "Taman Ahmad Yani berada di Jalan Imam Bonjol, Kecamatan Medan Petisah, Kota Medan, dan menempati lahan yang sebelumnya menjadi kawasan taman pertigaan. Ikon utamanya adalah patung Jenderal Ahmad Yani di atas tugu yang dikelilingi area hijau, jalur pejalan kaki, dan bangku taman. Pada pagi hari taman dipakai untuk olahraga, sedangkan sore hari dipenuhi pedagang jajanan dan warga yang bersantai. Tidak ada tiket masuk sehingga taman ini menjadi ruang publik gratis di tengah kota."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "Taman Ahmad Yani"@id, "Medan Petisah"@id, "Medan"@id, "Taman Kota"@id, "Monumen"@id, "Ruang Publik"@id ;
