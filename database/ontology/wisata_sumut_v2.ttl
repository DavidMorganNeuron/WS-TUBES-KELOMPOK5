data:ws-248 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-248"^^xsd:string ;
    ws:namaDestinasi "Aek Sijorni"@id ;
    ws:namaAlternatif "Air Terjun Aek Sijorni"@id,
        "Taman Wisata Air Aek Sijorni"@id ;
    ws:deskripsiSingkat "Air terjun bertingkat dengan air biru jernih di Desa Aek Libung, Kecamatan Sayur Matinggi, Kabupaten Tapanuli Selatan."@id ;
    ws:deskripsiLengkap "Aek Sijorni berada di Desa Aek Libung, Kecamatan Sayur Matinggi, Kabupaten Tapanuli Selatan, sekitar 30 kilometer dari Padangsidimpuan. Airnya jatuh bertingkat pada dinding batu dengan warna biru kehijauan dan kolam yang dapat dipakai berenang. Kawasan ini sudah dikelola dengan fasilitas area parkir, toilet, kamar bilas, warung makan, loker, musala, dan saung. Tiket masuk sepuluh ribu rupiah per orang pada hari biasa dan dapat meningkat pada hari libur, ditambah biaya parkir. Pengunjung biasanya datang pagi untuk mendapat kolam yang belum ramai."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Aek Sijorni, Sayur Matinggi, Tapanuli Selatan, air terjun bertingkat, kolam biru"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "Desa Aek Libung, Kec. Sayur Matinggi, Kab. Tapanuli Selatan, Sumatera Utara 22774"@id ;
    ws:lintang "1.157850"^^xsd:decimal ;
    ws:bujur "99.422160"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Padangsidimpuan, berkendara sekitar satu jam ke arah Sayur Matinggi mengikuti Jalan Lintas Sumatera."@id ;
    ws:jamOperasional "Setiap hari 07.00-18.00 WIB"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
