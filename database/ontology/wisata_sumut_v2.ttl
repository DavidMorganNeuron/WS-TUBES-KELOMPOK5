data:ws-161 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-161"^^xsd:string ;
    ws:namaDestinasi "Taman Alam Lumbini"@id ;
    ws:namaAlternatif "Lumbini Park"@id,
        "Pagoda Taman Alam Lumbini"@id ;
    ws:deskripsiSingkat "Taman Alam Lumbini adalah taman wisata religi Buddha di Desa Dolat Rayat, Kabupaten Karo, dengan pagoda emas replika Pagoda Shwedagon Myanmar."@id ;
    ws:deskripsiLengkap "Taman Alam Lumbini adalah taman wisata religi Buddha di Desa Dolat Rayat, Kabupaten Karo, dengan pagoda emas replika Pagoda Shwedagon Myanmar. Pagoda setinggi 46,8 meter dengan panjang dan lebar 68 meter ini selesai dibangun pada 2010 dan merupakan replika pagoda tertinggi kedua di Asia Tenggara. Kawasan ini juga memiliki taman, jembatan gantung, restoran vegetarian, dan toko suvenir, serta dapat dikunjungi tanpa tiket dengan sistem donasi sukarela."@id ;
