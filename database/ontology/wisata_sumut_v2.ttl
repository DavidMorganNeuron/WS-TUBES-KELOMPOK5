data:ws-102 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-102"^^xsd:string ;
    ws:namaDestinasi "Pemandian Alam Aek Manik"@id ;
    ws:namaAlternatif "Bah Damanik"@id, "Aek Manik"@id ;
    ws:deskripsiSingkat "Pemandian Alam Aek Manik adalah kolam mata air alami berpasir putih peninggalan Raja Damanik dengan kejernihan air yang memperlihatkan dasar sungainya."@id ;
    ws:deskripsiLengkap "Tersembunyi tak jauh dari kawasan Kebun Teh Sidamanik, Bah Damanik atau Aek Manik menyajikan pengalaman mandi yang tak terlupakan. Mata air ini dahulunya merupakan tempat pemandian khusus bagi keluarga Kerajaan Damanik yang menguasai wilayah tersebut. Alirannya tidak pernah keruh karena disaring langsung secara alami dari akar pohon besar di sekitarnya dan berlantai pasir halus kehitaman. Suhu airnya yang luar biasa dingin menjadi daya tarik bagi pelancong untuk melepaskan penat sehabis berjalan membelah perbukitan."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Pemandian Alam"@id, "Bah Damanik"@id, "Sidamanik"@id, "Simalungun"@id, "Mata Air"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Ambarisan, Kecamatan Sidamanik, Kabupaten Simalungun, Sumatera Utara 21171"@id ;
    ws:lintang "2.8362"^^xsd:decimal ;
    ws:bujur "98.9488"^^xsd:decimal ;
    ws:petunjukLokasi "Akses masuk melewati gang sempit di dekat lapangan sepak bola Sidamanik, kemudian berjalan kaki menurun."@id ;
    ws:jamOperasional "Setiap Hari 08.00-18.00"@id ;
