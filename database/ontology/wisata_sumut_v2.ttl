data:ws-195 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-195"^^xsd:string ;
    ws:namaDestinasi "Pantai Indah Situngkir"@id ;
    ws:namaAlternatif "Pantai Situngkir"@id ;
    ws:deskripsiSingkat "Pantai di tepi Danau Toba yang dikelola desa, berlokasi di Desa Situngkir, Kecamatan Pangururan, Kabupaten Samosir."@id ;
    ws:deskripsiLengkap "Pantai Indah Situngkir dikelola oleh warga dan pemerintah Desa Situngkir, Kecamatan Pangururan, Kabupaten Samosir. Area ini mulai beroperasi sekitar 2016 sebagai destinasi pantai danau dengan tiket masuk lima ribu rupiah per orang. Fasilitasnya mencakup lahan parkir yang luas untuk bus dan mobil, toilet, warung makanan dan minuman, serta gazebo di tepi air. Pengunjung biasanya berenang ringan di tepian, menyewa perahu untuk mengelilingi teluk, atau sekadar piknik sambil memandang Pulau Samosir bagian utara."@id ;
