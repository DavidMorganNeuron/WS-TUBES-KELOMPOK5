data:ws-236 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-236"^^xsd:string ;
    ws:namaDestinasi "T Garden Deli Serdang"@id ;
    ws:namaAlternatif "T-Garden"@id ;
    ws:deskripsiSingkat "Taman dan kafe keluarga di Kabupaten Deli Serdang yang memadukan area hijau dengan spot foto dan tempat makan."@id ;
    ws:deskripsiLengkap "T Garden berada di Kecamatan Sunggal, Kabupaten Deli Serdang, di sisi barat Kota Medan. Kawasan ini menggabungkan taman hijau, spot foto, area bermain anak, dan kafe yang menyajikan makanan Indonesia maupun internasional. Tersedia gazebo, toilet, musala, dan area parkir yang luas. Tiket masuk dua puluh lima ribu rupiah per orang dengan jam operasional sembilan pagi hingga enam sore. Tempat ini populer untuk sarapan akhir pekan, acara keluarga, dan sesi foto karena penataan tanamannya cukup rapi."@id ;
