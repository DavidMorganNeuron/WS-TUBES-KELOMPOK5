data:ws-235 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-235"^^xsd:string ;
    ws:namaDestinasi "Monako Park"@id ;
    ws:namaAlternatif "Monako Park Deli Serdang"@id ;
    ws:deskripsiSingkat "Taman wisata keluarga di Kabupaten Deli Serdang dengan area hijau, kolam, dan wahana permainan anak."@id ;
    ws:deskripsiLengkap "Monako Park berada di Kecamatan Pancur Batu, Kabupaten Deli Serdang, sekitar 30 menit berkendara dari pusat Kota Medan. Kawasan ini mengusung konsep wisata alam buatan dengan danau kecil, taman, gazebo, dan wahana permainan anak. Tersedia warung makan, toilet, musala, serta area parkir. Tiket masuk sepuluh ribu rupiah per orang. Monako Park buka setiap hari dari pagi hingga sore dan sering dipakai untuk rekreasi keluarga maupun kegiatan sekolah karena aksesnya yang dekat dari kota."@id ;
    ws:jenisDestinasi "Buatan"@id ;
