data:ws-017 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-017"^^xsd:string ;
    ws:namaDestinasi "Danau Linting"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Danau Linting adalah danau vulkanik yang terletak di Sinembah Tanjung Muda Hulu, Deli Serdang, Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Danau Linting adalah danau vulkanik yang terletak di Sinembah Tanjung Muda Hulu, Deli Serdang, Sumatera Utara, Indonesia. Danau ini dikenal karena warna airnya yang khas, yaitu biru kehijauan hingga toska, yang dipengaruhi kandungan belerang di dalamnya. Nama \"Linting\" merujuk pada wilayah tempat danau ini berada. Danau Linting telah lama dikenal masyarakat setempat sebagai lokasi alam dengan fenomena warna air yang berbeda dari danau biasa. Popularitasnya sebagai objek wisata meningkat seiring berkembangnya pariwisata di Sumatera Utara, meskipun pengelolaannya masih sederhana. Karakteristik Danau Linting memiliki diameter sekitar 240 meter dengan kedalaman yang belum dapat diukur secara pasti. Airnya berwarna biru kehijauan dan dapat berubah sesuai dengan intensitas cahaya matahari. Kandungan belerang yang tinggi membuat suhu air terasa hangat serta menimbulkan aroma khas belerang di sekitar lokasi. Kondisi tersebut menyebabkan danau ini tidak digunakan untuk kegiatan berenang. Lingkungan sekitar danau ditumbuhi pepohonan besar yang menciptakan suasana teduh. Kawasan sekitarnya masih relatif alami dengan vegetasi hutan tropis."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Linting, danau vulkanik, Sinembah Tanjung Muda Hulu, danau belerang"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "-"@id ;
    ws:lintang "3.229677"^^xsd:decimal ;
    ws:bujur "98.725719"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Sinembah Tanjung Muda Hulu, Kabupaten Deli Serdang, sekitar 1,5-2 jam dari Kota Medan."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "menikmati pemandangan danau"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Danau_Linting%2C_North_Sumatra_3.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.3"^^xsd:decimal .

