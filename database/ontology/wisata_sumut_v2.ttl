data:ws-151 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-151"^^xsd:string ;
    ws:namaDestinasi "Bukit Lawang"@id ;
    ws:namaAlternatif "Desa Bukit Lawang"@id,
        "Pintu masuk Taman Nasional Gunung Leuser"@id ;
    ws:deskripsiSingkat "Bukit Lawang adalah desa wisata di Kecamatan Bahorok, Kabupaten Langkat, yang menjadi pintu masuk Taman Nasional Gunung Leuser dan pusat wisata orangutan sumatra."@id ;
    ws:deskripsiLengkap "Bukit Lawang adalah desa wisata di Kecamatan Bahorok, Kabupaten Langkat, yang menjadi pintu masuk Taman Nasional Gunung Leuser dan pusat wisata orangutan sumatra. Kawasan ini dikenal sejak berdirinya pusat rehabilitasi orangutan di Bahorok pada 1973 dan kini menawarkan trekking hutan hujan, pengamatan orangutan liar, tubing menyusuri Sungai Bohorok, serta penginapan di tepi sungai. Perjalanan dari Kota Medan memakan waktu sekitar 3 jam."@id ;
