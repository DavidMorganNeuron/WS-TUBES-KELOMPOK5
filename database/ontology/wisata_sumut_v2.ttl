data:ws-249 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-249"^^xsd:string ;
    ws:namaDestinasi "Desa Wisata Tipang"@id ;
    ws:namaAlternatif "Tipang Mas"@id ;
    ws:deskripsiSingkat "Desa wisata di Kecamatan Baktiraja, Kabupaten Humbang Hasundutan, yang dikenal karena perbukitan, rumah adat, dan kuliner tepi Danau Toba."@id ;
    ws:deskripsiLengkap "Desa Wisata Tipang terletak di Kecamatan Baktiraja, Kabupaten Humbang Hasundutan. Kawasan ini dikembangkan sebagai desa wisata dengan paket kegiatan berupa trekking perbukitan, kunjungan ke rumah adat, susur desa, serta makan di restoran terapung yang menyajikan ikan dari Danau Toba. Homestay rumah adat dapat disewa dengan biaya sekitar seratus dua puluh ribu rupiah per malam. Tiket masuk kawasan dua puluh ribu rupiah per orang, sedangkan paket wisata tertentu dihitung terpisah. Pengelolaan dilakukan bersama warga dan difasilitasi Dinas Pariwisata setempat."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Desa Wisata Tipang, Tipang Mas, Baktiraja, Humbang Hasundutan, desa wisata, rumah adat"@id ;
    ws:beradaDi "Kabupaten Humbang Hasundutan"@id ;
    ws:alamat "Desa Tipang, Kec. Baktiraja, Kab. Humbang Hasundutan, Sumatera Utara"@id ;
    ws:lintang "2.360410"^^xsd:decimal ;
    ws:bujur "98.817620"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Bakkara, berkendara sekitar 15 menit menyusuri jalan desa menuju Tipang; lokasi berada di tepi Danau Toba."@id ;
    ws:jamOperasional "Setiap hari 08.00-17.00 WIB"@id ;
    ws:hargaMasuk "20000"^^xsd:decimal ;
    ws:noHpResmi "" ;
    ws:emailResmi "" ;
    ws:instagramResmi ""^^xsd:anyURI ;
    ws:memilikiFasilitas "Area Parkir"@id,
