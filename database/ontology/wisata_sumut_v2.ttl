data:ws-083 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-083"^^xsd:string ;
    ws:namaDestinasi "Padang Mardia"@id ;
    ws:namaAlternatif "Kompleks Makam Padang Mardia"@id ;
    ws:deskripsiSingkat "Padang Mardia adalah kompleks makam bersejarah raja-raja dan bangsawan di kawasan Tapanuli Bagian Selatan yang memiliki nilai leluhur tinggi."@id ;
    ws:deskripsiLengkap "Tersembunyi di wilayah Mandailing Natal, kompleks makam Padang Mardia merupakan situs peninggalan yang disakralkan oleh masyarakat adat setempat sebagai tempat peristirahatan para raja dan pemuka masa lalu. Susunan batu makam tradisional di situs ini menjadi pengingat eratnya ikatan batin antara masyarakat kekinian dengan akar historis dan kebesaran masa lampau suku Mandailing. Hingga saat ini, situs bersejarah ini kerap didatangi para peziarah atau peneliti budaya yang ingin meresapi kearifan masa lalu yang masih lestari di tanah Tapanuli."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Padang Mardia"@id, "Makam Raja"@id, "Situs"@id, "Mandailing Natal"@id ;
    ws:beradaDi "Kabupaten Mandailing Natal"@id ;
