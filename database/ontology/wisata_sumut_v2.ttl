data:ws-037 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-037"^^xsd:string ;
    ws:namaDestinasi "Gunung Toba"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Gunung Toba adalah gunung berapi supervulkan purba yang terletak di Provinsi Sumatera Utara."@id ;
    ws:deskripsiLengkap "Gunung Toba adalah gunung berapi supervulkan purba yang terletak di Provinsi Sumatera Utara. Sebagai salah satu supervolcano paling aktif dalam sejarah bumi, Gunung Toba tercatat pernah mengalami tiga letusan besar, dengan letusan terakhir sekitar 74.000 tahun lalu sebagai yang paling mematikan karena memuntahkan lebih dari 2.800 kilometer kubik material vulkanik ke atmosfer. Ledakan dahsyat berkategori skala 8 VEI (Volcanic Explosivity Index) ini memicu musim dingin vulkanik global yang menurunkan suhu bumi secara drastis serta menyebarkan abu sulfur hingga ke wilayah India dan Afrika. Pasca-letusan hebat tersebut, dinding gunung yang runtuh membentuk kaldera masif sepanjang 100 kilometer dan lebar 30 kilometer, yang seiring berjalannya waktu terisi air hingga menjadi Danau Toba yang megah, dengan Pulau Samosir di tengahnya yang terbentuk akibat desakan magma dari bawah danau."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Supervulkan"@id, "Toba"@id, "Kaldera"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Ronggur Nihuta, Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara"@id ;
    ws:lintang "2.617567190109934"^^xsd:decimal ;
    ws:bujur "98.81670985827797"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Provinsi Sumatera Utara dan melintasi beberapa kabupaten; kalderanya kini terisi air dan dikenal sebagai Danau Toba. Nilai beradaDi merujuk pada Kabupaten Toba sebagai wilayah inti kaldera."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Toko Oleh-Oleh"@id ;
    ws:dapatMelakukan "Mendaki"@id, "Berfoto"@id,
        "Menikmati Pemandangan"@id, "Berkemah"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Kaldera_Danau_Toba.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-038 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-038"^^xsd:string ;
    ws:namaDestinasi "HKBP Sipirok"@id ;
    ws:namaAlternatif "HKPB Sipirok"@id ;
    ws:deskripsiSingkat "Gereja HKBP Sipirok adalah gereja HKBP pertama yang ada di Tanah Batak terletak di Tapanuli Selatan."@id ;
    ws:deskripsiLengkap "Gereja HKBP Sipirok adalah gereja HKBP pertama yang ada di Tanah Batak terletak di Tapanuli Selatan. Gereja ini berlokasi di Jalan Rumah Sakit, Kecamatan Sipirok, Tapanuli Selatan. Pembangunan gereja ini diprakarsai oleh misionaris asal Belanda, Gerrit Van Asselt, pendeta asal Belanda yang diutus oleh badan Zending Ermelo ke tanah batak pada tahun 1857 dan menjadi misionaris pertama yang berhasil membaptis orang batak. Gereja ini didirikan pada tahun 1864 dan telah dilakukan renovasi berulang kali. Meskipun pembangunannya diprakarsai oleh pendeta Belanda, gereja ini juga mendapatkan pengaruh dari pendeta-pendeta asal Jerman yang berkontribusi juga dalam perkembangan agama Kristen di Tanah Batak. Kompleks gereja ini memiliki luas 7 Ha, terdapat gedung gereja, makam para missionaris, rumah pendeta, area persawahan milik gereja, dan tugu peringatan berdirinya gereja. Di kompleks ini juga pernah berdiri balai kesehatan milik HKBP, yang sekarang telah dijadikan pemerintah menjadi RSUD Sipirok. Berdirinya gereja ini diawali dengan rapat pelayanan di Sipirok oleh empat misionaris asal Eropa pada 7 Oktober 1861 mengenai pembagian wilayah penginjilan di Tapanuli. Tanggal tersebut dijadikan HKBP sebagai tanggal kelahirannya. Hasil rapat di Sipirok menyebabkan berdirinya gereja HKBP Sipirok pada bulan Mei 1864, dan menjadi gereja HKBP pertama di dunia. Bangunan gereja ini memiliki gaya arsitektur klasik-modern zaman Belanda, berlantaikan papan. Sampai saat ini, gereja ini masih berdiri kokoh dan masih dijadikan tempat beribadah oleh masyarakat. Gereja ini telah dijadikan oleh pemerintah menjadi tempat cagar budaya Provinsi Sumatera Utara. Walaupun telah berusia ratusan tahun, bangunan ini masih berdiri kokoh dan masih dipakai oleh Masyarakat sebagai tempat beribadah orang Kristen. Gereja ini adalah gereja induk (sabungan) resort sipirok dengan gereja pagarannya sebanyak 13 gereja. Gereja ini telah dijadikan oleh pemerintah menjadi tempat cagar budaya Provinsi Sumatera Utara."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "HKBP Sipirok, Gereja HKBP Sipirok, Sipirok, Tapanuli Selatan"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat ""@id ;
    ws:lintang "1.603872"^^xsd:decimal ;
    ws:bujur "99.268031"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Rumah Sakit, Kecamatan Sipirok, Kabupaten Tapanuli Selatan."@id ;
    ws:jamOperasional ""@id ;
