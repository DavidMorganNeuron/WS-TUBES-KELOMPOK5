data:ws-005 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-005"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Efrata"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air terjun Efrata adalah sebuah air terjun yang terletak di Kecamatan Harian, provinsi Sumatera Utara, di bagian barat negara Indonesia (186 km dari pusat Kota Medan)."@id ;
    ws:deskripsiLengkap "Air terjun Efrata adalah sebuah air terjun yang terletak di Kecamatan Harian, provinsi Sumatera Utara, di bagian barat negara Indonesia (186 km dari pusat Kota Medan). Ketinggian air terjun ini sekitar 26 meter dan lebar kurang lebih 12 meter. Kondisi lahan di sekitar objek wisata air terjun Efrata dikelilingi lahan pertanian, mengingat air terjun ini berada dekat desa. Terdapat sekitar 155 orang per kilometer persegi di sekitar air terjun ini yang dimana itu tergolong cukup padat. Suhu rata-rata disana adalah 19°C dan beriklim tropis. Bulan terpanas adalah pada Mei (20°C), dan suhu terdingin pada bulan Januari (18 °C). Curah hujan rata-rata disana sekitar 2.673 milimeter per tahun. Bulan terbasah adalah Desember dengan curah hujan 322 milimeter, sedangkan yang terkering adalah Juni dengan curah hujan 127 milimeter."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "air terjun Efrata, Harian, Samosir"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "-"@id ;
    ws:lintang "2.536899"^^xsd:decimal ;
    ws:bujur "98.642366"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Harian, Kabupaten Samosir, di tepi Danau Toba."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "menikmati pemandangan air terjun"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Air_Terjun_Efrata_tampak_dari_bawah_hingga_atas_06.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-006 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-006"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sampuren Putih"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air Terjun Sampuren Putih adalah sebuah air terjun yang terletak di Desa Cinta Rakyat, Kecamatan Percut Sei Tuan, Kabupaten Deli Serdang, Provinsi Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Air Terjun Sampuren Putih adalah sebuah air terjun yang terletak di Desa Cinta Rakyat, Kecamatan Percut Sei Tuan, Kabupaten Deli Serdang, Provinsi Sumatera Utara, Indonesia. Lokasinya berjarak sejauh 51,7 km dari Kota Medan. Ketinggian air terjun ini sekitar 3 meter. Rata-rata wisatawan yang berkunjung ke sini melakukan aktivitas trekking dan berkemah, selain mandi di air terjun. Suhu rata-rata disana adalah 23°C dan beriklim tropis. Bulan terpanas adalah pada Februari (24°C) serta bulan terdingin pada September (22°C). Curah hujan rata-rata di sana sekitar 3.483 milimeter per tahun. Bulan terbasah adalah Oktober dengan curah hujan 465 milimeter, sedangkan yang terkering adalah Juli dengan curah hujan 181 milimeter."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "air terjun Sampuren Putih, Cinta Rakyat, Percut Sei Tuan"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "-"@id ;
    ws:lintang "3.267326"^^xsd:decimal ;
    ws:bujur "98.600559"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Cinta Rakyat, Kecamatan Percut Sei Tuan, Kabupaten Deli Serdang, sekitar 51,7 km dari Kota Medan."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "trekking"@id ;
    ws:dapatMelakukan "berkemah"@id ;
    ws:dapatMelakukan "mandi di air terjun"@id ;
    ws:memilikiMedia "-"^^xsd:anyURI ;
    ws:ratingPengunjung "4.3"^^xsd:decimal .

data:ws-007 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-007"^^xsd:string ;
    ws:namaDestinasi "Candi Bahal"@id ;
    ws:namaAlternatif "Biaro Bahal"@id ;
    ws:namaAlternatif "Candi Portibi"@id ;
    ws:deskripsiSingkat "Kompleks candi Buddha Vajrayana peninggalan Kerajaan Pannai dari sekitar abad ke-11."@id ;
    ws:deskripsiLengkap "Candi Bahal, Biaro Bahal, atau Candi Portibi adalah kompleks candi Buddha aliran Vajrayana yang terletak di Desa Bahal, Kecamatan Padang Bolak, Portibi, Kabupaten Padang Lawas Utara, Sumatera Utara, sekitar 3 jam perjalanan dari Kota Padang Sidempuan atau berjarak sekitar 400 km dari Kota Medan. Candi ini terbuat dari bahan bata merah dan diduga berasal dari sekitar abad ke-11 dan dikaitkan dengan Kerajaan Pannai, salah satu pelabuhan di pesisir Selat Malaka yang ditaklukan dan menjadi bagian dari mandala Sriwijaya. Memiliki tiga bangunan kuno yaitu Biaro Bahal I, II dan III. Saling berhubungan dan terdiri dalam satu garis yang lurus. Biaro Bahal I yang terbesar. Kakinya berhiasan papan-papan sekelilingnya yang berukiran tokoh yaksa yang berkepala hewan, yang sedang menari-nari. Rupa-rupanya para penari itu memakai topeng hewani seperti pada upacara di Tibet. Di antara semua papan berhiasan itu ada ukiran singa yang duduk. Di Bahal II pernah ditemukan sebuah Arca Heruka, yaitu arca demonis yang mewujudkan tokoh pantheon Agama Buddha aliran Mahayana, sekte bajrayana atau tantrayana. Heruka berdiri di atas jenazah dalam sikap menari; pada tangan kanannya ada tongkat. Bahal III berukiran hiasan daun. Candi ini diberi nama berdasarkan nama desa tempat bangunan ini berdiri. Selain itu nama Portibi dalam bahasa Batak berarti 'dunia' atau 'bumi' istilah serapan yang berasal dari bahasa Sanskerta: Pertiwi (Dewi Bumi). Candi ini merupakan kompleks candi (dalam istilah setempat disebut biaro) yang terluas di provinsi Sumatera Utara, karena arealnya melingkupi kompleks Candi Bahal I, Bahal II dan Bahal III. Seluruh bangunan di ketiga kompleks candi dibuat dari bata merah, kecuali arca-arcanya yang terbuat dari batu keras. Masing-masing kompleks candi dikelilingi oleh pagar setinggi dan setebal sekitar 1 m yang juga terbuat dari susunan bata merah. Di sisi timur terdapat gerbang yang menjorok keluar dan di kanan-kirinya diapit oleh dinding setinggi sekitar 60 cm. Di setiap kompleks candi terdapat bangunan utama yang terletak di tengah halaman dengan pintu masuk tepat menghadap ke gerbang."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Bahal, Biaro Bahal, Candi Portibi, Padang Lawas Utara, Kerajaan Pannai"@id ;
    ws:beradaDi "Kabupaten Padang Lawas Utara"@id ;
    ws:alamat "-"@id ;
    ws:lintang "1.405556"^^xsd:decimal ;
    ws:bujur "99.730556"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Bahal, Kecamatan Padang Bolak, Kabupaten Padang Lawas Utara; sekitar 3 jam perjalanan dari Kota Padang Sidempuan atau sekitar 400 km dari Kota Medan."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "menjelajah situs candi"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Candi_Bahal_1.JPG"^^xsd:anyURI ;
    ws:ratingPengunjung "4.3"^^xsd:decimal .

