    ws:ratingPengunjung "4.7"^^xsd:decimal .

data:ws-054 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-054"^^xsd:string ;
    ws:namaDestinasi "Museum Pahlawan Nasional Letjen Jamin Ginting"@id ;
    ws:namaAlternatif "Museum Jamin Ginting"@id,
        "Museum Letjen Jamin Ginting"@id ;
    ws:deskripsiSingkat "Museum Pahlawan Nasional Letjen Jamin Ginting (dikenal sebagai Museum Letjen Jamin Ginting) adalah museum khusus yang diresmikan pada tanggal 17 September 2013."@id ;
    ws:deskripsiLengkap "Diresmikan pada tanggal 17 September 2013 oleh Menteri Pertahanan RI Purnomo Yusgiantoro, museum ini berdiri megah di tanah kelahiran sang pahlawan, yaitu Desa Suka, Kecamatan Tigapanah, Kabupaten Karo, Sumatera Utara. Bangunan museum dua lantai ini dirancang dengan bentuk arsitektur yang sangat ikonik, yakni menyerupai kacang tanah, yang melambangkan filosofi melindungi dan merawat isi serta sejarah di dalamnya dari berbagai terpaan zaman. Di dalam museum ini, pengunjung dapat melihat berbagai koleksi bersejarah mulai dari pakaian dinas militer, pangkat, perlengkapan perang, hingga alat-alat pertanian dan benda budaya Karo yang pernah digunakan atau lekat dengan kehidupan beliau. Selain sebagai destinasi wisata edukasi sejarah, keberadaan museum ini menjadi simbol penghormatan atas pengabdian Letjen Jamin Ginting yang juga pernah mengemban tugas negara sebagai Duta Besar Indonesia untuk Kanada."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Tigapanah"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Desa Suka, Kecamatan Tigapanah, Kabupaten Karo, Sumatera Utara 22171"@id ;
    ws:lintang "3.0610944539647558"^^xsd:decimal ;
    ws:bujur "98.52058812517498"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Suka, Kecamatan Tigapanah, Kabupaten Karo."@id ;
    ws:jamOperasional "Selasa - Minggu 10.00 - 18.00"@id ;
