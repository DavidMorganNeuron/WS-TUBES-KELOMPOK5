data:ws-101 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-101"^^xsd:string ;
    ws:namaDestinasi "Kebun Teh Sidamanik"@id ;
    ws:namaAlternatif "Kebun Teh Bah Butong"@id ;
    ws:deskripsiSingkat "Kebun Teh Sidamanik yang dikelola oleh PTPN IV merupakan perkebunan teh tertua dan terbesar di Sumatera Utara yang memancarkan hamparan hijau memanjakan mata."@id ;
    ws:deskripsiLengkap "Terletak di kawasan agrowisata Kecamatan Sidamanik, perkebunan yang memiliki luas mencapai ratusan hektare ini menawarkan hawa dingin pegunungan yang sangat menyegarkan pikiran. Perkebunan yang sudah beroperasi sejak era kolonial Belanda ini memiliki kontur tanah perbukitan bergelombang yang dihiasi jalur-jalur setapak tempat para pemetik teh bekerja di pagi hari. Pengunjung sering menelusuri kebun hijau ini sembari menyewa ATV atau berswafoto ria berlatarkan labirin-labirin pohon teh dengan latar belakang Gunung Simanuk-manuk."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Kebun Teh"@id, "Sidamanik"@id, "Simalungun"@id, "Bah Butong"@id, "Wisata Alam"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Jalan Pematangsiantar - Sidamanik, Kecamatan Sidamanik, Kabupaten Simalungun, Sumatera Utara 21171"@id ;
    ws:lintang "2.8394"^^xsd:decimal ;
    ws:bujur "98.9513"^^xsd:decimal ;
    ws:petunjukLokasi "Bisa ditempuh sekitar 45 menit perjalanan dari pusat Kota Pematangsiantar."@id ;
