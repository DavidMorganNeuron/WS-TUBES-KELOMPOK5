data:ws-106 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-106"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sipisopiso"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air Terjun Sipisopiso atau Sipiso-piso adalah sebuah air terjun yang berada di Desa Tongging, Kecamatan Merek, Kabupaten Karo, Provinsi Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Air Terjun Sipisopiso atau Sipiso-piso adalah sebuah air terjun yang berada di Desa Tongging, Kecamatan Merek, Kabupaten Karo, Provinsi Sumatera Utara, Indonesia. Air Terjun Sipisopiso memiliki ketinggian hingga 120 meter dan mengucur deras membentuk garis vertikal sempurna. Sehingga Air Terjun Sipisopiso masuk dalam air terjun tipe Plunge. Air Terjun Sipisopiso berada di bibir kaldera raksasa Danau Toba serta terbentuk pada aliran Sungai Pajanabolon yang merupakan salah satu sungai menyuplai air ke Danau Toba. Air Terjun Sipisopiso berada di ketinggian sekitar 1.300 meter di atas permukaan air laut. Nama Sipisopiso diambil dari nama sebuah Gunung yang berada tepat di timur laut Air Terjun Sipisopiso. Gunung yang juga disebut Gunung Sipisopiso ini memiliki ketinggian sekitar 1.860 meter di atas permukaan air laut."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "air terjun Sipisopiso, Sipiso-piso, Tongging, Merek, Danau Toba"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "-"@id ;
    ws:lintang "2.9162"^^xsd:decimal ;
    ws:bujur "98.5196"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Tongging, Kecamatan Merek, Kabupaten Karo, di bibir kaldera Danau Toba pada ketinggian sekitar 1.300 mdpl; dapat ditempuh sekitar 2,5 jam dari Kota Medan."@id ;
    ws:jamOperasional "Setiap hari 08.00-17.00 WIB"@id ;
    ws:hargaMasuk "7500"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "menikmati pemandangan air terjun"@id ;
    ws:dapatMelakukan "berfoto"@id ;
    ws:dapatMelakukan "menikmati panorama Danau Toba"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Sipiso-Piso_Falls_Front_View.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-108 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-108"^^xsd:string ;
    ws:namaDestinasi "Museum Karo Lingga"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Museum Karo Lingga adalah museum yang terletak di Jl. Kotacane No. 180 Kabanjahe yaitu 5 km di sebelah barat Kabanjahe, sekitar 1 km sebelum lokasi Perkampungan tradisional Lingga, Kecamatan Simpang Empat, Kabupaten Karo, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Museum Karo Lingga adalah museum yang terletak di Jl. Kotacane No. 180 Kabanjahe yaitu 5 km di sebelah barat Kabanjahe, sekitar 1 km sebelum lokasi Perkampungan tradisional Lingga, Kecamatan Simpang Empat, Kabupaten Karo, Sumatera Utara. Museum ini didirikan atas prakarsa G.H. Mantik, Pangkowilham Kodam II Bukit Barisan pada tahun 1977. Pada tanggal 6 Juni 1989 museum ini resmi dibuka dan dikelola oleh Yayasan Museum Karo Lingga. Sejarah Museum Karo Lingga berdiri di desa Budaya Lingga yang disebut juga sebagai lokasi Immemoria Nirwana Graha Aidilla. Di Desa Lingga terdapat banyak peninggalan-peninggalan budaya Karo yang hampir punah sebelum Museum Karo Lingga didirikan, contohnya rumah adat Karo yang diperkirakan berumur 250 tahun. Bentuk arsitektur museum ini adalah bentuk arsitektur tradisional Karo (rumah adat Karo). Bahan bangunannya sudah lebih modern, atapnya terbuat dari seng, dan pada bagian teras (ture) menunjukkan ciri khas suku Suku Karo. Pada tahun 1979, G.H. Mantik mengadakan kunjungan kerja di desa Lingga dan ia terkesan dengan tradisi leluhur karo yang tetap terpelihara. Dalam perjalanan berkeliling desa Lingga, ia tergelincir dan itu merupakan suatu hal yang tabu bagi masyarakat Karo. Pada saat tergelincir, jiwanya dianggap lengah oleh rasa terkejut dan harus diadakan suatu upacara ritual untuk mengembalikan itu. Didirikanlah sebuah rumah adat di desa yang disebut rumah Tersek atas dasar musyawarah masyarakat dan tetua adat. Namun karena kesibukan beliau, rumah tersebut disebut tidak dimanfaatkan sebagaimana mestinya. Pada tahun 1989 seorang tokoh adat di desa Lingga, Acih Ginting memprakarsai dan meminta persetujuan G.H. Mantik agar rumah adat Tersek tersebut direnovasi untuk dijadikan sebuah Museum. Museum tersebut digunakan untuk menyimpan benda-benda seni kerajinan dan barang-barang peninggalan suku Karo yang selama ini terdapat didalam rumah adat di desa Lingga."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Karo Lingga, Desa Lingga, Karo, museum budaya"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jl. Kotacane No.180, Kabanjahe, Kec. Simpang Empat, Kabupaten Karo, Sumatera Utara"@id ;
    ws:lintang "3.118111"^^xsd:decimal ;
    ws:bujur "98.475278"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Kotacane No. 180, Kabanjahe, sekitar 5 km ke arah barat Kabanjahe, Kabupaten Karo."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "062-821-848"^^xsd:string ;
    ws:emailResmi "karolingga@yahoo.co.id"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "melihat koleksi budaya Karo"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Museum_Karo_Lingga.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.2"^^xsd:decimal .

data:ws-109 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-109"^^xsd:string ;
    ws:namaDestinasi "Museum Pusaka Karo"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Museum Pusaka Karo adalah salah satu museum yang ada di Kabupaten Karo berada di Jl. Perwira no 1 kelurahan Gundaling 1, kecamatan Berastagi, Sumatera Utara, Indonesia yang menyimpan koleksi barang-barang pusaka masyarakat Karo."@id ;
    ws:deskripsiLengkap "Museum Pusaka Karo adalah salah satu museum yang ada di Kabupaten Karo berada di Jl. Perwira no 1 kelurahan Gundaling 1, kecamatan Berastagi, Sumatera Utara, Indonesia yang menyimpan koleksi barang-barang pusaka masyarakat Karo. Museum ini didirikan oleh misionaris Kapusin Belanda bernama oleh Pastor Leo atau Leonardus Egidius Joosten . Bangunan museum ini sebelumnya merupakan gedung Gereja Katolik Santa Maria Berastagi tahun 1962 yang sudah tidak digunakan lagi sejak tahun 2005. Pembangunan museum dimulai pada tahun 2010 dan peresmian dilakukan pada tanggal 9 Februari 2013 oleh Direktur Jenderal Ekonomi Kreatif Berbasis Seni dan Budaya, Ahman Sya dan ibu Lisa Tirto sebagai salah satu sponsor pendirian museum dan Rumah Gugung Tirto Meciho. Museum Pusaka Karo berada dalam pengelolaan Yayasan Pusaka Karo. Koleksi Museum Pusaka Karo berupa benda pusaka asli Karo yang disumbangkan atau dititipkan oleh masyarakat Karo. Museum memiliki seribuan koleksi berharga, di Museum Pusaka Karo, koleksi benda sejarah tidak hanya berasal dari institusi atau sumber formal, namun juga disumbangkan oleh masyarakat Karo dan ada juga yang menitipkan koleksi etnografika Karo oleh Mehemoni br Tarigan yang kemudian menyerahkan berbagai barang bersejarah untuk dipamerkan di museum. Barang-barang yang dipinjamkan dapat dikembalikan kapan saja sesuai kebutuhan pemiliknya. Museum ini memiliki sejumlah 1512 buah koleksi benda sejarah yang berasal dari berbagai periode, bahkan sejak abad ke-18. Salah satu peninggalan sejarah yang menarik adalah koleksi Pustaka Lak-lak. Pustaka Lak-lak merupakan buku dengan aksara kuno yang memiliki usia ratusan tahun. Buku-buku ini terbuat dari kulit kayu dan ditulis dengan aksara asli Karo. Isinya mencakup mantra-mantra yang dituliskan dengan tinta yang terbuat dari getah kayu."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Pusaka Karo, Berastagi, benda pusaka Karo, museum"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jl. Perwira No.1, Gundaling I, Kec. Berastagi, Kabupaten Karo, Sumatera Utara"@id ;
    ws:lintang "3.19492"^^xsd:decimal ;
    ws:bujur "98.50822"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jl. Perwira No. 1, Kelurahan Gundaling I, Kecamatan Berastagi, Kabupaten Karo."@id ;
    ws:jamOperasional "Selasa-Jumat 10.00-17.00 WIB, Minggu 14.30-17.30 WIB (Sabtu tutup)"@id ;
    ws:hargaMasuk "8000"^^xsd:decimal ;
    ws:noHpResmi "0628-922-18"^^xsd:string ;
    ws:emailResmi "leo_joosten@yahoo.co.id"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "melihat koleksi pusaka Karo"@id ;
    ws:dapatMelakukan "belajar sejarah dan budaya Karo"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Museum_Pusaka_Karo_%28Berastagi%29.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.5"^^xsd:decimal .

data:ws-110 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-110"^^xsd:string ;
    ws:namaDestinasi "Masjid Azizi"@id ;
    ws:namaAlternatif "Masjid Sultan Abdul Aziz"@id ;
    ws:namaAlternatif "Masjid Kesultanan Langkat"@id ;
    ws:deskripsiSingkat "Masjid Azizi (bahasa Arab: مسجد عزيزي), secara resmi bernama Masjid Sultan Abdul Aziz, atau lebih dikenal dengan Masjid Kesultanan Langkat adalah sebuah masjid bersejarah peninggalan Kesultanan Langkat yang berada di Kelurahan Tanjung Pura, Kecamatan Tanjung Pura, Kabupaten Langkat, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Masjid Azizi (bahasa Arab: مسجد عزيزي), secara resmi bernama Masjid Sultan Abdul Aziz (bahasa Arab: مسجد السلطان عبد العزيز) atau lebih dikenal dengan Masjid Kesultanan Langkat (bahasa Arab: مسجد لانجكات الملكي) adalah sebuah masjid bersejarah peninggalan Kesultanan Langkat yang berada di Kelurahan Tanjung Pura, Kecamatan Tanjung Pura, Kabupaten Langkat, Provinsi Sumatera Utara, Indonesia. Masjid ini awalnya dibangun pada tahun 1889, atas perintah Sultan Abdul Aziz, penguasa Kesultanan Langkat akhir abad ke-19. Arsitektur masjid ini menjadi inspirasi bagi arsitektur Masjid Zahir di Kedah, Malaysia."@id ;
    ws:jenisDestinasi "Religi"@id ;
