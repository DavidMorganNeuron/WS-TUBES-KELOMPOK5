data:ws-215 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-215"^^xsd:string ;
    ws:namaDestinasi "Wisata Sawah Pematang Johar"@id ;
    ws:namaAlternatif "Kampung Wisata Sawah Pematang Johar"@id ;
    ws:deskripsiSingkat "Kampung wisata edukasi berbasis persawahan di Desa Pematang Johar, Kecamatan Labuhan Deli, Kabupaten Deli Serdang, sekitar 17 km dari Kota Medan."@id ;
    ws:deskripsiLengkap "Wisata Sawah Pematang Johar berada di Dusun VI Rawa Badak, Desa Pematang Johar, Kecamatan Labuhan Deli, Kabupaten Deli Serdang, memanfaatkan areal sawah desa seluas sekitar 1.750 hektare. Kawasan ini diresmikan pada 2019 dan dikelola desa bersama mitra swasta. Pengunjung dapat menyusuri pematang, menyewa saung, mencoba perahu bebek, ikut edukasi bertani, dan berfoto dengan latar hamparan sawah serta perbukitan. Fasilitas yang tersedia antara lain area parkir, toilet, musala, warung makan, dan penyewaan sepeda air. Tiket masuk lima ribu rupiah per orang, dengan tambahan biaya untuk saung dan wahana."@id ;
    ws:jenisDestinasi "Kuliner"@id ;
    ws:kataKunci "Wisata Sawah Pematang Johar, Kampung Wisata Sawah, Labuhan Deli, Deli Serdang, edu wisata sawah"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Jl. Johar Raya Gg. Tanah Wakaf Dusun VI, Desa Pematang Johar, Kec. Labuhan Deli, Kab. Deli Serdang, Sumatera Utara 20373"@id ;
    ws:lintang "3.694330"^^xsd:decimal ;
    ws:bujur "98.718710"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, ambil Jalan Johar Raya ke arah Labuhan Deli sekitar 17 km; gerbang wisata berada di ujung gang Tanah Wakaf."@id ;
    ws:jamOperasional "Setiap hari 08.00-19.00 WIB"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
