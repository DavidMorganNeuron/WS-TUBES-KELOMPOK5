    ws:ratingPengunjung "4.4"^^xsd:decimal .

data:ws-023 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-023"^^xsd:string ;
    ws:namaDestinasi "Danau Sidihoni"@id ;
    ws:namaAlternatif "Tao Sidihoni"@id ;
    ws:deskripsiSingkat "Danau Sidihoni adalah fenomena unik berjuluk danau di atas danau yang terletak di atas Pulau Samosir dengan luas sekitar 5 hektare."@id ;
    ws:deskripsiLengkap "Danau Sidihoni (Tao Sidihoni) yang terletak di Desa Salaon Toba, Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara, mendapat julukan unik sebagai danau di atas danau karena posisinya berada di atas ketinggian sekitar 1.100–1.300 mdpl, jauh lebih tinggi daripada permukaan Danau Toba yang berada di ketinggian sekitar 905 mdpl. Memiliki luas kurang lebih 5 hektare, danau air tawar ini dikelilingi oleh padang rumput hijau yang landai, barisan pohon pinus, serta perbukitan yang memesona. Menariknya, air di Danau Sidihoni memiliki keunikan karena dapat berubah warna; saat musim kemarau airnya terlihat jernih kehijauan, sedangkan saat musim hujan atau terkena tiupan angin kencang ke arah dasar, airnya bisa berubah menjadi keruh kecoklatan akibat sedimentasi."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Sidihoni"@id, "Tao Sidihoni"@id, "Danau di Atas Danau"@id, "Ronggur Nihuta"@id, "Samosir"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Salaon Toba, Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara"@id ;
    ws:lintang "2.602254587969435"^^xsd:decimal ;
    ws:bujur "98.74467811225207"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Ronggur Nihuta, Kabupaten Samosir, sekitar 8 km dari Pangururan."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Toilet"@id, "Rumah Makan"@id, "Gazebo"@id ;
    ws:dapatMelakukan "Berfoto"@id,
