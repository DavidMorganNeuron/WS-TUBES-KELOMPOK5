    ws:alamat "Kec. Bahorok, Kab. Langkat, Sumatera Utara"@id ;
    ws:lintang "3.545000"^^xsd:decimal ;
    ws:bujur "98.124000"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Bukit Lawang, berkendara sekitar 20 menit mengikuti jalan desa menuju Landak River."@id ;
