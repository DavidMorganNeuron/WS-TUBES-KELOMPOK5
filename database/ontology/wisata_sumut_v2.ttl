data:ws-044 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-044"^^xsd:string ;
    ws:namaDestinasi "KiDZiLLA Centre Point"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "KiDZiLLA Centre Point Medan adalah arena bermain anak indoor berbasis edukasi yang terletak di Mall Centre Point, Kota Medan, dengan berbagai wahana interaktif seperti kolam bola, perosotan, dan trampolin."@id ;
    ws:deskripsiLengkap "Berlokasi di lantai 2 Mall Centre Point, Jl. Jawa No. 8, Kota Medan, KiDZiLLA hadir sebagai destinasi playland dan edutainment ramah anak yang dirancang untuk mendukung pertumbuhan motorik serta kreativitas si kecil melalui lingkungan yang aman. Di area bermain ini, anak-anak dapat menikmati ragam fasilitas menarik—mulai dari kolam mandi bola berwarna-warni, seluncuran, terowongan ketangkasan, hingga permainan interaktif berbasis layar digital. Tempat ini menjadi pilihan favorit keluarga untuk menghabiskan waktu berkualitas (family time) di tengah pusat kota Medan dengan harga tiket masuk yang cukup terjangkau."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "-"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Jawa No.8, Gg. Buntu, Kecamatan Medan Timur, Kota Medan, Sumatera Utara 20236"@id ;
    ws:lintang "3.5919270205619593"^^xsd:decimal ;
    ws:bujur "98.68102012517477"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak di dalam Mall Centre Point Medan di Jalan Jawa, Gang Buntu, Medan Timur, yang berjarak sekitar 10–15 menit berkendara dari pusat Kota Medan."@id ;
    ws:jamOperasional "Setiap Hari 10.00 - 22.00"@id ;
    ws:hargaMasuk "100000" ;
    ws:noHpResmi "082170657867" ;
    ws:emailResmi "https://www.centrepoint.co.id/stores/toys-baby-game-station/kidzilla" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Toilet"@id, "Wahana"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Bermain"@id, "Bersantai"@id ;
