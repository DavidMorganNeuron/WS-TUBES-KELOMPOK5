data:ws-245 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-245"^^xsd:string ;
    ws:namaDestinasi "Tip Top Restaurant"@id ;
    ws:namaAlternatif "Restoran Tip Top"@id,
        "Tip Top Kesawan"@id ;
    ws:deskripsiSingkat "Restoran tertua di Kota Medan yang didirikan pada 1934 di Jalan Ahmad Yani, Kesawan, dan masih mempertahankan resep serta peralatan lamanya."@id ;
    ws:deskripsiLengkap "Tip Top Restaurant berada di Jalan Jenderal Ahmad Yani Nomor 92 A-B, Kelurahan Kesawan, Kecamatan Medan Barat, Kota Medan. Cikal bakalnya adalah restoran Jang Kie yang dibuka pada 1929 dan kemudian berganti nama menjadi Tip Top pada 1934. Restoran ini menyajikan hidangan peranakan seperti bistik lidah, nasi goreng, dan es krim yang dibuat dengan mesin tua, serta mempertahankan meja, kursi, dan etalase kue bergaya kolonial. Tidak ada tiket masuk; pengunjung membayar pesanan. Restoran buka setiap hari dari pagi hingga malam dan menjadi salah satu tujuan wisata kuliner warisan di Medan."@id ;
    ws:jenisDestinasi "Kuliner"@id ;
    ws:kataKunci "Tip Top Restaurant, Tip Top Kesawan, kuliner warisan, es krim, Medan, restoran kolonial"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Jend. Ahmad Yani No. 92 A-B, Kel. Kesawan, Kec. Medan Barat, Kota Medan, Sumatera Utara"@id ;
    ws:lintang "3.586070"^^xsd:decimal ;
    ws:bujur "98.679630"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Jalan Ahmad Yani, Kesawan, sekitar 300 meter dari Tjong A Fie Mansion."@id ;
    ws:jamOperasional "Setiap hari 08.00-21.30 WIB"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
