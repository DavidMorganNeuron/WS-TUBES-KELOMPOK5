    ws:alamat "Kel. Pancuran Pinang, Kec. Sibolga Sambas, Kota Sibolga, Sumatera Utara"@id ;
    ws:lintang "1.7280556"^^xsd:decimal ;
    ws:bujur "98.7802778"^^xsd:decimal ;
    ws:petunjukLokasi "Dari dermaga Sibolga, sewa perahu nelayan sekitar 15 menit menuju Pulau Sarudik."@id ;
