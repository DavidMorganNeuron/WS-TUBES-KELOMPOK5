data:ws-116 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-116"^^xsd:string ;
    ws:namaDestinasi "Bukit Holbung"@id ;
    ws:namaAlternatif "Bukit Teletubbies Samosir"@id, "Holbung Samosir"@id ;
    ws:deskripsiSingkat "Bukit Holbung merupakan deretan sabana hijau bergelombang di pesisir barat Pulau Samosir yang menawarkan lanskap terbuka Danau Toba yang dramatis."@id ;
    ws:deskripsiLengkap "Menyandang julukan sebagai Bukit Teletubbies Samosir berkat morfologinya yang membulat indah bagaikan gundukan raksasa berselimut rerumputan ilalang, Bukit Holbung telah berdiri kokoh selama lebih dari dua abad tanpa perubahan struktural yang berarti. Untuk mencapai puncak perbukitannya, pengunjung cukup mendaki jalur berundak yang tidak terlalu ekstrem selama sekitar 15 menit. Dari puncaknya, kita bisa memanjakan mata dengan pemandangan perairan biru Danau Toba yang berpadu dengan jajaran Gunung Pusuk Buhit yang sakral, sehingga kawasan ini sering dipilih sebagai tempat mendirikan tenda untuk berkemah demi berburu momen matahari terbit."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Bukit Holbung"@id, "Sipege"@id, "Samosir"@id, "Wisata Alam"@id, "Bukit Teletubbies"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Desa Holbung, Kecamatan Sitiotio, Kabupaten Samosir, Sumatera Utara 22396"@id ;
    ws:lintang "2.5319"^^xsd:decimal ;
    ws:bujur "98.6992"^^xsd:decimal ;
    ws:petunjukLokasi "Dari arah Pangururan, menuju Tele dan mengambil rute menyeberang kawasan Harian Boho ke arah desa Holbung."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "10000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "@bukitholbung"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Rumah Makan"@id, "Toilet"@id ;
