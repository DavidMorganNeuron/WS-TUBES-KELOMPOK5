data:ws-023 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-023"^^xsd:string ;
    ws:namaDestinasi "Danau Sidihoni"@id ;
    ws:namaAlternatif "Tao Sidihoni"@id ;
    ws:deskripsiSingkat "Danau di atas Pulau Samosir, dikenal sebagai \"danau di atas danau\"."@id ;
    ws:deskripsiLengkap "Danau Sidihoni (bahasa Batak Toba: Tao Sidihoni) adalah sebuah danau yang terletak di Kecamatan Ronggur Nihuta, Kabupaten Samosir, Sumatera Utara. Oleh karena berada di atas Pulau Samosir, Danau Sidihoni disebut sebagai \"danau di atas danau\" (di atas Danau Toba). Danau Sidihoni berjarak 8 kilometer dari Pangururan. Pemandangan di sekitar danau bisa dipantulkan oleh air danau. Danau ini dikelilingi oleh bukit landai berwarna hijau muda dan deretan pohon pinus.Danau Sidinohi merupakan danau yang berada di atas danau. Danau Sidihoni dikenal memiliki pemandangan alam yang memukau dan suasana yang sejuk, dan menawarkan daya tarik tersendiri yang jarang ada di tempat lain. Warna air di danau ini dapat berubah sesuai dengan keadaan lingkungan sekitarnya. Dalam kondisi di mana terjadi proses sedimentasi tertentu, air di danau ini akan memiliki warna cenderung kecoklatan. Terdapat juga faktor lainnya yang dapat menyebabkan perubahan warna air danau, seperti angin yang dapat memberi guncangan pada air hingga dasar. Wisata Untuk dapat mencapai danau ini, wisatawan dapat melalui rute Pangururan menggunakan kendaraan roda dua maupun roda empat. Pertama, kunjungi Pelabuhan Parapet dan menaiki kapal menuju Pelabuhan Tomok di Pulau Samosir. Lanjutkan perjalanan selanjutnya menuju ke Pangururan lalu ikuti petunjuk arah menuju Danau Sidihoni. Markah tanah yang paling terkenal di sekitar danau ini adalah bangunan gereja HKBP Sidihoni."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Sidihoni, Tao Sidihoni, danau di atas danau, Ronggur Nihuta, Samosir"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "-"@id ;
    ws:lintang "2.601483"^^xsd:decimal ;
    ws:bujur "98.744764"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Ronggur Nihuta, Kabupaten Samosir, sekitar 8 km dari Pangururan."@id ;
