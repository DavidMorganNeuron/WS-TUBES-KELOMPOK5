    ws:alamat "Jl. Let. Jend. Jamin Ginting, Desa Sikeben, Kec. Sibolangit, Kabupaten Deli Serdang, Sumatera Utara 20157"@id ;
    ws:lintang "3.2775000"^^xsd:decimal ;
    ws:bujur "98.5480556"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di kawasan Green Hill City, Jalan Letjen Jamin Ginting, Desa Sikeben, Kecamatan Sibolangit, sekitar 45 km dari Kota Medan."@id ;
    ws:jamOperasional "Setiap hari 10.00-18.00"@id ;
