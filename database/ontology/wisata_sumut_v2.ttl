data:ws-137 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-137"^^xsd:string ;
    ws:namaDestinasi "Istana Kotapinang"@id ;
    ws:namaAlternatif "Istana Bahran"@id, "Situs Istana Kotapinang"@id ;
    ws:deskripsiSingkat "Istana Kotapinang merupakan sisa peninggalan reruntuhan tembok megah pusat peradaban Kesultanan Kotapinang di tepi Sungai Barumun."@id ;
    ws:deskripsiLengkap "Dibangun pada masa kejayaan Kesultanan Bahran atau Kesultanan Kotapinang di abad ke-19, kompleks istana ini hancur terbakar pada peristiwa pergolakan revolusi sosial Sumatera Timur di awal kemerdekaan. Saat ini, sisa-sisa tembok dan fondasi anak tangganya yang menjulang megah seakan menolak lekang oleh zaman. Lokasinya yang langsung menghadap kelokan Sungai Barumun menjadikannya potret klasik kejayaan bandar niaga sungai pesisir timur yang epik. Meskipun hanya berupa situs reruntuhan sejarah (heritage ruins), tempat ini justru mengundang minat banyak fotografer karena keeksotisannya yang pudar."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Istana Kotapinang"@id, "Istana Bahran"@id, "Kotapinang"@id, "Labuhanbatu Selatan"@id, "Kesultanan Melayu"@id ;
    ws:beradaDi "Kabupaten Labuhanbatu Selatan"@id ;
    ws:alamat "Jl. Istana, Kotapinang, Kecamatan Kotapinang, Kabupaten Labuhanbatu Selatan, Sumatera Utara 21464"@id ;
    ws:lintang "1.8952807"^^xsd:decimal ;
    ws:bujur "100.0933587"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak dekat tepi Sungai Barumun di kawasan kota tua Kotapinang."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
