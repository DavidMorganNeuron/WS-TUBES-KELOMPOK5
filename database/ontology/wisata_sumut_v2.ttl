data:ws-105 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-105"^^xsd:string ;
    ws:namaDestinasi "Masjid Agung Syahrun Nur"@id ;
    ws:namaAlternatif ""@id ;
    ws:deskripsiSingkat "Masjid Agung Syahrun Nur adalah masjid yang terletak di Sipirok, Tapanuli Selatan, Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Masjid Agung Syahrun Nur adalah masjid yang terletak di Sipirok, Tapanuli Selatan, Sumatera Utara, Indonesia. Masjid ini diresmikan pada 22 Januari 2021 dan menjadi salah satu ikon arsitektur serta pusat kegiatan keagamaan di wilayah tersebut. Arsitektur Masjid Agung Syahrun Nur mengadopsi desain arsitektur yang memadukan gaya Timur Tengah, Turki, dan elemen budaya lokal Tapanuli Selatan. Bangunan utama masjid memiliki satu kubah besar berwarna hijau dan empat menara tinggi. Fasad masjid dihiasi ornamen khas Suku Mandailing, termasuk ukiran singa dan motif kain ulos, yang mencerminkan identitas budaya setempat. Masjid ini terletak di kompleks perkantoran Pemerintah Kabupaten Tapanuli Selatan, tepat di kawasan Sipirok. Posisi strategis di tepi jalan lintas Sumatera memudahkan akses bagi masyarakat lokal maupun pengunjung dari luar daerah. Area sekitar masjid dilengkapi fasilitas pendukung, seperti taman, area parkir, dan fasilitas titik baca online. Selain berfungsi sebagai tempat ibadah, Masjid Agung Syahrun Nur juga menjadi pusat kegiatan keagamaan, pendidikan, dan sosial. Lingkungan masjid yang tertata dengan baik dan pemandangan alam sekitarnya menjadikannya salah satu destinasi wisata religi di Sumatera Utara."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Masjid Agung Syahrun Nur, Sipirok, Tapanuli Selatan"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat ""@id ;
    ws:lintang "1.519729"^^xsd:decimal ;
    ws:bujur "99.303319"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Sipirok, Kabupaten Tapanuli Selatan."@id ;
    ws:jamOperasional ""@id ;
