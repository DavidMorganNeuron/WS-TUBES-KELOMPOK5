data:ws-203 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-203"^^xsd:string ;
    ws:namaDestinasi "Pantai Fodo"@id ;
    ws:namaAlternatif "Pantai Fodo Gunungsitoli"@id ;
    ws:deskripsiSingkat "Pantai di pesisir barat Kota Gunungsitoli yang menjadi salah satu dari 17 destinasi andalan yang dikelola Dinas Pariwisata setempat."@id ;
    ws:deskripsiLengkap "Pantai Fodo terletak di Kecamatan Gunungsitoli, Kota Gunungsitoli, Pulau Nias. Kawasan ini termasuk dalam daftar destinasi yang dipromosikan Dinas Pariwisata dan Kebudayaan Kota Gunungsitoli bersama Taman Ya'ahowu. Pantainya berpasir gelap dengan garis pantai panjang dan ombak Samudra Hindia yang cukup kuat, sehingga lebih cocok untuk bersantai, memancing, dan menikmati panorama daripada berenang. Di sekitarnya terdapat warung kopi dan rumah makan ikan. Waktu terbaik berkunjung adalah pagi atau sore ketika cuaca tidak terlalu panas."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Fodo, Gunungsitoli, Nias, pantai barat Nias, Samudra Hindia"@id ;
    ws:beradaDi "Kota Gunungsitoli"@id ;
    ws:alamat "Kec. Gunungsitoli, Kota Gunungsitoli, Sumatera Utara"@id ;
    ws:lintang "1.246360"^^xsd:decimal ;
    ws:bujur "97.642290"^^xsd:decimal ;
    ws:petunjukLokasi "Dari pusat Kota Gunungsitoli, berkendara sekitar 10 menit ke arah barat menuju garis pantai di Kelurahan Fodo."@id ;
    ws:jamOperasional "Setiap hari 08.00-18.00 WIB"@id ;
