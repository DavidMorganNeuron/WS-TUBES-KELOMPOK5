data:ws-137 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-137"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Sigura-gura"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Air Terjun Sigura-gura adalah sebuah air terjun yang berada di Dusun Sigura-Gura, Desa Pintu Pohan Dolok, Kecamatan Pintu Pohan Meranti, Kabupaten Toba, Provinsi Sumatera Utara, Indonesia."@id ;
    ws:deskripsiLengkap "Air Terjun Sigura-gura adalah sebuah air terjun yang berada di Dusun Sigura-Gura, Desa Pintu Pohan Dolok, Kecamatan Pintu Pohan Meranti, Kabupaten Toba, Provinsi Sumatera Utara, Indonesia. Air Terjun Sigura-gura memiliki ketinggian hingga 250 m dan menjadikannya air terjun tertinggi di Indonesia. Air Terjun Sigura-gura berada di aliran Sungai Asahan di ketinggian sekitar 800 mdpl. Air Terjun Sigura-gura dikontrol dari pintu air Bendungan Sigura-gura yang berada tepat diatasnya. Dengan ketinggian mencapai 250 m, Air Terjun Sigura-gura memegang gelar sebagai air terjun tertinggi di Indonesia. Air Terjun Sigura-gura diposisikan di aliran Sungai Asahan, mengalir di ketinggian sekitar 800 mdpl."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "air terjun Sigura-gura, Sungai Asahan, Pintu Pohan Meranti, air terjun tertinggi di Indonesia"@id ;
