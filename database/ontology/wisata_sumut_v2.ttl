data:ws-213 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-213"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Simatutung"@id ;
    ws:namaAlternatif "Simatutung Waterfalls"@id ;
    ws:deskripsiSingkat "Air terjun bertingkat setinggi sekitar 150 meter di Kecamatan Angkola Sangkunur, Kabupaten Tapanuli Selatan, di antara Desa Sikapas dan Rianiate."@id ;
    ws:deskripsiLengkap "Air Terjun Simatutung berada di Kecamatan Angkola Sangkunur, Kabupaten Tapanuli Selatan, tepatnya di perbatasan Desa Sikapas dan Rianiate, pada ketinggian sekitar 1.650 meter di atas permukaan laut. Total tingginya mencapai sekitar 150 meter dengan beberapa undakan, dan suhu udara di sekitarnya berkisar 12 sampai 17 derajat Celsius. Kawasan ini pernah ditata ulang pada 2018 dan kini dilengkapi lahan parkir, toilet, serta warung kopi sederhana. Pengunjung dapat berendam di kolam alami atau berfoto dari area pandang. Pengelolaan dilakukan secara swadaya sehingga biaya masuk masih gratis."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Simatutung"@id, "Angkola Sangkunur"@id, "Tapanuli Selatan"@id, "Air Terjun Bertingkat"@id, "Rianiate"@id ;
    ws:beradaDi "Kabupaten Tapanuli Selatan"@id ;
    ws:alamat "Desa Rianiate, Kec. Angkola Sangkunur, Kab. Tapanuli Selatan, Sumatera Utara 22738"@id ;
    ws:lintang "1.3013125"^^xsd:decimal ;
    ws:bujur "98.9275625"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Padangsidimpuan, berkendara sekitar satu jam ke arah Angkola Sangkunur hingga plang Air Terjun Simatutung."@id ;
    ws:jamOperasional "Setiap hari 08.00-18.00"@id ;
