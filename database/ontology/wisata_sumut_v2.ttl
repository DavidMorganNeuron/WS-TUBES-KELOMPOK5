data:ws-011 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-011"^^xsd:string ;
    ws:namaDestinasi "Danau Baua"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Danau Baua adalah sebuah danau air tawar unik yang terletak tersembunyi tepat di bagian tengah Pulau Bawa, wilayah administrasi Kecamatan Sirombu, Kabupaten Nias Barat, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Berbeda dengan mayoritas destinasi di Kepulauan Hinako yang didominasi oleh pesisir laut terjal dan pantai berpasir yang menghadap langsung ke Samudera Hindia, Danau Baua menyajikan fenomena alam yang memikat berupa hamparan air tawar yang tenang di tengah-tengah pulau kecil. Kehadiran danau tersembunyi ini menjadi daya tarik ekologis yang kontras sekaligus menyegarkan bagi para petualang yang mengunjungi Pulau Bawa. Dikelilingi oleh vegetasi hijau dan suasana pedesaan yang dihuni masyarakat lokal yang ramah, Danau Baua menawarkan lanskap alami yang masih asri, menjadikannya sebuah permata tersembunyi yang menyimpan potensi wisata geografi luar biasa di Nias Barat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Baua"@id ;
    ws:beradaDi "Kabupaten Nias Barat"@id ;
    ws:alamat "Tuwa Tuwa, Kecamatan Sirombu, Kabupaten Nias Barat, Sumatera Utara"@id ;
    ws:lintang "0.827222"^^xsd:decimal ;
    ws:bujur "97.340278"^^xsd:decimal ;
    ws:petunjukLokasi "Rute darat dari Kota Medan menuju Danau Toba membentang sejauh kurang lebih 176 kilometer ke arah selatan melalui jalur Tebing Tinggi, Pematangsiantar, hingga tiba di Parapat."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Menikmati Pemandangan"@id, "Berenang"@id ;
    ws:memilikiMedia "https://image.idntimes.com/post/20200203/pulsesurfcharters-41484149-1879782205408502-467059537420816494-n-61d69c978199f9c50698b5739d1b9afa.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "-" .

data:ws-012 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-012"^^xsd:string ;
    ws:namaDestinasi "Danau Kurung"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Danau Kurung merupakan perairan alami yang terletak di Kampung Lama, Kecamatan Hamparan Perak, Kabupaten Deli Serdang, dengan suasana tenang dan asri khas pedesaan."@id ;
    ws:deskripsiLengkap "Berlokasi di wilayah Kampung Lama yang masuk dalam kawasan historis Kecamatan Hamparan Perak. Sebuah daerah yang dibuka oleh Datuk Setia Raja pada tahun 1823 serta memiliki akar sejarah dari peradaban Kerajaan Aru—Danau Kurung menyajikan perairan daratan rendah yang tenang. Lingkungan sekitar danau ini masih didominasi oleh nuansa pedesaan khas Deli Serdang dengan mayoritas penduduk lokal yang menjunjung adat serta kearifan budaya Melayu Deli. Meski tidak sepopuler destinasi wisata buatan atau vulkanik besar lainnya di Sumatera Utara, Danau Kurung menjadi salah satu titik perairan lokal yang memberikan karakteristik bentang alam asri bagi masyarakat setempat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Kurung"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Kampung Lama, Kecamatan Hamparan Perak, Kabupaten Deli Serdang, Sumatera Utara"@id ;
    ws:lintang "3.781176900100156"^^xsd:decimal ;
    ws:bujur "98.57286357360613"^^xsd:decimal ;
    ws:petunjukLokasi "Danau Kurung terletak di Kampung Lama, Kecamatan Hamparan Perak, Kabupaten Deli Serdang, Sumatera Utara, yang dapat ditempuh dari Kota Medan ke arah utara melewati Jalan Klambir V atau Jalan Hamparan Perak."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Menikmati Pemandangan"@id, "Berenang"@id ;
    ws:memilikiMedia "-"^^xsd:anyURI ;
    ws:ratingPengunjung "4.0"^^xsd:decimal .

data:ws-013 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-013"^^xsd:string ;
    ws:namaDestinasi "Danau Lau Kawar"@id ;
    ws:namaAlternatif "Lau Kawar"@id ;
    ws:deskripsiSingkat "Danau Lau Kawar adalah satu danau yang berada di Desa Kutagugung, Kecamatan Naman Teran (dulu Kecamatan Simpang Empat), di bawah kaki gunung berapi Sinabung, Kabupaten Karo, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Tersembunyi di bawah megahnya perbukitan dan hutan tropis di Desa Kutagugung, Kecamatan Naman Teran, Danau Lau Kawar menawarkan panorama air tenang dengan latar belakang Gunung Sinabung yang memukau. Dengan luas sekitar 200 hektar dan berada di ketinggian 2.451 meter di atas permukaan laut, kawasan ini menyajikan udara yang sangat sejuk serta suasana asri yang cocok untuk melepas penat. Selain menjadi lokasi favorit untuk berkemah dan bersantai di tepian danau, tempat ini juga sering dijadikan titik awal bagi para pendaki yang ingin menjelajahi jalur pendakian Gunung Sinabung."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Lau Kawar"@id, "Lau Kawar"@id, "Gunung Sinabung"@id, "Kutagugung"@id, "Naman Teran"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jl. Kiras Bangun, Kuta Gugung, Kecamatan Naman Teran, Kabupaten Karo, Sumatera Utara 22153"@id ;
    ws:lintang "3.194438213120289"^^xsd:decimal ;
    ws:bujur "98.38477165401072"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Kutagugung, Kecamatan Naman Teran, Kabupaten Karo, di bawah kaki Gunung Sinabung."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "15000"^^xsd:decimal ;
    ws:noHpResmi "081267777693" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/marihilllaukawar"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id,
        "Toilet"@id,
        "Warung Makan"@id ;
    ws:dapatMelakukan "Berfoto"@id,
        "Berkemah"@id,
        "Menikmati Pemandangan"@id, "Berenang"@id ;
