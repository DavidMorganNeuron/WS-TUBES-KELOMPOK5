data:ws-127 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-127"^^xsd:string ;
    ws:namaDestinasi "Tombak Sulu-sulu"@id ;
    ws:namaAlternatif "Gua Tombak Sulu-sulu"@id, "Gua Sisingamangaraja"@id ;
    ws:deskripsiSingkat "Tombak Sulu-sulu merupakan gua batu kapur sakral yang diyakini sebagai tempat kelahiran Raja Sisingamangaraja I di kawasan Bakkara."@id ;
    ws:deskripsiLengkap "Tombak Sulu-sulu secara harfiah berarti hutan yang terang. Tempat ini merupakan celah ceruk batuan karts purba yang ditutupi akar pohon beringin raksasa dan sulur-sulur tumbuhan lebat yang usianya diperkirakan ratusan tahun. Gua ini memiliki nilai spiritual yang teramat tinggi bagi masyarakat Batak Toba karena diyakini sebagai tempat turunnya wahyu dan tempat persemayaman ibunda Raja Sisingamangaraja I (Boru Pasaribu) saat melahirkan. Wisatawan diwajibkan melepaskan alas kaki, menjaga perkataan, dan mengenakan ulos sebelum melangkah masuk ke dalam area gua yang lembap dan mistis ini."@id ;
    ws:jenisDestinasi "Alam"@id, "Religi"@id ;
    ws:kataKunci "Tombak Sulu-sulu"@id, "Gua Sakral"@id, "Bakkara"@id, "Humbang Hasundutan"@id, "Wisata Religi"@id ;
    ws:beradaDi "Kabupaten Humbang Hasundutan"@id ;
    ws:alamat "Desa Marbun, Kecamatan Baktiraja, Kabupaten Humbang Hasundutan, Sumatera Utara 22457"@id ;
    ws:lintang "2.3077"^^xsd:decimal ;
    ws:bujur "98.8061"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak dekat dengan objek wisata Air Terjun Janji di Baktiraja."@id ;
    ws:jamOperasional "Setiap Hari 08.00-17.00"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "@disparporahumbahas "^^xsd:anyURI ;
    ws:memilikiFasilitas "Area Istirahat"@id ;
