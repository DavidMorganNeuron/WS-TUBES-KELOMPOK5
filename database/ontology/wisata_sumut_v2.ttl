data:ws-200 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-200"^^xsd:string ;
    ws:namaDestinasi "Pulau Sarudik"@id ;
    ws:namaAlternatif "Pulau Sarudik Sibolga"@id ;
    ws:deskripsiSingkat "Pulau kecil berjarak sekitar tiga kilometer dari pusat Kota Sibolga, di Kelurahan Pancuran Pinang, Kecamatan Sibolga Sambas."@id ;
    ws:deskripsiLengkap "Pulau Sarudik terletak di Kelurahan Pancuran Pinang, Kecamatan Sibolga Sambas, Kota Sibolga, dan hanya berjarak sekitar tiga kilometer dari pusat kota sehingga bisa ditempuh dengan perahu atau speed boat sewaan. Pantainya berpasir putih dengan ombak tenang dan kontur pesisir yang khas. Pengunjung biasanya berenang, bermain voli pantai, menyusuri pulau dengan perahu, atau memancing di sekitar karang. Tiket masuk kawasan sepuluh ribu rupiah per orang, belum termasuk biaya sewa perahu yang dapat dinegosiasikan dengan pemilik kapal di dermaga."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pulau Sarudik"@id, "Sibolga Sambas"@id, "Pancuran Pinang"@id, "Sibolga"@id, "Pulau Kecil"@id ;
