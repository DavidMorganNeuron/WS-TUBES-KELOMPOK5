data:ws-211 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-211"^^xsd:string ;
    ws:namaDestinasi "Makam Papan Tinggi"@id ;
    ws:namaAlternatif "Makam Papan Tinggi Barus"@id, "Makam Syekh Mahmud"@id ;
    ws:deskripsiSingkat "Situs makam kuno di atas bukit di Desa Pananggahan, Kecamatan Barus, Kabupaten Tapanuli Tengah, yang dikaitkan dengan penyebaran Islam awal di Sumatera."@id ;
    ws:deskripsiLengkap "Makam Papan Tinggi berada di Desa Pananggahan, Kecamatan Barus, Kabupaten Tapanuli Tengah, di puncak bukit setinggi sekitar 200 meter di atas permukaan laut. Untuk mencapainya pengunjung menaiki sekitar 710 anak tangga beton dari kaki bukit. Situs ini dipercaya sebagai makam Syekh Mahmud, tokoh penyebar Islam dari Yaman, dan menjadi tujuan ziarah sekaligus wisata sejarah karena Barus dahulu dikenal sebagai pelabuhan kapur barus bernama Fansur. Tiket masuk dua ribu rupiah per orang dan pengunjung biasanya memberi donasi sukarela kepada juru kunci."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Makam Papan Tinggi"@id, "Barus"@id, "Tapanuli Tengah"@id, "Syekh Mahmud"@id, "Ziarah"@id, "Sejarah Islam"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Desa Pananggahan, Kec. Barus, Kab. Tapanuli Tengah, Sumatera Utara"@id ;
    ws:lintang "2.0351875"^^xsd:decimal ;
    ws:bujur "98.4163125"^^xsd:decimal ;
    ws:petunjukLokasi "Dari pusat Barus, berkendara sekitar 10 menit ke arah Pananggahan lalu mendaki 710 anak tangga ke puncak bukit."@id ;
    ws:jamOperasional "Setiap hari 06.00-18.00"@id ;
    ws:hargaMasuk "2000"^^xsd:decimal ;
    ws:noHpResmi "+62 813-8933-1587"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Gazebo"@id, "Toilet"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Berfoto"@id, "Mendaki"@id, "Menikmati Pemandangan"@id, "Berziarah"@id ;
