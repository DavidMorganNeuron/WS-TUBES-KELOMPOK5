data:ws-233 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-233"^^xsd:string ;
    ws:namaDestinasi "Lau Kulap"@id ;
    ws:namaAlternatif "Wisata Lau Kulap"@id ;
    ws:deskripsiSingkat "Taman rekreasi air di Kabupaten Langkat dengan kolam alami dari aliran sungai pegunungan Leuser."@id ;
    ws:deskripsiLengkap "Lau Kulap berada di Kecamatan Bahorok, Kabupaten Langkat, memanfaatkan aliran sungai pegunungan yang jernih dan berbatu. Kawasan ini ditata sebagai taman rekreasi dengan kolam alami, gazebo, saung, dan area piknik keluarga. Fasilitasnya meliputi area parkir, toilet, kamar bilas, dan warung makan. Tiket masuk lima ribu rupiah per orang, dan pengunjung dapat datang setiap hari dari pagi hingga sore. Lokasinya sering dijadikan persinggahan sebelum atau sesudah trekking di Bukit Lawang karena berada di jalur yang sama."@id ;
