data:ws-248 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-248"^^xsd:string ;
    ws:namaDestinasi "Penatapen Barcelona"@id ;
    ws:namaAlternatif "Penatapan Barcelona"@id, "Cafe Barcelona Penatapan"@id, "Penatapan Berastagi Barcelona"@id ;
    ws:deskripsiSingkat "Kafe pinggir jalan di kawasan Penatapan Doulu perbatasan Karo dan Deli Serdang yang menyuguhkan pemandangan perbukitan, jagung bakar, dan kopi hangat."@id ;
    ws:deskripsiLengkap "Penatapen Barcelona berada di Jalan Jamin Ginting KM 55, Dusun Doulu, Desa Martelu, Kecamatan Sibolangit, Kabupaten Deli Serdang, tepat di tepi Jalan Lintas Medan-Kabanjahe dekat gapura perbatasan Kabupaten Karo. Kata penatapen berasal dari bahasa Karo yang berarti tempat menatap atau memandang, dan kawasan ini juga dikenal sebagai Puncak Doulu atau Penatapan Berastagi. Menurut pemiliknya, kafe ini sudah berdiri sejak 1990-an dan menjadi salah satu kafe yang paling dikenal di jajaran kafe Penatapan, dengan dekorasi bertema klub sepak bola Barcelona. Dari teras kafe, pengunjung dapat memandang perbukitan hijau dan rumah-rumah warga Sibolangit, meski pemandangan sering tertutup kabut saat cuaca berkabut. Menu yang tersedia antara lain mi instan kuah atau goreng, jagung bakar, jagung rebus, kopi, dan teh manis hangat dengan harga terjangkau. Tempat ini sering dijadikan persinggahan bagi pelancong yang menempuh jalur berliku menuju Berastagi dan lokasinya berdekatan dengan Air Terjun Sikulikap."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Penatapen Barcelona"@id, "Penatapan Berastagi"@id, "Puncak Doulu"@id, "Sibolangit"@id, "Deli Serdang"@id, "Jagung Bakar"@id, "Kafe Pemandangan"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Jl. Jamin Ginting KM 55, Dusun Doulu, Desa Martelu, Kec. Sibolangit, Kab. Deli Serdang, Sumatera Utara 22156"@id ;
    ws:lintang "3.243075"^^xsd:decimal ;
    ws:bujur "98.536373"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Medan, ikuti Jalan Lintas Medan-Kabanjahe menuju Berastagi hingga tiba di kawasan Penatapan Doulu, tidak jauh dari gapura perbatasan Deli Serdang-Karo dan Air Terjun Sikulikap."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "25000"^^xsd:decimal ;
    ws:noHpResmi "082275015071"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "https://www.instagram.com/penatapenbarcelona"^^xsd:anyURI ;
