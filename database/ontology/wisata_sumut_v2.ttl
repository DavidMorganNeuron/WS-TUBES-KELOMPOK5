data:ws-247 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-247"^^xsd:string ;
    ws:namaDestinasi "Pulau Pandang"@id ;
    ws:namaAlternatif "Pulau Pandang Batu Bara"@id ;
    ws:deskripsiSingkat "Pulau berpasir putih di perairan Kabupaten Batu Bara yang dapat dicapai dengan kapal feri dari pelabuhan Kuala Tanjung maupun Tanjung Tiram."@id ;
    ws:deskripsiLengkap "Pulau Pandang berada di perairan Kecamatan Tanjung Tiram, Kabupaten Batu Bara, sekitar satu jam dengan kapal feri dari daratan. Pulau ini memiliki pantai berpasir putih, air laut yang relatif jernih, dan deretan pohon kelapa, dengan fasilitas pondok dan warung yang dikelola warga. Pengunjung dapat berenang, bermain pasir, memancing, atau menyusuri pulau. Kawasan pulau terbuka 24 jam, sedangkan jadwal keberangkatan kapal biasanya pagi hari. Biaya kunjungan sekitar dua ratus delapan puluh lima ribu rupiah per rombongan untuk transportasi kapal dan retribusi."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pulau Pandang, Tanjung Tiram, Batu Bara, pulau, feri, pantai"@id ;
