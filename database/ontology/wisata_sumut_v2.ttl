data:ws-077 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-077"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Mbulayan"@id ;
    ws:namaAlternatif "Sampuren Mbulayan"@id ;
    ws:deskripsiSingkat "Air Terjun Mbulayan adalah pesona wisata alam tersembunyi di hutan Kabupaten Karo yang memiliki air yang jernih dan menyegarkan."@id ;
    ws:deskripsiLengkap "Bagi pencinta petualangan alam liar, Air Terjun Mbulayan menawarkan panorama eksotis yang masih sangat asri dan jauh dari sentuhan komersialisasi masif. Aliran air terjun ini menuruni tebing batu yang dilapisi lumut tebal, menciptakan kolam alami di bawahnya yang sangat dingin dan segar. Untuk mencapai lokasi ini, pengunjung harus melewati rute trekking membelah rimbunnya hutan tropis, sehingga destinasi ini sangat cocok bagi para pendaki yang gemar menjelajah alam dan berkemah di alam bebas."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Mbulayan"@id, "Karo"@id, "Wisata Alam"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
