data:ws-237 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-237"^^xsd:string ;
    ws:namaDestinasi "Dogi Park Waterboom"@id ;
    ws:namaAlternatif "Dogi Park"@id ;
    ws:deskripsiSingkat "Waterboom di Kabupaten Batu Bara yang menyediakan kolam renang, seluncuran, dan area bermain air untuk keluarga."@id ;
    ws:deskripsiLengkap "Dogi Park Waterboom berada di Kecamatan Indrapura, Kabupaten Batu Bara, sekitar dua jam berkendara dari Medan. Kawasan ini memiliki kolam anak, kolam dewasa, seluncuran, dan area bermain air yang dikelilingi taman. Fasilitasnya meliputi area parkir, toilet, kamar bilas, kantin, gazebo, dan musala. Tiket masuk lima belas ribu rupiah per orang pada hari biasa dan naik pada akhir pekan. Dogi Park buka setiap hari dari pukul sepuluh pagi hingga enam sore dan menjadi alternatif rekreasi air bagi warga Batu Bara serta kabupaten sekitar."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "Dogi Park Waterboom"@id, "Indrapura"@id, "Batu Bara"@id, "Waterboom"@id, "Kolam Renang"@id ;
    ws:beradaDi "Kabupaten Batu Bara"@id ;
    ws:alamat "Jl. H. Barus Siregar, Desa Tanjung Kubah, Indrapura, Kec. Air Putih, Kab. Batu Bara, Sumatera Utara 21256"@id ;
    ws:lintang "3.291911"^^xsd:decimal ;
    ws:bujur "99.374983"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Kisaran, berkendara sekitar 30 menit ke arah Indrapura mengikuti jalan lintas Sumatera."@id ;
    ws:jamOperasional "Setiap hari 10.00-18.00"@id ;
