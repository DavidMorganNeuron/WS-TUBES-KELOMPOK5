data:ws-123 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-123"^^xsd:string ;
    ws:namaDestinasi "Geosite Sipinsur"@id ;
    ws:namaAlternatif "Taman Wisata Sipinsur"@id, "Sipinsur Park Geosite"@id ;
    ws:deskripsiSingkat "Geosite Sipinsur adalah padang hutan pinus dataran tinggi seluas 2 hektare dengan angin menyejukkan yang pernah dikunjungi Presiden Joko Widodo."@id ;
    ws:deskripsiLengkap "Menempati dataran tinggi Kabupaten Humbang Hasundutan dengan ketinggian 1.213 meter di atas permukaan laut, Taman Sipinsur (Geosite Sipinsur) menawarkan atmosfer liburan pegunungan yang nyaris menyerupai pesona hutan Eropa. Ratusan batang pohon pinus menjulang kokoh melindungi taman tertata ini, sementara ujung bukitnya menjadi anjungan luar biasa untuk melihat secara vertikal ke perairan Danau Toba dan Pulau Sibandang di bawah sana. Berkat udara dinginnya yang khas dan tanah berpasir putihnya yang selalu bersih, wilayah ini menjadi rujukan utama aktivitas kemah akhir pekan maupun acara pramuka skala nasional."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Geosite Sipinsur"@id, "Paranginan"@id, "Humbang Hasundutan"@id, "Hutan Pinus"@id, "Taman Wisata Sipinsur"@id ;
