data:ws-162 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-162"^^xsd:string ;
    ws:namaDestinasi "Salib Kasih"@id ;
    ws:namaAlternatif "Salib Kasih Tarutung"@id, "Taman Wisata Rohani Salib Kasih"@id ;
    ws:deskripsiSingkat "Salib Kasih adalah monumen salib di puncak Bukit Siatas Barita, Kabupaten Tapanuli Utara, yang dibangun untuk menghormati misionaris Ingwer Ludwig Nommensen."@id ;
    ws:deskripsiLengkap "Salib Kasih adalah monumen salib di puncak Bukit Siatas Barita, Kabupaten Tapanuli Utara, yang dibangun untuk menghormati misionaris Ingwer Ludwig Nommensen yang mulai menyebarkan ajaran Kristen di Tapanuli pada 1863. Monumen ini berada sekitar 2 km dari pusat Kota Tarutung dan dapat dicapai melalui pendakian sekitar 1 km menuju puncak bukit, dari mana pengunjung dapat menikmati panorama perbukitan Tapanuli."@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Salib Kasih"@id, "Tarutung"@id, "Siatas Barita"@id, "Nommensen"@id, "Wisata Rohani"@id ;
