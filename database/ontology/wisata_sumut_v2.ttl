data:ws-207 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-207"^^xsd:string ;
    ws:namaDestinasi "Pantai Bebas Parapat"@id ;
    ws:namaAlternatif "Pantai Bebas"@id, "Ruang Terbuka Publik Parapat"@id ;
    ws:deskripsiSingkat "Ruang terbuka publik di tepi Danau Toba, Kelurahan Parapat, Kecamatan Girsang Sipangan Bolon, Kabupaten Simalungun, yang diresmikan pada 2022."@id ;
    ws:deskripsiLengkap "Pantai Bebas Parapat terletak di Jalan Sisingamangaraja, Kelurahan Parapat, Kecamatan Girsang Sipangan Bolon, Kabupaten Simalungun, tepat di tepi Danau Toba. Kawasan ini ditata sebagai ruang terbuka publik dengan jalur pejalan kaki, panggung terbuka, taman, dan area duduk menghadap danau, lalu diresmikan pada Februari 2022. Akses masuknya gratis; pengunjung hanya membayar parkir. Tempat ini sering dipakai untuk piknik, berolahraga, menikmati matahari terbenam, dan menjadi titik awal menuju pelabuhan feri Ajibata maupun Tigaras."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Bebas Parapat"@id, "Parapat"@id, "Girsang Sipangan Bolon"@id, "Simalungun"@id, "Ruang Terbuka Publik"@id, "Danau Toba"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Jl. Sisingamangaraja, Kel. Parapat, Kec. Girsang Sipangan Bolon, Kab. Simalungun, Sumatera Utara"@id ;
    ws:lintang "2.6688125"^^xsd:decimal ;
    ws:bujur "98.9376875"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di pusat Kota Parapat di tepi jalan lintas utama, tidak jauh dari Pelabuhan Ajibata."@id ;
