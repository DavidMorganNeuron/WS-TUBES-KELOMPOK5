data:ws-246 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-246"^^xsd:string ;
    ws:namaDestinasi "Pulau Kalimantung"@id ;
    ws:namaAlternatif "Pulau Kalimantung Tapanuli Tengah"@id ;
    ws:deskripsiSingkat "Gugusan pulau kecil di perairan Kecamatan Pandan, Kabupaten Tapanuli Tengah, yang biasa dikunjungi dengan perahu sewaan."@id ;
    ws:deskripsiLengkap "Pulau Kalimantung berada di perairan Kecamatan Pandan, Kabupaten Tapanuli Tengah, dan dapat dicapai dengan perahu sewaan dari pesisir Pandan maupun Sibolga. Gugusan pulau ini memiliki pasir putih sempit, air laut jernih, dan terumbu karang yang cocok untuk snorkeling sederhana. Pengunjung biasanya datang untuk berenang, memancing, atau piknik di pantai berpasir, lalu kembali sebelum sore. Biaya kunjungan sekitar tiga ratus ribu rupiah per rombongan untuk sewa perahu dan retribusi, dan jam kunjungan mengikuti kesepakatan dengan pemilik perahu."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pulau Kalimantung, Pandan, Tapanuli Tengah, pulau kecil, snorkeling, perahu"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Kec. Pandan, Kab. Tapanuli Tengah, Sumatera Utara"@id ;
    ws:lintang "1.561092"^^xsd:decimal ;
    ws:bujur "98.576625"^^xsd:decimal ;
    ws:petunjukLokasi "Dari pesisir Pandan atau dermaga Sibolga, sewa perahu nelayan sekitar 30 menit menuju gugusan Pulau Kalimantung."@id ;
    ws:jamOperasional "Setiap hari 24 jam"@id ;
    ws:hargaMasuk "300000"^^xsd:decimal ;
    ws:noHpResmi "" ;
    ws:emailResmi "" ;
    ws:instagramResmi ""^^xsd:anyURI ;
    ws:memilikiFasilitas "Dermaga"@id,
        "Gazebo"@id,
        "Toilet"@id ;
    ws:dapatMelakukan "Berenang"@id,
        "Memancing"@id,
        "Menikmati pantai"@id,
        "Piknik"@id,
        "Snorkeling"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Kapal_wisata_di_Pulau_Kalimantung.jpg"^^xsd:anyURI ;
