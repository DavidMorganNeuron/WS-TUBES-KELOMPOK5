data:ws-272 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-272"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Pelaruga"@id ;
    ws:namaAlternatif "Air Terjun Teroh-teroh"@id ;
    ws:namaAlternatif "Kolam Abadi Pelaruga"@id ;
    ws:namaAlternatif "Pemandu Alam Rumah Galuh"@id ;
    ws:deskripsiSingkat "Air Terjun Pelaruga, yang nama aslinya Air Terjun Teroh-teroh, adalah air terjun setinggi sekitar 12 meter di Desa Rumah Galuh, Kecamatan Sei Bingai, Kabupaten Langkat."@id ;
    ws:deskripsiLengkap "Air Terjun Pelaruga, yang nama aslinya Air Terjun Teroh-teroh, adalah air terjun setinggi sekitar 12 meter di Desa Rumah Galuh, Kecamatan Sei Bingai, Kabupaten Langkat. Nama Pelaruga merupakan singkatan dari Pemandu Alam Rumah Galuh, komunitas pemandu lokal yang merawat kawasan ini, sedangkan nama Teroh-teroh berasal dari bahasa Karo yang berarti \"bawah-bawah\" karena air terjun ini terletak di dasar lembah. Di hulu aliran terdapat Kolam Abadi, mata air jernih kebiruan dengan kedalaman sekitar 3 meter. Pengunjung biasanya ditemani pemandu menempuh trekking 15-20 menit menuju Kolam Abadi, lalu melanjutkan body rafting menyusuri sungai hingga Air Terjun Teroh-teroh. Lokasinya sekitar 1,5 jam dari Kota Medan melalui Binjai."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:jenisDestinasi "Religi"@id ;
    ws:kataKunci "Air Terjun Pelaruga"@id ;
