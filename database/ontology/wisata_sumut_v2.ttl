data:ws-013 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-013"^^xsd:string ;
    ws:namaDestinasi "Danau Lau Kawar"@id ;
    ws:namaAlternatif "Lau Kawar"@id ;
    ws:deskripsiSingkat "Danau Lau Kawar adalah satu danau yang berada di Desa Kutagugung, Kecamatan Naman Teran (dulu Kecamatan Simpang Empat), di bawah kaki gunung berapi Sinabung, Kabupaten Karo, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Tersembunyi di bawah megahnya perbukitan dan hutan tropis di Desa Kutagugung, Kecamatan Naman Teran, Danau Lau Kawar menawarkan panorama air tenang dengan latar belakang Gunung Sinabung yang memukau. Dengan luas sekitar 200 hektar dan berada di ketinggian 2.451 meter di atas permukaan laut, kawasan ini menyajikan udara yang sangat sejuk serta suasana asri yang cocok untuk melepas penat. Selain menjadi lokasi favorit untuk berkemah dan bersantai di tepian danau, tempat ini juga sering dijadikan titik awal bagi para pendaki yang ingin menjelajahi jalur pendakian Gunung Sinabung."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Danau Lau Kawar"@id, "Lau Kawar"@id, "Gunung Sinabung"@id, "Kutagugung"@id, "Naman Teran"@id ;
    ws:beradaDi "Kabupaten Karo"@id ;
    ws:alamat "Jl. Kiras Bangun, Kuta Gugung, Kecamatan Naman Teran, Kabupaten Karo, Sumatera Utara 22153"@id ;
    ws:lintang "3.194438213120289"^^xsd:decimal ;
    ws:bujur "98.38477165401072"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Kutagugung, Kecamatan Naman Teran, Kabupaten Karo, di bawah kaki Gunung Sinabung."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "15000"^^xsd:decimal ;
    ws:noHpResmi "081267777693" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "https://www.instagram.com/marihilllaukawar"^^xsd:anyURI ;
