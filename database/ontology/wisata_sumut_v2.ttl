data:ws-163 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-163"^^xsd:string ;
    ws:namaDestinasi "Desa Adat Bawomataluo"@id ;
    ws:namaAlternatif "Bawomataluo"@id, "Bawömataluo"@id ;
    ws:deskripsiSingkat "Bawomataluo adalah desa adat di Kecamatan Fanayama, Kabupaten Nias Selatan, yang dikenal karena rumah adat Nias dan atraksi lompat batu (fahombo)."@id ;
    ws:deskripsiLengkap "Bawomataluo adalah desa adat di Kecamatan Fanayama, Kabupaten Nias Selatan, yang dikenal karena rumah adat Nias dan atraksi lompat batu (fahombo). Desa ini berada di atas bukit sekitar 400 mdpl dan memiliki deretan omo hada (rumah adat) yang berhadapan sepanjang jalan batu, dengan batu megalitik di halaman masing-masing. Atas keaslian dan kelengkapan budayanya, Bawomataluo ditetapkan sebagai cagar budaya peringkat nasional pada 2017."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Bawomataluo"@id, "Desa Adat Nias"@id, "Lompat Batu"@id, "Fahombo"@id, "Omo Hada"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Desa Bawomataluo, Kec. Fanayama, Kabupaten Nias Selatan, Sumatera Utara"@id ;
    ws:lintang "0.614335"^^xsd:decimal ;
    ws:bujur "97.770376"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Fanayama, Kabupaten Nias Selatan, sekitar 2-3 jam perjalanan darat dari Gunungsitoli."@id ;
    ws:jamOperasional "Setiap hari 08.00-18.00"@id ;
    ws:hargaMasuk "20000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Pemandu Wisata"@id, "Toilet"@id, "Toko Suvenir"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Mengapresiasi"@id, "Menjelajahi"@id, "Menonton"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/COLLECTIE_TROPENMUSEUM_Een_adathuis_in_Bawomataloewo_met_megalieten_en_een_zinken_dak_TMnr_60038140.jpg"^^xsd:anyURI ;
