data:ws-232 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-232"^^xsd:string ;
    ws:namaDestinasi "Landak River"@id ;
    ws:namaAlternatif "Landak River Langkat"@id ;
    ws:deskripsiSingkat "Wisata sungai dengan aliran jernih di Kabupaten Langkat yang dilengkapi kolam dan area piknik di tepi sungai."@id ;
    ws:deskripsiLengkap "Landak River berada di Kecamatan Bahorok, Kabupaten Langkat, memanfaatkan aliran sungai berair jernih yang berasal dari kawasan Taman Nasional Gunung Leuser. Pengunjung dapat berenang di kolam alami, menyusuri tepi sungai, atau bersantai di gazebo dan saung yang dibangun di atas batu. Kawasan ini buka 24 jam dengan tiket masuk sepuluh ribu rupiah per orang. Fasilitasnya mencakup area parkir, toilet, kamar bilas, warung makan, dan penyewaan ban pelampung. Pada musim hujan arus sungai bisa deras sehingga pengunjung perlu mengikuti arahan pengelola."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Landak River"@id, "Bahorok"@id, "Langkat"@id, "Sungai"@id, "Leuser"@id, "Berenang"@id ;
