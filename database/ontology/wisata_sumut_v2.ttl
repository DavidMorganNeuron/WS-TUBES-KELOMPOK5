data:ws-039 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-039"^^xsd:string ;
    ws:namaDestinasi "Gunung Imun"@id ;
    ws:namaAlternatif "Dolok Imun"@id ;
    ws:deskripsiSingkat "Gunung Imun adalah sebuah gunung berapi kecil sekaligus situs leluhur yang disakralkan oleh keturunan Raja Naipospos di Kabupaten Tapanuli Utara, Sumatera Utara."@id ;
    ws:deskripsiLengkap "Gunung Imun atau yang sering disebut Dolok Imun merupakan kerucut lava muda dengan ketinggian sekitar 1.505 hingga 1.800 meter di atas permukaan laut yang terletak di wilayah Tapanuli Utara dan berada di sepanjang jalur Sesar Sumatra. Secara historis dan kultural, kawasan ini sangat penting bagi masyarakat adat Batak khususnya keturunan Raja Naipospos (seperti marga Sibagariang, Hutauruk, Simanungkalit, dan Situmeang) karena di puncaknya terdapat makam leluhur serta situs sejarah. Di balik keindahannya, hutan di kawasan ini sempat mengalami tantangan serius akibat aksi perambahan dan penggundulan hutan, yang kemudian memicu berbagai upaya penghijauan serta restorasi oleh masyarakat adat bersama pemerintah setempat."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "-"@id ;
    ws:beradaDi "Kabupaten Tapanuli Utara"@id ;
    ws:alamat "Sibaragas, Kecamatan Pagaran, Kabupaten Tapanuli Utara, Sumatera Utara"@id ;
    ws:lintang "2.158750464020816"^^xsd:decimal ;
    ws:bujur "98.92999996760678"^^xsd:decimal ;
    ws:petunjukLokasi "Perjalanan darat dari Kota Medan menuju Gunung (Dolok) Imun di Kabupaten Tapanuli Utara ditempuh melalui Jalan Tol Medan–Tebing Tinggi, lalu dilanjutkan sepanjang Jalan Lintas Sumatera ke arah Pematang Siantar dan Parapat hingga mencapai kawasan Kecamatan Pagaran atau Sipoholon."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0" ;
    ws:noHpResmi "-" ;
    ws:emailResmi "-" ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "Berfoto"@id, "Menikmati Pemandangan"@id, "Berkemah"@id ;
    ws:memilikiMedia "https://inimedan.com/wp-content/uploads/2023/06/Digunduli2.jpg"^^xsd:anyURI ;
