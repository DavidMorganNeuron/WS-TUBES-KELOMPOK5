data:ws-095 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-095"^^xsd:string ;
    ws:namaDestinasi "Tugu Titik Nol Islam Nusantara"@id ;
    ws:namaAlternatif "Monumen Titik Nol Islam"@id, "Tugu Barus"@id ;
    ws:deskripsiSingkat "Tugu Titik Nol Islam Nusantara adalah monumen bersejarah yang diresmikan Presiden Joko Widodo di pesisir Barus sebagai tonggak awal masuknya Islam di Indonesia."@id ;
    ws:deskripsiLengkap "Monumen megah ini berdiri di tepi Pantai Barus, Kabupaten Tapanuli Tengah, untuk menegaskan bahwa kota bandar Barus (Pancur) telah disinggahi pedagang dari Timur Tengah pada awal abad ke-7 Masehi. Diresmikan pada 24 Maret 2017, bangunan tugu ini memiliki desain menyerupai kubah berlapis mosaik biru-putih dengan tiga pilar penyangga yang merepresentasikan keharmonisan keberagaman budaya. Monumen wisata edukasi ini dikelilingi oleh area plaza publik dengan pemandangan langsung ke lautan Samudra Hindia, sangat cocok didatangi pada sore hari."@id ;
    ws:jenisDestinasi "Budaya"@id, "Religi"@id ;
    ws:kataKunci "Titik Nol Islam"@id, "Barus"@id, "Tugu Islam Nusantara"@id, "Tapanuli Tengah"@id ;
    ws:beradaDi "Kabupaten Tapanuli Tengah"@id ;
    ws:alamat "Pasar Batu Gerigis, Kecamatan Barus, Kabupaten Tapanuli Tengah, Sumatera Utara 22564"@id ;
    ws:lintang "2.0402"^^xsd:decimal ;
    ws:bujur "98.4069"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak di kawasan Pantai Barus, tidak jauh dari jalan poros utama kota Barus."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "Tempat Parkir"@id, "Area Istirahat"@id, "Toilet"@id ;
    ws:dapatMelakukan "Mempelajari"@id, "Berfoto"@id, "Menikmati Pemandangan"@id, "Bersantai"@id ;
    ws:memilikiMedia "https://thumb.wikimedia.org/wikipedia/commons/thumb/2/24/Kilometer_0_Peradaban_Islam_Nusantara_berada_di_tepi_pantai_Barus.jpg/960px-Kilometer_0_Peradaban_Islam_Nusantara_berada_di_tepi_pantai_Barus.jpg?utm_source=id.wikipedia.org&utm_campaign=index&utm_content=thumbnail"^^xsd:anyURI ;
