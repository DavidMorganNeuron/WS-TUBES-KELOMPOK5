data:ws-144 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-144"^^xsd:string ;
    ws:namaDestinasi "Pantai Sirombu"@id ;
    ws:namaAlternatif "Pantai Sirombu Nias Barat"@id ;
    ws:deskripsiSingkat "Pantai Sirombu adalah ikon tepi laut kebanggaan Nias Barat dengan batu karang tegak dan ombak besar yang juga berfungsi sebagai pelabuhan penyeberangan lokal."@id ;
    ws:deskripsiLengkap "Berbeda dari kebanyakan pesisir yang didominasi pasir lembut, garis Pantai Sirombu yang membentang luas diwarnai oleh jejeran tebing batu karang (atol) tajam berwarna gelap, sisa-sisa fenomena geologis pengangkatan dasar laut kala gempa 2005. Deru ombak besar Samudra Hindia yang terus menghantam atol karang menyuguhkan tontonan alami dramatis. Di sisi pantai yang landai, pengunjung dimanjakan dengan berdirinya kawasan pusat perbelanjaan hasil tangkapan laut yang selalu sibuk karena merupakan pintu masuk bagi kapal pengangkut penumpang ke Kepulauan Hinako."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Sirombu"@id, "Nias Barat"@id, "Wisata Pantai"@id, "Pelabuhan Sirombu"@id, "Karang Laut"@id ;
    ws:beradaDi "Kabupaten Nias Barat"@id ;
    ws:alamat "Desa Sirombu, Kecamatan Sirombu, Kabupaten Nias Barat, Sumatera Utara 22867"@id ;
    ws:lintang "0.9418"^^xsd:decimal ;
    ws:bujur "97.4589"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak persis di pusat kawasan keramaian Kecamatan Sirombu, sekitar 1 jam dari Mandrehe."@id ;
    ws:jamOperasional "Selalu Buka"@id ;
    ws:hargaMasuk "0"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
