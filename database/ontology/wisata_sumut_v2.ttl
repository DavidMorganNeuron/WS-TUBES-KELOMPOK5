data:ws-209 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-209"^^xsd:string ;
    ws:namaDestinasi "Rumah Pengasingan Soekarno"@id ;
    ws:namaAlternatif "Rumah Pengasingan Bung Karno Parapat"@id ;
    ws:deskripsiSingkat "Bangunan kolonial tahun 1820 di Parapat yang menjadi tempat pengasingan Presiden Soekarno pada 1949, kini difungsikan sebagai rumah bersejarah."@id ;
    ws:deskripsiLengkap "Rumah Pengasingan Soekarno berada di Jalan Sisingamangaraja, Parapat, Kecamatan Girsang Sipangan Bolon, Kabupaten Simalungun. Bangunan bergaya indische architectuur ini dibangun sekitar 1820 sebagai pesanggrahan perkebunan Belanda, lalu dipakai mengasingkan Soekarno bersama Haji Agus Salim dan Sjahrir pada awal 1949. Perabotan, foto, lukisan, dan buku masa itu masih tersimpan di dalamnya. Rumah dua lantai berukuran 10 x 20 meter ini dikelilingi taman sekitar dua hektare dan menghadap Danau Toba. Tiket masuk sekitar lima ribu rupiah per orang."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Rumah Pengasingan Soekarno"@id, "Bung Karno"@id, "Parapat"@id, "Simalungun"@id, "Sejarah Kemerdekaan"@id, "Bangunan Kolonial"@id ;
    ws:beradaDi "Kabupaten Simalungun"@id ;
    ws:alamat "Jl. Sisingamangaraja, Parapat, Kec. Girsang Sipangan Bolon, Kab. Simalungun, Sumatera Utara 21174"@id ;
