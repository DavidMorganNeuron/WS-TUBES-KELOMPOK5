data:ws-046 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-046"^^xsd:string ;
    ws:namaDestinasi "Waterland Tamora"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Waterland Tamora merupakan destinasi wisata air dan taman bermain terpadu terbesar serta termewah di Tanjung Morawa, Kabupaten Deli Serdang, Sumatera Utara, yang menghadirkan konsep rekreasi keluarga yang lengkap dengan harga tiket terjangkau."@id ;
    ws:deskripsiLengkap "Terletak di Jalan Bandar Labuhan, Desa Limau Manis, Waterland Tamora menawarkan pengalaman liburan seru yang memadukan wahana air dan darat dalam satu kawasan terintegrasi. Destinasi ini dilengkapi dengan beragam fasilitas unggulan seperti kolam anak berkonsep ember tumpah, kolam arus, kolam semi-olimpiade, serta deretan seluncuran air menegangkan seperti Giant Water Splash dan water slide. Tidak hanya bermain air, pengunjung juga bisa menikmati keseruan di area darat melalui kehadiran Tamora Funland yang menyajikan wahana seperti sky bike, komidi putar, hingga kapal Viking, serta adanya mini zoo dan Sunlake Foodcorner."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "-"@id ;
    ws:beradaDi "Kabupaten Deli Serdang"@id ;
    ws:alamat "Jl. Bandar Labuhan, Limau Manis, Kecamatan Tanjung Morawa, Kabupaten Deli Serdang, Sumatera Utara 20362"@id ;
    ws:lintang "3.4943751476123626"^^xsd:decimal ;
    ws:bujur "98.77475496750316"^^xsd:decimal ;
    ws:petunjukLokasi "Dari pusat Kota Medan, arahkan kendaraan melalui Jalan Sisingamangaraja atau Tol Belmera keluar di Gerbang Tol Tanjung Morawa, lalu lanjutkan perjalanan menuju Jalan Kelapa Sawit hingga ke Jalan Bandar Labuhan di Desa Limau Manis tempat Waterland Tamora berada."@id ;
