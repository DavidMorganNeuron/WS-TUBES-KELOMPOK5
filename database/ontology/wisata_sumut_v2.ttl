data:ws-251 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-251"^^xsd:string ;
    ws:namaDestinasi "Desa Meat"@id ;
    ws:namaAlternatif "Desa Adat Meat"@id ;
    ws:deskripsiSingkat "Desa adat Batak Toba di Kecamatan Tampahan, Kabupaten Toba, yang dikenal sebagai kampung pengrajin tenun ulos."@id ;
    ws:deskripsiLengkap "Desa Meat berada di Kecamatan Tampahan, Kabupaten Toba, di tepi Danau Toba. Kampung ini dikenal sebagai salah satu pusat tenun ulos, dengan rumah-rumah adat beratap ijuk dan lumbung padi berjejer di sepanjang jalan desa. Pengunjung dapat melihat proses menenun, membeli ulos langsung dari pengrajin, dan mendengarkan penjelasan tokoh desa tentang adat Batak. Pemerintah desa memungut kontribusi sekitar sepuluh ribu rupiah per orang untuk pemeliharaan kawasan. Area ini terbuka sepanjang hari, meski aktivitas menenun paling ramai pada pagi hingga siang."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Desa Meat, Desa Adat Meat, Tampahan, Toba, tenun ulos, rumah adat"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Desa Meat, Kec. Tampahan, Kab. Toba, Sumatera Utara"@id ;
    ws:lintang "2.323040"^^xsd:decimal ;
    ws:bujur "99.005080"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Balige, berkendara sekitar 20 menit ke arah Tampahan mengikuti jalan tepi Danau Toba."@id ;
    ws:jamOperasional "Setiap hari 24 jam"@id ;
