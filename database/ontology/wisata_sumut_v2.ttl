data:ws-106 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-106"^^xsd:string ;
    ws:namaDestinasi "Museum Batak TB Silalahi Center"@id ;
    ws:namaAlternatif "TB Silalahi Center"@id, "Museum TB Silalahi"@id, "Museum Batak Balige"@id ;
    ws:deskripsiSingkat "Museum Batak TB Silalahi Center adalah pusat pelestarian sejarah, seni, dan kebudayaan enam puak Batak yang berada di Balige."@id ;
    ws:deskripsiLengkap "Diresmikan pada tahun 2011, museum yang digagas oleh Letjen (Purn) T.B. Silalahi ini didesain dengan konsep arsitektur modern berpadu motif gorga. Museum ini menyajikan koleksi artefak budaya Batak yang sangat komprehensif, mulai dari senjata tradisional, perhiasan, ulos berusia ratusan tahun, hingga patung sigale-gale dan rumah adat otentik. Selain itu, di dalam satu kawasan yang sama juga terdapat Museum Pribadi T.B. Silalahi yang menampilkan perjalanan karier militer beliau, dilengkapi dengan fasilitas kolam renang, kafe, dan pemandangan luar biasa yang menghadap langsung ke hamparan Danau Toba."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Museum Batak"@id, "TB Silalahi"@id, "Balige"@id, "Toba"@id, "Sejarah Batak"@id ;
    ws:beradaDi "Kabupaten Toba"@id ;
    ws:alamat "Jl. Pagar Batu No.88, Silalahi Pagar Batu, Kecamatan Balige, Kabupaten Toba, Sumatera Utara 22312"@id ;
    ws:lintang "2.3375"^^xsd:decimal ;
    ws:bujur "99.0487"^^xsd:decimal ;
