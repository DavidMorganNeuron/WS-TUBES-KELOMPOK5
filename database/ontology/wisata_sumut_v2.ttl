data:ws-201 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-201"^^xsd:string ;
    ws:namaDestinasi "Pantai Lagundri"@id ;
    ws:namaAlternatif "Lagundri Beach"@id ;
    ws:deskripsiSingkat "Pantai selancar di Teluk Dalam, Kabupaten Nias Selatan, bersebelahan dengan Pantai Sorake dan dikenal karena ombaknya yang mendunia."@id ;
    ws:deskripsiLengkap "Pantai Lagundri terletak di Desa Botohilitano, Kecamatan Teluk Dalam, Kabupaten Nias Selatan, hanya sekitar dua kilometer dari Pantai Sorake. Pantai ini menjadi salah satu titik selancar kelas dunia karena ombaknya dapat mencapai tujuh hingga sepuluh meter pada April sampai September. Selain surfing, pengunjung dapat berenang di bagian teluk yang lebih tenang, menyusuri pasir putih, atau menginap di surf camp dan losmen di sekitarnya. Tiket masuk kawasan sepuluh ribu rupiah per orang, sementara sewa papan selancar dan pemandu diatur langsung dengan pengelola lokal."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Lagundri"@id, "Lagundri Beach"@id, "Teluk Dalam"@id, "Nias Selatan"@id, "Surfing"@id, "Ombak"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "Desa Botohilitano, Kec. Teluk Dalam, Kab. Nias Selatan, Sumatera Utara"@id ;
    ws:lintang "0.5794375"^^xsd:decimal ;
    ws:bujur "97.7326875"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Pelabuhan Teluk Dalam, berkendara sekitar 15 menit ke arah utara mengikuti jalan menuju Sorake dan Lagundri."@id ;
    ws:jamOperasional "Setiap hari 07.30-18.00"@id ;
