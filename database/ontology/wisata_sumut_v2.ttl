data:ws-204 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-204"^^xsd:string ;
    ws:namaDestinasi "Pantai Sirombu"@id ;
    ws:namaAlternatif "Pantai Sirombu Nias Barat"@id ;
    ws:deskripsiSingkat "Pantai di Kecamatan Sirombu, Kabupaten Nias Barat, yang dikelola kelompok sadar wisata desa dan tercatat di data resmi destinasi Kemenpar."@id ;
    ws:deskripsiLengkap "Pantai Sirombu berada di Desa Sirombu, Kecamatan Sirombu, Kabupaten Nias Barat, dan mulai dikembangkan sebagai destinasi sejak 2011. Profil resminya mencatat jam operasional pukul 08.00 hingga 23.00 WIB dengan keterangan tidak ada tiket masuk. Pantainya menghadap Samudra Hindia dengan pasir putih kecokelatan, dilengkapi gazebo, toilet, dan warung yang dikelola warga. Pengunjung dapat berenang di bagian yang tenang, memancing dari tepi, atau menyaksikan nelayan menurunkan perahu pada pagi hari."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Sirombu, Nias Barat, Sirombu, pokdarwis, pantai barat Nias"@id ;
    ws:beradaDi "Kabupaten Nias Barat"@id ;
