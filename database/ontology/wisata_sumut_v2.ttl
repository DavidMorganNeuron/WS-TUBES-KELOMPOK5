data:ws-113 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-113"^^xsd:string ;
    ws:namaDestinasi "Sorake"@id ;
    ws:namaAlternatif "Pantai Sorake"@id ;
    ws:deskripsiSingkat "Sorake adalah sebuah pantai yang bersebelahan dengan pantai Lagundri."@id ;
    ws:deskripsiLengkap "Sorake adalah sebuah pantai yang bersebelahan dengan pantai Lagundri. Pantai ini terletak di Kecamatan Luahagundre Maniamolo, Kabupaten Nias Selatan, Sumatera Utara. Pantai Sorake terkenal dengan ombaknya yang besar sehingga sangat cocok untuk kegiatan berselancar. Setiap tahun banyak wisatawan terutama wisatawan manca negara yang mengunjungi pantai ini. Di pantai ini juga sering diadakan kompetisi selancar baik yang bersifat lokal maupun kompetisi yang pesertanya dari berbagai negara. Nias Open adalah salah satu kejuaraan yang diselenggarakan di pantai ini, dengan diikuti ratusan peselancar dari berbagai negara dengan pemenangnya didominasi oleh peselancar dari Australia tiap tahun. Pantai Sorake ini memiliki karakter ombak yang bagus, bahkan tingginya bisa mencapai 15 m di bulan-bulan tertentu, misalnya bulan April hingga September. Lebih menantang lagi saat bulan purnama tiba. Ombaknya bisa bergulung utuh hingga ke bibir pantai, dan punya 11 kali gelombang sebelum pecah. Ombaknya juga punya lima tingkatan berbeda, sehingga peselancar bisa beraksi dengan berbagai gaya. Selain itu, ombak di Pantai Sorake selalu muncul tanpa ada jeda waktu, sehingga sangat menyenangkan bagi para surfer. Terdapat home stay dan penginapan kecil serta hotel di pantai ini. Hotel berbintang pun ada 1 unit yaitu Sorake Beach Hotel."@id ;
    ws:jenisDestinasi "Bahari"@id ;
    ws:kataKunci "Pantai Sorake, surfing, ombak, Nias Selatan, Lagundri"@id ;
    ws:beradaDi "Kabupaten Nias Selatan"@id ;
    ws:alamat "-"@id ;
    ws:lintang "0.573202"^^xsd:decimal ;
    ws:bujur "97.732281"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Kecamatan Luahagundre Maniamolo, Kabupaten Nias Selatan, bersebelahan dengan Pantai Lagundri."@id ;
    ws:jamOperasional "24 jam"@id ;
    ws:hargaMasuk "5000"^^xsd:decimal ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "berselancar"@id ;
    ws:dapatMelakukan "menikmati pantai"@id ;
    ws:memilikiMedia "https://commons.wikimedia.org/wiki/Special:FilePath/Pantai_Sorake.jpg"^^xsd:anyURI ;
    ws:ratingPengunjung "4.7"^^xsd:decimal .

data:ws-114 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-114"^^xsd:string ;
    ws:namaDestinasi "Candi Sipamutung"@id ;
    ws:namaAlternatif "-"@id ;
    ws:deskripsiSingkat "Candi Sipamutung (Biaro Sipamutung) adalah salah satu candi bercorak Buddha peninggalan Kerajaan Pannai di Kompleks Percandian Padang Lawas."@id ;
    ws:deskripsiLengkap "Candi Sipamutung (Biaro Sipamutung) adalah salah satu candi bercorak Buddha peninggalan Kerajaan Pannai di Kompleks Percandian Padang Lawas. Secara administratif, candi ini terletak di desa Siparau, kecamatan Barumun Tengah, Kabupaten Padang Lawas, provinsi Sumatera Utara. Sekitar 40 kilometer dari ibu kota Kabupaten Padanglawas, Sibuhuan atau sekitar 70 kilometer dari Kota Padangsidimpuan dan 400 kilometer dari Medan, Ibu kota Provinsi Sumatera Utara. Secara geografis, Candi Sipamutung terletak di tepi Sungai Barumun yang membelah dataran rendah Padanglawas. Bangunan ini diperkirakan berdiri pada abad 11. Candi Sipamutung merupakan candi terbesar di Kompleks Percandian Padanglawas. Candi Sipamutung secara umum terbuat dari bata dan mempunyai luas lahan 6000 meter persegi dan luas candi 74 x 74 meter yang dikelilingi tembok bata. Komplek Candi Sipamutung terdiri dari 1 bangunan utama dan 6 candi perwara dan 16 stupa. Bangunan utamanya memiliki luas 11 x 11 meter dan tinggi 13 meter yang terdiri dari bagian kaki, badan, dan atap. Candi-candi perwara di sekitar candi induk berbentuk mandapa berdenah segi empat berukuran luas 10,25 X 9,9 meter dan tinggi 1,15 meter."@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:jenisDestinasi "Budaya"@id ;
    ws:kataKunci "Candi Sipamutung, Kerajaan Pannai, Sungai Barumun, Siparau, Barumun Tengah"@id ;
    ws:beradaDi "Kabupaten Padang Lawas"@id ;
    ws:alamat "Desa Siparau, Kecamatan Barumun Tengah, Kabupaten Padang Lawas, Sumatera Utara"@id ;
    ws:lintang "1.39273"^^xsd:decimal ;
    ws:bujur "99.75465"^^xsd:decimal ;
    ws:petunjukLokasi "Berada di Desa Siparau, Kecamatan Barumun Tengah, Kabupaten Padang Lawas, di tepi Sungai Barumun; sekitar 400 km dari Kota Medan."@id ;
    ws:jamOperasional "-"@id ;
    ws:hargaMasuk "-" ;
    ws:noHpResmi "-"^^xsd:string ;
    ws:emailResmi "-"^^xsd:string ;
    ws:instagramResmi "-"^^xsd:anyURI ;
    ws:memilikiFasilitas "-"@id ;
    ws:dapatMelakukan "menjelajah situs candi"@id ;
    ws:dapatMelakukan "berfoto"@id ;
