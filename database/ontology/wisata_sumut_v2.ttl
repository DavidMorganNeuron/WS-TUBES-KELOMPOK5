    ws:alamat "Kec. Bilah Barat, Kab. Labuhanbatu, Sumatera Utara"@id ;
    ws:lintang "2.068000"^^xsd:decimal ;
    ws:bujur "99.812000"^^xsd:decimal ;
    ws:petunjukLokasi "Dari Rantauprapat, berkendara sekitar 30 menit ke arah Bilah Barat hingga gerbang hutan lindung."@id ;
