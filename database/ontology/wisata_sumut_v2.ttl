data:ws-050 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-050"^^xsd:string ;
    ws:namaDestinasi "Medan Zoo"@id ;
    ws:namaAlternatif "Kebun Binatang Simalingkar Medan"@id ;
    ws:deskripsiSingkat "Medan Zoo Simalingkar B adalah salah satu kebun binatang tertua di Indonesia yang berdiri sejak tahun 1952 dan dipindahkan ke wilayah Simalingkar B, Medan Tuntungan, pada tahun 2005 dengan luas area mencapai 30 hektare."@id ;
    ws:deskripsiLengkap "Medan Zoo yang terletak di Jalan Bunga Rampai IV, Kelurahan Simalingkar B, Kecamatan Medan Tuntungan, merupakan pusat konservasi serta wisata edukasi legendaris yang memiliki akar sejarah panjang sejak beroperasi pertama kali pada tahun 1952 di kawasan Jalan Brigjen Katamso. Pada April 2005, fasilitas ini resmi direlokasi ke lahan yang lebih luas seluas 30 hektare di Simalingkar B untuk memberikan ruang hidup yang lebih representatif bagi berbagai koleksi satwa seperti Harimau Sumatra, Gajah Sumatra, beruang, rusa, dan beragam jenis unggas. Meskipun memiliki nilai historis dan potensi besar sebagai paru-paru kota serta destinasi keluarga, dalam beberapa tahun terakhir pengelolaannya menghadapi berbagai tantangan finansial dan pemeliharaan infrastruktur yang membuat kondisinya cukup memprihatinkan, sehingga mengundang perhatian pemerintah dan publik untuk melakukan upaya revitalisasi menyeluruh."@id ;
    ws:jenisDestinasi "Buatan"@id ;
    ws:kataKunci "-"@id ;
    ws:beradaDi "Kota Medan"@id ;
    ws:alamat "Jl. Bunga Rampe IV, Simalingkar B, Kecamatan Medan Tuntungan, Kota Medan, Sumatera Utara 20135"@id ;
    ws:lintang "3.4834123677787643"^^xsd:decimal ;
