data:ws-125 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-125"^^xsd:string ;
    ws:namaDestinasi "Air Terjun Janji"@id ;
    ws:namaAlternatif "Sampuran Janji"@id ;
    ws:deskripsiSingkat "Air Terjun Janji merupakan situs alam bersejarah di Lembah Bakkara di mana raja-raja masa lampau sering berkumpul untuk mengambil sumpah setia."@id ;
    ws:deskripsiLengkap "Berdasarkan legenda leluhur masyarakat Humbang Hasundutan, Air Terjun Janji dahulunya adalah tempat sakral yang dimanfaatkan sebagai saksi diikrarkannya janji setia dan sumpah para raja purba Batak sebelum maju menuju medan peperangan, mengingat sumber airnya dianggap suci dan menenangkan jiwa. Air terjun ini memiliki tinggi curahan lebih dari 30 meter yang menempel langsung ke dinding tebing kapur berselimut pepohonan yang merambat. Lokasinya sangat dekat dengan muara Danau Toba dan mudah diakses dari pinggir jalan Desa Marbun, menjadikannya primadona penyejuk raga sesudah pengunjung mengitari Lembah Bakkara."@id ;
    ws:jenisDestinasi "Alam"@id ;
    ws:kataKunci "Air Terjun Janji"@id, "Bakkara"@id, "Bakti Raja"@id, "Humbang Hasundutan"@id, "Sampuran Janji"@id ;
    ws:beradaDi "Kabupaten Humbang Hasundutan"@id ;
    ws:alamat "Desa Marbun Toruan, Kecamatan Baktiraja, Kabupaten Humbang Hasundutan, Sumatera Utara 22457"@id ;
    ws:lintang "2.339167"^^xsd:decimal ;
