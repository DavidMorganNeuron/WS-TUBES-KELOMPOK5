data:ws-117 a ws:DestinasiWisata ;
    ws:idDestinasi "ws-117"^^xsd:string ;
    ws:namaDestinasi "Menara Pandang Tele"@id ;
    ws:namaAlternatif "Menara Tele"@id ;
    ws:deskripsiSingkat "Menara Pandang Tele adalah ikon infrastruktur observasi tiga tingkat di Samosir yang berada di puncak tertinggi jalan darat menuju Pulau Samosir."@id ;
    ws:deskripsiLengkap "Menara setinggi empat lantai ini terletak di perbukitan Tele dan berfungsi sebagai titik pemberhentian (rest area) paling ikonis sebelum para pelancong menuruni jalur ekstrem menuju pusat Pulau Samosir. Dari anjungan observasi tertingginya, wisatawan disuguhi panorama mahakarya luar biasa: bentang kaldera Danau Toba yang diapit daratan Pulau Samosir di kejauhan, kemegahan Gunung Pusuk Buhit di sebelah kanan, dan hamparan daratan dataran tinggi Humbang Hasundutan. Fasilitas ini sangat sempurna bagi peminat fotografi lanskap maupun keluarga yang ingin beristirahat sejenak sambil menyesap kopi lokal dengan udara yang sangat dingin."@id ;
    ws:jenisDestinasi "Buatan"@id, "Alam"@id ;
    ws:kataKunci "Menara Pandang Tele"@id, "Tele"@id, "Samosir"@id, "Danau Toba"@id, "Titik Pandang"@id ;
    ws:beradaDi "Kabupaten Samosir"@id ;
    ws:alamat "Turpuk Limbong, Kecamatan Harian, Kabupaten Samosir, Sumatera Utara 22396"@id ;
    ws:lintang "2.5520625"^^xsd:decimal ;
    ws:bujur "98.6398125"^^xsd:decimal ;
    ws:petunjukLokasi "Terletak persis di pinggir jalan raya utama akses darat Pangururan - Sidikalang/Dolok Sanggul."@id ;
