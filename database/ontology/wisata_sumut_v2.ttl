    ws:bujur "99.16599073866811"^^xsd:decimal ;
    ws:petunjukLokasi "Berkendara melalui Jalan Tol Medan–Tebing Tinggi sejauh kurang lebih 82 kilometer menuju Ramayana Tebing Tinggi di Jalan Jenderal Sudirman"@id ;
